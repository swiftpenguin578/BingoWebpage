<template data-page-header-template="identity">
    <header class="page-head" data-page-family="identity"><div style="min-width:0"><h1 class="h1" tabindex="-1">@T["Identity"]</h1><p class="summary"><span data-summary-template="@T["AdminDesign.Name, description, buy-in and timezone for {0}."].Value"></span></p></div></header>
</template>
<template data-page-loading-template="identity" data-page-title="@T["Identity"]">
    <link rel="stylesheet" href="~/css/admin-design-identity.css" asp-append-version="true" />
    <div class="card form-card" aria-busy="true" aria-label="@T["Loading identity"]">
        <div class="sk-block"><div class="sk" style="width:22%"></div><div class="sk" style="width:100%;height:34px;margin-top:14px;border-radius:8px"></div><div class="sk" style="width:100%;height:120px;margin-top:18px;border-radius:8px"></div></div>
        <div class="sk-block"><div class="sk" style="width:18%"></div><div class="sk" style="width:46%;height:34px;margin-top:14px;border-radius:8px"></div></div>
        <div class="sk-block" style="border-bottom:0"><div class="sk" style="width:16%"></div><div class="sk" style="width:70%;height:34px;margin-top:14px;border-radius:8px"></div></div>
    </div>
</template>
