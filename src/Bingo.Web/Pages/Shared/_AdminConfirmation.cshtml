<dialog class="admin-confirmation" data-admin-confirmation data-toast-host
        aria-labelledby="admin-confirmation-title" aria-describedby="admin-confirmation-description"
        data-discard-title="@T["Discard unsaved changes?"]"
        data-discard-description="@T["Continuing will discard unsaved changes in this editor."]"
        data-discard-action="@T["Discard changes"]"
        data-failure="@T["The change could not be sent. Check your connection and try again."]">
    <form data-admin-confirmation-form>
        <h2 id="admin-confirmation-title"></h2>
        <p id="admin-confirmation-description"></p>
        <div data-admin-confirmation-reason-field hidden>
            <label for="admin-confirmation-reason">@T["Reason"]</label>
            <textarea id="admin-confirmation-reason" name="reason" rows="3" maxlength="4000"></textarea>
        </div>
        <div data-admin-confirmation-typed-field hidden>
            <label for="admin-confirmation-typed" data-admin-confirmation-typed-label></label>
            <input id="admin-confirmation-typed" name="confirmation" autocomplete="off" />
        </div>
        <p data-admin-confirmation-feedback role="alert" tabindex="-1" hidden></p>
        <div class="admin-confirmation-actions">
            <button type="button" class="admin-button-secondary" data-admin-confirmation-cancel autofocus>@T["Cancel"]</button>
            <button type="submit" class="admin-button-secondary" data-admin-confirmation-action></button>
        </div>
    </form>
</dialog>
