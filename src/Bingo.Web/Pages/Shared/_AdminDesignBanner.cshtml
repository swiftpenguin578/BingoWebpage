@model Bingo.Web.UI.AdminDesignBanner
<div class="banner @Model.Tone" role="@(Model.Tone == "is-info" ? "status" : "alert")" id="@Model.Id" hidden="@Model.Hidden"><partial name="_AdminDesignIcon" model='new AdminDesignIcon(Model.Icon)' /><span class="grow"><b data-component-lead hidden="@(string.IsNullOrEmpty(Model.Lead))">@Model.Lead</b><span data-component-text>@Model.Text</span></span></div>
