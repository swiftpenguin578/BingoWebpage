@inject IStringLocalizer<AdminCommunityResource> D
<template data-page-header-template="dashboard">
    <header class="page-head" data-page-family="dashboard"><div style="min-width:0"><h1 class="h1" tabindex="-1">@T["Dashboard"]</h1><p class="summary" aria-hidden="true"><span>&nbsp;</span></p></div>
    <div class="next-event" data-dashboard-loading-card aria-hidden="true"><div class="grow">
        <div class="next-label" style="position:relative">&nbsp;<span class="sk" style="position:absolute;width:30%;top:5px"></span></div>
        <div class="next-name" style="position:relative">&nbsp;<span class="sk" style="position:absolute;width:75%;top:5px"></span></div>
        <div class="next-meta" style="position:relative">&nbsp;<span class="sk" style="position:absolute;width:55%;top:5px"></span></div>
    </div><span class="sk" style="width:56px;height:6px;flex:none"></span><span class="sk" style="width:52px;height:28px;flex:none;border-radius:var(--dk-radius-xs)"></span></div>
    </header>
</template>
<template data-page-loading-template="dashboard" data-page-title="@T["Dashboard"]">
    <link rel="stylesheet" href="~/css/admin-design-dashboard.css" asp-append-version="true" />
    <div class="card" aria-busy="true" aria-label="@T["Loading statistics"]"><div class="stat-strip">
    @for (var i = 0; i < 4; i++)
    {
        <div class="stat"><div class="sk" style="width:46%"></div><div class="sk dash-sk-stat-value" style="width:38%"></div><div class="sk dash-sk-stat-note" style="width:62%;height:8px"></div></div>
    }
    </div></div>
    <div class="dash-grid">
        <div class="card panel"><div class="sk" style="width:30%"></div><div class="sk dash-sk-chart"></div></div>
        <div class="card panel"><div class="sk" style="width:40%"></div><div class="sk dash-sk-recap"></div><div class="sk dash-sk-fact-first" style="width:80%"></div><div class="sk dash-sk-fact" style="width:70%"></div><div class="sk dash-sk-fact" style="width:75%"></div></div>
    </div>
</template>
<template data-page-failure-template="dashboard">
    <div class="card"><div class="empty is-error" role="alert"><div class="empty-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /></div><div class="empty-title">@D["Couldn’t load statistics"]</div><div class="empty-text">@D["The dashboard figures didn’t load. Events and participants are unaffected."]</div><button type="button" class="btn" data-load-retry>@D["Try again"]</button></div></div>
</template>
