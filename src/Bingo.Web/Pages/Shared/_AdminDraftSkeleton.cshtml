@* U6: Teams / Draft loading body (readiness card, teams bar, three team cards). Text rows keep real line height (rule 7). *@
<div class="td-sk" aria-busy="true" aria-label="@T["Loading teams"]" data-draft-skeleton>
    <div class="card td-ready"><div class="td-ready-main"><div class="td-ready-text"><div class="td-sk-line"><div class="sk td-sk-w30"></div></div><div class="td-sk-sub"><div class="sk td-sk-w70"></div></div></div><div class="td-checks">@for (var i = 0; i < 3; i++) { <div class="td-sk-sub"><div class="sk td-sk-w60"></div></div> }</div></div></div>
    <div class="td-bar"><div class="td-sk-line"><div class="sk td-sk-w12"></div></div></div>
    <div class="tcards">@for (var i = 0; i < 3; i++) { <div class="tcard"><div class="sk-block"><div class="td-sk-line"><div class="sk td-sk-w40"></div></div><div class="td-sk-sub td-sk-gap"><div class="sk td-sk-w70"></div></div><div class="td-sk-sub"><div class="sk td-sk-w60"></div></div><div class="td-sk-sub"><div class="sk td-sk-w66"></div></div></div></div> }</div>
</div>
