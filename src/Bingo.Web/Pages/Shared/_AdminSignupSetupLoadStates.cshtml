<template data-page-header-template="signupsetup"><header class="page-head" data-page-family="signupsetup"><div style="min-width:0"><h1 class="h1" tabindex="-1">@T["Signup setup"]</h1><p class="summary"><span data-summary-template=""></span></p></div></header></template>
<template data-page-loading-template="signupsetup" data-page-title="@T["Signup setup"]"><link rel="stylesheet" href="~/css/admin-design-signupsetup.css" asp-append-version="true"/><div class="ss-wrap"><div class="tabs ss-tabs"><button class="tab is-on" disabled>@T["Settings"]</button><button class="tab" disabled>@T["Signup form"]</button></div><div class="card form-card" aria-busy="true" aria-label="@T["Loading signup setup"]">@foreach(var width in new[]{26,20,18}){<div class="sk-block"><div class="ss-sk-line"><div class="sk" style="width:@(width)%"></div></div><div class="sk" style="width:40%;height:34px;margin-top:14px;border-radius:8px"></div></div>}</div></div></template>
