@* JS clones the same partials used by server-rendered components. *@
<template data-admin-template="confirmation"><partial name="_AdminDesignConfirmation" /></template>
<template data-admin-template="toast"><partial name="_AdminDesignToast" model='new AdminDesignToast()' /></template>
<template data-admin-template="toast-error"><partial name="_AdminDesignToast" model='new AdminDesignToast(Error: true)' /></template>
<template data-admin-template="field-note"><partial name="_AdminDesignFieldNote" model='new AdminDesignFieldNote(UseCurrent: true)' /></template>
<template data-admin-template="field-error"><partial name="_AdminDesignFieldError" model='new AdminDesignFieldError("")' /></template>
<template data-admin-template="banner-info"><partial name="_AdminDesignBanner" model='new AdminDesignBanner("is-info", "info")' /></template>
<template data-admin-template="banner-error"><partial name="_AdminDesignBanner" model='new AdminDesignBanner("is-error", "error")' /></template>
<template data-admin-template="banner-warning"><partial name="_AdminDesignBanner" model='new AdminDesignBanner("is-warning", "warning")' /></template>
<template data-admin-template="banner-uncertain"><partial name="_AdminDesignBanner" model='new AdminDesignBanner("is-warning", "uncertain")' /></template>
<template data-admin-template="loading"><partial name="_AdminDesignLoading" /></template>
<template data-admin-template="load-failure"><partial name="_AdminDesignLoadFailure" /></template>
<partial name="_AdminDashboardLoadStates" />
<partial name="_AdminEventsLoadStates" />
<partial name="_AdminIdentityLoadStates" />
<partial name="_AdminScheduleLoadStates" />
<partial name="_AdminSignupSetupLoadStates" />
<partial name="_AdminAccountsLoadStates" />
<partial name="_AdminAuditLoadStates" />
