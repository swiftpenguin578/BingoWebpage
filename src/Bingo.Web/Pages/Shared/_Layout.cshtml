@using Bingo.Web.Navigation
@using Bingo.Web.UI
@inject SharedShellService SharedShell
@{
    var shell = await SharedShell.GetAsync(User, ViewContext.RouteData.Values, Context.RequestAborted);
    var captainNavigation = shell.CaptainNavigation;
    var submissionNavigation = shell.SubmissionNavigation;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isPublicBoardsPage = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase)
        || currentPage?.StartsWith("/Events/", StringComparison.OrdinalIgnoreCase) == true
        || currentPage?.StartsWith("/Evidence", StringComparison.OrdinalIgnoreCase) == true;
    var isAccountPage = currentPage?.StartsWith("/Account/", StringComparison.OrdinalIgnoreCase) == true;
    var isSubmissionsPage = currentPage?.StartsWith("/Submissions", StringComparison.OrdinalIgnoreCase) == true;
    var isCaptainPage = currentPage?.StartsWith("/Captain", StringComparison.OrdinalIgnoreCase) == true
        || (isSubmissionsPage && captainNavigation is not null);
    var isAccountSubsectionPage = currentPage is "/Account/Settings" or "/Account/MyAccounts" or "/Account/MyEvents" or "/Account/ChangePassword";
    var isAccountSettingsPage = currentPage is "/Account/Settings" or "/Account/ChangePassword";
    var isHowToPage = string.Equals(currentPage, "/HowTo", StringComparison.OrdinalIgnoreCase);
    var isLandingPage = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
    var isPass1PublicPage = currentPage is "/Events/Signup"
        or "/Events/Confirmation"
        or "/Account/Login"
        or "/Account/DiscordComplete"
        or "/Account/Onboarding"
        or "/Account/AccessDenied"
        or "/Error"
        or "/Errors/StatusCode";
    var isEventBoardPage = currentPage is "/Events/Board" or "/Events/TeamBoard";
    var eventSlug = ViewContext.RouteData.Values["slug"]?.ToString();
    var eventBoardView = Context.Request.Query["view"].ToString();
    var isRecentDropsView = string.Equals(currentPage, "/Events/Board", StringComparison.OrdinalIgnoreCase) && string.Equals(eventBoardView, "drops", StringComparison.OrdinalIgnoreCase);
    var isLeaderboardsView = string.Equals(currentPage, "/Events/Board", StringComparison.OrdinalIgnoreCase) && string.Equals(eventBoardView, "leaderboards", StringComparison.OrdinalIgnoreCase);
    var isViewBingo = isEventBoardPage && !isRecentDropsView && !isLeaderboardsView;
    var hasSecondaryNavigation = (isEventBoardPage && !string.IsNullOrWhiteSpace(eventSlug)) || isAccountSubsectionPage;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      data-public-select-option="@T["Select option"]"
      data-public-page-template="@T["Page {0} of {1}"]"
      data-public-sort-template="@T["Sort by {0}"]"
      data-public-sort-current-template="@T["Currently sorted by {0} {1}. Activate to sort {2}."]"
      data-public-sort-ascending="@T["ascending"]"
      data-public-sort-descending="@T["descending"]"
      data-public-toast-success="@T["Success"]"
      data-public-toast-warning="@T["Warning"]"
      data-public-toast-error="@T["Error"]"
      data-public-toast-information="@T["Information"]"
      data-public-toast-dismiss="@T["Dismiss message"]"
      data-time-label="@T["Time"]"
      data-time-hour="@T["hour"]"
      data-time-minute="@T["minute"]"
      data-sort-column="@T["Column"]"
      data-sort-by-template="@T["Sort by {0}"]"
      data-sort-current-template="@T["Currently sorted by {0} {1}. Activate to sort {2}."]"
      data-sort-direction-ascending="@T["ascending"]"
      data-sort-direction-descending="@T["descending"]"
      data-post-error="@T["The change could not be sent. Check your connection and try again."]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSRS Community Bingo</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <style>html, body { background: var(--public-ui-page-canvas); }</style>
    <script>
        (() => {
            let theme = "light";
            try { theme = localStorage.getItem("bingo:public-theme") === "dark" ? "dark" : "light"; } catch { }
            document.documentElement.dataset.publicTheme = theme;
            document.documentElement.style.backgroundColor = theme === "dark" ? "#1B1A1D" : "#FFF9EC";
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr-dark.min.css" />
    <link rel="stylesheet" href="~/css/site.transitional.foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.public-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.transitional.application.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bingo.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="public-ui-page-canvas @(isLandingPage ? "public-ui-editorial-landing" : isPass1PublicPage ? "public-ui-pass1" : null) @ViewData["BodyClass"] @(hasSecondaryNavigation ? "public-ui-has-secondary-nav" : null)">
    <a class="skip-link" href="#main-content">@T["Skip to main content"]</a>
    <header class="landing-shell-header">
        <nav class="landing-shell-nav" aria-label="@T["Public navigation"]">
            <div class="landing-shell-primary">
                <a class="landing-shell-brand" asp-area="" asp-page="/Index" aria-label="@T["OSRS Community Bingo home"]">
                    <img class="landing-shell-brand-mark" src="~/images/branding/dk-legacy-public-mark.png" asp-append-version="true" alt="" />
                </a>
                <div class="landing-shell-links">
                    <a class="landing-shell-link @(isPublicBoardsPage ? "is-current" : null)" aria-current="@(isPublicBoardsPage ? "page" : null)" asp-area="" asp-page="/Index">@T["Events"]</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="landing-shell-link @(isAccountPage ? "is-current" : null)" aria-current="@(isAccountPage ? "page" : null)" asp-page="/Account/Settings">@T["Account"]</a>
                        }
                        @if (captainNavigation is not null)
                        {
                            <a class="landing-shell-link @(isCaptainPage ? "is-current" : null)" aria-current="@(isCaptainPage ? "page" : null)" href="@captainNavigation.Url">@T["Captain"]</a>
                        }
                        @if (submissionNavigation is not null)
                        {
                            <a class="landing-shell-link @(isSubmissionsPage ? "is-current" : null)" aria-current="@(isSubmissionsPage ? "page" : null)" href="@submissionNavigation.Url">@T["submissions"]</a>
                        }
                        <a class="landing-shell-link @(isHowToPage ? "is-current" : null)" aria-current="@(isHowToPage ? "page" : null)" asp-page="/HowTo">@T["How to"]</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <a class="landing-shell-link" asp-page="/Admin/Index">@T["Admin"]</a>
                        }
                    </div>
                    <div class="landing-shell-actions">
                        <div class="landing-shell-menu" data-public-ui-popover>
                            <button type="button" class="landing-shell-icon" aria-label="@T["Open navigation"]" aria-expanded="false" aria-controls="public-ui-header-menu-panel">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                            </button>
                            <div id="public-ui-header-menu-panel" class="landing-shell-menu-panel" data-public-ui-popover-panel hidden>
                                <a class="landing-shell-link @(isPublicBoardsPage ? "is-current" : null)" aria-current="@(isPublicBoardsPage ? "page" : null)" asp-area="" asp-page="/Index">@T["Events"]</a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a class="landing-shell-link @(isAccountPage ? "is-current" : null)" aria-current="@(isAccountPage ? "page" : null)" asp-area="" asp-page="/Account/Settings">@T["Account"]</a>
                                }
                                @if (captainNavigation is not null)
                                {
                                    <a class="landing-shell-link @(isCaptainPage ? "is-current" : null)" aria-current="@(isCaptainPage ? "page" : null)" href="@captainNavigation.Url">@T["Captain"]</a>
                                }
                                @if (submissionNavigation is not null)
                                {
                                    <a class="landing-shell-link @(isSubmissionsPage ? "is-current" : null)" aria-current="@(isSubmissionsPage ? "page" : null)" href="@submissionNavigation.Url">@T["submissions"]</a>
                                }
                                <a class="landing-shell-link @(isHowToPage ? "is-current" : null)" aria-current="@(isHowToPage ? "page" : null)" asp-area="" asp-page="/HowTo">@T["How to"]</a>
                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                {
                                    <a class="landing-shell-link" asp-area="" asp-page="/Admin/Index">@T["Admin"]</a>
                                }
                            </div>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="public-ui-header-popover landing-shell-popover" data-notification-inbox data-public-ui-notification-inbox data-event-ids="@string.Join(',', shell.Notifications.EventIds)">
                                <div data-public-ui-popover>
                                    <button type="button" class="landing-shell-icon" aria-label="@T["Notifications"]" aria-expanded="false" aria-controls="public-ui-header-notification-panel">
                                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M10.268 21a2 2 0 0 0 3.464 0" /><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></svg>
                                        <span class="landing-shell-notification" data-notification-count hidden="@(shell.Notifications.Count == 0)">@(shell.Notifications.Count > 99 ? "99+" : shell.Notifications.Count)</span>
                                    </button>
                                    <div id="public-ui-header-notification-panel" class="public-ui-header-popover__panel public-ui-header-popover__panel--notifications" data-public-ui-popover-panel hidden>
                                        <div class="public-ui-header-popover__heading">
                                            <strong class="public-ui-section-heading" data-notification-heading>@shell.Notifications.Heading</strong>
                                            <span class="public-ui-supporting-text">
                                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                                {
                                                    @T["Personal {0} · Admin {1}", shell.Notifications.PersonalCount, shell.Notifications.AdminActionCount]
                                                }
                                                else
                                                {
                                                    @T["Personal {0}", shell.Notifications.PersonalCount]
                                                }
                                            </span>
                                        </div>
                                        <div class="public-ui-header-popover__list" data-notification-list>
                                            @foreach (var item in shell.Notifications.Items)
                                            {
                                                <a class="public-ui-header-popover__item" href="@item.Url"><strong class="public-ui-section-heading">@item.Title</strong><span class="public-ui-supporting-text">@item.Detail</span></a>
                                            }
                                        </div>
                                        <p class="public-ui-header-popover__empty public-ui-supporting-text" data-notification-empty hidden="@(shell.Notifications.Count > 0)">@shell.Notifications.EmptyText</p>
                                        <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" data-notification-overview href="@shell.Notifications.OverviewUrl" hidden="@(string.IsNullOrWhiteSpace(shell.Notifications.OverviewUrl))">@shell.Notifications.OverviewLabel</a>
                                        @if (shell.Notifications.AdminActionCount > 0 || shell.Notifications.AdminItems.Count > 0)
                                        {
                                            <div class="public-ui-header-popover__heading"><strong class="public-ui-section-heading">@shell.Notifications.AdminHeading</strong><span class="public-ui-supporting-text">@shell.Notifications.AdminActionCount</span></div>
                                            <div class="public-ui-header-popover__list">
                                                @foreach (var item in shell.Notifications.AdminItems)
                                                {
                                                    <a class="public-ui-header-popover__item" href="@item.Url"><strong class="public-ui-section-heading">@item.Title</strong><span class="public-ui-supporting-text">@item.Detail</span></a>
                                                }
                                            </div>
                                            <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" href="@shell.Notifications.AdminOverviewUrl">@shell.Notifications.AdminOverviewLabel</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="public-ui-header-popover landing-shell-popover">
                            <div data-public-ui-popover>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button" class="landing-shell-account" aria-label="@T["Account"]" aria-expanded="false" aria-controls="public-ui-header-settings-panel"><span>@User.Identity.Name</span><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></button>
                                }
                                else
                                {
                                <button type="button" class="landing-shell-icon" aria-label="@T["Settings"]" aria-expanded="false" aria-controls="public-ui-header-settings-panel">
                                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>
                                </button>
                                }
                                <div id="public-ui-header-settings-panel" class="public-ui-header-popover__panel public-ui-header-popover__panel--settings" data-public-ui-popover-panel hidden>
                                    <strong class="public-ui-header-popover__heading public-ui-section-heading">@T["Settings"]</strong>
                                    <form method="post" asp-page="/Language" class="public-ui-header-popover__form">
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <label class="public-ui-header-popover__field" for="site-language"><span class="public-ui-role-label">@T["Language"]</span><span class="public-ui-header-popover__select"><select id="site-language" name="culture" class="public-ui-control-visual public-ui-control-visual--select" aria-label="@T["Language"]" onchange="this.form.submit()">
                                            <option value="en" selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">@T["English"]</option>
                                            <option value="da" selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "da")">@T["Danish"]</option>
                                        </select><span class="public-ui-select-chevron" aria-hidden="true"></span></span><noscript><button class="public-ui-action public-ui-action--standard public-ui-action--compact" type="submit">@T["Apply language"]</button></noscript></label>
                                    </form>
                                    <label class="public-ui-header-popover__field" for="site-theme"><span class="public-ui-role-label">@T["Theme"]</span><span class="public-ui-header-popover__select"><select id="site-theme" class="public-ui-control-visual public-ui-control-visual--select" data-public-theme-control aria-label="@T["Theme"]"><option value="light">@T["Light"]</option><option value="dark">@T["Dark"]</option></select><span class="public-ui-select-chevron" aria-hidden="true"></span></span></label>
                                    <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" asp-page="/Privacy">@T["Privacy"]</a>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <div class="public-ui-header-popover__account">
                                            <span class="public-ui-supporting-text">@T["Signed in as"]</span>
                                            <strong class="public-ui-section-heading">@User.Identity.Name</strong>
                                        </div>
                                        <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" asp-page="/Account/Settings">@T["Account settings"]</a>
                                        @if (User.FindFirst("bingo:account_type")?.Value == "WebsiteAccount")
                                        {
                                            <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" asp-page="/Account/MyAccounts">@T["My accounts"]</a>
                                            <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" asp-page="/Account/MyEvents">@T["My events"]</a>
                                        }
                                        <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" asp-page="/Account/ChangePassword">@T["Change password"]</a>
                                        <form method="post" asp-page="/Account/Logout"><button class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--compact" type="submit">@T["Sign out"]</button></form>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a class="landing-shell-link landing-shell-sign-in" asp-page="/Account/Login">@T["Sign in"]</a>
                        }
                    </div>
            </div>
    </nav>
    </header>
    @if (isEventBoardPage && !string.IsNullOrWhiteSpace(eventSlug))
    {
        <nav class="public-ui-header-context-nav" aria-label="@T["Bingo views"]">
            <a class="public-ui-header-context-link @(isViewBingo ? "is-current" : null)" aria-current="@(isViewBingo ? "page" : null)" asp-page="/Events/Board" asp-route-slug="@eventSlug">
                @T["Boards"]
            </a>
            <a class="public-ui-header-context-link @(isRecentDropsView ? "is-current" : null)" aria-current="@(isRecentDropsView ? "page" : null)" asp-page="/Events/Board" asp-route-slug="@eventSlug" asp-route-view="drops">@T["Drops"]</a>
            <a class="public-ui-header-context-link @(isLeaderboardsView ? "is-current" : null)" aria-current="@(isLeaderboardsView ? "page" : null)" asp-page="/Events/Board" asp-route-slug="@eventSlug" asp-route-view="leaderboards">@T["Leaderboards"]</a>
        </nav>
    }
    @if (isAccountSubsectionPage)
    {
        <nav class="public-ui-header-context-nav" aria-label="@T["Account navigation"]">
            <a class="public-ui-header-context-link @(isAccountSettingsPage ? "is-current" : null)" aria-current="@(isAccountSettingsPage ? "page" : null)" asp-page="/Account/Settings">@T["Settings"]</a>
            <a class="public-ui-header-context-link @(currentPage == "/Account/MyAccounts" ? "is-current" : null)" aria-current="@(currentPage == "/Account/MyAccounts" ? "page" : null)" asp-page="/Account/MyAccounts">@T["My accounts"]</a>
            <a class="public-ui-header-context-link @(currentPage == "/Account/MyEvents" ? "is-current" : null)" aria-current="@(currentPage == "/Account/MyEvents" ? "page" : null)" asp-page="/Account/MyEvents">@T["My events"]</a>
        </nav>
    }
    @if (shell.Breadcrumbs.Count > 0 && ViewData["HideBreadcrumbs"] as bool? != true)
    {
        <nav class="breadcrumb-bar" aria-label="@T["Breadcrumb"]">
            <div class="container breadcrumb-bar-content">
                <ol class="app-breadcrumbs">
                    @for (var index = 0; index < shell.Breadcrumbs.Count; index++)
                    {
                        var crumb = shell.Breadcrumbs[index];
                        <li class="@(index == shell.Breadcrumbs.Count - 1 ? "current" : null)">
                            @if (!string.IsNullOrWhiteSpace(crumb.Url))
                            {
                                <a href="@crumb.Url">@crumb.Label</a>
                            }
                            else
                            {
                                <span aria-current="page">@crumb.Label</span>
                            }
                        </li>
                    }
                </ol>
                @if (ViewData["BreadcrumbActionLabel"] is string breadcrumbActionLabel &&
                     ViewData["BreadcrumbActionUrl"] is string breadcrumbActionUrl &&
                     !string.IsNullOrWhiteSpace(breadcrumbActionLabel) &&
                     !string.IsNullOrWhiteSpace(breadcrumbActionUrl))
                {
                    <a class="breadcrumb-action" href="@breadcrumbActionUrl">@breadcrumbActionLabel</a>
                }
            </div>
        </nav>
    }
    <div class="@(isLandingPage ? "landing-shell-frame" : isPass1PublicPage ? "public-ui-document-frame" : "container")">
        <main id="main-content" role="main" class="pb-3 @(isLandingPage ? "landing-shell-main" : isPass1PublicPage ? "public-ui-pass1-main" : null)" tabindex="-1">
            @await Html.PartialAsync("_TransientToast")
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/notification-inbox.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
