@using Bingo.Web.Navigation
@using Bingo.Web.UI
@inject SharedShellService SharedShell
@{
    var shell = await SharedShell.GetAsync(User, ViewContext.RouteData.Values, Context.RequestAborted);
    var overlayMode = ViewData["OverlayMode"] as bool? == true;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSRS Community Bingo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr-dark.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bingo.Web.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"] @(overlayMode ? "overlay-document" : null)">
    @if (!overlayMode)
    {
    <a class="skip-link" href="#main-content">@T["Skip to main content"]</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom @((ViewData["CompactNavigation"] as bool? == true || shell.Breadcrumbs.Count > 0) ? string.Empty : "mb-3") app-nav">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">OSRS Community Bingo</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="nav-popover header-notification" data-notification-inbox data-event-ids="@string.Join(',', shell.Notifications.EventIds)">
                        <details>
                            <summary class="nav-icon-button" aria-label="@T["Notifications"]">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                                <span class="notification-count" data-notification-count hidden="@(shell.Notifications.Count == 0)">@(shell.Notifications.Count > 99 ? "99+" : shell.Notifications.Count)</span>
                            </summary>
                            <div class="nav-panel notification-panel">
                                <div class="nav-panel-heading">
                                    <strong data-notification-heading>@shell.Notifications.Heading</strong>
                                    <span class="notification-total">@T["Personal {0} · Admin {1}", shell.Notifications.PersonalCount, shell.Notifications.AdminActionCount]</span>
                                </div>
                                <div class="notification-list" data-notification-list>
                                    @foreach (var item in shell.Notifications.Items)
                                    {
                                        <a class="notification-item" href="@item.Url"><strong>@item.Title</strong><span>@item.Detail</span></a>
                                    }
                                </div>
                                <p class="notification-empty" data-notification-empty hidden="@(shell.Notifications.Count > 0)">@shell.Notifications.EmptyText</p>
                                <a class="notification-overview" data-notification-overview href="@shell.Notifications.OverviewUrl" hidden="@(string.IsNullOrWhiteSpace(shell.Notifications.OverviewUrl))">@shell.Notifications.OverviewLabel</a>
                                @if (shell.Notifications.AdminActionCount > 0 || shell.Notifications.AdminItems.Count > 0)
                                {
                                    <div class="nav-panel-heading"><strong>@shell.Notifications.AdminHeading</strong><span class="notification-total">@shell.Notifications.AdminActionCount</span></div>
                                    <div class="notification-list">
                                        @foreach (var item in shell.Notifications.AdminItems)
                                        {
                                            <a class="notification-item" href="@item.Url"><strong>@item.Title</strong><span>@item.Detail</span></a>
                                        }
                                    </div>
                                    <a class="notification-overview" href="@shell.Notifications.AdminOverviewUrl">@shell.Notifications.AdminOverviewLabel</a>
                                }
                            </div>
                        </details>
                    </div>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between @(User.Identity?.IsAuthenticated == true ? "nav-authenticated" : null)">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">@T["Public boards"]</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Index">@T["Admin tools"]</a></li>
                        }
                        @if (User.IsInRole("Captain"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Captain/Index">@T["Captain board"]</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav nav-utilities">
                        <li class="nav-item nav-popover settings-popover">
                            <details>
                                <summary class="nav-icon-button" aria-label="@T["Settings"]">
                                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21h-4v-.08A1.7 1.7 0 0 0 9 19.36a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.63 15 1.7 1.7 0 0 0 3.08 14H3v-4h.08A1.7 1.7 0 0 0 4.64 9a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.63 1.7 1.7 0 0 0 10 3.08V3h4v.08A1.7 1.7 0 0 0 15 4.64a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.37 9 1.7 1.7 0 0 0 20.92 10H21v4h-.08A1.7 1.7 0 0 0 19.4 15Z" /></svg>
                                </summary>
                                <div class="nav-panel settings-panel">
                                    <strong class="settings-heading">@T["Settings"]</strong>
                                    <form method="post" asp-page="/Language" class="settings-language-form">
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <label for="site-language">@T["Language"]</label>
                                        <select id="site-language" name="culture" aria-label="@T["Language"]" onchange="this.form.submit()">
                                            <option value="en" selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">English</option>
                                            <option value="da" selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "da")">Dansk</option>
                                        </select>
                                        <noscript><button type="submit">@T["Apply language"]</button></noscript>
                                    </form>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <div class="settings-account">
                                            <span>@T["Signed in as"]</span>
                                            <strong>@User.Identity.Name</strong>
                                        </div>
                                        <a asp-page="/Account/Settings">@T["Account settings"]</a>
                                        @if (User.FindFirst("bingo:account_type")?.Value == "WebsiteAccount")
                                        {
                                            <a asp-page="/Account/MyAccounts">@T["My accounts"]</a>
                                            <a asp-page="/Account/MyEvents">@T["My events"]</a>
                                        }
                                        <a asp-page="/Account/ChangePassword">@T["Change password"]</a>
                                        <form method="post" asp-page="/Account/Logout"><button type="submit">@T["Sign out"]</button></form>
                                    }
                                </div>
                            </details>
                        </li>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">@T["Sign in"]</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    }
    @if (shell.Breadcrumbs.Count > 0 && ViewData["HideBreadcrumbs"] as bool? != true)
    {
        <nav class="breadcrumb-bar" aria-label="@T["Breadcrumb"]">
            <div class="container breadcrumb-bar-content">
                <ol class="app-breadcrumbs">
                    @for (var index = 0; index < shell.Breadcrumbs.Count; index++)
                    {
                        var crumb = shell.Breadcrumbs[index];
                        <li class="@(index == shell.Breadcrumbs.Count - 1 ? "current" : null)">
                            @if (!string.IsNullOrWhiteSpace(crumb.Url))
                            {
                                <a href="@crumb.Url">@crumb.Label</a>
                            }
                            else
                            {
                                <span aria-current="page">@crumb.Label</span>
                            }
                        </li>
                    }
                </ol>
                @if (ViewData["BreadcrumbActionLabel"] is string breadcrumbActionLabel &&
                     ViewData["BreadcrumbActionUrl"] is string breadcrumbActionUrl &&
                     !string.IsNullOrWhiteSpace(breadcrumbActionLabel) &&
                     !string.IsNullOrWhiteSpace(breadcrumbActionUrl))
                {
                    <a class="breadcrumb-action" href="@breadcrumbActionUrl">@breadcrumbActionLabel</a>
                }
            </div>
        </nav>
    }
    <div class="@(overlayMode ? "overlay-page-frame" : "container")">
        <main id="main-content" role="main" class="pb-3" tabindex="-1">
            <div id="app-notice-region" aria-live="polite">
                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    var messageType = UiMessage.Resolve(statusMessage, TempData[UiMessage.TypeKey]?.ToString());
                    var messageLabel = messageType switch
                    {
                        UiMessageType.Success => T["Success"],
                        UiMessageType.Warning => T["Warning"],
                        UiMessageType.Error => T["Error"],
                        _ => T["Information"]
                    };
                    <div class="app-notice notice-@messageType.ToString().ToLowerInvariant()" role="@(messageType == UiMessageType.Error ? "alert" : "status")" tabindex="-1" data-feedback-target>
                        <strong>@messageLabel</strong>
                        <span>@T[statusMessage]</span>
                        <button type="button" class="app-notice-dismiss" data-dismiss-notice aria-label="@T["Dismiss message"]">×</button>
                    </div>
                }
            </div>
            @RenderBody()
        </main>
    </div>

    @if (!overlayMode)
    {
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 OSRS Community Bingo · <a asp-area="" asp-page="/Privacy">@T["Privacy"]</a>
        </div>
    </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/notification-inbox.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
