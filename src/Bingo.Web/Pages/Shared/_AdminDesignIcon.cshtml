        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"/>
        break;
    case "check":
        <path d="M3.8 8.4 6.6 11.2 12.2 5"/>
        break;
    case "close":
        <path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/>
        break;
    case "bell":
        <path d="M3 11h10l-1.5-2V6a3.5 3.5 0 0 0-7 0v3L3 11m3 2h4"/>
        break;
    case "trophy":
        <path d="M5 2.5h6v3.5a3 3 0 0 1-6 0z"/><path d="M5 3.5H3v1a2 2 0 0 0 2 2M11 3.5h2v1a2 2 0 0 1-2 2M8 9v2.5M5.5 13.5h5M6.5 11.5h3"/>
        break;
    case "ended":
        <path d="M5 5l6 6M11 5l-6 6"/>
        break;
    default: throw new InvalidOperationException($"Unknown Admin design icon: {Model.Name}");
}
</svg>
