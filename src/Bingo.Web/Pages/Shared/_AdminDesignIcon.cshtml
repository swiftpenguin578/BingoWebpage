    case "warning":
        <path d="M8 2.5 14 13H2z"/><path d="M8 6.5v3M8 11.2h.01"/>
        break;
    case "uncertain":
        <circle cx="8" cy="8" r="6"/><path d="M8 4.8v3.6M8 11h.01"/>
        break;
    case "info":
        <circle cx="8" cy="8" r="6"/><path d="M8 7.2v3.8M8 5h.01"/>
