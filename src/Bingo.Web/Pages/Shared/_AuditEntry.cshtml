@model Bingo.Domain.Auditing.AuditEntry
@inject Microsoft.Extensions.Localization.IStringLocalizer<Bingo.Web.AuditResource> AuditText
@{
    var entry = AuditPresenter.Present(Model, AuditText);
}
<div class="admin-audit-presentation" data-audit-entry="@Model.Id">
    <strong>@entry.Action</strong>
    <p>@AuditText["Actor"]: @entry.Actor · @AuditText["Target"]: @entry.Target</p>
    @if (!string.IsNullOrWhiteSpace(entry.Reason))
    {
        <p>@AuditText["Reason"]: @entry.Reason</p>
    }
    @if (!string.IsNullOrWhiteSpace(entry.LifecycleSummary))
    {
        <p>@entry.LifecycleSummary</p>
    }
    @if (entry.Changes.Count > 0)
    {
        <dl>
        @foreach (var change in entry.Changes)
        {
            <dt>@change.Field</dt>
            <dd>@AuditText["Before"]: @change.Before → @AuditText["After"]: @change.After</dd>
        }
        </dl>
    }
    <details class="admin-audit-change">
        <summary>@AuditText["Technical details"]</summary>
        <dl>
            <dt>@AuditText["Action key"]</dt><dd><code>@entry.ActionKey</code></dd>
            <dt>@AuditText["Details"]</dt><dd><code class="admin-audit-json">@(entry.Details ?? "—")</code></dd>
            <dt>@AuditText["Before"]</dt><dd><code class="admin-audit-json">@(entry.BeforeState ?? "—")</code></dd>
            <dt>@AuditText["After"]</dt><dd><code class="admin-audit-json">@(entry.AfterState ?? "—")</code></dd>
        </dl>
    </details>
</div>
