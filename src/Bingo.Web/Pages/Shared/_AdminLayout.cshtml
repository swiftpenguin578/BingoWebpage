@using System.Globalization
@using Bingo.Web.Navigation
@using Bingo.Web.UI
@inject SharedShellService SharedShell
@{
    var shell = await SharedShell.GetAsync(User, ViewContext.RouteData.Values, Context.RequestAborted, Context.Request.Query["eventId"].ToString());
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var eventContext = shell.AdminEvent;
    var isCurrent = (string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
    var eventSection = currentPage switch
    {
        "/Admin/Events/Manage" => "overview",
        "/Admin/Events/Identity" => "identity",
        "/Admin/Events/Schedule" => "schedule",
        "/Admin/Events/Questions" or "/Admin/Events/Participant" or "/Admin/Events/Participants" => "participants",
        "/Admin/Events/Board" or "/Admin/Events/BoardPreview" => "board",
        "/Admin/Events/Draft" => "draft",
        "/Admin/Review/Index" or "/Admin/Review/Details" => "evidence",
        "/Admin/Events/Finalize" => "finalization",
        _ => string.Empty
    };
    var pageHeading = eventSection switch
    {
        "overview" => T["Overview"],
        "identity" => T["Identity"],
        "schedule" => T["Schedule"],
        "participants" => T["Participants"],
        "board" => T["Board editor"],
        "draft" => T["Teams / Draft"],
        "evidence" => T["Review"],
        "finalization" => T["Finalize"],
        _ => ViewData["Title"]?.ToString() ?? T["Admin"].Value
    };
    var pageDescription = eventSection == "overview" ? T["Event lifecycle and readiness"] : null;
    var headerBlockerCount = eventContext?.BlockerCount ?? 0;
    var blockerHref = eventSection == "overview" ? "#readiness" : eventContext is null ? "#readiness" : $"/Admin/Events/Manage/{eventContext.Id}#readiness";
    var signedInName = User.Identity?.Name?.Trim();
    var accountInitials = string.IsNullOrWhiteSpace(signedInName)
        ? string.Empty
        : new string(signedInName.Where(char.IsLetterOrDigit).Take(2).Select(char.ToUpperInvariant).ToArray());
}
<!-- Inline icons adapted from Lucide, ISC License: https://lucide.dev/license -->
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSRS Community Bingo</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr-dark.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bingo.Web.styles.css" asp-append-version="true" />
</head>
<body class="admin-shell-body @ViewData["BodyClass"]">
    <a class="skip-link" href="#main-content">@T["Skip to main content"]</a>
    <header class="admin-header">
        <nav class="admin-header-nav" aria-label="@T["Admin navigation"]">
            <a class="admin-brand" asp-page="/Admin" aria-label="DKL Bingo Admin">
                <span class="admin-brand-mark" aria-hidden="true"></span>
                <span class="admin-brand-product">DKL Bingo</span>
            </a>
            <div class="admin-page-context">
                <span class="admin-page-title">@pageHeading</span>
                @if (pageDescription is not null)
                {
                    <span class="admin-page-description">@pageDescription</span>
                }
            </div>
            <div class="admin-event-selector nav-popover" data-admin-event-selector>
                <details>
                    <summary class="admin-selected-event @(eventContext is null ? "admin-selected-event-empty" : null)" aria-label="@(eventContext is null ? T["Select an event"] : T["Selected event"])" aria-haspopup="listbox">
                        @if (eventContext is not null)
                        {
                            <span class="admin-selected-event-name">@eventContext.Name</span>
                        }
                        else
                        {
                            <span class="admin-selected-event-name">@T["Select an event"]</span>
                        }
                        <svg class="admin-event-selector-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                    </summary>
                    <div class="admin-event-selector-menu" role="listbox" aria-label="@T["Available events"]">
                        @foreach (var option in shell.AdminEvents)
                        {
                            var isSelectedEvent = eventContext?.Id == option.Id;
                            <a class="admin-event-option @(isSelectedEvent ? "is-current" : null)" asp-page="/Admin/Events/Manage" asp-route-id="@option.Id" aria-current="@(isSelectedEvent ? "page" : null)" role="option" aria-selected="@isSelectedEvent">
                                <span class="admin-event-option-copy">
                                    <span>@option.Name</span>
                                    <small class="admin-state admin-state-@option.State.ToString().ToLowerInvariant()">@option.StatusLabel</small>
                                </span>
                                @if (isSelectedEvent)
                                {
                                    <svg class="admin-event-option-check" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m5 12 4 4L19 6" /></svg>
                                }
                            </a>
                        }
                    </div>
                </details>
            </div>
            @if (headerBlockerCount > 0)
            {
                <a class="admin-header-blockers" href="@blockerHref" aria-label="@T["{0} blockers", headerBlockerCount]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><path d="M12 9v4m0 4h.01" /></svg>
                    <span>@T["{0} blockers", headerBlockerCount]</span>
                </a>
            }
            <div class="admin-header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="nav-popover header-notification" data-notification-inbox data-event-ids="@string.Join(',', shell.Notifications.EventIds)">
                        <details>
                            <summary class="nav-icon-button" aria-label="@T["Notifications"]">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M10.268 21a2 2 0 0 0 3.464 0" /><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></svg>
                                <span class="notification-count" data-notification-count hidden="@(shell.Notifications.Count == 0)">@(shell.Notifications.Count > 99 ? "99+" : shell.Notifications.Count)</span>
                            </summary>
                            <div class="nav-panel notification-panel">
                                <div class="nav-panel-heading"><strong data-notification-heading>@shell.Notifications.Heading</strong><span class="notification-total">@T["Personal {0} · Admin {1}", shell.Notifications.PersonalCount, shell.Notifications.AdminActionCount]</span></div>
                                <div class="notification-list" data-notification-list>
                                    @foreach (var item in shell.Notifications.Items)
                                    {
                                        <a class="notification-item" href="@item.Url"><strong>@item.Title</strong><span>@item.Detail</span></a>
                                    }
                                </div>
                                <p class="notification-empty" data-notification-empty hidden="@(shell.Notifications.Count > 0)">@shell.Notifications.EmptyText</p>
                                <a class="notification-overview" data-notification-overview href="@shell.Notifications.OverviewUrl">@shell.Notifications.OverviewLabel</a>
                                @if (shell.Notifications.AdminActionCount > 0 || shell.Notifications.AdminItems.Count > 0)
                                {
                                    <div class="nav-panel-heading"><strong>@shell.Notifications.AdminHeading</strong><span class="notification-total">@shell.Notifications.AdminActionCount</span></div>
                                    <div class="notification-list">
                                        @foreach (var item in shell.Notifications.AdminItems)
                                        {
                                            <a class="notification-item" href="@item.Url"><strong>@item.Title</strong><span>@item.Detail</span></a>
                                        }
                                    </div>
                                    <a class="notification-overview" href="@shell.Notifications.AdminOverviewUrl">@shell.Notifications.AdminOverviewLabel</a>
                                }
                            </div>
                        </details>
                    </div>
                }
                <div class="nav-popover settings-popover">
                    <details>
                        <summary class="nav-icon-button" aria-label="@T["Settings"]">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>
                        </summary>
                        <div class="nav-panel settings-panel">
                            <strong class="settings-heading">@T["Settings"]</strong>
                            <form method="post" asp-page="/Language" class="settings-language-form">
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}")" />
                                <label for="admin-site-language">@T["Language"]</label>
                                <select id="admin-site-language" name="culture" aria-label="@T["Language"]" onchange="this.form.submit()">
                                    <option value="en" selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en")">English</option>
                                    <option value="da" selected="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "da")">Dansk</option>
                                </select>
                                <noscript><button type="submit">@T["Apply language"]</button></noscript>
                            </form>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="settings-account"><span>@T["Signed in as"]</span><strong>@User.Identity.Name</strong></div>
                                <a asp-page="/Account/Settings">@T["Account settings"]</a>
                                <a asp-page="/Account/ChangePassword">@T["Change password"]</a>
                                <form method="post" asp-page="/Account/Logout"><button type="submit">@T["Sign out"]</button></form>
                            }
                        </div>
                    </details>
                </div>
                @if (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name))
                {
                    <div class="admin-account-context" aria-label="@T["Signed in as"]">
                        <span class="admin-account-avatar" aria-hidden="true">@accountInitials</span>
                        <span class="admin-account-copy">
                            <span class="admin-account-name">@signedInName</span>
                            <span class="admin-account-role">@(User.IsInRole("SuperAdmin") ? T["Super Admin"] : T["Admin"])</span>
                        </span>
                    </div>
                }
                <button class="admin-menu-toggle" type="button" data-admin-menu-toggle aria-controls="admin-sidebar" aria-expanded="false">
                    <span class="visually-hidden">@T["Toggle Admin navigation"]</span>
                    <svg class="admin-menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 5h16" /><path d="M4 12h16" /><path d="M4 19h16" /></svg>
                </button>
            </div>
        </nav>
    </header>

    <div class="admin-layout">
        <button class="admin-menu-scrim" type="button" data-admin-menu-scrim hidden aria-label="@T["Close Admin navigation"]"></button>
        <aside class="admin-sidebar" id="admin-sidebar" aria-label="@T["Admin workspace"]">
            <nav class="admin-sidebar-nav">
                <a class="admin-nav-link @(isCurrent("/Admin") ? "is-active" : null)" href="/Admin" aria-current="@(isCurrent("/Admin") ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" /></svg>@T["Dashboard"]</a>
                <a class="admin-nav-link @(isCurrent("/Admin/Events/Index") ? "is-active" : null)" asp-page="/Admin/Events/Index" aria-current="@(isCurrent("/Admin/Events/Index") ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg>@T["Events"]</a>
                <a class="admin-nav-link @(currentPage.StartsWith("/Admin/Catalogue/", StringComparison.Ordinal) ? "is-active" : null)" asp-page="/Admin/Catalogue/Index" aria-current="@(currentPage.StartsWith("/Admin/Catalogue/", StringComparison.Ordinal) ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" /></svg>@T["OSRS Catalogue"]</a>
                <a class="admin-nav-link @(currentPage.StartsWith("/Admin/Accounts/", StringComparison.Ordinal) ? "is-active" : null)" asp-page="/Admin/Accounts/Index" aria-current="@(currentPage.StartsWith("/Admin/Accounts/", StringComparison.Ordinal) ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><path d="M16 3.128a4 4 0 0 1 0 7.744" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><circle cx="9" cy="7" r="4" /></svg>@T["Accounts / Roles"]</a>
                <a class="admin-nav-link @(currentPage.StartsWith("/Admin/Audit/", StringComparison.Ordinal) ? "is-active" : null)" asp-page="/Admin/Audit/Index" aria-current="@(currentPage.StartsWith("/Admin/Audit/", StringComparison.Ordinal) ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" /></svg>@T["Audit"]</a>

                @if (eventContext is not null)
                {
                    <details class="admin-event-nav" data-admin-event-navigation open>
                        <summary class="admin-event-parent" aria-controls="admin-event-navigation-links">
                            <svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M3 9h18" /><path d="M9 21V9" /></svg>
                            <span>@T["Event workspace"]</span>
                            <svg class="admin-event-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                        </summary>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "overview" ? "is-active" : null)" data-admin-event-section="overview" href="/Admin/Events/Manage/@eventContext.Id" aria-current="@(eventSection == "overview" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" /><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" /><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" /></svg>@T["Overview"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "identity" ? "is-active" : null)" data-admin-event-section="identity" href="/Admin/Events/Identity/@eventContext.Id" aria-current="@(eventSection == "identity" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>@T["Identity"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "schedule" ? "is-active" : null)" data-admin-event-section="schedule" href="/Admin/Events/Schedule/@eventContext.Id" aria-current="@(eventSection == "schedule" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg>@T["Schedule"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "participants" ? "is-active" : null)" data-admin-event-section="participants" href="/Admin/Events/Participants/@eventContext.Id" aria-current="@(eventSection == "participants" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m16 11 2 2 4-4" /><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>@T["Participants"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "board" ? "is-active" : null)" data-admin-event-section="board" href="/Admin/Events/Board/@eventContext.Id" aria-current="@(eventSection == "board" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M3 9h18" /><path d="M3 15h18" /><path d="M9 3v18" /><path d="M15 3v18" /></svg>@T["Board editor"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "draft" ? "is-active" : null)" data-admin-event-section="draft" href="/Admin/Events/Draft/@eventContext.Id" aria-current="@(eventSection == "draft" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M18 21a8 8 0 0 0-16 0" /><circle cx="10" cy="8" r="5" /><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3" /></svg>@T["Teams / Draft"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "evidence" ? "is-active" : null)" data-admin-event-section="evidence" href="/Admin/Review?eventId=@eventContext.Id" aria-current="@(eventSection == "evidence" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="m9 15 2 2 4-4" /></svg>@T["Review"]</a>
                        </div>
                        <div class="admin-event-item">
                        <a class="admin-nav-link @(eventSection == "finalization" ? "is-active" : null)" data-admin-event-section="finalization" href="/Admin/Events/Finalize/@eventContext.Id" aria-current="@(eventSection == "finalization" ? "page" : null)"><svg class="admin-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978" /><path d="M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978" /><path d="M18 9h1.5a1 1 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z" /><path d="M6 9H4.5a1 1 0 0 1-1-5H6" /></svg>@T["Finalize"]</a>
                        </div>
                    </details>
                }
            </nav>
            <div class="admin-sidebar-footer">
                <a class="admin-exit-link" asp-page="/Index"><svg class="admin-exit-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="m16 17 5-5-5-5" /><path d="M21 12H9" /><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /></svg>@T["Exit Admin"]</a>
            </div>
        </aside>

        <div class="admin-main">
            <main id="main-content" role="main" tabindex="-1">
                <div id="app-notice-region" aria-live="polite">
                    @if (TempData["StatusMessage"] is string statusMessage)
                    {
                        var messageType = UiMessage.Resolve(statusMessage, TempData[UiMessage.TypeKey]?.ToString());
                        var messageLabel = messageType switch
                        {
                            UiMessageType.Success => T["Success"],
                            UiMessageType.Warning => T["Warning"],
                            UiMessageType.Error => T["Error"],
                            _ => T["Information"]
                        };
                        <div class="app-notice notice-@messageType.ToString().ToLowerInvariant()" role="@(messageType == UiMessageType.Error ? "alert" : "status")" tabindex="-1" data-feedback-target><strong>@messageLabel</strong><span>@T[statusMessage]</span><button type="button" class="app-notice-dismiss" data-dismiss-notice aria-label="@T["Dismiss message"]">×</button></div>
                    }
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    <dialog class="admin-route-dialog" data-signup-questions-dialog aria-labelledby="signup-questions-dialog-title" aria-describedby="signup-questions-dialog-description">
        <header class="admin-route-dialog-header">
            <div><p class="admin-module-eyebrow">@T["Signup administration"]</p><h2 id="signup-questions-dialog-title">@T["Signup questions"]</h2><p id="signup-questions-dialog-description">@T["Edit the questions shown on the public signup form."]</p></div>
            <button type="button" class="admin-route-dialog-close" data-signup-questions-close aria-label="@T["Close signup questions"]">×</button>
        </header>
        <iframe title="@T["Signup questions editor"]" data-signup-questions-frame></iframe>
    </dialog>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/notification-inbox.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/signup-questions-overlay.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
