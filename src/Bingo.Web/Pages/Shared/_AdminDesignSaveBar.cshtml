@model Bingo.Web.UI.AdminDesignSaveBar
<div class="form-bar"><span class="dirty" data-identity-dirty role="status" hidden><span class="dot"></span>@Model.Unsaved</span><span class="saved-note" data-identity-state role="status" hidden="@(string.IsNullOrEmpty(Model.Saved))"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("check")' /><span data-component-text>@Model.Saved</span></span><button type="submit" class="btn btn-primary" data-identity-save aria-disabled="true" title="@Model.NoChanges" style="min-width:132px"><span class="spin" hidden></span><span data-component-text>@Model.Save</span></button></div>
