@* SignupSetup.dc.html:334–414. Direct drawer children preserve shared scroll and footer geometry. *@
<template data-signup-drawer>
 <div class="dr-head"><div class="grow"><div class="eyebrow">@T["Custom question"]</div><h2 class="dr-title" id="drawer-title" data-drawer-title></h2></div><button class="icon-btn" type="button" id="drawer-close" data-close aria-label="@T["Close"]"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")'/></button></div>
 <div class="dr-body">
  <div class="dr-banners" data-drawer-banners hidden><div class="banner is-warning" data-drawer-note role="alert" id="dr-banner" tabindex="-1"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("uncertain")'/><span class="grow" data-drawer-note-text></span></div></div>
  <div class="sec"><form id="signup-question-form" novalidate><div class="form-fields">
   <div class="field"><div class="lbl-row"><label class="lbl" for="q-label">@T["Question"]</label><span class="field-count" data-count="label" aria-live="polite" hidden></span></div><input class="input" id="q-label" autocomplete="off" aria-required="true" aria-invalid="false" placeholder="@T["e.g. When do you usually play?"]"/><div class="field-err" id="q-label-err" data-error="label" hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")'/><span></span></div></div>
   <div class="field"><div class="lbl-row"><label class="lbl" for="q-help">@T["Help text"] <span class="opt">· @T["Optional"].Value.ToLowerInvariant()</span></label><span class="field-count" data-count="help" aria-live="polite" hidden></span></div><textarea class="textarea ss-help" id="q-help" aria-invalid="false" placeholder="@T["Shown under the question on the signup form."]"></textarea><div class="field-err" id="q-help-err" data-error="help" hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")'/><span></span></div></div>
   <div class="field"><div class="lbl" id="q-type-lbl">@T["Answer type"]</div><div data-type-editable><div class="choices" role="radiogroup" aria-labelledby="q-type-lbl" aria-describedby="q-type-hint">
    @foreach(var type in new[] { ("Text", "Text", "Players write an answer."), ("Number", "Number", "Players enter a number."), ("YesNo", "Yes or no", "Players choose yes or no."), ("SingleChoice", "Single choice", "Players pick one option.") }) {
     <label class="choice"><input type="radio" name="q-type" id="qt-@type.Item1" value="@type.Item1" checked="@(type.Item1 == "Text")"/><span><span class="choice-title ss-choice-line">@T[type.Item2]</span><span class="choice-sub ss-choice-line">@T[type.Item3]</span></span></label>
    }
   </div><div class="field-hint" id="q-type-hint"></div></div><div data-type-readonly hidden><div class="ro-value" aria-labelledby="q-type-lbl" data-type-value></div><div class="field-lock">@T["Locked because players have answered. To change it, delete this question and add a new one."]</div></div></div>
   <div class="field" data-choices role="group" aria-labelledby="q-choices-lbl" hidden><div class="lbl" id="q-choices-lbl">@T["Choices"]</div><div data-choices-editable><ol class="ch-list"></ol><button class="btn btn-sm q-add" id="q-add-choice" type="button" data-add-choice><partial name="_AdminDesignIcon" model='new AdminDesignIcon("plus")'/>@T["Add choice"]</button><div class="field-err" id="q-choices-err" data-error="choices" hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")'/><span></span></div><div class="field-hint">@T["Players pick one. Press Enter in a choice to add the next."]</div></div><div data-choices-readonly hidden><ol class="ch-ro"></ol><div class="field-lock">@T["Locked because players have answered."]</div></div></div>
   <div class="field"><label class="check-row"><input id="q-required" type="checkbox" aria-describedby="q-required-sub"/><span><span class="choice-title ss-choice-line">@T["Players must answer"]</span><span class="choice-sub ss-choice-line" id="q-required-sub" data-required-note></span></span></label></div>
   <div class="field-note"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("info")'/><span>@T["Answers are shown on the public signup list."]</span></div>
  </div></form></div>
 </div>
 <div class="dr-foot"><div class="spacer"></div><span class="dirty" data-drawer-dirty role="status" hidden><span class="dot"></span>@T["Unsaved changes"]</span><button class="btn" id="dr-cancel" type="button" data-cancel>@T["Cancel"]</button><button class="btn btn-primary ss-drawer-save" id="dr-save" type="submit" form="signup-question-form" data-save><span class="spin" hidden></span><span data-save-label></span></button></div>
</template>
