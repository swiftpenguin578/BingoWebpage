@page
@model Bingo.Web.Pages.Admin.Catalogue.ImportModel
@{ ViewData["Title"] = "Import OSRS catalogue"; }
<section class="form-page narrow-page">
    <p class="eyebrow">OSRS catalogue</p><h1>Initial CSV import</h1>
    <p>This fixed format is intended to seed the catalogue once. Existing bosses, items, and drops with matching names are updated. You can edit everything manually afterward.</p>
    <div class="panel"><p><strong>Header:</strong></p><code class="csv-header">@Model.RequiredHeader</code><p class="form-hint">Use <code>boss</code>, <code>activity</code>, <code>item</code>, or <code>drop</code> as record_type. Boss and item rows may appear in any order; drop rows reference them through source and item.</p></div>
    <form method="post" enctype="multipart/form-data" class="panel form-stack">
        <div asp-validation-summary="All" class="text-danger"></div><label asp-for="Upload"></label><input asp-for="Upload" class="form-control" accept=".csv,text/csv" />
        <button class="btn btn-primary" onclick="return confirm('Import this catalogue file? Matching records will be updated.');">Import catalogue</button>
    </form>
    <p><a asp-page="Index">Back to catalogue</a></p>
</section>
