@page
@model Bingo.Web.Pages.Admin.Catalogue.WikiDryRunModel
@using Bingo.Web.Catalogue
@{ ViewData["Title"] = "OSRS Wiki catalogue preview"; }

<section class="table-page wiki-dry-run-page">
    <p class="eyebrow">OSRS catalogue</p>
    <div class="page-heading">
        <div>
            <h1>Wiki import preview</h1>
            <p class="form-intro">Compare the current catalogue with special and unique drops listed on the OSRS Wiki. This preview cannot change the database.</p>
        </div>
        <a class="btn btn-outline-light" asp-page="Index">Back to catalogue</a>
    </div>

    @if (Model.Report is null)
    {
        <div class="panel wiki-dry-run-start">
            <div>
                <h2>Run a safe comparison</h2>
                <p>The Wiki is checked live for every active boss or activity. Unique drops are proposed automatically. Tertiary tables contribute only pets, jars and reviewed boss-specific exceptions. Unsupported pages are listed instead of guessed.</p>
            </div>
            <form method="post">
                <button class="btn btn-outline-primary" type="submit">Run preview</button>
            </form>
        </div>
    }
    else
    {
        <div class="wiki-dry-run-summary" aria-label="Preview summary">
            <div><strong>@Model.Report.Bosses.Count</strong><span>bosses checked</span></div>
            <div><strong>@Model.Report.CandidateCount</strong><span>drop candidates</span></div>
            <div><strong>@Model.Report.ReviewCount</strong><span>need review</span></div>
            <div><strong>@Model.Report.UnmatchedCount</strong><span>pages unmatched</span></div>
        </div>

        <div class="notice notice-info">
            <strong>Preview complete</strong>
            <span>Nothing has been saved yet. Applying this reviewed import keeps boss EHB rates, replaces old seeded drops, stores all rate variants and updates Wiki images and source links.</span>
        </div>

        <div class="panel wiki-dry-run-apply">
            <div>
                <h2>Apply the reviewed catalogue</h2>
                <p>Old drops are deleted for matched bosses. Historical published boards keep their saved snapshots, while reusable templates should be checked after the import.</p>
            </div>
            <form method="post" asp-page-handler="Import" data-confirm="Replace the current seeded drops with this reviewed Wiki catalogue?">
                <button class="btn btn-outline-primary" type="submit">Apply Wiki catalogue</button>
            </form>
        </div>

        <div class="wiki-dry-run-list">
        @foreach (var boss in Model.Report.Bosses)
        {
            var additions = boss.Drops.Count(x => x.Action == WikiDropAction.Add);
            var replacements = boss.Drops.Count(x => x.Action == WikiDropAction.Replace);
            var reviews = boss.Drops.Count(x => x.NeedsReview);
            <details class="panel wiki-dry-run-boss" open="@(boss.Status != WikiBossPreviewStatus.Ready ? "open" : null)">
                <summary>
                    <span>
                        <strong>@boss.BossName</strong>
                        <small>@additions new · @replacements changed · @reviews to review</small>
                    </span>
                    <span class="catalogue-status @(boss.Status == WikiBossPreviewStatus.Ready ? "is-active" : "is-inactive")">@(boss.Status == WikiBossPreviewStatus.Ready ? "Ready" : "Review")</span>
                </summary>
                <div class="wiki-dry-run-body">
                    <p><a href="@boss.WikiUrl" target="_blank" rel="noopener">Open @boss.WikiPage on the OSRS Wiki</a></p>
                    @if (!string.IsNullOrWhiteSpace(boss.Note))
                    {
                        <p class="text-warning">@boss.Note</p>
                    }
                    @if (boss.Drops.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table wiki-dry-run-table">
                                <thead><tr><th>Drop</th><th>Wiki section</th><th>Proposed change</th><th>Rate</th><th>Review</th></tr></thead>
                                <tbody>
                                @foreach (var drop in boss.Drops)
                                {
                                    <tr>
                                        <td><strong>@drop.Name</strong></td>
                                        <td>@drop.Section</td>
                                        <td>@drop.Action</td>
                                        <td>
                                            @foreach (var rate in drop.Rates)
                                            {
                                                <span class="wiki-rate-variant"><strong>@rate.Label:</strong> @rate.DisplayRate</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(drop.Condition)) { <small>@drop.Condition</small> }
                                        </td>
                                        <td>@(drop.NeedsReview ? drop.ReviewReason : "No")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </details>
        }
        </div>
    }
</section>

@section Scripts {
<script>
document.querySelectorAll('form[data-confirm]').forEach(form => form.addEventListener('submit', event => {
    if (!confirm(form.dataset.confirm)) event.preventDefault();
}));
</script>
}
