@section HeaderSummary {
    @* Count summary with fixed words (Events/Accounts style); the last item is the reference's own sentence. *@
    @if (Model.Activities.Count == 0) { <span data-catalogue-summary>@D["No activities yet"]</span> }
    else { <span data-catalogue-summary>@{ var activeParts = D["{0} active activities"].Value.Split("{0}"); }@activeParts[0]<b class="tnum">@Model.ActiveCount</b>@activeParts[^1]</span><span>@{ var dropParts = D["{0} drops"].Value.Split("{0}"); }@dropParts[0]<b class="tnum">@Model.ActiveDropCount</b>@dropParts[^1]</span> }<span>@D["Shared by every event’s board estimates"]</span>
}
@section HeaderActions {
    <div class="head-actions"><a class="btn btn-primary" id="add-activity" href="@Model.DirectoryUrl(add: true)" data-catalogue-new><partial name="_AdminDesignIcon" model='new AdminDesignIcon("plus")' />@D["Add activity"]</a></div>
}
<div data-catalogue-directory data-directory-canonical="@Model.CanonicalUrl" data-catalogue-labels="@labelJson" data-super-admin="@(Model.IsSuperAdmin ? "true" : "false")" data-decimal="@decimalSeparator">
<div class="toolbar ct-toolbar" role="search" aria-label="@D["Find activities and drops"]">
    <div class="tbar-right ct-filters">
        <div class="search @(Model.Search.Length > 0 ? "has-clear" : null)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("search")' /><input class="input" id="ct-search" type="search" placeholder="@D["Search activities and drops"]" aria-label="@D["Search activities and drops"]" maxlength="@IndexModel.SearchLimit" autocomplete="off" value="@Model.Search" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" data-catalogue-search><button class="icon-btn clear" type="button" aria-label="@D["Clear search"]" data-catalogue-clear hidden="@(Model.Search.Length == 0)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button></div>
        <div class="seg" role="radiogroup" aria-label="@D["Category"]">@foreach (var (key, label) in categoryOptions) { <label class="seg-opt @(Model.Category == key ? "is-on" : null)"><input class="sr" type="radio" name="ct-cat" value="@key" checked="@(Model.Category == key)" data-catalogue-category>@D[label]</label> }</div>
    </div>
    <div class="tabs" role="radiogroup" aria-label="@D["Status"]">
        <label class="tab @(Model.InactiveTab ? null : "is-on")"><input class="sr" type="radio" name="ct-status" value="" checked="@(!Model.InactiveTab)" data-catalogue-status><span>@D["Active"]</span><span class="tab-count" data-catalogue-count="active">@Model.ActiveCount</span></label>
        <label class="tab @(Model.InactiveTab ? "is-on" : null)"><input class="sr" type="radio" name="ct-status" value="inactive" checked="@Model.InactiveTab" data-catalogue-status><span>@D["Inactive"]</span><span class="tab-count" data-catalogue-count="inactive">@Model.InactiveCount</span></label>
    </div>
</div>
<div data-directory-banners class="directory-fragments"></div>
<div class="card">
<div class="tbl-wrap" id="tbl-wrap" data-admin-scroll-region data-catalogue-wrap><div class="tbl ct-tbl sticky-first" role="table" aria-label="@D["Activities"]">
<div class="tr th-row" role="row">@foreach (var (label, cls) in columns) { <div class="th @cls" role="columnheader">@D[label]</div> }</div>
<div class="rows" role="rowgroup" data-catalogue-rows>
@foreach (var row in Model.Activities)
{
    var flags = new List<(string Label, string Tone)>();
    if (row.Rate is not > 0) flags.Add((D["Rate missing"].Value, "is-warning"));
    if (row.WithoutProbability > 0) flags.Add((D["{0} without probability", row.WithoutProbability].Value, "is-warning"));
    if (row.WithoutValue > 0) flags.Add((D["{0} without value", row.WithoutValue].Value, "is-warning"));
    if (row.Active && row.ActiveDrops == 0) flags.Add((D["No drops"].Value, "is-neutral"));
    var rateText = row.Rate is { } rate and > 0 ? (IndexModel.IsMinigame(row.Category) ? D["{0} runs/hr", IndexModel.Number(rate)] : D["{0} kills/hr", IndexModel.Number(rate)]).Value : D["Not set"].Value;
    <div class="tr row @(Model.RequestedActivity == row.Id ? "is-selected" : null)" role="row" hidden="@(!row.Visible)" data-activity-row="@row.Id" data-name="@row.Name" data-category="@row.Category" data-active="@(row.Active ? "true" : "false")" data-drop-names="@string.Join("\n", row.DropNames)">
        <div class="td c-name" role="cell"><div class="ct-who"><span class="thumb" style="@Art(row.ImageUrl)" aria-hidden="true"></span><span class="ct-min"><a class="name-btn" id="open-@row.Id" href="@Model.DirectoryUrl(activity: row.Id)" data-catalogue-open="@row.Id">@row.Name</a><span class="cell-sub" data-category-label="@D[row.Category]">@D[row.Category]@(row.MatchedBy is { } match ? " · " + D["matches {0}", match].Value : null)</span></span></div></div>
        <div class="td ct-num" role="cell"><span class="tval @(row.Rate is > 0 ? null : "is-muted")">@rateText</span></div>
        <div class="td ct-num" role="cell">@(row.InactiveDrops > 0 ? D["{0} + {1} inactive", row.ActiveDrops, row.InactiveDrops].Value : row.ActiveDrops.ToString(System.Globalization.CultureInfo.CurrentCulture))</div>
        <div class="td" role="cell"><div class="cell-tags">@foreach (var flag in flags) { <span class="pill @flag.Tone">@flag.Label</span> }@if (flags.Count == 0) { <span class="ct-muted">—</span> }</div></div>
        <div class="td" role="cell"><span class="badge @(row.Active ? "badge-success" : "badge-neutral")">@(row.Active ? D["Active"] : D["Inactive"])</span></div>
    </div>
}
</div>
</div></div>
<div class="empty" data-catalogue-empty hidden="@(visible > 0)"><div class="empty-ic"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.5h11v8h-11z"/><path d="M5.5 4.5V3h5v1.5"/></svg></div><div class="empty-title" data-catalogue-empty-title>@(Model.Activities.Count == 0 ? D["The catalogue is empty"] : filtered ? D["No activities match"] : Model.InactiveTab ? D["No inactive activities"] : D["No active activities"])</div><div class="empty-text" data-catalogue-empty-text>@(Model.Activities.Count == 0 ? D["Add a boss or activity, then its drops, to give boards EHB estimates."] : filtered ? D["Search looks at activity and drop names. Try another word or category."] : D["Deactivated activities appear here."])</div><button class="btn" type="button" id="empty-clear" data-catalogue-empty-clear hidden="@(!(filtered && Model.Activities.Count > 0))">@D["Clear search and filters"]</button>@if (Model.Activities.Count == 0) { <a class="btn btn-primary" href="@Model.DirectoryUrl(add: true)" data-catalogue-new>@D["Add activity"]</a> }</div>
<div class="tfoot"><div class="tfoot-left"><span data-catalogue-foot>@(visible == 0 ? string.Empty : filtered ? (visible == 1 ? D["1 activity match"].Value : D["{0} activities match", visible].Value) : (visible == 1 ? D["1 activity"].Value : D["{0} activities", visible].Value))</span></div></div>
</div>
@if (Model.DrawerRequested) { <partial name="_CatalogueDrawer" model="Model" /> }
<template data-catalogue-drawer-pending><div class="sec" aria-busy="true" aria-label="@D["Loading activity"]"><div class="ct-sk-line"><div class="sk ct-sk-w50"></div></div><div class="ct-sk-line ct-sk-gap"><div class="sk ct-sk-w80"></div></div><div class="ct-sk-line ct-sk-gap12"><div class="sk ct-sk-w65"></div></div></div></template>
<template data-catalogue-drawer-failed><div class="empty is-error" role="alert"><div class="empty-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /></div><div class="empty-title">@D["Couldn’t load this activity"]</div><div class="empty-text">@D["Check your connection and try again. Nothing was changed."]</div><button type="button" class="btn" data-load-retry>@D["Try again"]</button></div></template>
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-catalogue.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-catalogue.js" asp-append-version="true" data-admin-page-script></script> }
