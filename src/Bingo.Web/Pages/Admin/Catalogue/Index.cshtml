@page
@model Bingo.Web.Pages.Admin.Catalogue.IndexModel
@using System.Globalization
@using Bingo.Domain.Catalogue
@using Bingo.Web.Catalogue
@inject OsrsWikiImageCache WikiImages
@{
    ViewData["Title"] = T["OSRS catalogue"];
    ViewData["AdminPageDescription"] = T["Manage bosses, activities, their drops and the values used to calculate EHB."];
    var categories = new[] { "Boss", "Skilling boss", "Minigame" };
    var partialTargets = "#app-notice-region, .catalogue-editor-component";
    var pageUrl = Url.Page("/Admin/Catalogue/Index");
    var selectedBoss = Model.BossId is { } selectedBossId ? Model.Bosses.FirstOrDefault(x => x.Id == selectedBossId) : null;
    var selectedDrops = selectedBoss is null ? [] : Model.Drops.Where(x => x.BossActivityId == selectedBoss.Id).ToList();
    var isEditorRoute = Model.IsEditorRoute;
}

<section class="admin-catalogue-page @(Model.IsOverlay ? "admin-dialog-page" : null)" data-catalogue-page="true" data-catalogue-editor-route="@isEditorRoute.ToString().ToLowerInvariant()" data-catalogue-overlay="@Model.IsOverlay.ToString().ToLowerInvariant()" data-catalogue-url="@pageUrl">
    @if (isEditorRoute)
    {
        <section class="catalogue-editor-component @(Model.IsOverlay ? "catalogue-editor-dialog-page" : "catalogue-standalone-editor") @(Model.AddBoss ? "catalogue-add-boss-dialog" : null)" data-catalogue-editor="true" aria-labelledby="catalogue-editor-title" aria-describedby="catalogue-editor-description">
            @if (Model.IsOverlay)
            {
                <header class="catalogue-editor-heading admin-dialog-component-heading">
                    <div><h2 id="catalogue-editor-title">@(Model.AddBoss ? T["Add boss or activity"] : selectedBoss?.Name)</h2><p id="catalogue-editor-description">@(Model.AddBoss ? T["Add the activity first. Its drops can be added from the catalogue afterward."] : T["Edit the activity, manage its drops, and preserve the values used to calculate EHB."])</p></div>
                    <button type="button" class="admin-route-dialog-close" data-catalogue-close aria-label="@T["Close catalogue editor"]"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg></button>
                </header>
            }
            else
            {
                <header class="catalogue-editor-heading catalogue-standalone-heading">
                    <div><h1 id="catalogue-editor-title">@(Model.AddBoss ? T["Add boss or activity"] : selectedBoss?.Name)</h1><p id="catalogue-editor-description">@(Model.AddBoss ? T["Add the activity first. Its drops can be added from the catalogue afterward."] : T["Edit the activity, manage its drops, and preserve the values used to calculate EHB."])</p></div>
                    <a class="admin-button-secondary" href="@pageUrl">@T["Back to catalogue"]</a>
                </header>
            }

            @if (Model.AddBoss)
            {
                <form method="post" asp-page-handler="Boss" class="catalogue-editor-form" data-update-targets="@partialTargets">
                    <input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="AddBoss" value="true" />
                    <div class="catalogue-editor-fields">
                        <div class="admin-field"><label asp-for="Boss.Name"></label><input asp-for="Boss.Name" class="form-control" /></div>
                        <div class="admin-field"><label asp-for="Boss.Category"></label><select asp-for="Boss.Category" class="form-select" data-catalogue-rate-category><option>Boss</option><option>Skilling boss</option><option>Minigame</option></select></div>
                        <div class="admin-field"><label asp-for="Boss.EfficientRate" data-catalogue-rate-label>@IndexModel.RateLabel(Model.Boss.Category)</label><input asp-for="Boss.EfficientRate" class="form-control" /></div>
                        <div class="admin-field catalogue-editor-wide"><label asp-for="Boss.Notes"></label><textarea asp-for="Boss.Notes" class="form-control" rows="3"></textarea></div>
                        <div class="catalogue-editor-wide catalogue-reference-heading"><h3>@T["Reference details"]</h3><p>@T["Record the data source and use a direct OSRS Wiki image URL."]</p></div>
                        <div class="admin-field"><label asp-for="Boss.DataSource"></label><input asp-for="Boss.DataSource" class="form-control" /></div>
                        <div class="admin-field"><label asp-for="Boss.ImageUrl"></label><input asp-for="Boss.ImageUrl" class="form-control" type="url" /></div>
                    </div>
                    <div class="catalogue-editor-actions"><button class="admin-button-create" type="submit"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" /></svg><span>@T["Add boss or activity"]</span></button></div>
                </form>
            }
            else if (selectedBoss is not null)
            {
                <div class="catalogue-editor-body">
                    <form method="post" asp-page-handler="UpdateBoss" class="catalogue-editor-form" data-update-targets="@partialTargets">
                        <input type="hidden" name="BossId" value="@selectedBoss.Id" />
                        <input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" />
                        <input type="hidden" name="recordId" value="@selectedBoss.Id" />
                        <input type="hidden" name="expectedVersion" value="@selectedBoss.Version" />
                        <div class="catalogue-editor-fields">
                            <div class="admin-field"><label>@T["Name"]</label><input name="name" value="@selectedBoss.Name" class="form-control" required /></div>
                            <div class="admin-field"><label>@T["Category"]</label><select name="category" class="form-select">@foreach (var category in categories) { <option selected="@(category == selectedBoss.Category ? "selected" : null)">@category</option> }</select></div>
                            <div class="admin-field"><label>@IndexModel.RateLabel(selectedBoss.Category)</label><input name="efficientRate" value="@(selectedBoss.EfficientRate?.ToString("0.############", CultureInfo.InvariantCulture))" class="form-control" type="number" min="0" step="any" /></div>
                            <div class="admin-field"><label>@T["Data source"]</label><input name="dataSource" value="@selectedBoss.DataSource" class="form-control" /></div>
                            <div class="admin-field catalogue-editor-wide"><label>@T["Image URL"]</label><input name="imageUrl" value="@selectedBoss.ImageUrl" class="form-control" type="url" placeholder="@T["Direct image or OSRS Wiki media link"]" /></div>
                        </div>
                        <div class="catalogue-editor-actions"><button class="admin-button-secondary" type="submit">@T["Save activity"]</button></div>
                    </form>

                    <section class="catalogue-add-drop-section" aria-labelledby="catalogue-add-drop-heading">
                        <header class="catalogue-section-heading"><div><h3 id="catalogue-add-drop-heading">@T["Add drop"]</h3><p>@T["Add a drop to this activity."]</p></div></header>
                        <form method="post" asp-page-handler="BossDrop" class="catalogue-add-drop-form" data-update-targets="@partialTargets">
                            <input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="BossDrop.BossActivityId" value="@selectedBoss.Id" />
                            <div class="catalogue-add-drop-fields"><div class="admin-field"><label>@T["Item name"]</label><input name="BossDrop.ItemName" class="form-control" placeholder="@T["For example: Tanzanite fang"]" /></div><div class="admin-field"><label>@T["Displayed drop rate"]</label><input name="BossDrop.DisplayRate" class="form-control catalogue-display-rate-input" placeholder="@T["For example: 2 × 1/1,024"]" /></div><div class="admin-field"><label>@T["Personal probability per reward roll"]</label><input name="BossDrop.NumericProbability" class="form-control catalogue-probability-input" type="number" min="0" max="1" step="any" placeholder="0.0009765625" /></div><div class="admin-field"><label>@T["Condition or note"]</label><input name="BossDrop.Condition" class="form-control" placeholder="@T["Optional restrictions or notes"]" /></div></div>
                            <div class="catalogue-add-drop-details"><div class="admin-field"><label>@T["Data source"]</label><input name="BossDrop.DataSource" class="form-control" /></div><div class="admin-field"><label>@T["Image URL"]</label><input name="BossDrop.ImageUrl" class="form-control" type="url" /></div><div class="admin-field"><label>@T["Rolls per {0}", IndexModel.RateUnit(selectedBoss.Category, 1m)]</label><input name="BossDrop.RollsPerCompletion" class="form-control" type="number" min="1" max="100" value="1" /></div><div class="admin-field"><label>@T["Roll group"]</label><input name="BossDrop.RollGroup" class="form-control" maxlength="120" value="default" /></div></div>
                            <div class="catalogue-add-drop-actions"><button class="admin-button-create" type="submit"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" /></svg><span>@T["Add drop"]</span></button></div>
                        </form>
                    </section>
                    <section class="catalogue-drop-section" aria-labelledby="catalogue-drops-heading">
                        <header class="catalogue-section-heading"><div><h3 id="catalogue-drops-heading">@T["Drops"]</h3><p>@T["Review and manage the configured drops and their EHB values."]</p></div><span class="catalogue-section-count">@T["{0} configured", selectedDrops.Count]</span></header>
                        @if (selectedDrops.Count == 0)
                        {
                            <p class="catalogue-empty-state">@T["No drops have been added yet."]</p>
                        }
                        else
                        {
                            <div class="catalogue-drop-list">
                                @foreach (var drop in selectedDrops)
                                {
                                    var dropMissingProbability = drop.Probability is null or <= 0;
                                    <article class="catalogue-drop-card @(!drop.Active ? "is-inactive" : null)" data-catalogue-drop-row data-catalogue-drop-id="@drop.Id" data-catalogue-drop-initial-expanded="@(Model.DropId == drop.Id ? "true" : "false")">
                                        <header class="catalogue-drop-summary">
                                            <span class="catalogue-drop-image @(!string.IsNullOrWhiteSpace(drop.ImageUrl) ? "has-image" : null)" aria-label="@T["Item image"]">@if (!string.IsNullOrWhiteSpace(drop.ImageUrl)) { <img src="@WikiImages.GetPublicUrl(drop.ImageUrl)" alt="" loading="lazy" /> } else { <span>@T["Image"]</span> }</span>
                                            <div class="catalogue-drop-summary-copy"><strong>@drop.ItemName</strong><small>@drop.DisplayRate · @(drop.DefaultEhb?.ToString("0.####") ?? T["Not available"]) EHB</small></div>
                                            <span class="catalogue-drop-status-actions">@if (dropMissingProbability) { <span class="admin-status-pill is-yellow">@T["Missing probability"]</span> } <span class="admin-status-pill @(drop.Active ? "is-green" : "is-muted")">@(drop.Active ? T["Active"] : T["Inactive"])</span></span>
                                            <button type="button" class="catalogue-drop-edit-toggle" data-catalogue-drop-toggle aria-expanded="true" aria-controls="catalogue-drop-editor-@drop.Id" aria-label="@T["Edit {0}", drop.ItemName]"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m16.5 3.5 4 4" /><path d="M4 20l4.5-1 11-11a2.12 2.12 0 0 0-3-3l-11 11L4 20Z" /></svg></button>
                                        </header>
                                        <div class="catalogue-drop-editor" id="catalogue-drop-editor-@drop.Id" data-catalogue-drop-editor>
                                        <form id="catalogue-drop-form-@drop.Id" method="post" asp-page-handler="UpdateDrop" class="catalogue-drop-edit-form" data-update-targets="@partialTargets">
                                            <input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordId" value="@drop.Id" /><input type="hidden" name="expectedVersion" value="@drop.Version" /><input type="hidden" name="useExistingItem" value="false" data-use-existing-item /><input type="hidden" name="originalDisplayRate" value="@drop.DisplayRate" /><input type="hidden" name="originalNumericProbability" value="@(drop.Probability?.ToString("0.############", CultureInfo.InvariantCulture))" />
                                            <div class="catalogue-drop-name-editor"><label>@T["Item name"]</label><input name="itemName" value="@drop.ItemName" data-original-item-name="@drop.ItemName" class="form-control" maxlength="200" required /></div>
                                            <div class="catalogue-inline-confirmation" data-catalogue-duplicate-confirmation hidden role="alertdialog"><p>@T["This item already exists as a shared catalogue item. Use that existing item for this drop?"]</p><div><button type="button" class="admin-button-secondary" data-catalogue-duplicate-cancel>@T["Keep current name"]</button><button type="button" class="admin-button-secondary" data-catalogue-duplicate-confirm>@T["Use existing item"]</button></div></div>
                                            <div class="admin-field"><label>@T["Displayed drop rate"]</label><input name="displayRate" value="@drop.DisplayRate" class="form-control catalogue-display-rate-input" required /></div>
                                            <div class="admin-field"><label>@T["Personal probability"]</label><input name="numericProbability" value="@(drop.Probability?.ToString("0.############", CultureInfo.InvariantCulture))" class="form-control catalogue-probability-input" type="number" min="0" max="1" step="any" />@if (dropMissingProbability) { <span class="admin-status-pill is-yellow">@T["Missing probability"]</span> }<small>@T["Per reward roll. For example, 1/100 is 0.01."]</small></div>
                                            <div class="catalogue-ehb-result"><span>@T["Calculated EHB"]</span><output>@(drop.DefaultEhb?.ToString("0.####") ?? T["Not available"])</output></div>
                                            <div class="catalogue-drop-details"><div class="admin-field"><label>@T["Data source"]</label><input name="dataSource" value="@drop.DataSource" class="form-control" /></div><div class="admin-field"><label>@T["Image URL"]</label><input name="imageUrl" value="@drop.ImageUrl" class="form-control" type="url" /></div><div class="admin-field"><label>@T["Rolls per {0}", IndexModel.RateUnit(selectedBoss.Category, 1m)]</label><input name="rollsPerCompletion" value="@drop.RollsPerCompletion" class="form-control" type="number" min="1" max="100" /></div><div class="admin-field"><label>@T["Roll group"]</label><input name="rollGroup" value="@drop.RollGroup" class="form-control" maxlength="120" /></div></div>
                                        </form>
                                        <div class="catalogue-drop-actions">
                                            <button class="admin-button-secondary" type="submit" form="catalogue-drop-form-@drop.Id">@T["Save drop"]</button>
                                            @if (drop.Active)
                                            {
                                                <details class="admin-destructive-confirmation catalogue-confirmation-box"><summary class="admin-button-secondary action-danger-outline">@T["Deactivate drop"]</summary><div class="event-confirmation-box" role="alertdialog" aria-labelledby="deactivate-drop-@drop.Id"><p><strong id="deactivate-drop-@drop.Id">@T["Deactivate {0}?", drop.ItemName]</strong><span>@T["The drop remains in the catalogue and can be reactivated later."]</span></p><form method="post" asp-page-handler="ToggleDrop" data-update-targets="@partialTargets"><input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordId" value="@drop.Id" /><input type="hidden" name="expectedVersion" value="@drop.Version" /><div class="catalogue-confirmation-actions"><button type="button" class="admin-button-secondary" data-catalogue-confirmation-cancel>@T["Cancel"]</button><button class="admin-button-secondary action-danger-outline" type="submit">@T["Deactivate drop"]</button></div></form></div></details>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="ToggleDrop" data-update-targets="@partialTargets"><input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordId" value="@drop.Id" /><input type="hidden" name="expectedVersion" value="@drop.Version" /><button class="admin-button-secondary" type="submit">@T["Reactivate drop"]</button></form>
                                            }
                                            @if (User.IsInRole("SuperAdmin")) { <details class="admin-destructive-confirmation catalogue-confirmation-box"><summary class="admin-button-secondary action-danger-outline">@T["Delete permanently"]</summary><div class="event-confirmation-box" role="alertdialog" aria-labelledby="delete-drop-@drop.Id"><p><strong id="delete-drop-@drop.Id">@T["Delete {0} permanently?", drop.ItemName]</strong><span>@T["Only an unused catalogue record can be deleted."]</span></p><form method="post" asp-page-handler="Delete" data-update-targets="@partialTargets"><input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordType" value="drop" /><input type="hidden" name="recordId" value="@drop.Id" /><input type="hidden" name="expectedVersion" value="@drop.Version" /><label>@T["Type DELETE to confirm"]<input name="confirmation" class="form-control" required /></label><div class="catalogue-confirmation-actions"><button type="button" class="admin-button-secondary" data-catalogue-confirmation-cancel>@T["Cancel"]</button><button class="admin-button-secondary action-danger-outline" type="submit">@T["Delete permanently"]</button></div></form></div></details> }
                                        </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                    <div class="catalogue-editor-footer">
                        @if (selectedBoss.Active)
                        {
                            <details class="admin-destructive-confirmation catalogue-confirmation-box"><summary class="admin-button-secondary action-danger-outline">@T["Deactivate activity"]</summary><div class="event-confirmation-box" role="alertdialog" aria-labelledby="deactivate-boss-@selectedBoss.Id"><p><strong id="deactivate-boss-@selectedBoss.Id">@T["Deactivate {0}?", selectedBoss.Name]</strong><span>@T["The activity remains in the catalogue and can be reactivated later."]</span></p><form method="post" asp-page-handler="ToggleBoss" data-update-targets="@partialTargets"><input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordId" value="@selectedBoss.Id" /><input type="hidden" name="expectedVersion" value="@selectedBoss.Version" /><div class="catalogue-confirmation-actions"><button type="button" class="admin-button-secondary" data-catalogue-confirmation-cancel>@T["Cancel"]</button><button class="admin-button-secondary action-danger-outline" type="submit">@T["Deactivate activity"]</button></div></form></div></details>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="ToggleBoss" data-update-targets="@partialTargets"><input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordId" value="@selectedBoss.Id" /><input type="hidden" name="expectedVersion" value="@selectedBoss.Version" /><button class="admin-button-secondary" type="submit">@T["Reactivate activity"]</button></form>
                        }
                        @if (User.IsInRole("SuperAdmin")) { <details class="admin-destructive-confirmation catalogue-confirmation-box"><summary class="admin-button-secondary action-danger-outline">@T["Delete permanently"]</summary><div class="event-confirmation-box" role="alertdialog" aria-labelledby="delete-boss-@selectedBoss.Id"><p><strong id="delete-boss-@selectedBoss.Id">@T["Delete {0} permanently?", selectedBoss.Name]</strong><span>@T["Only an unused catalogue record can be deleted."]</span></p><form method="post" asp-page-handler="Delete" data-update-targets="@partialTargets"><input type="hidden" name="BossId" value="@selectedBoss.Id" /><input type="hidden" name="Overlay" value="@(Model.IsOverlay ? "true" : "false")" /><input type="hidden" name="recordType" value="boss" /><input type="hidden" name="recordId" value="@selectedBoss.Id" /><input type="hidden" name="expectedVersion" value="@selectedBoss.Version" /><label>@T["Type DELETE to confirm"]<input name="confirmation" class="form-control" required /></label><div class="catalogue-confirmation-actions"><button type="button" class="admin-button-secondary" data-catalogue-confirmation-cancel>@T["Cancel"]</button><button class="admin-button-secondary action-danger-outline" type="submit">@T["Delete permanently"]</button></div></form></div></details> }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        <div class="admin-events-directory-controls catalogue-directory-controls">
            <form class="admin-events-toolbar" method="get" data-catalogue-directory-search aria-label="@T["Catalogue filters"]">
                <div class="admin-search-field admin-events-search">
                    <label class="visually-hidden" for="boss-search">@T["Search catalogue"]</label>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                    <input id="boss-search" class="admin-search-field-input form-control" type="search" name="search" autocomplete="off" placeholder="@T["Search bosses, activities, and drops…"]" data-catalogue-search-input />
                    <button class="admin-search-clear" type="button" data-admin-search-clear aria-label="@T["Clear catalogue search"]" hidden><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg></button>
                </div>
                <div class="admin-events-state-filter admin-field">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                    <label for="catalogue-category">@T["Category:"]</label>
                    <div class="admin-events-state-select">
                        <select id="catalogue-category" class="admin-filter-select form-select" name="category" data-catalogue-category-filter>
                            <option value="all">All</option>
                            <option value="Boss">Boss</option>
                            <option value="Skilling boss">Skilling boss</option>
                            <option value="Minigame">Minigame</option>
                            <option value="inactive">Inactive</option>
                        </select>
                        <svg class="admin-events-state-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                    </div>
                </div>
            </form>
            <a class="admin-button-create" href="@pageUrl?addBoss=true" data-catalogue-add>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                <span>@T["Add boss or activity"]</span>
            </a>
        </div>
        <aside class="information-callout" role="note"><div class="information-callout-heading"><svg class="information-callout-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 7.5h.01" /></svg><strong>@T["Team content"]</strong></div><span>@T["When adding a drop for team content, enter the chance of receiving it in your own name at the team size used for the EHB rate. For example, in a five-player Nex team, your personal chance of receiving a Nihil horn is 1/1,290 per kill."]</span></aside>
        <p id="no-boss-results" class="catalogue-empty-state" hidden>@T["No bosses or activities match the current filters."]</p>
        <div id="boss-list" class="catalogue-card-grid" data-catalogue-list>
            @foreach (var boss in Model.Bosses)
            {
                var bossDrops = Model.Drops.Where(x => x.BossActivityId == boss.Id).ToList();
                var missingDropValues = bossDrops.Count(x => x.Active && (x.Probability is null or <= 0));
                var editorUrl = $"{pageUrl}?bossId={boss.Id}";
                var searchText = string.Join(" ", new[] { boss.Name, boss.Category }.Concat(bossDrops.Select(x => x.ItemName)));
                <a class="catalogue-record-card @(boss.Active ? null : "is-inactive")" href="@editorUrl" data-catalogue-record data-editor-url="@editorUrl" data-category="@boss.Category" data-active="@boss.Active.ToString().ToLowerInvariant()" data-search="@searchText.ToLowerInvariant()">
                    <span class="catalogue-card-image @(!string.IsNullOrWhiteSpace(boss.ImageUrl) ? "has-image" : null)">@if (!string.IsNullOrWhiteSpace(boss.ImageUrl)) { <img src="@WikiImages.GetPublicUrl(boss.ImageUrl)" alt="" loading="lazy" /> } else { <span>@T["Image"]</span> }</span>
                    <span class="catalogue-card-content"><strong>@boss.Name</strong><small class="catalogue-card-meta">@boss.Category · @(boss.EfficientRate?.ToString("0.##", CultureInfo.InvariantCulture) ?? T["Rate missing"]) @IndexModel.RateUnit(boss.Category, boss.EfficientRate)/hour · @T["{0} drop(s)", bossDrops.Count]</small>@if (boss.EfficientRate is null or <= 0 || missingDropValues > 0) { <span class="catalogue-warnings">@if (boss.EfficientRate is null or <= 0) { <span class="admin-status-pill is-yellow">@T["Missing EHB rate"]</span> } @if (missingDropValues > 0) { <span class="admin-status-pill is-yellow">@T["{0} drop(s) missing probability", missingDropValues]</span> }</span> }</span>
                    <span class="catalogue-card-status admin-status-pill @(boss.Active ? "is-green" : "is-muted")">@(boss.Active ? T["Active"] : T["Inactive"])</span>
                </a>
            }
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/catalogue-admin.js" asp-append-version="true"></script>
}
