@page
@using Bingo.Application.Integrations.WiseOldMan
@inject IWiseOldManStatus WiseOldManStatus
@{
    ViewData["Title"] = T["Administration"];
}

<section class="content-page admin-home">
    <p class="eyebrow">@T["Administration"]</p>
    <h1>@T["Admin tools"]</h1>
    <div class="foundation-grid admin-links">
        <a class="foundation-card" asp-page="/Admin/Events/Index">
            <div><h2>@T["Events"]</h2><p>@T["Set up events, open signups and manage players."]</p></div>
        </a>
        <a class="foundation-card" asp-page="/Admin/Catalogue/Index"><div><h2>@T["OSRS catalogue"]</h2><p>@T["Manage bosses, activities, drops, drop rates and EHB."]</p></div></a>
        <a class="foundation-card" asp-page="/Admin/Review/Index"><div><h2>@T["Evidence review"]</h2><p>@T["Review tile submissions from captains."]</p></div></a>
        <a class="foundation-card" asp-page="/Admin/Accounts/Index">
            <div><h2>@T["Accounts"]</h2><p>@T["Manage admins and captain accounts."]</p></div>
        </a>
        <a class="foundation-card" asp-page="/Admin/Audit/Index">
            <div><h2>@T["Audit log"]</h2><p>@T["See sign-ins and changes made by admins."]</p></div>
        </a>
    </div>
    @{ var wiseOldMan = WiseOldManStatus.GetStatus(); }
    <section class="panel" aria-labelledby="wise-old-man-status">
        <h2 id="wise-old-man-status">@T["Wise Old Man request status"]</h2>
        <p class="form-hint">@T["Observed limit"]: @(wiseOldMan.ObservedLimit?.ToString() ?? T["Not observed"]), @T["remaining"]: @(wiseOldMan.ObservedRemaining?.ToString() ?? T["Not observed"]), @T["reset"]: @(wiseOldMan.ResetAt?.ToLocalTime().ToString("g") ?? T["Not observed"])</p>
        <p class="form-hint">@T["Last request"]: @(wiseOldMan.LastRequestAt?.ToLocalTime().ToString("g") ?? T["Never"]) · @T["last success"]: @(wiseOldMan.LastSuccessAt?.ToLocalTime().ToString("g") ?? T["Never"]) · @T["last error"]: @(wiseOldMan.LastErrorAt?.ToLocalTime().ToString("g") ?? T["Never"]) · @T["last 429"]: @(wiseOldMan.LastRateLimitedAt?.ToLocalTime().ToString("g") ?? T["Never"])</p>
    </section>
</section>
