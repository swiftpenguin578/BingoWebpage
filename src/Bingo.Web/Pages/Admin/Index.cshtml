@page
@model Bingo.Web.Pages.Admin.IndexModel
@using Bingo.Application.Dashboard
@using Bingo.Domain.Events
@using System.Text.Json
@inject IStringLocalizer<AdminCommunityResource> D
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Summary"] = Model.Summary;
    var data = Model.Dashboard!;
    string N(long value) => Bingo.Web.Pages.Admin.IndexModel.Number(value);
    var stats = data.Statistics;
    var firstTracked = data.Chart.FirstOrDefault(point => point.TrackingStarts);
    var latest = data.Chart.LastOrDefault();
    var platformCount = data.History.Count(row => !row.IsHistoricalImport);
    var hasImported = data.History.Any(row => row.IsHistoricalImport);
    var reviewApproved = data.History.Where(row => row.State == EventState.AwaitingFinalReview && row.ApprovedSubmissions.IsAvailable).Sum(row => row.ApprovedSubmissions.Value);
    var approvedHint = platformCount == 0 ? Model.L("The imported event has no evidence submissions.")
        : !stats.ApprovedSubmissions.IsAvailable ? Model.L("Published board approval or a usable event interval is unavailable.")
        : Model.L("Platform events only.") + (hasImported ? Model.L(" Reconstructed records from the imported event are excluded.") : "")
            + (reviewApproved > 0 ? Model.L(" {0} are from an event still in final review and may change.", N(reviewApproved)) : "");
    var noDates = data.History.Any(row => row.ActualStartedAt is null || (row.State != EventState.Live && row.ActualEndedAt is null));
    var statRows = new[] {
        (Label: "Events held", Metric: stats.EventsHeld, Note: stats.ProvisionalEvents > 0 ? Model.L("{0} live or awaiting final review", N(stats.ProvisionalEvents)) : Model.L("since {0}", Model.Month(data.Chart.FirstOrDefault()?.ActualStartedAt, data.Chart.FirstOrDefault()?.Timezone)), Hint: Model.L("Events that have gone Live, including any awaiting final review.") + (stats.Provisional ? " " + Model.L("Figures are provisional and may still change.") : ""), Delta: ""),
        (Label: "Unique participants", Metric: stats.UniqueWebsiteParticipants, Note: firstTracked is null ? Model.L("not tracked yet") : Model.L("tracked since {0}", firstTracked.EventName), Hint: noDates ? Model.L("A usable actual lifecycle interval is unavailable. Unknown is not zero.") : firstTracked is null ? Model.L("Imported participants aren’t linked to website accounts, so they can’t be counted as unique people.") : Model.L("Counted by website account, tracked since {0}.", firstTracked.EventName) + (hasImported ? Model.L(" Imported participants aren’t linked to accounts, so they aren’t included.") : ""), Delta: firstTracked is not null && latest is { TrackingStarts: false, IsHistoricalImport: false } && stats.LatestNewParticipants.IsAvailable ? "+" + Bingo.Web.Pages.Admin.IndexModel.Value(stats.LatestNewParticipants) : ""),
        (Label: "Total participations", Metric: stats.EventParticipations, Note: Model.L("each person once per event"), Hint: noDates ? Model.L("A usable actual lifecycle interval is unavailable. Unknown is not zero.") : Model.L("Players summed across every event held, including imported history. Each person counts once per event."), Delta: data.Chart.Count > 1 && latest is { Participants.IsAvailable: true } ? "+" + Bingo.Web.Pages.Admin.IndexModel.Value(latest.Participants) : ""),
        (Label: "Approved submissions", Metric: stats.ApprovedSubmissions, Note: platformCount == 0 ? Model.L("no platform events yet") : !stats.ApprovedSubmissions.IsAvailable ? Model.L("not available") : hasImported ? Model.L("platform events only") : Model.L(platformCount == 1 ? "across {0} event" : "across {0} events", N(platformCount)), Hint: approvedHint, Delta: data.History.Count(row => !row.IsHistoricalImport) > 1 && stats.LatestNewApprovedSubmissions.IsAvailable ? "+" + Bingo.Web.Pages.Admin.IndexModel.Value(stats.LatestNewApprovedSubmissions) : "")
    };
    var chartMax = data.Chart.Select(point => point.Participants.Value).DefaultIfEmpty().Max();
    var chartStep = chartMax > 150 ? 50 : 25;
    var chartTop = Math.Max(chartStep, (long)Math.Ceiling((double)chartMax / chartStep) * chartStep);
    int Height(long value) => Math.Max(2, (int)Math.Round((double)value / chartTop * 208));
    var columns = new[] {
        (DashboardHistorySortField.EventDate, "Event", "c-name"), (DashboardHistorySortField.Players, "Players", "num"),
        (DashboardHistorySortField.ApprovedSubmissions, "Approved submissions", "num"), (DashboardHistorySortField.WinnerBoard, "Winner’s board", ""),
        (DashboardHistorySortField.Ehb, "EHB gained", "num c-ehb"), (DashboardHistorySortField.Winner, "Winner", "")
    };
}
@section HeaderActions {
    @if (data.CurrentEvent is { } card)
    {
        <div class="next-event" aria-label="@D[card.State == EventState.Live ? "Current event" : "Next event"]">
            <div class="grow"><div class="next-label">@D[card.State == EventState.Live ? "Current event" : "Next event"]</div><div class="next-name">@card.EventName</div><div class="next-meta"><span class="dot @(card.State == EventState.Live ? "tone-live" : card.State == EventState.SignupOpen ? "tone-open" : "tone-draft")"></span><span>@Model.Phase(card.State)</span> · <span>@Model.NextDate(card)</span></div></div>
            @if (card.Capacity is { } cap)
            {
                <div class="meter" title="@D["{0} of {1} places filled", N(card.ConfirmedParticipants), N(cap)]"><div class="meter-track" style="--meter-w:56px"><div class="meter-fill" style="width:@(Bingo.Web.Pages.Admin.IndexModel.Percent(cap > 0 ? Math.Min(1m, (decimal)card.ConfirmedParticipants / cap) : 0))%"></div></div><span class="meter-label">@N(card.ConfirmedParticipants)/@N(cap)</span></div>
            }
            else { <span class="meter-label">@D["{0} confirmed · No capacity set", N(card.ConfirmedParticipants)]</span> }
            <a class="btn btn-sm" href="@card.OverviewPath">@D["Open"]</a>
        </div>
    }
}
<div data-dashboard data-history-orders="@JsonSerializer.Serialize(Model.HistoryOrders)" data-sort-template="@D["Sorted by {0}, {1}."]" data-sort-ascending="@D["ascending"]" data-sort-descending="@D["descending"]" data-sort-announcement="@D["Sorted by {0}, {1}.", D[columns.Single(column => column.Item1 == Model.Sort).Item2].Value, D[Model.Descending ? "descending" : "ascending"].Value]">
<span class="sr" aria-live="polite" data-sort-status></span>
@if (data.History.Count == 0)
{
    <div class="card fade-in"><div class="empty"><div class="empty-ic"><svg class="ic" viewBox="0 0 16 16"><path d="M2.5 13.5h11M4.5 11V8M8 11V4.5M11.5 11V6.5"/></svg></div><div class="empty-title">@D["No events have been held yet"]</div><div class="empty-text">@D["Participation, results and history appear here once the first event has ended."]</div><a class="btn" href="/Admin/Events">@D["Go to Events"]</a></div></div>
}
else
{
    <section class="card fade-in" aria-label="@D["Headline statistics"]"><div class="stat-strip">
    @for (var i = 0; i < statRows.Length; i++)
    {
        var stat = statRows[i];
        <div class="stat"><div class="stat-label">@D[stat.Label]</div><div class="stat-value @(!stat.Metric.IsAvailable ? "is-empty" : "")" data-stat="@i">@Bingo.Web.Pages.Admin.IndexModel.Value(stat.Metric)</div><div class="stat-note">
        @if (stat.Delta.Length > 0) { <span class="stat-delta"><span class="stat-delta-fig"><svg class="ic" viewBox="0 0 16 16"><path d="M2.5 11.5 6.5 7.5l2.5 2.5 4.5-4.5M10 5.5h3.5V9"/></svg><b>@stat.Delta</b></span><span>@D[i == 1 ? "new in the latest event" : "from the latest event"]</span></span> }
        else { <span>@stat.Note</span> }
        @{ var hint = stat.Hint + (stats.LatestContributionProvisional && stat.Delta.Length > 0 && i > 0 ? " " + D[latest?.State == EventState.Live ? "Figures are provisional and may still change." : "The latest event is still in final review, so its figures are provisional."].Value : ""); }
        <span class="hint @(i == 0 ? "tip-start" : i == 3 ? "tip-end" : "")" tabindex="0" aria-label="@hint"><svg class="hint-ic" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6"/><path d="M8 7.2v3.8M8 5h.01"/></svg><span class="hint-tip" aria-hidden="true">@hint</span></span></div></div>
    }
    </div></section>
    <div class="dash-grid">
    @if (data.Chart.Count >= 2)
    {
        <section class="card panel fade-in" aria-labelledby="part-title">
            <div class="panel-head"><h2 class="panel-title" id="part-title">@D["Participation by event"]</h2><div class="legend" aria-label="@D["Legend"]">
            @if (data.Chart.Any(point => point.ReturningWebsiteParticipants.IsAvailable)) { <span class="legend-item"><span class="legend-key s-1"></span>@D["Returning"]</span> }
            <span class="legend-item"><span class="legend-key s-2"></span>@D[data.Chart.Any(point => point.ReturningWebsiteParticipants.IsAvailable) ? "First time" : "Tracked players"]</span>
            @if (data.Chart.Any(point => point.IsHistoricalImport)) { <span class="legend-item"><span class="legend-key s-muted"></span>@D["Imported (not linked)"]</span> }
            @if (stats.Provisional) { <span class="legend-item"><span class="legend-key s-2 is-provisional"></span>@D["Provisional"]</span> }
            </div></div>
            <div class="chart" id="chart" style="--bar-count:@data.Chart.Count">
                <div class="chart-plot" style="--chart-h:208px">
                @for (long tick = 0; tick <= chartTop; tick += chartStep)
                {
                    var top = ((1m - (decimal)tick / chartTop) * 100m).ToString("0.##", CultureInfo.InvariantCulture);
                    <div class="chart-gridline @(tick == 0 ? "is-base" : "")" style="top:@top%"></div><div class="chart-tick" style="top:@top%">@Bingo.Web.Pages.Admin.IndexModel.Number(tick)</div>
                }
                <div class="bars" role="group" aria-label="@D["Players per event"]">
                @for (var i = 0; i < data.Chart.Count; i++)
                {
                    var point = data.Chart[i];
                    var provisional = point.Provisional ? " is-provisional" : "";
                    <button class="bar-col" aria-label="@Model.ChartLabel(point)" aria-describedby="tip-@i" data-chart-bar="@i" data-open-url="@(data.History.Single(row => row.EventId == point.EventId).OverviewPath)">
                    <span class="bar"><span class="bar-total">@Bingo.Web.Pages.Admin.IndexModel.Value(point.Participants)</span><span class="bar-stack" aria-hidden="true">
                    @if (!point.Participants.IsAvailable) { }
                    else if (point.IsHistoricalImport || point.TrackingStarts) { <span class="bar-seg @(point.IsHistoricalImport ? "s-muted" : "s-2" + provisional)" style="height:@(Height(point.Participants.Value))px"></span> }
                    else { <span class="bar-seg @("s-1" + provisional)" style="height:@(Math.Max(0, Height(point.ReturningWebsiteParticipants.Value) - 1))px"></span><span class="bar-seg @("s-2" + provisional)" style="height:@(Math.Max(0, Height(point.NewWebsiteParticipants.Value) - 1))px"></span> }
                    </span></span></button>
                }
                </div></div>
                <div class="chart-x" aria-hidden="true">
                @foreach (var point in data.Chart)
                {
                    <div class="chart-xlabel"><div class="chart-xname" title="@point.EventName">@point.EventName</div><div class="chart-xmeta">@Model.Month(point.ActualStartedAt, point.Timezone)</div><div class="chart-xtiny">@(point.ActualStartedAt is { } at ? DateTimePresentation.Format(at, "MMM ’yy", point.Timezone, CultureInfo.CurrentCulture) : Model.L("Not recorded"))</div><div class="chart-xnote">
                    @if (point.IsHistoricalImport || point.Provisional || point.TrackingStarts) { <span class="pill @(point.IsHistoricalImport ? "is-neutral" : point.Provisional ? "is-warning" : "")">@D[point.IsHistoricalImport ? "Imported" : point.Provisional ? "Provisional" : "Tracking starts"]</span> }
                    else if (point.Participants.Value > 0) { <span class="chart-xmeta">@Bingo.Web.Pages.Admin.IndexModel.Percent((decimal)point.ReturningWebsiteParticipants.Value / point.Participants.Value)% @D["Returning"].Value.ToLower(CultureInfo.CurrentCulture)</span> }
                    </div></div>
                }
                </div>
                @for (var i = 0; i < data.Chart.Count; i++)
                {
                    var point = data.Chart[i];
                    <div class="chart-tip" id="tip-@i" role="tooltip" aria-hidden="true" data-chart-tip="@i"><div class="tip-title">@point.EventName</div><div class="tip-meta">@Model.Range(point.ActualStartedAt, point.ActualEndedAt, point.Timezone) · @D["{0} teams", N(point.TeamCount)]</div><div class="tip-rows"><div class="tip-row"><span>@D["Players"]</span><b>@Bingo.Web.Pages.Admin.IndexModel.Value(point.Participants)</b></div>
                    @if (point.ReturningWebsiteParticipants.IsAvailable) { <div class="tip-row"><span class="tip-key s-1"></span><span>@D["Returning"]</span><b>@Bingo.Web.Pages.Admin.IndexModel.Value(point.ReturningWebsiteParticipants)</b></div><div class="tip-row"><span class="tip-key s-2"></span><span>@D["First time"]</span><b>@Bingo.Web.Pages.Admin.IndexModel.Value(point.NewWebsiteParticipants)</b></div><div class="tip-row"><span>@D["Returning share"]</span><b>@(point.Participants.Value == 0 ? "0" : Bingo.Web.Pages.Admin.IndexModel.Percent((decimal)point.ReturningWebsiteParticipants.Value / point.Participants.Value))%</b></div> }
                    </div>
                    @if (point.IsHistoricalImport || point.TrackingStarts || point.Provisional) { <div class="tip-note">@Model.ChartTipNote(point)</div> }
                    </div>
                }
            </div>
            <div class="panel-foot"><span class="panel-note">@D["Each person counted once per event."] @if (firstTracked is not null) { @D[data.Chart.Any(point => point.ReturningWebsiteParticipants.IsAvailable) ? "Tracking by website account starts with {0}; returning means they played an earlier tracked event." : "Tracking by website account starts with {0}; returning players appear from the next tracked event.", firstTracked.EventName] }</span></div>
        </section>
    }
    @if (data.LatestEndedRecap is { } recap)
    {
        var history = data.History.Single(row => row.EventId == recap.EventId);
        var lastOfficial = data.History.FirstOrDefault(row => !row.Provisional && row.Winners.Count > 0);
        var recapPoint = data.Chart.Single(point => point.EventId == recap.EventId);
        <section class="card panel fade-in recap @(data.Chart.Count < 2 ? "is-wide" : "")" aria-labelledby="recap-title">
        <div class="panel-head"><h2 class="panel-title" id="recap-title">@D["Latest event"]</h2><span class="badge @(recap.Provisional ? "badge-warning" : "badge-neutral")">@D[recap.Provisional ? "Provisional" : recap.IsHistoricalImport ? "Imported · archived" : "Finalized"]</span></div>
        <div class="recap-name">@recap.EventName</div><div class="recap-when">@Model.Range(recap.ActualStartedAt, recap.ActualEndedAt, history.Timezone)</div>
        <div class="highlight @(recap.Provisional ? "is-muted" : "")"><div class="highlight-ic"><svg class="ic" viewBox="0 0 16 16">@if (recap.Provisional) { <circle cx="8" cy="8" r="5.5"/><path d="M8 5v3l2 1.5"/> } else { <path d="M5 2.5h6v3.5a3 3 0 0 1-6 0zM5 3.5H3v1a2 2 0 0 0 2 2M11 3.5h2v1a2 2 0 0 1-2 2M8 9v2.5M5.5 13.5h5M6.5 11.5h3"/> }</svg></div><div style="min-width:0;flex:1"><div class="highlight-label">@D[recap.Provisional ? "Results provisional" : "Winner"]</div><div class="highlight-value">@(recap.Provisional ? D["Final review in progress"].Value : Model.Winners(recap.Winners))</div><div class="highlight-sub">@(recap.Provisional ? lastOfficial is null ? D["The winner is shown once results are official."].Value : Model.L("Last official winner: {0} · {1}", Model.Winners(lastOfficial.Winners), lastOfficial.EventName) : Model.L("{0} teams competed", N(recap.TeamCount)))</div></div>
        @if (recap.WinnerBoard is { } board) { <div class="meter" title="@D["Winner completed {0} of {1} tiles", N(board.CompletedTiles), N(board.TotalTiles)]"><div class="meter-track" style="--meter-w:48px"><div class="meter-fill" style="width:@Bingo.Web.Pages.Admin.IndexModel.Percent(board.CompletionRatio)%"></div></div><span class="meter-label">@N(board.CompletedTiles)/@N(board.TotalTiles)</span></div> }
        </div>
        <dl class="facts">
        <div class="fact"><dt class="fact-label">@D["Players"]</dt><dd class="fact-value">@Bingo.Web.Pages.Admin.IndexModel.Value(recap.Participants)<span class="fact-sub">@D["{0} teams", N(recap.TeamCount)]@if (recapPoint.ReturningWebsiteParticipants.IsAvailable) { @D[" · {0}% returning", Bingo.Web.Pages.Admin.IndexModel.Percent(recap.Participants.Value == 0 ? 0m : (decimal)recapPoint.ReturningWebsiteParticipants.Value / recap.Participants.Value)] }</span></dd></div>
        <div class="fact"><dt class="fact-label">@D["Approved submissions"]</dt><dd class="fact-value">@if (!recap.ApprovedSubmissions.IsAvailable) { <span class="hint tip-end" tabindex="0" aria-label="@(recap.IsHistoricalImport ? D["Imported history has no evidence submissions; its contributions were reconstructed."].Value : Model.SubmissionHint(history))">—<span class="hint-tip" aria-hidden="true">@(recap.IsHistoricalImport ? D["Imported history has no evidence submissions; its contributions were reconstructed."].Value : Model.SubmissionHint(history))</span></span> } else { @Bingo.Web.Pages.Admin.IndexModel.Value(recap.ApprovedSubmissions) }<span class="fact-sub">@(recap.ApprovedSubmissions.IsAvailable ? recap.Provisional ? D["may change in final review"].Value : "" : D["not available"].Value)</span></dd></div>
        @if (history.Ehb.IsAvailable) { <div class="fact is-secondary"><dt class="fact-label">@D["EHB gained"]</dt><dd class="fact-value">@history.Ehb.Gain?.ToString("N0", CultureInfo.CurrentCulture)<span class="fact-sub">@D["{0} of {1} accounts · Wise Old Man", N(history.Ehb.MatchedAccounts), N(history.Ehb.ExpectedAccounts)]@(history.IsHistoricalImport ? D[" (frozen)"].Value : "")</span></dd></div> }
        </dl>
        <div class="panel-foot"><span class="panel-note">@(recap.Provisional ? Model.L("Ended {0}", DateTimePresentation.Format(recap.ActualEndedAt, "d MMM yyyy", history.Timezone, CultureInfo.CurrentCulture)) : D[recap.IsHistoricalImport ? "Imported history · attribution reconstructed" : "Finalized results"].Value)</span>@if (data.Chart.Count < 2) { <span class="panel-note">@D["Participation by event appears once a second event has been held."]</span> }<a class="btn btn-quiet btn-sm" href="@recap.OverviewPath">@D["Open event"]<svg class="ic" viewBox="0 0 16 16"><path d="M6 4l4 4-4 4"/></svg></a></div>
        </section>
    }
    else
    {
        <section class="card panel recap @(data.Chart.Count < 2 ? "is-wide" : "")"><div class="panel-head"><h2 class="panel-title">@D["Latest event"]</h2></div><div class="empty"><div class="empty-title">@D["No ended event yet"]</div><div class="empty-text">@D["The recap appears after an event has ended."]</div></div></section>
    }
    </div>
    <section class="card dash-section fade-in" aria-labelledby="hist-title"><div class="panel-head hist-head"><h2 class="panel-title" id="hist-title">@D["Event history"]</h2><span class="panel-aside">@D["{0} events", N(data.History.Count)]</span></div><div class="tbl-wrap" id="tbl-wrap"><div class="tbl hist" role="table" aria-label="@D["Event history"]"><div class="tr th-row" role="row">
    @foreach (var (field, label, cls) in columns)
    {
        var sorted = field == Model.Sort;
        <div class="th @cls @(sorted ? "is-sorted" : "")" role="columnheader" aria-sort="@(sorted ? Model.Descending ? "descending" : "ascending" : "none")"><a class="th-btn" href="@Model.SortUrl(field)" id="dashboard-sort-@field" data-dashboard-sort="@field">@D[label]<svg class="ic sort-ic @(sorted ? Model.Descending ? "is-desc" : "is-asc" : "")" viewBox="0 0 16 16"><path d="M4.5 10 8 6.5l3.5 3.5"/></svg></a></div>
    }
    </div><div class="rows" role="rowgroup">
    @foreach (var row in Model.History)
    {
        <div class="tr row" role="row" data-open-url="@row.OverviewPath" data-history-event="@row.EventId">
        <div class="td c-name" role="cell"><div class="name-line"><a class="name-btn" title="@row.EventName" href="@row.OverviewPath">@row.EventName</a>
        @if (row.IsHistoricalImport || row.Provisional) { <span class="pill @(row.IsHistoricalImport ? "is-neutral" : "is-warning")">@D[row.IsHistoricalImport ? "Imported" : row.State == EventState.Live ? "Live · provisional" : "Final review"]</span> }</div><div class="sub">@Model.Range(row.ActualStartedAt, row.ActualEndedAt, row.Timezone)</div></div>
        <div class="td num" role="cell">@Bingo.Web.Pages.Admin.IndexModel.Value(row.Participants)</div>
        <div class="td num" role="cell">@if (row.ApprovedSubmissions.IsAvailable) { @Bingo.Web.Pages.Admin.IndexModel.Value(row.ApprovedSubmissions) } else { <span class="hint tip-end muted" tabindex="0" aria-label="@Model.SubmissionHint(row)">—<span class="hint-tip" aria-hidden="true">@Model.SubmissionHint(row)</span></span> }</div>
        <div class="td" role="cell">@if (row.WinnerBoard is { } board) { <div class="meter"><div class="meter-track"><div class="meter-fill" style="width:@Bingo.Web.Pages.Admin.IndexModel.Percent(board.CompletionRatio)%"></div></div><span class="meter-label">@board.CompletedTiles/@board.TotalTiles @D["tiles"]</span></div> } else { var hint = D[row.Provisional ? "Shown once results are official." : "Not recorded."].Value; <span class="hint tip-start muted" tabindex="0" aria-label="@hint">—<span class="hint-tip" aria-hidden="true">@hint</span></span> }</div>
        <div class="td num c-ehb" role="cell"><span class="hint tip-end muted" tabindex="0" aria-label="@Model.EhbHint(row)">@(row.Ehb.IsAvailable ? row.Ehb.Gain?.ToString("N0", CultureInfo.CurrentCulture) : "—")<span class="hint-tip" aria-hidden="true">@Model.EhbHint(row)</span></span></div>
        <div class="td" role="cell">@if (row.Provisional) { <span class="hint tip-end" tabindex="0" aria-label="@D["Official results are published after final review."]"><span class="pill is-warning">@D["Provisional"]</span><span class="hint-tip" aria-hidden="true">@D["Official results are published after final review."]</span></span> } else { <div class="cell-main">@Model.Winners(row.Winners)</div> }</div>
        </div>
    }
    </div></div></div></section>
}
<section class="dash-section fade-in" aria-labelledby="comm-title"><div class="section-head"><h2 class="panel-title" id="comm-title">@D["Community"]</h2><span class="panel-aside">@D["Current figures"]</span></div><div class="card"><div class="stat-strip is-compact" style="--stat-cols:3">
<div class="stat"><div class="stat-label">@D["Website accounts"]</div><div class="stat-value">@Bingo.Web.Pages.Admin.IndexModel.Value(data.Community.WebsiteAccounts)</div><div class="stat-note">@D["registered in total"]</div></div>
<div class="stat"><div class="stat-label">@D[data.Community.UsedThirtyDayFallback ? "New in the last 30 days" : "New since the last event"]</div><div class="stat-value">@Bingo.Web.Pages.Admin.IndexModel.Value(data.Community.NewWebsiteAccounts)</div><div class="stat-note">@(data.Community.Since is null ? D["No usable actual ended boundary is available."].Value : data.Community.UsedThirtyDayFallback ? D["created recently"].Value : Model.L("created after {0}", Model.Date(data.Community.Since)))</div></div>
<div class="stat"><div class="stat-label">@D["Logged in during the last 30 days"]</div><div class="stat-value">@Bingo.Web.Pages.Admin.IndexModel.Value(data.Community.LoggedInWebsiteAccounts)</div><div class="stat-note">@(data.Community.WebsiteAccounts.IsAvailable && data.Community.LoggedInWebsiteAccounts.IsAvailable ? Model.L("{0}% of accounts", Bingo.Web.Pages.Admin.IndexModel.Percent(data.Community.WebsiteAccounts.Value > 0 ? (decimal)data.Community.LoggedInWebsiteAccounts.Value / data.Community.WebsiteAccounts.Value : 0m)) : D["not available"].Value)</div></div>
</div></div></section>
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-dashboard.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-dashboard.js" asp-append-version="true" data-admin-page-script></script> }
