@page
@{
    ViewData["Title"] = "Administration";
}

<section class="content-page admin-home">
    <p class="eyebrow">Administration</p>
    <h1>Operations</h1>
    <div class="foundation-grid admin-links">
        <a class="foundation-card" asp-page="/Admin/Events/Index">
            <div><h2>Events</h2><p>Create events, open signups, and manage participants.</p></div>
        </a>
        <a class="foundation-card" asp-page="/Admin/Accounts/Index">
            <div><h2>Accounts</h2><p>Manage administrators and temporary captain access.</p></div>
        </a>
        <a class="foundation-card" asp-page="/Admin/Audit/Index">
            <div><h2>Audit log</h2><p>Review authentication and administrative changes.</p></div>
        </a>
    </div>
</section>
