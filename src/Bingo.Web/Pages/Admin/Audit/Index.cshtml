@page
@model Bingo.Web.Pages.Admin.Audit.IndexModel
@{
    ViewData["Title"] = T["Audit log"];
}

<section class="admin-audit-page" aria-labelledby="admin-audit-title">
    <header class="admin-audit-context">
        <p class="admin-audit-eyebrow">@T["Administration"]</p>
        <h1 id="admin-audit-title">@T["Audit log"]</h1>
    </header>

    <form method="get" class="admin-audit-toolbar" aria-label="@T["Audit log filters"]">
        <div class="admin-field admin-search-field admin-audit-action-field">
            <label asp-for="Action">@T["Action"]</label>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
            <input asp-for="Action" type="search" class="admin-search-field-input form-control" />
            <span asp-validation-for="Action" class="admin-audit-validation"></span>
        </div>
        <div class="admin-field">
            <label asp-for="Actor"></label>
            <input asp-for="Actor" class="form-control" />
            <span asp-validation-for="Actor" class="admin-audit-validation"></span>
        </div>
        <div class="admin-field">
            <label asp-for="Entity"></label>
            <input asp-for="Entity" class="form-control" />
            <span asp-validation-for="Entity" class="admin-audit-validation"></span>
        </div>
        <div class="admin-field">
            <label asp-for="EventId">@T["Event ID"]</label>
            <input asp-for="EventId" class="form-control" />
        </div>
        <div class="admin-field">
            <label asp-for="From"></label>
            <input asp-for="From" class="form-control" />
        </div>
        <div class="admin-field">
            <label asp-for="To"></label>
            <input asp-for="To" class="form-control" />
        </div>
        <div class="admin-audit-toolbar-actions">
            <button class="admin-button-primary" type="submit">@T["Filter"]</button>
            <a class="admin-button-secondary" asp-page="Index">@T["Clear"]</a>
        </div>
    </form>

    <section class="admin-audit-surface" aria-labelledby="admin-audit-entries-title">
        <header class="admin-audit-surface-heading">
            <div>
                <h2 id="admin-audit-entries-title">@T["Audit entries"]</h2>
                <p>@T["Administrative history, ordered newest first."]</p>
            </div>
            <span class="admin-audit-page-indicator">@T["Page {0}", Model.PageNumber]</span>
        </header>

        @if (Model.Entries.Count == 0)
        {
            <div class="admin-audit-empty" role="status">
                <h3>@T["No audit entries found"]</h3>
                <p>@T["Try clearing one or more filters to inspect the complete stream."]</p>
            </div>
        }
        else
        {
            <div class="admin-audit-table-wrap">
                <table class="admin-audit-table">
                    <thead>
                        <tr>
                            <th scope="col">@T["Time"]</th>
                            <th scope="col">@T["Actor"]</th>
                            <th scope="col">@T["Action"]</th>
                            <th scope="col">@T["Target"]</th>
                            <th scope="col">@T["Details"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td data-label="Time">@entry.OccurredAt.ToLocalTime().ToString("g")</td>
                            <td data-label="Actor">@entry.ActorUsername</td>
                            <td data-label="Action"><code class="admin-audit-action">@entry.Action</code></td>
                            <td data-label="Target"><span class="admin-audit-target-type">@entry.TargetType</span><span class="admin-audit-target-id">@entry.TargetId</span></td>
                            <td data-label="Details">
                                <span class="admin-audit-details-text">@entry.Details</span>
                                @if (entry.BeforeState is not null || entry.AfterState is not null)
                                {
                                    <details class="admin-audit-change">
                                        <summary>@T["Structured change"]</summary>
                                        <dl>
                                            <div>
                                                <dt>@T["Before"]</dt>
                                                <dd><code class="admin-audit-json">@(entry.BeforeState ?? "—")</code></dd>
                                            </div>
                                            <div>
                                                <dt>@T["After"]</dt>
                                                <dd><code class="admin-audit-json">@(entry.AfterState ?? "—")</code></dd>
                                            </div>
                                        </dl>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <nav class="admin-audit-pagination" aria-label="@T["Audit log pages"]">
        @if (Model.PageNumber > 1)
        {
            <a class="admin-button-secondary" asp-route-action="@Model.Action" asp-route-actor="@Model.Actor" asp-route-entity="@Model.Entity" asp-route-eventId="@Model.EventId" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-pageNumber="@(Model.PageNumber - 1)">@T["Previous"]</a>
        }
        else
        {
            <span class="admin-audit-page-link is-disabled" aria-disabled="true">@T["Previous"]</span>
        }
        <span class="admin-audit-page-count">@T["Page {0}", Model.PageNumber]</span>
        @if (Model.HasNextPage)
        {
            <a class="admin-button-secondary" asp-route-action="@Model.Action" asp-route-actor="@Model.Actor" asp-route-entity="@Model.Entity" asp-route-eventId="@Model.EventId" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-pageNumber="@(Model.PageNumber + 1)">@T["Next"]</a>
        }
        else
        {
            <span class="admin-audit-page-link is-disabled" aria-disabled="true">@T["Next"]</span>
        }
    </nav>
</section>
