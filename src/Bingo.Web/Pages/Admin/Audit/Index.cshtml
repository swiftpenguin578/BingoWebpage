@page
@model Bingo.Web.Pages.Admin.Audit.IndexModel
@using Bingo.Domain.Events
@using Bingo.Web.Pages.Admin.Audit
@inject IStringLocalizer<AdminCommunityResource> D
@inject IStringLocalizer<Bingo.Web.AuditResource> A
@{
    ViewData["Title"] = "Audit";
    ViewData["PageFamily"] = "audit";
    ViewData["LocalizedTitle"] = D["Audit"].Value;
    var columns = new[] { ("When", "c-name"), ("Action", ""), ("Event", ""), ("Actor", ""), ("Affected account", ""), ("Recorded", "") };
    string Phase(EventState state) => state switch
    {
        EventState.Draft => D["Setup"].Value, EventState.SignupOpen => D["Signups open"].Value, EventState.SignupClosed => D["Signups closed"].Value,
        EventState.Live => D["Live"].Value, EventState.AwaitingFinalReview => D["Final review"].Value, EventState.Finalized => D["Finished"].Value,
        EventState.Archived => D["Archived"].Value, _ => D["Cancelled"].Value
    };
    string ActionLabel(string action) => AuditAreas.Find(action) is { } area ? D["{0} actions", D[area.Label].Value].Value : A[AuditPresenter.ActionLabels.GetValueOrDefault(action, "Recorded administrative action")].Value;
    string Day(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.CurrentCulture);
    var views = Model.Entries.Select(entry => new AuditEntryView(entry, AuditPresenter.Present(entry, A, Model.Names), Model.EventOf(entry))).ToList();
    var specific = Model.Action.Length > 0 && AuditAreas.Find(Model.Action) is null;
    var moreCount = (Model.Type.Length > 0 ? 1 : 0) + (Model.From is not null || Model.To is not null ? 1 : 0) + (specific ? 1 : 0);
    var beyond = Model.Entries.Count == 0 && Model.PageNumber > 1;
    var eventName = Model.EventId is { } selectedEvent && Model.EventsById.TryGetValue(selectedEvent, out var selectedOption) ? selectedOption.Name : null;
    var presets = new[] { ("Today", Model.Today, Model.Today), ("Last 7 days", Model.Today.AddDays(-6), Model.Today), ("Last 30 days", Model.Today.AddDays(-29), Model.Today) };
    var months = string.Join('|', Enumerable.Range(1, 12).Select(month => new DateTime(2000, month, 1).ToString("MMM", CultureInfo.CurrentCulture).TrimEnd('.') + "," + new DateTime(2000, month, 1).ToString("MMMM", CultureInfo.CurrentCulture)));
}
@section HeaderSummary {
    <span>@D["Times in Copenhagen time ({0})", IndexModel.Offset(Model.Now)]</span>
}
<div data-audit-directory data-directory-canonical="@Model.AuditUrl()" data-month-names="@months"
     data-date-format-error="@D["Enter dates like 27 May 2027."]" data-date-order-error="@D["The start date must be on or before the end date."]" data-actor-length-error="@D["Use 100 characters or fewer."]">
<div class="toolbar au-toolbar" role="search" aria-label="@D["Filter the history"]">
    <div class="tbar-right au-filters">
        <div class="search @(Model.Actor.Length > 0 ? "has-clear" : null)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("search")' /><input class="input" id="actor-input" type="search" placeholder="@D["Actor"]" aria-label="@D["Filter by actor"]" autocomplete="off" value="@Model.Actor" aria-describedby="actor-err actor-hint" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" data-audit-actor><button class="icon-btn clear" type="button" aria-label="@D["Clear actor filter"]" data-audit-actor-clear hidden="@(Model.Actor.Length == 0)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button></div>
        <button class="btn filter-btn @(Model.EventId is not null ? "is-active" : null)" type="button" id="event-filter" data-menu-target="audit-event-menu" aria-haspopup="menu" aria-expanded="false" data-audit-event-button><span class="fb-lbl">@D["Event"]</span><span>@(eventName ?? D["All"].Value)</span><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></button>
        <button class="btn filter-btn @(Model.Action.Length > 0 ? "is-active" : null)" type="button" id="action-filter" data-menu-target="audit-action-menu" aria-haspopup="menu" aria-expanded="false" data-audit-action-button><span class="fb-lbl">@D["Action"]</span><span>@(Model.Action.Length > 0 ? ActionLabel(Model.Action) : D["All"].Value)</span><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></button>
        <button class="btn filter-btn @(moreCount > 0 ? "is-active" : null)" type="button" id="more-filters" aria-haspopup="dialog" aria-expanded="false" aria-controls="fpanel" data-audit-more>@D["More filters"]@if (moreCount > 0) { <span class="filter-count" aria-label="@(moreCount == 1 ? D["1 more filter applied"] : D["{0} more filters applied", moreCount])">@moreCount</span> }<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></button>
    </div>
</div>
<div class="field-err au-actor-err" id="actor-err" hidden data-audit-actor-err><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /><span data-component-text></span></div>
<p class="sr" id="actor-hint">@D["Matches actors whose name contains what you type. The list updates as you type."]</p>
<div data-audit-fragments class="directory-fragments">
@if (Model.Filtered)
{
    <div class="filter-row" aria-label="@D["Active filters"]">
        @if (Model.Actor.Length > 0) { <button class="filter-chip" type="button" data-audit-url="@Model.AuditUrl(actor: string.Empty, page: 1)" aria-label="@D["Remove filter: {0}", D["Actor: {0}", Model.Actor]]">@D["Actor: {0}", Model.Actor]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button> }
        @if (eventName is not null) { <button class="filter-chip" type="button" data-audit-url="@Model.AuditUrl(clearEvent: true, page: 1)" aria-label="@D["Remove filter: {0}", D["Event: {0}", eventName]]">@D["Event: {0}", eventName]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button> }
        @if (Model.Action.Length > 0) { <button class="filter-chip" type="button" data-audit-url="@Model.AuditUrl(action: string.Empty, page: 1)" aria-label="@D["Remove filter: {0}", D["Action: {0}", ActionLabel(Model.Action)]]">@D["Action: {0}", ActionLabel(Model.Action)]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button> }
        @if (Model.Type.Length > 0) { var typeLabel = A[AuditPresenter.TargetLabels[Model.Type]].Value; <button class="filter-chip" type="button" data-audit-url="@Model.AuditUrl(type: string.Empty, page: 1)" aria-label="@D["Remove filter: {0}", D["Record: {0}", typeLabel]]">@D["Record: {0}", typeLabel]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button> }
        @if (Model.From is not null || Model.To is not null)
        {
            var range = Model.From is { } f && Model.To is { } t ? f == t ? Day(f) : $"{Day(f)} – {Day(t)}" : Model.From is { } only ? D["From {0}", Day(only)].Value : D["Until {0}", Day(Model.To!.Value)].Value;
            <button class="filter-chip" type="button" data-audit-url="@Model.AuditUrl(clearDates: true, page: 1)" aria-label="@D["Remove filter: {0}", range]">@range<partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button>
        }
        <button class="btn btn-sm btn-quiet" type="button" id="clear-all" data-audit-url="/Admin/Audit" data-audit-clear-all>@D["Clear all"]</button>
    </div>
}
@if (Model.DroppedLinkParts)
{
    <div class="banner is-info page-banner" role="status" id="au-notice" tabindex="-1"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("info")' /><span class="grow"><b>@D["Some filters in the link weren’t recognised."]</b> @D["They were left out; the rest are applied."]</span><button type="button" class="banner-btn" data-audit-notice-dismiss>@D["Dismiss"]</button></div>
}
</div>
<div class="card">
<div class="tbl-wrap" id="audit-table-scroll" data-admin-scroll-region data-audit-wrap><div class="tbl au-tbl sticky-first" role="table" aria-label="@D["Audit entries, newest first"]">
<div class="tr th-row" role="row">@foreach (var (label, cls) in columns) { <div class="th @cls" role="columnheader">@D[label]</div> }</div>
<div data-audit-results>
@if (views.Count > 0)
{
    <div class="rows" role="rowgroup">
    @foreach (var view in views)
    {
        var entry = view.Entry; var p = view.Presentation;
        var local = DateTimePresentation.ToTimezone(entry.OccurredAt);
        <div class="tr row @(Model.EntryId == entry.Id ? "is-selected" : null)" role="row" data-audit-entry="@entry.Id" data-audit-row>
            <div class="td c-name" role="cell"><span class="cell-main au-date">@local.ToString("d MMM yyyy", CultureInfo.CurrentCulture)</span><span class="cell-sub">@local.ToString("HH:mm", CultureInfo.CurrentCulture)</span></div>
            <div class="td" role="cell"><div class="cell-tags"><a class="name-btn" id="open-@entry.Id" href="@Model.AuditUrl(entry: entry.Id)" title="@p.Action" data-audit-open="@entry.Id">@p.Action</a>@if (view.Automated) { <span class="pill is-neutral">@D["Automated"]</span> }</div><span class="cell-sub" title="@(p.Summary ?? p.Target)">@(p.Summary ?? p.Target)</span></div>
            <div class="td" role="cell"><div class="cell-tags">@if (view.Event is { } ev) { <span class="cell-main" title="@ev.Name">@ev.Name</span>@if (ev.IsHidden) { <span class="pill is-neutral">@D["Hidden"]</span> } } else { <span class="cell-main au-muted">@(view.HasEvent ? D["Unknown event"] : D["No event"])</span> }</div></div>
            <div class="td" role="cell">@if (view.Automated) { <span class="actor is-system"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.2"/><path d="M8 1.8v2M8 12.2v2M1.8 8h2M12.2 8h2M3.6 3.6 5 5M11 11l1.4 1.4M3.6 12.4 5 11M11 5l1.4-1.4"/></svg><span class="cell-main">@D["System"]</span></span> } else { <span class="actor"><span class="cell-main">@("@" + p.Actor)</span></span> }</div>
            <div class="td" role="cell">@{ var affected = p.Affected ?? []; }@if (affected.Count == 0) { <span class="cell-main au-muted">—</span> } else if (affected.Count == 1 && p.AffectedMore == 0) { var line = AuditAccountLine.Of(affected[0]); <span class="cell-main" title="@line">@line</span> } else { <span class="cell-main">@D["Multiple accounts"]</span> }</div>
            <div class="td" role="cell"><div class="cell-tags">@if (p.Changes.Count > 0) { <span class="pill is-neutral">@(p.Changes.Count == 1 ? D["1 change"] : D["{0} changes", p.Changes.Count])</span> }@if (p.LifecycleSummary is { Length: > 0 } lifecycle) { <span class="pill is-neutral">@lifecycle</span> }@if (p.Reason is { Length: > 0 }) { <span class="pill">@D["Reason"]</span> }@if (p.Changes.Count == 0 && p.LifecycleSummary is null && p.Reason is null) { <span class="au-muted">—</span> }</div></div>
        </div>
    }
    </div>
}
else
{
    <div class="empty" role="row"><div role="cell" class="au-cell-contents"><div class="empty-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("audit")' /></div><div class="empty-title">@(beyond ? D["No entries on this page"] : Model.Filtered ? D["No entries match these filters"] : D["No history yet"])</div><div class="empty-text">@(beyond ? D["The history may have changed since this link was made."] : Model.Filtered ? D["Try removing a filter or widening the date range."] : D["Administrative actions appear here as they happen."])</div>@if (beyond) { <button type="button" class="btn" id="empty-first" data-audit-url="@Model.AuditUrl(page: 1)">@D["Go to the first page"]</button> } else if (Model.Filtered) { <button type="button" class="btn" id="empty-clear" data-audit-url="/Admin/Audit" data-audit-clear-all>@D["Clear filters"]</button> }</div></div>
}
@foreach (var view in views) { <partial name="_AuditEntryDrawer" model="view" /> }
</div>
</div></div>
<div data-audit-footer>
@if (views.Count > 0 || beyond)
{
    <div class="tfoot"><div class="tfoot-left"><span>@(views.Count == 0 ? string.Empty : (views.Count == 1 ? D["Showing 1 entry"].Value : D["Showing {0} entries", views.Count].Value) + (Model.Filtered ? D[" matching your filters"].Value : string.Empty))</span></div>
        <nav class="pager" aria-label="@D["Pages"]"><button class="btn btn-sm" type="button" id="pg-prev" disabled="@(Model.PageNumber <= 1)" data-audit-url="@Model.AuditUrl(page: Model.PageNumber - 1)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-left")' />@D["Newer"]</button><span class="au-page" aria-live="polite">@D["Page {0}", Model.PageNumber]</span><button class="btn btn-sm" type="button" id="pg-next" disabled="@(!Model.HasNextPage)" data-audit-url="@Model.AuditUrl(page: Model.PageNumber + 1)">@D["Older"]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></button></nav>
    </div>
}
</div>
</div>
<div data-audit-direct>
@if (Model.EntryRequested && Model.SelectedEntry is { } selected && !Model.Entries.Any(entry => entry.Id == selected.Id))
{
    <partial name="_AuditEntryDrawer" model='new AuditEntryView(selected, AuditPresenter.Present(selected, A, Model.Names), Model.EventOf(selected))' />
}
@if (Model.EntryRequested) { <span hidden data-audit-requested="@(Model.SelectedEntry?.Id.ToString() ?? "missing")"></span> }
</div>
<template data-audit-detail="missing">
    <div class="dr-head"><div class="grow"><div class="eyebrow">@D["Audit entry"]</div><h2 class="dr-title" id="drawer-title">@D["Entry not found"]</h2></div><button class="icon-btn" type="button" id="drawer-close" aria-label="@D["Close"]" data-audit-drawer-close><partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button></div>
    <div class="dr-body" id="drawer-body"><div class="empty"><div class="empty-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /></div><div class="empty-title">@D["This entry isn’t available"]</div><div class="empty-text">@D["The link may be incomplete, or the entry belongs to history you can’t view here. Audit entries are never edited or deleted."]</div></div></div>
    <div class="dr-foot"><div class="spacer"></div><button class="btn" type="button" id="dr-done" data-audit-drawer-close>@D["Close"]</button></div>
</template>
@* Menus use the shared shell menu behaviour; the More filters panel is bounded to the viewport (A4). *@
<div data-audit-menus>
<div class="menu au-menu" id="audit-event-menu" role="menu" aria-label="@D["Event filter"]" hidden>
    <button class="menu-item" type="button" role="menuitemradio" aria-checked="@(Model.EventId is null ? "true" : "false")" data-audit-url="@Model.AuditUrl(clearEvent: true, page: 1)"><span class="grow">@D["All events"]</span>@if (Model.EventId is null) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check", "ic menu-check")' /> }</button>
    <div class="menu-sep" role="separator"></div>
    @foreach (var option in Model.EventOptions)
    {
        <button class="menu-item" type="button" role="menuitemradio" aria-checked="@(Model.EventId == option.Id ? "true" : "false")" data-audit-url="@Model.AuditUrl(eventId: option.Id, page: 1)"><span class="grow">@option.Name</span><span class="menu-hint">@(option.IsHidden ? D["Hidden · {0}", Phase(option.State)].Value : Phase(option.State))</span>@if (Model.EventId == option.Id) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check", "ic menu-check")' /> }</button>
    }
</div>
<div class="menu" id="audit-action-menu" role="menu" aria-label="@D["Action filter"]" hidden>
    <button class="menu-item" type="button" role="menuitemradio" aria-checked="@(Model.Action.Length == 0 ? "true" : "false")" data-audit-url="@Model.AuditUrl(action: string.Empty, page: 1)"><span class="grow">@D["All actions"]</span>@if (Model.Action.Length == 0) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check", "ic menu-check")' /> }</button>
    <div class="menu-sep" role="separator"></div>
    @foreach (var area in AuditAreas.All)
    {
        var inArea = Model.Action == area.Token || specific && area.Contains(Model.Action);
        <button class="menu-item" type="button" role="menuitemradio" aria-checked="@(inArea ? "true" : "false")" data-audit-url="@Model.AuditUrl(action: area.Token, page: 1)"><span class="grow">@D[area.Label]</span>@if (specific && area.Contains(Model.Action)) { <span class="menu-hint">@D["Specific action"]</span> }@if (inArea) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check", "ic menu-check")' /> }</button>
    }
    <div class="menu-sep" role="separator"></div>
    <button class="menu-item" type="button" role="menuitem" data-audit-specific><span class="grow">@D["Specific action…"]</span></button>
</div>
<div class="fpanel au-panel" id="fpanel" role="dialog" aria-modal="false" aria-labelledby="fp-title" hidden data-audit-panel>
    <h2 class="sr" id="fp-title">@D["More filters"]</h2>
    <div class="field">
        <label class="lbl" for="fp-action">@D["Specific action"]</label>
        <div class="select-wrap"><select class="select select-field" id="fp-action">
            <option value="" selected="@(!specific)">@D["Any action"]</option>
            @foreach (var area in AuditAreas.All)
            {
                var keys = AuditPresenter.ActionLabels.Where(pair => area.Contains(pair.Key)).Select(pair => (pair.Key, Label: A[pair.Value].Value)).OrderBy(pair => pair.Label, StringComparer.CurrentCulture).ToList();
                if (keys.Count == 0) { continue; }
                <option value="" disabled>— @D[area.Label] —</option>
                @foreach (var (key, label) in keys) { <option value="@key" selected="@(specific && Model.Action == key)">@label</option> }
            }
            @if (specific && !AuditPresenter.ActionLabels.ContainsKey(Model.Action)) { <option value="@Model.Action" selected>@Model.Action</option> }
        </select><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></div>
    </div>
    <div class="field">
        <label class="lbl" for="fp-type">@D["Record type"]</label>
        <div class="select-wrap"><select class="select select-field" id="fp-type">
            <option value="" selected="@(Model.Type.Length == 0)">@D["Any record type"]</option>
            @foreach (var (key, label) in AuditPresenter.TargetLabels) { <option value="@key" selected="@(Model.Type == key)">@A[label]</option> }
        </select><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></div>
    </div>
    <div class="field" role="group" aria-labelledby="fp-dates-lbl">
        <div class="lbl" id="fp-dates-lbl">@D["Date range"] <span class="opt">· @D["Copenhagen time"]</span></div>
        <div class="fpanel-presets">@foreach (var (label, from, to) in presets) { <button class="btn btn-sm" type="button" aria-pressed="false" data-audit-preset data-from="@Day(from)" data-to="@Day(to)">@D[label]</button> }</div>
        <div class="fpanel-pair au-pair">
            <div><label class="lbl" for="fp-from">@D["From"]</label><input class="input" id="fp-from" placeholder="@D["dd mmm yyyy"]" autocomplete="off" aria-describedby="fp-date-err" value="@(Model.From is { } fromValue ? Day(fromValue) : string.Empty)"></div>
            <div><label class="lbl" for="fp-to">@D["To"]</label><input class="input" id="fp-to" placeholder="@D["dd mmm yyyy"]" autocomplete="off" aria-describedby="fp-date-err" value="@(Model.To is { } toValue ? Day(toValue) : string.Empty)"></div>
        </div>
        <div class="field-err" id="fp-date-err" hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /><span data-component-text></span></div>
        <div class="field-hint">@D["Both days are included. Leave either blank for no limit."]</div>
    </div>
    <div class="fpanel-foot">
        <button class="btn btn-sm btn-quiet" type="button" id="fp-reset" data-audit-panel-reset>@D["Reset these"]</button>
        <button class="btn btn-sm btn-primary" type="button" id="fp-apply" data-audit-panel-apply>@D["Apply"]</button>
    </div>
</div>
</div>
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-audit.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-audit.js" asp-append-version="true" data-admin-page-script></script> }
