@page
@model Bingo.Web.Pages.Admin.Audit.IndexModel
@{
    ViewData["Title"] = T["Audit log"];
}

<section class="admin-audit-page" aria-labelledby="admin-audit-title">
    <header class="admin-audit-context">
        <p class="admin-audit-eyebrow">@T["Administration"]</p>
        <h1 id="admin-audit-title">@T["Audit log"]</h1>
    </header>

    @if (Model.DroppedLinkParts) { <p class="admin-audit-empty" role="status">@T["Some filters in the link weren’t recognised."] @T["They were left out; the rest are applied."]</p> }
    <form method="get" class="admin-audit-toolbar" aria-label="@T["Audit log filters"]">
        <div class="admin-field admin-search-field admin-audit-action-field">
            <label for="audit-action">@T["Action"]</label>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
            <input id="audit-action" name="action" value="@Model.Action" type="search" class="admin-search-field-input form-control" />

        </div>
        <div class="admin-field">
            <label for="audit-actor">@T["Actor"]</label>
            <input id="audit-actor" name="actor" value="@Model.Actor" class="form-control" />

        </div>
        <div class="admin-field">
            <label for="audit-type">@T["Entity"]</label>
            <input id="audit-type" name="type" value="@Model.Type" class="form-control" />

        </div>
        <div class="admin-field">
            <label for="audit-event">@T["Event"]</label>
            <select id="audit-event" name="event" class="form-select">
                <option value="">@T["All events"]</option>
                @foreach (var eventOption in Model.EventOptions)
                {
                    <option value="@eventOption.Id" selected="@(Model.EventId == eventOption.Id)">@eventOption.Name@if (eventOption.IsHidden) { <text> (@T["Hidden"])</text> }</option>
                }
            </select>
        </div>
        <div class="admin-field">
            <label for="audit-from">@T["From"]</label>
            <input id="audit-from" name="from" value="@Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" type="date" class="form-control" />

        </div>
        <div class="admin-field">
            <label for="audit-to">@T["To"]</label>
            <input id="audit-to" name="to" value="@Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" type="date" class="form-control" />

        </div>
        <div class="admin-audit-toolbar-actions">
            <button class="admin-button-primary" type="submit">@T["Filter"]</button>
            <a class="admin-button-secondary" asp-page="Index">@T["Clear"]</a>
        </div>
    </form>

    @if (Model.EntryRequested)
    {
        <section class="admin-audit-entry" aria-labelledby="admin-audit-entry-title">
            @if (Model.EntryUnavailable)
            {
                <div class="admin-audit-empty" role="status">
                    <h2 id="admin-audit-entry-title">@T["This entry isn't available"]</h2>
                    <p>@T["The entry may be missing or unavailable for this account."]</p>
                </div>
            }
            else if (Model.SelectedEntry is { } selectedEntry)
            {
                <header class="admin-audit-surface-heading">
                    <div>
                        <p class="admin-audit-eyebrow">@T["Audit entry"]</p>
                        <h2 id="admin-audit-entry-title">@DateTimePresentation.Format(selectedEntry.OccurredAt, "dd MMM yyyy, HH:mm", provider: CultureInfo.CurrentCulture)</h2>
                    </div>
                </header>
                <partial name="/Pages/Shared/_AuditEntry.cshtml" model="selectedEntry" />
            }
        </section>
    }

    <section class="admin-audit-surface" aria-labelledby="admin-audit-entries-title">
        <header class="admin-audit-surface-heading">
            <div>
                <h2 id="admin-audit-entries-title">@T["Audit entries"]</h2>
                <p>@T["Administrative history, ordered newest first."]</p>
            </div>
            <span class="admin-audit-page-indicator">@T["Page {0}", Model.PageNumber]</span>
        </header>

        @if (Model.Entries.Count == 0)
        {
            <div class="admin-audit-empty" role="status">
                <h3>@T["No audit entries found"]</h3>
                <p>@T["Try clearing one or more filters to inspect the complete stream."]</p>
            </div>
        }
        else
        {
            <div class="admin-audit-table-wrap">
                <table class="admin-audit-table">
                    <thead>
                        <tr>
                            <th scope="col">@T["Time"]</th>
                            <th scope="col">@T["Details"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td data-label="Time">@DateTimePresentation.Format(entry.OccurredAt, "dd MMM yyyy, HH:mm", provider: CultureInfo.CurrentCulture)</td>
                            <td data-label="Details">
                                <partial name="_AuditEntry" model="entry" />
                                <a class="admin-audit-entry-link" href="@Model.AuditUrl(entry: entry.Id)">@T["Open entry"]</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <nav class="admin-audit-pagination" aria-label="@T["Audit log pages"]">
        @if (Model.PageNumber > 1)
        {
            <a class="admin-button-secondary" href="@Model.AuditUrl(page: Model.PageNumber - 1)">@T["Previous"]</a>
        }
        else
        {
            <span class="admin-audit-page-link is-disabled" aria-disabled="true">@T["Previous"]</span>
        }
        <span class="admin-audit-page-count">@T["Page {0}", Model.PageNumber]</span>
        @if (Model.HasNextPage)
        {
            <a class="admin-button-secondary" href="@Model.AuditUrl(page: Model.PageNumber + 1)">@T["Next"]</a>
        }
        else
        {
            <span class="admin-audit-page-link is-disabled" aria-disabled="true">@T["Next"]</span>
        }
    </nav>
</section>
