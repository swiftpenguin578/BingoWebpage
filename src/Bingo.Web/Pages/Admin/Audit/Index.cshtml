@page
@model Bingo.Web.Pages.Admin.Audit.IndexModel
@{
    ViewData["Title"] = "Audit log";
}

<section class="table-page">
    <div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Audit log</h1></div></div>
    <form method="get" class="panel filter-row">
        <div><label asp-for="Action"></label><input asp-for="Action" class="form-control" /></div>
        <div><label asp-for="Actor"></label><input asp-for="Actor" class="form-control" /></div>
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-light" asp-page="Index">Clear</a>
    </form>
    <div class="table-wrap panel">
        <table>
            <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Target</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.OccurredAt.ToLocalTime().ToString("g")</td>
                    <td>@entry.ActorUsername</td>
                    <td><code>@entry.Action</code></td>
                    <td>@entry.TargetType @entry.TargetId</td>
                    <td>@entry.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
