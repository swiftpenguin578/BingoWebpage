@page
@model Bingo.Web.Pages.Admin.Accounts.IndexModel
@using Bingo.Domain.Access
@{
    ViewData["Title"] = T["Accounts / Roles"];
    ViewData["AdminPageDescription"] = T["Manage website accounts and roles."];
    string RoleLabel(GlobalRole role) => role switch
    {
        GlobalRole.SuperAdmin => T["Super Admin"].Value,
        GlobalRole.Admin => T["Admin"].Value,
        _ => T["User"].Value
    };
}

<section class="admin-accounts-page">
    <section class="admin-accounts-section" data-admin-account-section="website" aria-labelledby="website-accounts-heading">
        <div class="admin-events-directory-controls">
            <form class="admin-events-toolbar" method="get" asp-page="./Index" data-admin-account-filter="website">
                <div class="admin-search-field">
                    <label class="visually-hidden" for="website-account-search">@T["Search accounts"]</label>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                    <input id="website-account-search" class="admin-search-field-input form-control" type="search" name="WebsiteSearch" value="@Model.WebsiteSearch" placeholder="@T["Search accounts…"]" />
                    <button class="admin-search-clear" type="button" data-admin-search-clear aria-label="@T["Clear account search"]" hidden="@(string.IsNullOrWhiteSpace(Model.WebsiteSearch) ? "hidden" : null)"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg></button>
                </div>
                <div class="admin-events-state-filter admin-field">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                    <label for="website-account-role">@T["Role:"]</label>
                    <div class="admin-events-state-select">
                        <select id="website-account-role" class="admin-filter-select form-select" name="WebsiteRole" data-admin-account-role>
                            <option value="">@T["Any role"]</option>
                            @foreach (var role in Enum.GetValues<GlobalRole>())
                            {
                                <option value="@role" selected="@(Model.WebsiteRole == role ? "selected" : null)">@RoleLabel(role)</option>
                            }
                        </select>
                        <svg class="admin-events-state-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                    </div>
                </div>
                <button class="visually-hidden" type="submit">@T["Search accounts"]</button>
            </form>
            <div class="admin-accounts-actions">
                @if (User.IsInRole(nameof(GlobalRole.SuperAdmin)))
                {
                    <a class="admin-button-secondary" asp-page="Transfer">@T["Transfer ownership"]</a>
                }
            </div>
        </div>
        <div class="admin-accounts-table-wrap">
            <header class="admin-accounts-section-heading">
                <div><h2 id="website-accounts-heading">@T["Website accounts"]</h2><p>@T["Normal website identities and their global roles."]</p></div>
            </header>
            <div class="admin-events-table-scroll">
                <table class="event-table admin-accounts-table admin-accounts-website-table">
                    <colgroup>
                        <col class="admin-accounts-col-account" />
                        <col class="admin-accounts-col-role" />
                        <col class="admin-accounts-col-state" />
                        <col class="admin-accounts-col-discord" />
                        <col class="admin-accounts-col-last-login" />
                        <col class="admin-accounts-col-event-roles" />
                        <col class="admin-accounts-col-actions" />
                    </colgroup>
                    <thead><tr><th><span class="admin-accounts-table-header-label">@T["Account"]</span></th><th><span class="admin-accounts-table-header-label">@T["Role"]</span></th><th><span class="admin-accounts-table-header-label">@T["State"]</span></th><th><span class="admin-accounts-table-header-label">@T["Discord"]</span></th><th><span class="admin-accounts-table-header-label">@T["Last login"]</span></th><th><span class="admin-accounts-table-header-label">@T["Current event roles"]</span></th><th><span class="admin-accounts-table-header-label">@T["Actions"]</span></th></tr></thead>
                    <tbody>
                    @foreach (var account in Model.WebsiteAccounts)
                    {
                        var roleModifier = account.Role switch { GlobalRole.SuperAdmin => "is-purple", GlobalRole.Admin => "is-blue", _ => "is-muted" };
                        <tr>
                            <td data-label="Account">
                                <strong>@account.Username</strong>
                                @if (account.DiscordLinked && !string.IsNullOrWhiteSpace(account.DiscordDisplayName))
                                {
                                    <small class="admin-account-discord-name">@account.DiscordDisplayName</small>
                                }
                            </td>
                            <td data-label="Role"><span class="admin-status-pill @roleModifier">@RoleLabel(account.Role)</span></td>
                            <td data-label="State"><span class="admin-status-pill @(account.Active ? "is-green" : "is-muted")">@(account.Active ? T["Active"] : T["Disabled"])</span></td>
                            <td data-label="Discord"><span class="admin-account-discord-status @(account.DiscordLinked ? "is-linked" : "is-unlinked")">@(account.DiscordLinked ? T["Linked"] : T["Not linked"])</span></td>
                            <td data-label="Last login"><span class="admin-account-support">@(account.LastLoginAt is { } ? DateTimePresentation.Format(account.LastLoginAt.Value, "dd MMM yyyy, HH:mm", provider: CultureInfo.CurrentCulture) : T["Never"].Value)</span></td>
                            <td data-label="Current event roles"><span class="admin-account-support admin-account-ellipsis" title="@account.EventRoleSummary">@account.EventRoleSummary</span></td>
                            <td class="event-row-action" data-label="Actions"><a class="event-overview-row-action" data-account-manage-trigger="true" asp-page="Manage" asp-route-id="@account.Id">@T["Manage"]</a></td>
                        </tr>
                    }
                    @if (!Model.WebsiteAccounts.Any()) { <tr><td class="admin-accounts-empty" colspan="7">@T["No website accounts match this search or role."]</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="admin-accounts-pager">
            @if (Model.WebsitePage > 1) { <a class="admin-button-secondary" asp-route-WebsiteSearch="@Model.WebsiteSearch" asp-route-WebsiteRole="@Model.WebsiteRole" asp-route-WebsitePage="@(Model.WebsitePage - 1)">@T["Previous website accounts"]</a> }
            @if (Model.WebsiteHasNextPage) { <a class="admin-button-secondary" asp-route-WebsiteSearch="@Model.WebsiteSearch" asp-route-WebsiteRole="@Model.WebsiteRole" asp-route-WebsitePage="@(Model.WebsitePage + 1)">@T["Next website accounts"]</a> }
        </div>
    </section>

</section>

@section Scripts {
    <script src="~/js/account-manage-dialog.js" asp-append-version="true"></script>
}
