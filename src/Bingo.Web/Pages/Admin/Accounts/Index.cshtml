@page
@model Bingo.Web.Pages.Admin.Accounts.IndexModel
@using Bingo.Domain.Access
@{ ViewData["Title"] = "Accounts"; }
<section class="table-page">
    <div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Accounts</h1><p>Website accounts and emergency credentials have separate filters and pagination.</p></div><div class="button-row"><a class="btn action-accent-outline" asp-page="Create">Create emergency credential</a>@if(User.IsInRole(nameof(GlobalRole.SuperAdmin))){<a class="btn btn-outline-light" asp-page="Transfer">Transfer ownership</a>}</div></div>
    <section class="panel"><h2>Website accounts</h2><form method="get" class="filter-row"><label>Search public username<input name="WebsiteSearch" value="@Model.WebsiteSearch" class="form-control" /></label><label>Role<select name="WebsiteRole" class="form-control"><option value="">Any role</option>@foreach(var role in Enum.GetValues<GlobalRole>()){<option value="@role" selected="@(Model.WebsiteRole == role)">@role</option>}</select></label><label>State<select name="WebsiteState" class="form-control"><option value="">Any state</option><option value="active" selected="@(Model.WebsiteState == "active")">Active</option><option value="disabled" selected="@(Model.WebsiteState == "disabled")">Disabled</option></select></label><label>Discord<select name="WebsiteDiscord" class="form-control"><option value="">Any link state</option><option value="linked" selected="@(Model.WebsiteDiscord == "linked")">Linked</option><option value="unlinked" selected="@(Model.WebsiteDiscord == "unlinked")">Unlinked</option></select></label><label>Event<select name="WebsiteEventId" class="form-control"><option value="">Any event</option>@foreach(var item in Model.Events){<option value="@item.Id" selected="@(Model.WebsiteEventId == item.Id)">@item.Name</option>}</select></label><input type="hidden" name="EmergencySearch" value="@Model.EmergencySearch"/><input type="hidden" name="EmergencyEventId" value="@Model.EmergencyEventId"/><input type="hidden" name="EmergencyTeamId" value="@Model.EmergencyTeamId"/><input type="hidden" name="EmergencySetup" value="@Model.EmergencySetup"/><input type="hidden" name="EmergencyState" value="@Model.EmergencyState"/><input type="hidden" name="EmergencyCutoff" value="@Model.EmergencyCutoff"/><input type="hidden" name="EmergencyPage" value="@Model.EmergencyPage"/><button class="btn btn-outline-light">Apply</button></form>
    <div class="table-wrap"><table><thead><tr><th>Username</th><th>Role</th><th>State</th><th>Discord</th><th>Last login</th><th>Current event roles</th><th></th></tr></thead><tbody>@foreach(var account in Model.WebsiteAccounts){<tr><td>@account.Username</td><td>@account.Role</td><td>@(account.Active ? "Active" : "Disabled")</td><td>@(account.DiscordLinked ? "Linked" : "Unlinked")</td><td>@(account.LastLoginAt?.ToLocalTime().ToString("g") ?? "Never")</td><td>@account.EventRoleSummary</td><td><a asp-page="Manage" asp-route-id="@account.Id">Details</a></td></tr>}@if(!Model.WebsiteAccounts.Any()){<tr><td colspan="7">No website accounts match these filters.</td></tr>}</tbody></table></div>
    <div class="button-row">@if(Model.WebsitePage>1){<a class="btn btn-outline-light" asp-route-WebsiteSearch="@Model.WebsiteSearch" asp-route-WebsiteRole="@Model.WebsiteRole" asp-route-WebsiteState="@Model.WebsiteState" asp-route-WebsiteDiscord="@Model.WebsiteDiscord" asp-route-WebsiteEventId="@Model.WebsiteEventId" asp-route-WebsitePage="@(Model.WebsitePage-1)" asp-route-EmergencySearch="@Model.EmergencySearch" asp-route-EmergencyEventId="@Model.EmergencyEventId" asp-route-EmergencyTeamId="@Model.EmergencyTeamId" asp-route-EmergencySetup="@Model.EmergencySetup" asp-route-EmergencyState="@Model.EmergencyState" asp-route-EmergencyCutoff="@Model.EmergencyCutoff" asp-route-EmergencyPage="@Model.EmergencyPage">Previous website accounts</a>}@if(Model.WebsiteHasNextPage){<a class="btn btn-outline-light" asp-route-WebsiteSearch="@Model.WebsiteSearch" asp-route-WebsiteRole="@Model.WebsiteRole" asp-route-WebsiteState="@Model.WebsiteState" asp-route-WebsiteDiscord="@Model.WebsiteDiscord" asp-route-WebsiteEventId="@Model.WebsiteEventId" asp-route-WebsitePage="@(Model.WebsitePage+1)" asp-route-EmergencySearch="@Model.EmergencySearch" asp-route-EmergencyEventId="@Model.EmergencyEventId" asp-route-EmergencyTeamId="@Model.EmergencyTeamId" asp-route-EmergencySetup="@Model.EmergencySetup" asp-route-EmergencyState="@Model.EmergencyState" asp-route-EmergencyCutoff="@Model.EmergencyCutoff" asp-route-EmergencyPage="@Model.EmergencyPage">Next website accounts</a>}</div></section>
    <section class="panel"><h2>Emergency credentials</h2><form method="get" class="filter-row"><label>Search login username<input name="EmergencySearch" value="@Model.EmergencySearch" class="form-control"/></label><label>Event<select name="EmergencyEventId" class="form-control"><option value="">Any event</option>@foreach(var item in Model.Events){<option value="@item.Id" selected="@(Model.EmergencyEventId == item.Id)">@item.Name</option>}</select></label><label>Team ID<input name="EmergencyTeamId" value="@Model.EmergencyTeamId" class="form-control"/></label><label>Setup<select name="EmergencySetup" class="form-control"><option value="">Any</option><option value="complete" selected="@(Model.EmergencySetup == "complete")">Complete</option><option value="pending" selected="@(Model.EmergencySetup == "pending")">Pending</option></select></label><label>State<select name="EmergencyState" class="form-control"><option value="">Any</option><option value="enabled" selected="@(Model.EmergencyState == "enabled")">Enabled</option><option value="disabled" selected="@(Model.EmergencyState == "disabled")">Disabled</option></select></label><label>Cutoff<select name="EmergencyCutoff" class="form-control"><option value="">Any</option><option value="open" selected="@(Model.EmergencyCutoff == "open")">Not cutoff</option><option value="cutoff" selected="@(Model.EmergencyCutoff == "cutoff")">Cutoff disabled</option></select></label><input type="hidden" name="WebsiteSearch" value="@Model.WebsiteSearch"/><input type="hidden" name="WebsiteRole" value="@Model.WebsiteRole"/><input type="hidden" name="WebsiteState" value="@Model.WebsiteState"/><input type="hidden" name="WebsiteDiscord" value="@Model.WebsiteDiscord"/><input type="hidden" name="WebsiteEventId" value="@Model.WebsiteEventId"/><input type="hidden" name="WebsitePage" value="@Model.WebsitePage"/><button class="btn btn-outline-light">Apply</button></form>
    <div class="table-wrap"><table><thead><tr><th>Login username</th><th>Event</th><th>Team</th><th>Setup</th><th>Enabled</th><th>Cutoff</th><th>Last login</th><th></th></tr></thead><tbody>@foreach(var account in Model.EmergencyCredentials){<tr><td>@account.Username</td><td>@account.EventName</td><td>@account.TeamName</td><td>@(account.SetupComplete ? "Complete" : "Pending")</td><td>@(account.Enabled ? "Enabled" : "Disabled")</td><td>@(account.CutoffDisabled ? "Disabled at cutoff" : "Open")</td><td>@(account.LastLoginAt?.ToLocalTime().ToString("g") ?? "Never")</td><td><a asp-page="Manage" asp-route-id="@account.Id">Details</a></td></tr>}@if(!Model.EmergencyCredentials.Any()){<tr><td colspan="8">No emergency credentials match these filters.</td></tr>}</tbody></table></div>
    <div class="button-row">@if(Model.EmergencyPage>1){<a class="btn btn-outline-light" asp-route-WebsiteSearch="@Model.WebsiteSearch" asp-route-WebsiteRole="@Model.WebsiteRole" asp-route-WebsiteState="@Model.WebsiteState" asp-route-WebsiteDiscord="@Model.WebsiteDiscord" asp-route-WebsiteEventId="@Model.WebsiteEventId" asp-route-WebsitePage="@Model.WebsitePage" asp-route-EmergencySearch="@Model.EmergencySearch" asp-route-EmergencyEventId="@Model.EmergencyEventId" asp-route-EmergencyTeamId="@Model.EmergencyTeamId" asp-route-EmergencySetup="@Model.EmergencySetup" asp-route-EmergencyState="@Model.EmergencyState" asp-route-EmergencyCutoff="@Model.EmergencyCutoff" asp-route-EmergencyPage="@(Model.EmergencyPage-1)">Previous emergency credentials</a>}@if(Model.EmergencyHasNextPage){<a class="btn btn-outline-light" asp-route-WebsiteSearch="@Model.WebsiteSearch" asp-route-WebsiteRole="@Model.WebsiteRole" asp-route-WebsiteState="@Model.WebsiteState" asp-route-WebsiteDiscord="@Model.WebsiteDiscord" asp-route-WebsiteEventId="@Model.WebsiteEventId" asp-route-WebsitePage="@Model.WebsitePage" asp-route-EmergencySearch="@Model.EmergencySearch" asp-route-EmergencyEventId="@Model.EmergencyEventId" asp-route-EmergencyTeamId="@Model.EmergencyTeamId" asp-route-EmergencySetup="@Model.EmergencySetup" asp-route-EmergencyState="@Model.EmergencyState" asp-route-EmergencyCutoff="@Model.EmergencyCutoff" asp-route-EmergencyPage="@(Model.EmergencyPage+1)">Next emergency credentials</a>}</div></section>
</section>
