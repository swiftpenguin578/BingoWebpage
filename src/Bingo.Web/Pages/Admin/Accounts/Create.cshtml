@page
@model Bingo.Web.Pages.Admin.Accounts.CreateModel
@using Bingo.Domain.Access
@{
    ViewData["Title"] = "Create account";
}

<section class="form-page wide-form">
    <p class="eyebrow">Account management</p>
    <h1>Create account</h1>
    <p class="form-intro">Emergency captain credentials are separate disabled logins, each restricted to one active team in an event. The captain sets the password through a one-time setup link, then an Admin enables the credential.</p>
    <form method="get" class="panel filter-row">
        <label for="event-selection">Event</label><select id="event-selection" name="eventId" asp-items="Model.Events" class="form-select"><option value="">Choose event</option></select>
        <button class="btn btn-outline-light" type="submit">Show teams</button>
    </form>
    <form method="post" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.Username"></label><input asp-for="Input.Username" class="form-control" /><span asp-validation-for="Input.Username" class="field-error"></span>
        <input asp-for="Input.EventId" type="hidden" />
        @if (Model.Events.SingleOrDefault(item => item.Value == Model.Input.EventId?.ToString()) is { } selectedEvent)
        {
            <p class="form-hint">Selected event: @selectedEvent.Text. Access begins at the event start, has full submission access through the submission cutoff, and is disabled at that cutoff. If an Admin deliberately re-enables it afterward, it has correction-only access.</p>
        }
        else
        {
            <p class="form-hint">Choose an event above to load its active teams.</p>
        }
        <label asp-for="Input.TeamId"></label><select asp-for="Input.TeamId" class="form-select"><option value="">Choose team</option>@foreach(var team in Model.Teams){<option value="@team.Id">@team.Name</option>}</select><span asp-validation-for="Input.TeamId" class="field-error"></span>
        <div class="button-row"><button class="btn btn-primary" type="submit">Create</button><a class="btn btn-outline-light" asp-page="Index">Cancel</a></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.querySelector('form[method="get"] select').addEventListener('change', event => event.currentTarget.form.requestSubmit());</script> }
