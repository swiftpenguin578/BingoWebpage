@page
@model Bingo.Web.Pages.Admin.Tiles.IndexModel
@using Bingo.Domain.Boards
@{ViewData["Title"]="Tile templates";}
<section class="table-page"><p class="eyebrow">Board catalogue</p><h1>Tile templates</h1><form method="post" class="panel form-stack"><h2>Create tile</h2><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control"/><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="form-control"></textarea><label asp-for="Input.ObjectiveType"></label><select asp-for="Input.ObjectiveType" asp-items="Html.GetEnumSelectList<ObjectiveType>()" class="form-select"></select><label asp-for="Input.EvidenceInstructions"></label><textarea asp-for="Input.EvidenceInstructions" class="form-control"></textarea><label asp-for="Input.ManualEhb"></label><input asp-for="Input.ManualEhb" class="form-control"/><button class="btn btn-primary">Create tile</button></form><div class="table-wrap panel"><table><thead><tr><th>Name</th><th>Type</th><th>EHB override</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var tile in Model.Tiles){<tr><td>@tile.Name</td><td>@tile.Type</td><td>@(tile.Ehb?.ToString()??"Calculated")</td><td>@(tile.Active?"Active":"Inactive")</td><td><a asp-page="Requirements" asp-route-id="@tile.Id">Edit</a> <form method="post" asp-page-handler="Toggle" class="inline-form"><input type="hidden" name="tileId" value="@tile.Id"/><button class="btn btn-sm btn-warning">@(tile.Active?"Deactivate":"Reactivate")</button></form></td></tr>}</tbody></table></div></section>
