@page
@model Bingo.Web.Pages.Admin.PublicUiModel
@{
    Layout = null;
    ViewData["Title"] = T["Public UI Catalogue"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DKLegacy Admin</title>
    <link rel="stylesheet" href="~/css/site.transitional.foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.public-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.transitional.application.css" asp-append-version="true" />
</head>
<body class="public-ui-catalogue-document">
    <main class="public-ui-catalogue-page">
        <header class="public-ui-header" aria-label="@T["Public header specimen"]">
            <a class="public-ui-header-brand" href="/Admin/PublicUi" aria-label="@T["DK Legacy home"]">
                <img class="public-ui-header-brand-mark" src="/images/branding/dk-legacy-public-mark.png" alt="" />
                <span>DK Legacy</span>
            </a>
            <nav class="public-ui-header-nav" aria-label="@T["Public navigation"]">
                <a class="public-ui-header-nav-link is-current" href="/Admin/PublicUi" aria-current="page">@T["Events"]</a>
                <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["Account"]</a>
                <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["How to"]</a>
                <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["Admin"]</a>
            </nav>
            <div class="public-ui-header-actions" aria-label="@T["Header utilities"]">
                <span class="public-ui-header-icon" role="img" aria-label="@T["7 notifications"]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M10.268 21a2 2 0 0 0 3.464 0" /><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></svg>
                    <span class="public-ui-header-notification">7</span>
                </span>
                <span class="public-ui-header-icon" role="img" aria-label="@T["Settings"]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>
                </span>
            </div>
        </header>
        <section class="public-ui-header-catalogue-state">
            <span class="public-ui-header-catalogue-label">@T["Integrated event header"]</span>
            <header class="public-ui-header public-ui-header--integrated" aria-label="@T["Integrated public event header specimen"]">
                <div class="public-ui-header-primary">
                    <a class="public-ui-header-brand" href="/Admin/PublicUi" aria-label="@T["OSRS Community Bingo home"]">
                        <img class="public-ui-header-brand-mark" src="/images/branding/dk-legacy-public-mark.png" alt="" />
                    </a>
                    <nav class="public-ui-header-nav" aria-label="@T["Public navigation"]">
                        <a class="public-ui-header-nav-link is-current" href="/Admin/PublicUi" aria-current="page">@T["Events"]</a>
                        <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["Account"]</a>
                        <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["How to"]</a>
                        <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["Admin"]</a>
                    </nav>
                    <div class="public-ui-header-actions" aria-label="@T["Header utilities"]">
                        <details class="public-ui-header-menu" data-public-ui-popover>
                            <summary class="public-ui-header-icon public-ui-header-menu-trigger" aria-label="@T["Open navigation"]">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                            </summary>
                            <div class="public-ui-header-menu-panel">
                                <a class="public-ui-header-nav-link" href="/Admin/PublicUi" aria-current="page">@T["Events"]</a>
                                <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["Account"]</a>
                                <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["How to"]</a>
                                <a class="public-ui-header-nav-link" href="/Admin/PublicUi">@T["Admin"]</a>
                            </div>
                        </details>
                        <div class="public-ui-header-popover">
                            <details open data-public-ui-popover>
                                <summary class="public-ui-header-icon" aria-label="@T["Notifications"]">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M10.268 21a2 2 0 0 0 3.464 0" /><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></svg>
                                    <span class="public-ui-header-notification">7</span>
                                </summary>
                                <div class="public-ui-header-popover__panel public-ui-header-popover__panel--notifications">
                                    <div class="public-ui-header-popover__heading"><strong class="public-ui-section-heading">@T["Notifications"]</strong><span class="public-ui-supporting-text">@T["Personal {0}", 3]</span></div>
                                    <div class="public-ui-header-popover__list">
                                        <a class="public-ui-header-popover__item" href="/Admin/PublicUi"><strong class="public-ui-section-heading">@T["Drop approved"]</strong><span class="public-ui-supporting-text">@T["Your screenshot was approved."]</span></a>
                                        <a class="public-ui-header-popover__item" href="/Admin/PublicUi"><strong class="public-ui-section-heading">@T["New event"]</strong><span class="public-ui-supporting-text">@T["A new bingo event is ready."]</span></a>
                                    </div>
                                    <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" href="/Admin/PublicUi">@T["View all notifications"]</a>
                                </div>
                            </details>
                        </div>
                        <div class="public-ui-header-popover">
                            <details open data-public-ui-popover>
                                <summary class="public-ui-header-icon" aria-label="@T["Settings"]">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>
                                </summary>
                                <div class="public-ui-header-popover__panel public-ui-header-popover__panel--settings">
                                    <strong class="public-ui-header-popover__heading public-ui-section-heading">@T["Settings"]</strong>
                                    <label class="public-ui-header-popover__field"><span class="public-ui-role-label">@T["Language"]</span><span class="public-ui-header-popover__select"><select class="public-ui-control-visual public-ui-control-visual--select" aria-label="@T["Language"]"><option>@T["English"]</option><option>@T["Dansk"]</option></select><span class="public-ui-select-chevron" aria-hidden="true"></span></span></label>
                                    <div class="public-ui-header-popover__account"><span class="public-ui-supporting-text">@T["Signed in as"]</span><strong class="public-ui-section-heading">RuneWarden</strong></div>
                                    <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" href="/Admin/PublicUi">@T["Account settings"]</a>
                                    <a class="public-ui-header-popover__action public-ui-action public-ui-action--text public-ui-action--compact" href="/Admin/PublicUi">@T["Sign out"]</a>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>
                <nav class="public-ui-header-context-nav" aria-label="@T["Event navigation"]">
                    <a class="public-ui-header-context-link is-current" href="/Admin/PublicUi" aria-current="page">@T["View bingo"]</a>
                    <a class="public-ui-header-context-link" href="/Admin/PublicUi">@T["Recent drops"]</a>
                    <a class="public-ui-header-context-link" href="/Admin/PublicUi">@T["Leaderboards"]</a>
                </nav>
            </header>
        </section>
        <section class="public-ui-page-width--compact" aria-labelledby="compact-page-masthead-title">
            <span class="public-ui-catalogue-specimen-label">@T["Public page masthead · compact 38rem"]</span>
            <div class="public-ui-page-masthead public-ui-page-masthead--borderless">
                <header class="public-ui-component-header">
                    <div class="public-ui-component-header__copy">
                        <span class="public-ui-overline">@T["Account security"]</span>
                        <h2 id="compact-page-masthead-title" class="public-ui-component-title">@T["Change password"]</h2>
                        <p class="public-ui-supporting-text">@T["Keep your account secure with a new password."]</p>
                    </div>
                </header>
            </div>
        </section>
        <section class="public-ui-page-width--signup" aria-labelledby="signup-page-masthead-title">
            <span class="public-ui-catalogue-specimen-label">@T["Public page masthead · signup 48rem"]</span>
            <div class="public-ui-page-masthead">
                <header class="public-ui-component-header">
                    <div class="public-ui-component-header__copy">
                        <span class="public-ui-overline">@T["Event signup"]</span>
                        <h2 id="signup-page-masthead-title" class="public-ui-component-title">TEST 16 — Signup lookup</h2>
                        <p class="public-ui-supporting-text">@T["Choose an account and continue your event signup."]</p>
                    </div>
                </header>
                <aside aria-label="@T["Signup metadata"]">
                    <span class="public-ui-state public-ui-state--information">@T["Signups open"]</span>
                    <span class="public-ui-supporting-text">@T["Closes 6 Sep 2026"]</span>
                </aside>
            </div>
        </section>
        <section class="public-ui-page-width--wide" aria-labelledby="wide-page-masthead-title">
            <span class="public-ui-catalogue-specimen-label">@T["Public page masthead · wide 80rem"]</span>
            <div class="public-ui-page-masthead">
                <header class="public-ui-component-header">
                    <div class="public-ui-component-header__copy">
                        <h2 id="wide-page-masthead-title" class="public-ui-component-title">@T["Follow every team, tile and drop."]</h2>
                        <p class="public-ui-supporting-text">@T["Open an event to see how every team is doing, then choose a team to view their board and completed tiles."]</p>
                    </div>
                </header>
                <aside aria-label="@T["Event actions"]">
                    <span class="public-ui-state public-ui-state--success">@T["Live now"]</span>
                    <a class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" href="/Admin/PublicUi">@T["View event"]</a>
                </aside>
            </div>
        </section>
        <section class="public-ui-page-width--wide" aria-labelledby="home-hero-specimen-title">
            <span class="public-ui-catalogue-specimen-label">@T["Homepage landing hero"]</span>
            <div class="public-ui-home-hero">
                <div class="public-ui-page-width--wide">
                    <header class="public-ui-component-header">
                        <div class="public-ui-component-header__copy">
                            <img class="public-ui-header-brand-mark" src="/images/branding/dk-legacy-public-mark.png" alt="" />
                            <h2 id="home-hero-specimen-title" class="public-ui-component-title">DK Legacy Bingo</h2>
                            <p class="public-ui-supporting-text">@T["The dedicated home for DK Legacy bingo events—follow live boards, reviewed submissions, and rankings from one place."]</p>
                        </div>
                        <div class="public-ui-action-list">
                            <a class="public-ui-action public-ui-action--commit" href="#public-event-directory-heading">@T["View events"]</a>
                            <a class="public-ui-action public-ui-action--standard" href="/Account/Login">@T["Sign in"]</a>
                        </div>
                    </header>
                    <div class="public-ui-data-group">
                        <article><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M3 15h18M9 3v18M15 3v18" /></svg><h3 class="public-ui-section-heading">@T["Live boards"]</h3><p class="public-ui-supporting-text">@T["Follow every team's tile progress as the event unfolds."]</p></article>
                        <article><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18H6z" /><path d="m9 13 2 2 4-5" /><path d="M9 7h6" /></svg><h3 class="public-ui-section-heading">@T["Reviewed submissions"]</h3><p class="public-ui-supporting-text">@T["Browse approved drops and the evidence behind completed tiles."]</p></article>
                        <article><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16" /><path d="M8 16v-5M12 16V8M16 16v-8" /></svg><h3 class="public-ui-section-heading">@T["Rankings and stats"]</h3><p class="public-ui-supporting-text">@T["Compare teams and players through progress, Drop EHB, and EHB."]</p></article>
                    </div>
                </div>
            </div>
        </section>
        <section class="public-ui-catalogue-specimen public-ui-page-width--wide" aria-labelledby="three-column-data-group-heading">
            <span class="public-ui-catalogue-specimen-label">@T["Three-column data group"]</span>
            <h2 id="three-column-data-group-heading" class="public-ui-section-heading">@T["Responsive nested items"]</h2>
            <div class="public-ui-data-group public-ui-data-group--three-column">
                <article class="public-ui-nested-container"><h3 class="public-ui-section-heading">@T["Captain"]</h3><p class="public-ui-supporting-text">RuneWarden</p></article>
                <article class="public-ui-nested-container"><h3 class="public-ui-section-heading">@T["CoCaptain"]</h3><p class="public-ui-supporting-text">MapleRune</p></article>
                <article class="public-ui-nested-container"><h3 class="public-ui-section-heading">@T["Participant"]</h3><p class="public-ui-supporting-text">Oakfire</p></article>
            </div>
        </section>
        <section class="public-ui-catalogue-specimen public-ui-page-width--compact" aria-labelledby="static-dialog-heading">
            <span class="public-ui-catalogue-specimen-label">@T["Static route counterpart"]</span>
            <section class="public-ui-dialog-page public-ui-dialog-page--inset" aria-labelledby="static-dialog-heading">
                <header class="public-ui-dialog__header public-ui-component-header">
                    <div class="public-ui-component-header__copy">
                        <h2 id="static-dialog-heading" class="public-ui-component-title">@T["Standalone password form"]</h2>
                    </div>
                </header>
                <div class="public-ui-dialog__content">
                    <form class="public-ui-page-form">
                        <label><span class="public-ui-role-label">@T["Current password"]</span><input class="public-ui-control-visual" type="password" autocomplete="current-password" /></label>
                        <div class="public-ui-divider" role="separator"></div>
                        <label><span class="public-ui-role-label">@T["New password"]</span><input class="public-ui-control-visual" type="password" autocomplete="new-password" /></label>
                        <label><span class="public-ui-role-label">@T["Confirm password"]</span><input class="public-ui-control-visual" type="password" autocomplete="new-password" /></label>
                        <div class="public-ui-dialog__actions"><button type="button" class="public-ui-action public-ui-action--commit">@T["Update password"]</button></div>
                    </form>
                </div>
            </section>
        </section>
        <section class="public-ui-catalogue-specimen public-ui-page-width--wide" aria-labelledby="public-discovery-heading">
            <span class="public-ui-catalogue-specimen-label">@T["Public discovery and signup page widths"]</span>
            <header class="public-ui-component-header"><div class="public-ui-component-header__copy"><span class="public-ui-overline">@T["Event discovery"]</span><h2 id="public-discovery-heading" class="public-ui-component-title">@T["Follow every team, tile and drop."]</h2><p class="public-ui-supporting-text">@T["Wide discovery uses the shared public surface hierarchy."]</p></div></header>
            <div class="public-ui-surface public-ui-surface--flat public-ui-sectioned-surface"><div class="public-ui-sectioned-surface__section"><strong class="public-ui-component-title">@T["Signup-open event"]</strong><span class="public-ui-supporting-text">@T["The same shared form shell narrows to 48rem."]</span><a class="public-ui-action public-ui-action--commit" href="/Admin/PublicUi">@T["Sign up"]</a></div></div>
        </section>
        <section class="public-ui-catalogue-specimen public-ui-catalogue-specimen--wide public-ui-page-width--wide" aria-labelledby="public-event-directory-heading">
            <span class="public-ui-catalogue-specimen-label">@T["Homepage event directory rows"]</span>
            <h2 id="public-event-directory-heading" class="public-ui-section-heading">@T["Lifecycle entries"]</h2>
            <div class="public-ui-surface public-ui-surface--flat public-ui-sectioned-surface" aria-label="@T["Event directory examples"]">
                <a class="public-ui-event-directory-row" href="/Admin/PublicUi"><span class="public-ui-state public-ui-state--success">@T["Live now"]</span><span class="public-ui-component-header__copy"><strong class="public-ui-component-title">TEST 15 — DKL Live</strong><span class="public-ui-supporting-text">@T["6 teams · Ends 3 Aug 2026, 18:00"]</span></span><span class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact">@T["View board"]</span></a>
                <a class="public-ui-event-directory-row" href="/Admin/PublicUi"><span class="public-ui-state public-ui-state--information">@T["Signups open"]</span><span class="public-ui-component-header__copy"><strong class="public-ui-component-title">TEST 16 — Signup lookup</strong><span class="public-ui-supporting-text">@T["24 confirmed of 30 · 3 waiting · Closes 25 Aug 2026, 18:00"]</span></span><span class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact">@T["Sign up"]</span></a>
                <a class="public-ui-event-directory-row" href="/Admin/PublicUi"><span class="public-ui-state public-ui-state--neutral">@T["Board published"]</span><span class="public-ui-component-header__copy"><strong class="public-ui-component-title">TEST 17 — Upcoming board</strong><span class="public-ui-supporting-text">@T["5 × 5 board · 4 teams · Starts 1 Sep 2026, 18:00"]</span></span><span class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact">@T["View board"]</span></a>
                <a class="public-ui-event-directory-row" href="/Admin/PublicUi"><span class="public-ui-state public-ui-state--neutral">@T["Archived"]</span><span class="public-ui-component-header__copy"><strong class="public-ui-component-title">TEST 14 — Previous event</strong><span class="public-ui-supporting-text">@T["Ended 18 Jul 2026, 18:00"]</span></span><span class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact">@T["View history"]</span></a>
            </div>
        </section>
        <section class="public-ui-catalogue-specimen public-ui-page-width--signup" aria-labelledby="signup-width-heading">
            <span class="public-ui-catalogue-specimen-label">@T["Signup form width and page form composition"]</span>
            <form class="public-ui-surface public-ui-surface--flat public-ui-sectioned-surface public-ui-page-form"><div class="public-ui-sectioned-surface__section"><h2 id="signup-width-heading" class="public-ui-section-heading">@T["Signup form"]</h2><div class="public-ui-page-form__grid"><div class="public-ui-page-form__field"><label><span class="public-ui-role-label">@T["Account"]</span><select class="public-ui-control-visual public-ui-control-visual--select"><option>@T["Choose an account"]</option></select></label><p class="public-ui-supporting-text"><a class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact" href="/Admin/PublicUi">@T["Don't see your account? Add it to My accounts"]</a></p></div><div class="public-ui-page-form__field"><label><span class="public-ui-role-label">@T["EHB (Wise Old Man)"]</span></label><div class="public-ui-page-form__inline-control public-ui-page-form__inline-control--inset-action"><input class="public-ui-control-visual" type="number" /><button type="button" class="public-ui-action public-ui-action--text public-ui-action--compact"><svg aria-hidden="true" focusable="false" viewBox="0 0 16 16"><path d="M13 6a5 5 0 0 0-8.5-1L3 6.5M3 3v3.5h3.5M3 10a5 5 0 0 0 8.5 1l1.5-1.5M13 13v-3.5H9.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg>@T["Fetch from WOM"]</button></div></div><div class="public-ui-page-form__field"><label class="public-ui-checkbox"><input type="checkbox" checked aria-label="@T["I am willing to be a captain"]" /><span class="public-ui-checkbox-mark" aria-hidden="true"></span><span class="public-ui-supporting-text">@T["I am willing to be a captain"]</span></label></div><div class="public-ui-divider public-ui-page-form__field--wide" role="separator"></div><div class="public-ui-page-form__field"><label><span class="public-ui-role-label">@T["Note"]</span><textarea class="public-ui-control-visual" rows="1"></textarea></label></div></div><div class="public-ui-action-list"><button type="button" class="public-ui-action public-ui-action--commit">@T["Sign up"]</button></div></div></form>
        </section>
        <section class="public-ui-catalogue-specimen public-ui-page-width--compact" aria-labelledby="account-character-row-heading">
            <span class="public-ui-catalogue-specimen-label">@T["Account character management row"]</span>
            <section class="public-ui-surface public-ui-surface--flat public-ui-sectioned-surface">
                <div class="public-ui-sectioned-surface__section public-ui-sectioned-surface__section--account-character public-ui-nested-container">
                    <header class="public-ui-component-header">
                        <span class="public-ui-overline">#1 <span class="public-ui-state public-ui-state--success">@T["Preferred"]</span></span>
                        <div class="public-ui-action-list" aria-label="@T["Change list order"]"><form><button type="button" class="public-ui-action public-ui-action--text public-ui-action--compact" disabled>↑</button></form><form><button type="button" class="public-ui-action public-ui-action--text public-ui-action--compact">↓</button></form></div>
                    </header>
                    <form id="catalogue-character-edit" class="public-ui-page-form">
