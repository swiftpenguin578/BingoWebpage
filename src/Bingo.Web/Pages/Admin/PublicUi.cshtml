                    </div>
                    <div class="public-ui-catalogue-submission-result-host public-ui-surface public-ui-surface--charcoal">
                        <div class="public-ui-submission-result public-ui-submission-result--failure"><span class="public-ui-state public-ui-state--error">!</span><strong class="public-ui-component-title">@T["Submission failed"]</strong><p class="public-ui-supporting-text">@T["Try again after checking the selected target."]</p><button type="button" class="public-ui-action public-ui-action--standard">@T["Okay"]</button></div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script src="~/js/public-leaderboards.js" asp-append-version="true"></script>
    <script>
        (() => {
            const toolbar = document.querySelector("[data-public-ui-recent-drops-toolbar]");
            if (!toolbar) return;
            const input = toolbar.querySelector("input[type='search']");
            const clearButton = toolbar.querySelector("[data-public-ui-recent-drops-clear]");
            if (!input || !clearButton) return;
            const syncClearButton = () => { clearButton.hidden = input.value.length === 0; };
            input.addEventListener("input", syncClearButton);
            clearButton.addEventListener("click", () => { input.value = ""; syncClearButton(); input.focus(); });
            syncClearButton();
        })();
    </script>
</body>
</html>
