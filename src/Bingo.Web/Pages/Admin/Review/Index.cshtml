@page
@model Bingo.Web.Pages.Admin.Review.IndexModel
@using Bingo.Domain.Evidence
@{ViewData["Title"]="Evidence review";}
<section class="table-page">
    <div class="page-heading">
        <div><p class="eyebrow">Active event review</p><h1>Evidence queue</h1><p>@(Model.EventId is null ? "Choose a live or final-review event" : Model.EventName)</p></div>
        <a asp-page="/Admin/Index">Administration</a>
    </div>
    @if (Model.Events.Count > 0)
    {
        <form method="get" class="panel filter-bar">
            <select name="eventId" class="form-select" aria-label="Event">
                <option value="">Choose event</option>
                @foreach (var item in Model.Events) { <option value="@item.Id" selected="@(item.Id == Model.EventId)">@item.Name</option> }
            </select>
            @if (Model.EventId is not null)
            {
                <select name="teamId" class="form-select"><option value="">All teams</option>@foreach(var t in Model.Teams){<option value="@t.Id">@t.Name</option>}</select>
                <select name="tileId" class="form-select"><option value="">All tiles</option>@foreach(var t in Model.Tiles){<option value="@t.Id">@t.Name</option>}</select>
                <select name="status" class="form-select"><option value="">All statuses</option>@foreach(var s in Enum.GetValues<SubmissionStatus>()){<option value="@s">@s</option>}</select>
            }
            <button class="btn btn-outline-light">@(Model.EventId is null ? "Open queue" : "Filter")</button>
        </form>
    }
    @if(Model.EventId is not null)
    {
        <div class="table-wrap panel"><table><thead><tr><th>Submitted</th><th>Team</th><th>Tile</th><th>Player</th><th>Status</th><th>Contribution</th><th>Code</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><a asp-page="Details" asp-route-id="@row.Id">@row.SubmittedAt.ToLocalTime().ToString("g")</a>@if(row.DuringGrace){<small class="balance-warning">After event end — verify screenshot time</small>}</td><td>@row.Team</td><td>@row.Tile</td><td>@row.Player</td><td>@row.Status</td><td>@row.Claimed@if(row.Approved>0){<text> → @row.Approved</text>}</td><td>@(row.ExpectedCode??"Disabled")</td></tr>}</tbody></table></div>
    }
</section>
