@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Review.DetailsModel
@using Bingo.Domain.Evidence
@{ViewData["Title"]=$"Review {Model.Details.Tile}";var reviewable=Model.Details.Status is SubmissionStatus.Pending or SubmissionStatus.ChangesRequested;}
<section class="table-page"><div class="page-heading"><div><p class="eyebrow">@Model.Details.Status · @Model.Details.Team</p><h1>@Model.Details.Tile</h1><p>Submitted @Model.Details.SubmittedAt.ToLocalTime().ToString("g") by @Model.Details.Player</p></div><a asp-page="Index">Back to queue</a></div>
@if(Model.ChecksumMatches.Count>0){<aside class="status-message"><strong>Possible duplicate screenshot</strong><p>This exact image checksum also appears on:</p><ul>@foreach(var match in Model.ChecksumMatches){<li><a asp-page="Details" asp-route-id="@match.Id">@match.SubmittedAt.ToLocalTime().ToString("g") · @match.Tile · @match.Status</a></li>}</ul><small>This is a warning only. Nothing is rejected automatically.</small></aside>}
<div class="review-layout"><section class="panel evidence-viewer">@if(Model.Assets.FirstOrDefault(x=>x.Active) is {} current){<button type="button" class="evidence-lightbox-trigger" onclick="document.getElementById('evidence-lightbox').showModal()"><img src="/Evidence/@current.Id" alt="Evidence screenshot"/></button><p>@current.Filename · @current.Width×@current.Height · @(current.Bytes/1024) KB · <a href="/Evidence/@current.Id" target="_blank">Open original</a></p><dialog id="evidence-lightbox" class="evidence-lightbox" onclick="if(event.target===this)this.close()"><button type="button" class="dialog-close" onclick="this.closest('dialog').close()" aria-label="Close">×</button><img src="/Evidence/@current.Id" alt="Evidence screenshot enlarged"/></dialog>}<dl><div><dt>Player who received the drop</dt><dd>@Model.Details.Player</dd></div><div><dt>Expected code</dt><dd>@(Model.Details.ExpectedCode??"Verification disabled")</dd></div><div><dt>Boss/drop</dt><dd>@(Model.Details.Drop is null?"Manual objective":$"{Model.Details.Boss} — {Model.Details.Drop}")</dd></div><div><dt>Requirement</dt><dd>@Model.Details.Requirement</dd></div><div><dt>Claimed / approved</dt><dd>@Model.Details.Claimed / @Model.Details.Approved</dd></div><div><dt>Captain requested privacy</dt><dd>@(Model.Details.PublicPrivacyRequested?"Yes — hidden automatically on approval":"No")</dd></div><div><dt>Captain note</dt><dd>@Model.Details.CaptainNote</dd></div></dl></section>
<aside class="form-stack">@if(reviewable){<form method="post" asp-page-handler="Approve" class="panel" onsubmit="return confirm('Approve this evidence and apply its eligible remaining contribution?');"><button class="btn btn-primary">Approve</button></form><form method="post" asp-page-handler="RequestChanges" class="panel form-stack"><label>Required correction note</label><textarea asp-for="Input.Note" required></textarea><button class="btn btn-warning">Request changes</button></form><form method="post" asp-page-handler="Reject" class="panel form-stack"><label>Required rejection reason</label><textarea asp-for="Input.Note" required></textarea><button class="btn btn-danger">Reject</button></form><form method="post" asp-page-handler="Duplicate" class="panel form-stack"><label>Original submission</label><select asp-for="Input.DuplicateOfSubmissionId" required><option value="">Choose original</option>@foreach(var x in Model.DuplicateOptions){<option value="@x.Id">@x.Label</option>}</select><label>Note</label><input asp-for="Input.Note" value="Duplicate submission" required/><button class="btn btn-danger">Mark duplicate</button></form>}
@if(Model.Details.Status==SubmissionStatus.Approved){<form method="post" asp-page-handler="@(Model.Details.PublicHidden ? "RestoreVisibility" : "HideVisibility")" class="panel"><button type="submit" class="btn btn-outline-light">@(Model.Details.PublicHidden?"Restore public screenshot and player":"Hide public screenshot and player")</button></form><form method="post" asp-page-handler="Reverse" class="panel form-stack" onsubmit="return confirm('Reverse this approval and remove its exact contribution?');"><label>Required reversal reason</label><textarea asp-for="Input.Note" required></textarea><button class="btn btn-danger">Reverse approval</button></form>}</aside></div>
@if(reviewable){<details class="panel"><summary><strong>Correct metadata before approval</strong></summary><form method="post" asp-page-handler="Edit" class="form-stack"><label>Tile and requirement</label><select asp-for="Input.RequirementId">@foreach(var group in Model.Requirements.GroupBy(x=>x.Tile)){<optgroup label="@group.Key">@foreach(var req in group){<option value="@req.Id" data-tile="@req.TileId">@req.Description</option>}</optgroup>}</select><input asp-for="Input.BoardTileId" type="hidden"/><label>Drop</label><select asp-for="Input.DropSnapshotId"><option value="">Manual / none</option>@foreach(var group in Model.Drops.GroupBy(x=>x.Boss)){<optgroup label="@group.Key">@foreach(var d in group){<option value="@d.Id">@d.Item (@d.Rate)</option>}</optgroup>}</select><label>Player</label><select asp-for="Input.CreditedParticipantId">@foreach(var p in Model.Players){<option value="@p.Id">@p.Label</option>}</select><label>Claimed contribution</label><input asp-for="Input.ClaimedWeight" min="1"/><label>Audit note</label><input asp-for="Input.Note"/><button class="btn btn-outline-light">Save metadata</button></form></details>}
<div class="action-grid"><section class="panel"><h2>Prior approved evidence for this requirement</h2><ul>@foreach(var x in Model.PriorApproved){<li><a asp-page="Details" asp-route-id="@x.Id">@x.SubmittedAt.ToLocalTime().ToString("g") · @x.Player · @x.Amount</a></li>}</ul></section><section class="panel"><h2>Evidence versions</h2><ul>@foreach(var x in Model.Assets){<li><a href="/Evidence/@x.Id" target="_blank">@x.UploadedAt.ToLocalTime().ToString("g") · @x.Role</a> @(x.Active?"current":"historical") · @x.Checksum[..12]</li>}</ul></section><section class="panel"><h2>Review history</h2><ul>@foreach(var x in Model.History){<li>@x.At.ToLocalTime().ToString("g") · @x.Actor · @x.Action @if(x.Note is not null){<span>— @x.Note</span>}</li>}</ul></section></div>
</section>
@section Scripts{<script>const req=document.getElementById('Input_RequirementId');const tile=document.getElementById('Input_BoardTileId');req?.addEventListener('change',()=>tile.value=req.selectedOptions[0].dataset.tile);</script>}
