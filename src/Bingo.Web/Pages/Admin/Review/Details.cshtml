@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Review.DetailsModel
@using Bingo.Domain.Evidence
@using Bingo.Web.Pages.Admin.Review
@inject Bingo.Web.Navigation.SharedShellService Shell
@{
    ViewData["Title"] = "Review";
    ViewData["PageFamily"] = "review";
    ViewData["LocalizedTitle"] = Model.Missing ? T["Submission not found"].Value : Model.Details.Tile;
    // A2: the event comes from the submission; a wrong eventId in the link is corrected in the shell.
    if (!Model.Missing) ViewData["AdminDesignShell"] = await Shell.GetAdminDesignAsync(User, ViewContext.RouteData.Values, HttpContext.RequestAborted, Model.Details.EventId.ToString());
}
@section HeaderTitle {
@if (!Model.Missing)
{
    var d = Model.Details;
    var badge = d.Status switch { SubmissionStatus.Pending => "badge-warning", SubmissionStatus.Approved => "badge-success", SubmissionStatus.Withdrawn => "badge-neutral", _ => "badge-danger" };
    <div class="subhead rv-subhead">
        <a class="btn btn-sm btn-quiet subhead-back" id="back-btn" href="@Model.QueueUrl" data-shell-link data-review-back><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-left")' />@T["Review"]</a>
        <div class="subhead-title">
            <h1 class="h1" id="page-h1" tabindex="-1">@d.Tile</h1>
            <span class="badge @badge" id="ws-status">@T[ReviewStatusText.Key(d.Status)]</span>
        </div>
    </div>
}
else
{
    <h1 class="h1" id="page-h1" tabindex="-1">@T["Submission not found"]</h1>
}
}
@section HeaderActions {
    @if (Model.Neighbours is { Count: > 1 } pager)
    {
        <nav class="subhead-pager" aria-label="@T["Submission {0} of {1} in the queue list", pager.Position, pager.Count]">
            @if (pager.PreviousId is { } previous) { <a class="btn btn-sm" id="prev-sub" href="@Model.DetailsUrl(previous)" data-shell-link aria-label="@T["Previous submission"]"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-left")' /><span class="rv-hide-sm">@T["Previous"]</span></a> }
            else { <button class="btn btn-sm" id="prev-sub" type="button" disabled aria-label="@T["Previous submission"]"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-left")' /><span class="rv-hide-sm">@T["Previous"]</span></button> }
            <span class="pager-pos">@T["{0} of {1}", pager.Position, pager.Count]</span>
            @if (pager.NextId is { } next) { <a class="btn btn-sm" id="next-sub" href="@Model.DetailsUrl(next)" data-shell-link aria-label="@T["Next submission"]"><span class="rv-hide-sm">@T["Next"]</span><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></a> }
            else { <button class="btn btn-sm" id="next-sub" type="button" disabled aria-label="@T["Next submission"]"><span class="rv-hide-sm">@T["Next"]</span><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></button> }
        </nav>
    }
}
@if (Model.Missing)
{
    <div class="card"><div class="empty"><div class="empty-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /></div><div class="empty-title">@T["This submission isn’t available"]</div><div class="empty-text">@T["The link may be incomplete, or the event is hidden."]</div>@if (Guid.TryParse(HttpContext.Request.Query["eventId"], out var queueEvent)) { <a class="btn" href="@ReviewList.QueueUrl(queueEvent, Model.Search, Model.Status)" data-shell-link>@T["Go to the queue"]</a> } else { <a class="btn" href="/Admin/Events" data-shell-link>@T["AdminDesign.Events"]</a> }</div></div>
}
else
{
    <partial name="_ReviewWorkspace" model="Model" />
}
@section Styles { <link rel="stylesheet" href="~/css/admin-design-review.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-review.js" asp-append-version="true" data-admin-page-script></script> }
