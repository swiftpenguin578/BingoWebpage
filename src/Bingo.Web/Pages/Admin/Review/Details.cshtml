@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Review.DetailsModel
@using Bingo.Domain.Evidence
@{ ViewData["Title"] = $"Review {Model.Details.Tile}"; var reviewable = Model.Details.Status == SubmissionStatus.Pending; }
<section class="table-page">
    <div class="page-heading"><div><p class="eyebrow">@Model.Details.Status · @Model.Details.Team</p><h1>@Model.Details.Tile</h1><p>Submitted @Model.Details.SubmittedAt.ToLocalTime().ToString("g") (UTC: @Model.Details.SubmittedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")) by @Model.Details.Player</p></div><a asp-page="Index">Back to queue</a></div>
    @if (Model.ChecksumMatches.Count > 0) { <aside class="status-message"><strong>Possible duplicate screenshot</strong><p>This exact image checksum also appears on:</p><ul>@foreach (var match in Model.ChecksumMatches) { <li><a asp-page="Details" asp-route-id="@match.Id">@match.SubmittedAt.ToLocalTime().ToString("g") · @match.Tile · @match.Status</a></li> }</ul><small>This is a warning only; the review decision remains Approve or reasoned Reject.</small></aside> }
    <div class="review-layout">
        <section class="panel evidence-viewer">
            @if (Model.Assets.FirstOrDefault(x => x.Active) is { } current) { <button type="button" class="evidence-lightbox-trigger" onclick="document.getElementById('evidence-lightbox').showModal()"><img src="/Evidence/@current.Id" alt="Evidence screenshot" /></button><p>@current.Filename · @current.Width×@current.Height · @(current.Bytes / 1024) KB · <a href="/Evidence/@current.Id" target="_blank">Open original</a></p><dialog id="evidence-lightbox" class="evidence-lightbox" onclick="if(event.target===this)this.close()"><button type="button" class="dialog-close" onclick="this.closest('dialog').close()" aria-label="Close">×</button><img src="/Evidence/@current.Id" alt="Evidence screenshot enlarged" /></dialog> }
            <dl><div><dt>Credited character</dt><dd>@Model.Details.Player</dd></div><div><dt>Expected code</dt><dd>@(Model.Details.ExpectedCode ?? "Verification disabled")</dd></div><div><dt>Boss/drop</dt><dd>@(Model.Details.Drop is null ? "Manual objective" : $"{Model.Details.Boss} — {Model.Details.Drop}")</dd></div><div><dt>Requirement</dt><dd>@Model.Details.Requirement</dd></div><div><dt>Claimed / approved</dt><dd>@Model.Details.Claimed / @Model.Details.Approved</dd></div><div><dt>Captain note</dt><dd>@Model.Details.CaptainNote</dd></div></dl>
            @if (Model.Details.MinutesAfterEventEnd is int minutes && Model.Details.EventEndsAt is DateTimeOffset eventEnd) { <p class="form-hint">Uploaded @minutes minute(s) after event end. Latest clan event time: @eventEnd.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'").</p> }
            @if (Model.Details.EligibilityGap is { } gap) { <aside class="status-message"><strong>Uploaded during an ineligible final-review interval.</strong><p>This evidence timestamp falls between @gap.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") and @gap.ResumedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'"). Review it as outside the authoritative live eligibility intervals.</p></aside> }
        </section>
        <aside class="form-stack">
            @if (reviewable) { <form method="post" asp-page-handler="Approve" class="panel" onsubmit="return confirm('Approve this evidence and apply its eligible remaining contribution?');"><input asp-for="Input.ExpectedVersion" type="hidden" /><button class="btn btn-primary">Approve</button></form><form method="post" asp-page-handler="Reject" class="panel form-stack"><input asp-for="Input.ExpectedVersion" type="hidden" /><label>Required rejection reason</label><textarea asp-for="Input.Reason" required></textarea><button class="btn btn-danger">Reject</button></form> }
            @if (Model.Details.Status == SubmissionStatus.Approved) { <form method="post" asp-page-handler="Reverse" class="panel form-stack" onsubmit="return confirm('Reverse this approval and remove its exact contribution?');"><input asp-for="Input.ExpectedVersion" type="hidden" /><label>Required reversal reason</label><textarea asp-for="Input.Reason" required></textarea><button class="btn btn-danger">Reverse approval</button></form> }
        </aside>
    </div>
    @if (reviewable) { <details class="panel"><summary><strong>Correct metadata before approval</strong></summary><form method="post" asp-page-handler="Edit" class="form-stack"><input asp-for="Input.ExpectedVersion" type="hidden" /><label>Tile and requirement</label><select asp-for="Input.RequirementId" data-correction-requirement onchange="syncCorrectionDropSelector(this)">@foreach (var group in Model.Requirements.GroupBy(x => x.Tile)) { <optgroup label="@group.Key">@foreach (var req in group) { <option value="@req.Id" data-tile="@req.TileId">@req.Description</option> }</optgroup> }</select><input asp-for="Input.BoardTileId" data-correction-tile type="hidden" /><label>Drop</label><select asp-for="Input.DropSnapshotId" data-correction-drop><option value="">Manual / none</option>@foreach (var group in Model.Drops.Where(x => x.RequirementId == Model.Input.RequirementId).GroupBy(x => x.Boss)) { <optgroup label="@group.Key">@foreach (var d in group) { <option value="@d.Id" data-requirement-id="@d.RequirementId">@d.Item (@d.Rate)</option> }</optgroup> }</select><select data-correction-drop-catalogue hidden aria-hidden="true" tabindex="-1"><option value="">Manual / none</option>@foreach (var group in Model.Drops.GroupBy(x => x.Boss)) { <optgroup label="@group.Key">@foreach (var d in group) { <option value="@d.Id" data-requirement-id="@d.RequirementId">@d.Item (@d.Rate)</option> }</optgroup> }</select><label>Credited Playing character</label><select asp-for="Input.CreditedOsrsCharacterId" required>@foreach (var character in Model.Characters) { <option value="@character.Id">@character.Label</option> }</select><p>Submission time, weight, contribution, and active evidence asset remain unchanged. The participant is derived from the selected event character.</p><label>Written correction reason</label><textarea asp-for="Input.Reason" required></textarea><button class="btn btn-outline-light">Save metadata</button></form></details> }
    <div class="action-grid"><section class="panel"><h2>Prior approved evidence for this requirement</h2><ul>@foreach (var x in Model.PriorApproved) { <li><a asp-page="Details" asp-route-id="@x.Id">@x.SubmittedAt.ToLocalTime().ToString("g") · @x.Player · @x.Amount</a></li> }</ul></section><section class="panel"><h2>Evidence versions</h2><ul>@foreach (var x in Model.Assets) { <li><a href="/Evidence/@x.Id" target="_blank">@x.UploadedAt.ToLocalTime().ToString("g") · @x.Role</a> @(x.Active ? "current" : "historical") · @x.Checksum[..12]</li> }</ul></section><section class="panel"><h2>Review history</h2><ul>@foreach (var x in Model.History) { <li>@x.At.ToLocalTime().ToString("g") · @x.Actor · @x.Action @if (x.Note is not null) { <span>— @x.Note</span> }</li> }</ul></section></div>
</section>
