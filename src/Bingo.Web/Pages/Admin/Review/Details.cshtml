@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Review.DetailsModel
@using Bingo.Domain.Evidence
@using Bingo.Web.UI
@{
    ViewData["Title"] = T["Review {0}", Model.Details.Tile];
    ViewData["CompactNavigation"] = true;
    ViewData["AdminPageDescription"] = T["Inspect evidence, resolve its review state, and preserve the audit record."];
    var reviewable = Model.Details.Status == SubmissionStatus.Pending;
    var statusModifier = Model.Details.Status switch
    {
        SubmissionStatus.Pending => "is-yellow",
        SubmissionStatus.Approved => "is-green",
        SubmissionStatus.Rejected or SubmissionStatus.Reversed => "is-danger",
        _ => "is-muted"
    };
    var currentAsset = Model.Assets.FirstOrDefault(x => x.Active);
}

<section class="admin-review-page admin-review-detail-page">
    <header class="admin-review-detail-heading">
        <a class="admin-button-secondary admin-review-back-link" asp-page="Index">← @T["Back to queue"]</a>
        <div class="admin-review-detail-heading-copy">
            <div class="admin-review-detail-kicker">
                <span class="admin-module-eyebrow">@Model.Details.Team</span>
                <span class="admin-status-pill @statusModifier">@T[Model.Details.Status.ToString()]</span>
            </div>
            <h1>@Model.Details.Tile</h1>
            <p>@(T["Submitted {0} by {1}", Model.Details.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture), Model.Details.Player]) · @Model.Details.SubmittedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>
        </div>
    </header>

    @if (Model.ChecksumMatches.Count > 0)
    {
        <aside class="admin-review-callout admin-review-warning" role="alert">
            <strong>@T["Possible duplicate screenshot"]</strong>
            <p>@T["This exact image checksum also appears on the following submissions:"]</p>
            <ul>
                @foreach (var match in Model.ChecksumMatches)
                {
                    <li><a asp-page="Details" asp-route-id="@match.Id">@match.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture) · @match.Tile · @T[match.Status.ToString()]</a></li>
                }
            </ul>
            <small>@T["This is a warning only; the review decision remains Approve or reasoned Reject."]</small>
        </aside>
    }

    <div class="admin-review-detail-grid">
        <main class="admin-review-detail-main">
            <section class="admin-review-surface admin-review-evidence-surface" aria-labelledby="evidence-title">
                <header class="admin-review-surface-heading">
                    <div>
                        <p class="admin-module-eyebrow">@T["Evidence inspection"]</p>
                        <h2 id="evidence-title">@T["Submitted evidence"]</h2>
                    </div>
                    @if (currentAsset is not null)
                    {
                        <span class="admin-review-asset-state">@T["Active asset"]</span>
                    }
                </header>

                @if (currentAsset is { } asset)
                {
                    <button type="button" class="admin-review-evidence-trigger" onclick="document.getElementById('evidence-lightbox').showModal()" aria-haspopup="dialog" aria-controls="evidence-lightbox">
                        <img src="/Evidence/@asset.Id" alt='@T["Evidence screenshot"]' />
                        <span>@T["Open evidence viewer"]</span>
                    </button>
                    <div class="admin-review-asset-meta">
                        <span>@asset.Filename</span>
                        <span>@asset.Width×@asset.Height · @(asset.Bytes / 1024) KB</span>
                        <a href="/Evidence/@asset.Id" target="_blank" rel="noopener">@T["Open original asset"]</a>
                    </div>
                    <dialog id="evidence-lightbox" class="admin-review-lightbox" aria-labelledby="evidence-lightbox-title" onclick="if(event.target===this)this.close()">
                        <div class="admin-review-lightbox-heading">
                            <strong id="evidence-lightbox-title">@T["Evidence screenshot"]</strong>
                            <button type="button" class="admin-review-lightbox-close" onclick="this.closest('dialog').close()" aria-label='@T["Close evidence viewer"]'>×</button>
                        </div>
                        <img src="/Evidence/@asset.Id" alt='@T["Evidence screenshot enlarged"]' />
                    </dialog>
                }
                else
                {
                    <div class="admin-review-no-asset" role="status">
                        <strong>@T["No active evidence asset"]</strong>
                        <p>@T["The submission has no asset available for inspection."]</p>
                    </div>
                }

                <section class="admin-review-metadata-group" aria-labelledby="authoritative-metadata-title">
                    <header class="admin-review-subsection-heading">
                        <h3 id="authoritative-metadata-title">@T["Authoritative submission metadata"]</h3>
                        <p>@T["These values are the submitted record used by review and contribution calculations."]</p>
                    </header>
                    <dl class="admin-review-metadata-grid">
                        <div><dt>@T["Credited player"]</dt><dd>@Model.Details.Player</dd></div>
                        <div><dt>@T["Expected code"]</dt><dd>@(Model.Details.ExpectedCode ?? T["Verification disabled"])</dd></div>
                        <div><dt>@T["Boss / drop"]</dt><dd>@(Model.Details.Drop is null ? T["Manual objective"] : $"{Model.Details.Boss} — {Model.Details.Drop}")</dd></div>
                        <div><dt>@T["Requirement"]</dt><dd>@Model.Details.Requirement</dd></div>
                        <div><dt>@T["Claimed → approved"]</dt><dd>@Model.Details.Claimed → @Model.Details.Approved</dd></div>
                        <div><dt>@T["Submitted"]</dt><dd>@Model.Details.SubmittedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd></div>
                        <div><dt>@T["Captain note"]</dt><dd>@(Model.Details.CaptainNote ?? T["No Captain note"])</dd></div>
                        @if (Model.Details.Note is not null)
                        {
                            <div><dt>@T["Reviewer note"]</dt><dd>@Model.Details.Note</dd></div>
                        }
                    </dl>
                </section>

                @if (Model.Details.MinutesAfterEventEnd is int minutes && Model.Details.EventEndsAt is DateTimeOffset eventEnd)
                {
                    <aside class="admin-review-callout admin-review-warning" role="note">
                        <strong>@T["After event end"]</strong>
                        <p>@T["Uploaded {0} minute(s) after event end. Latest event end: {1}.", minutes, eventEnd.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")] @T["Verify the screenshot time before deciding."]</p>
                    </aside>
                }
                @if (Model.Details.EligibilityGap is { } gap)
                {
                    <aside class="admin-review-callout admin-review-warning" role="alert">
                        <strong>@T["Ineligible final-review interval"]</strong>
                        <p>@T["This evidence timestamp falls between {0} and {1}. Treat it as outside the authoritative live eligibility intervals.", gap.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'"), gap.ResumedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")]</p>
                    </aside>
                }
            </section>

            @if (reviewable)
            {
                <details class="admin-review-surface admin-review-correction" open="@(Model.Input.Reason is not null ? "open" : null)">
                    <summary><span><strong>@T["Correct metadata before approval"]</strong><small>@T["Change only the authoritative selectors and record a written reason."]</small></span><span aria-hidden="true">⌄</span></summary>
                    <form method="post" asp-page-handler="Edit" class="admin-review-correction-form">
                        <input asp-for="Input.ExpectedVersion" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                        <div class="admin-review-form-grid">
                            <div class="admin-review-form-field">
                                <label asp-for="Input.RequirementId">@T["Tile and requirement"]</label>
                                <select asp-for="Input.RequirementId" data-correction-requirement onchange="syncCorrectionDropSelector(this)">
                                    @foreach (var group in Model.Requirements.GroupBy(x => x.Tile))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var requirement in group)
                                            {
                                                <option value="@requirement.Id" data-tile="@requirement.TileId">@requirement.Description</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <input asp-for="Input.BoardTileId" data-correction-tile type="hidden" />
                            <div class="admin-review-form-field">
                                <label asp-for="Input.DropSnapshotId">@T["Drop"]</label>
                                <select asp-for="Input.DropSnapshotId" data-correction-drop>
                                    <option value="">@T["Manual / none"]</option>
                                    @foreach (var group in Model.Drops.Where(x => x.RequirementId == Model.Input.RequirementId).GroupBy(x => x.Boss))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var drop in group)
                                            {
                                                <option value="@drop.Id" data-requirement-id="@drop.RequirementId">@drop.Item (@drop.Rate)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <select data-correction-drop-catalogue hidden aria-hidden="true" tabindex="-1">
                                    <option value="">@T["Manual / none"]</option>
                                    @foreach (var group in Model.Drops.GroupBy(x => x.Boss))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var drop in group)
                                            {
                                                <option value="@drop.Id" data-requirement-id="@drop.RequirementId">@drop.Item (@drop.Rate)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <div class="admin-review-form-field">
                                <label asp-for="Input.CreditedOsrsCharacterId">@T["Credited playing character"]</label>
                                <select asp-for="Input.CreditedOsrsCharacterId" required>
                                    @foreach (var character in Model.Characters)
                                    {
                                        <option value="@character.Id">@character.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <p class="admin-review-form-note">@T["Submission time, weight, contribution, and active evidence asset remain unchanged. The participant is derived from the selected event character."]</p>
                        <div class="admin-review-form-field">
                            <label asp-for="Input.Reason">@T["Written correction reason"]</label>
                            <textarea asp-for="Input.Reason" required aria-describedby="metadata-correction-reason-hint"></textarea>
                            <span id="metadata-correction-reason-hint" class="admin-review-form-hint">@T["Required for the audit record."]</span>
                            <span asp-validation-for="Input.Reason" class="field-error"></span>
                        </div>
                        <button class="admin-button-secondary" type="submit">@T["Save metadata correction"]</button>
                    </form>
                </details>
            }

            <div class="admin-review-secondary-grid">
                <section class="admin-review-surface admin-review-operational-section" aria-labelledby="prior-approved-title">
                    <header class="admin-review-subsection-heading"><h2 id="prior-approved-title">@T["Prior approved evidence"]</h2><p>@T["Approved records for this team and requirement."]</p></header>
                    @if (Model.PriorApproved.Count == 0)
                    {
                        <p class="admin-review-empty-note">@T["No prior approved evidence for this requirement."]</p>
                    }
                    else
                    {
                        <ul class="admin-review-operational-list">
                            @foreach (var item in Model.PriorApproved)
                            {
                                <li><a asp-page="Details" asp-route-id="@item.Id">@item.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture) · @item.Player</a><span>@item.Amount @T["Contribution"]</span></li>
                            }
                        </ul>
                    }
                </section>
                <section class="admin-review-surface admin-review-operational-section" aria-labelledby="asset-history-title">
                    <header class="admin-review-subsection-heading"><h2 id="asset-history-title">@T["Evidence versions"]</h2><p>@T["Immutable asset history and checksums."]</p></header>
                    @if (Model.Assets.Count == 0)
                    {
                        <p class="admin-review-empty-note">@T["No evidence assets are attached."]</p>
                    }
                    else
                    {
                        <ul class="admin-review-operational-list">
                            @foreach (var item in Model.Assets)
                            {
                                var checksum = item.Checksum[..Math.Min(12, item.Checksum.Length)];
                                <li><a href="/Evidence/@item.Id" target="_blank" rel="noopener">@item.UploadedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture) · @item.Role</a><span>@(item.Active ? T["current"] : T["Historical"]) · @checksum</span></li>
                            }
                        </ul>
                    }
                </section>
                <section class="admin-review-surface admin-review-operational-section" aria-labelledby="review-history-title">
                    <header class="admin-review-subsection-heading"><h2 id="review-history-title">@T["Immutable review history"]</h2><p>@T["Every review decision and reason remains recorded."]</p></header>
                    @if (Model.History.Count == 0)
                    {
                        <p class="admin-review-empty-note">@T["No review actions have been recorded."]</p>
                    }
                    else
                    {
                        <ul class="admin-review-operational-list admin-review-history-list">
                            @foreach (var item in Model.History)
                            {
                                <li><strong>@T[item.Action.ToString()]</strong><span>@item.At.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture) · @item.Actor</span>@if (item.Note is not null) { <small>@item.Note</small> }</li>
                            }
                        </ul>
                    }
                </section>
            </div>
        </main>

        <aside class="admin-review-action-rail" aria-labelledby="review-actions-title">
            <section class="admin-review-surface admin-review-actions-surface">
                <header class="admin-review-surface-heading">
                    <div>
                        <p class="admin-module-eyebrow">@T["Reviewer actions"]</p>
                        <h2 id="review-actions-title">@T["Resolve submission"]</h2>
                    </div>
                </header>
                @if (reviewable)
                {
                    <form method="post" asp-page-handler="Approve" class="admin-review-action-form" onsubmit="return confirm('Approve this evidence and apply its eligible remaining contribution?');">
                        <input asp-for="Input.ExpectedVersion" type="hidden" />
                        <p>@T["Approve the evidence and apply its eligible remaining contribution."]</p>
                        <button class="admin-button-primary" type="submit">@T["Approve evidence"]</button>
                    </form>
                    <form method="post" asp-page-handler="Reject" class="admin-review-action-form">
                        <input asp-for="Input.ExpectedVersion" type="hidden" />
                        <label asp-for="Input.Reason">@T["Required rejection reason"]</label>
                        <textarea asp-for="Input.Reason" required></textarea>
                        <span asp-validation-for="Input.Reason" class="field-error"></span>
                        <button class="admin-button-secondary action-danger-outline" type="submit">@T["Reject evidence"]</button>
                    </form>
                }
                @if (Model.Details.Status == SubmissionStatus.Approved)
                {
                    <form method="post" asp-page-handler="Reverse" class="admin-review-action-form" onsubmit="return confirm('Reverse this approval and remove its exact contribution?');">
                        <input asp-for="Input.ExpectedVersion" type="hidden" />
                        <label asp-for="Input.Reason">@T["Required reversal reason"]</label>
                        <textarea asp-for="Input.Reason" required></textarea>
                        <span asp-validation-for="Input.Reason" class="field-error"></span>
                        <button class="admin-button-secondary action-danger-outline" type="submit">@T["Reverse approval"]</button>
                    </form>
                }
                @if (!reviewable && Model.Details.Status != SubmissionStatus.Approved)
                {
                    <p class="admin-review-empty-note">@T["No review action is available for this submission state."]</p>
                }
            </section>
        </aside>
    </div>
</section>
