@page
@model Bingo.Web.Pages.Admin.Review.SubmitModel
@{ViewData["Title"]="Admin evidence submission";}
<section class="form-page"><div class="page-heading"><div><p class="eyebrow">Administrative fallback</p><h1>Submit evidence</h1><p>@Model.EventName · submission window bypass is audited</p></div><a asp-page="Index">Back to review</a></div><div asp-validation-summary="All"></div><form method="post" enctype="multipart/form-data" class="panel form-stack"><label>Team</label><select asp-for="Input.TeamId" required><option value="">Choose team</option>@foreach(var x in Model.Teams){<option value="@x.Id">@x.Name</option>}</select><label>Tile</label><select asp-for="Input.BoardTileId" required><option value="">Choose tile</option>@foreach(var x in Model.Tiles){<option value="@x.Id">@x.Name</option>}</select><label>Requirement</label><select asp-for="Input.RequirementId" required><option value="">Choose requirement</option>@foreach(var x in Model.Requirements){<option value="@x.Id" data-tile="@x.TileId">@x.Description</option>}</select><label>Drop</label><select asp-for="Input.DropSnapshotId"><option value="">Manual / no drop</option>@foreach(var group in Model.Drops.GroupBy(x=>x.Boss)){<optgroup label="@group.Key">@foreach(var x in group){<option value="@x.Id">@x.Item (@x.Rate)</option>}</optgroup>}</select><label>Player</label><select asp-for="Input.CreditedParticipantId" required><option value="">Choose player</option>@foreach(var x in Model.Players){<option value="@x.Id" data-team="@x.TeamId">@x.Name</option>}</select><label>Contribution</label><input asp-for="Input.ClaimedWeight" min="1"/><label>Note</label><textarea asp-for="Input.Note"></textarea><label>Screenshot</label><div class="evidence-drop" tabindex="0"><strong>Paste or drag screenshot here</strong><input asp-for="Input.Evidence" type="file" accept="image/png,image/jpeg,image/webp" required/><img alt="Evidence preview" hidden/></div><button class="btn btn-primary">Create pending submission</button></form></section>
@section Scripts{<script>const zone=document.querySelector('.evidence-drop'),input=zone.querySelector('input'),preview=zone.querySelector('img');const show=file=>{if(!file)return;const dt=new DataTransfer();dt.items.add(file);input.files=dt.files;preview.src=URL.createObjectURL(file);preview.hidden=false};zone.addEventListener('dragover',e=>e.preventDefault());zone.addEventListener('drop',e=>{e.preventDefault();show([...e.dataTransfer.files].find(x=>x.type.startsWith('image/')))});zone.addEventListener('paste',e=>show([...e.clipboardData.files].find(x=>x.type.startsWith('image/'))));input.addEventListener('change',()=>show(input.files[0]));</script>}
