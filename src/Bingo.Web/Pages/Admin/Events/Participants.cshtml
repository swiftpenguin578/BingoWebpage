@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.ParticipantsModel
@using Bingo.Domain.Events
@using Bingo.Domain.Signups
@{
    var eventView = Model.Event!;
    ViewData["Title"] = T["Participants · {0}", eventView.Name];
    ViewData["AdminPageDescription"] = T["Manage signup settings, capacity, and participants."];
    var currentParticipants = Model.Participants.Where(item => item.Status is SignupStatus.Confirmed or SignupStatus.WaitingList).ToList();
    var historyParticipants = Model.Participants.Where(item => item.Status == SignupStatus.Withdrawn).ToList();
    var signupQuestionCount = Model.ActiveSignupQuestions.Count;
    var requiredSignupQuestions = Model.ActiveSignupQuestions.Where(question => question.Required).ToList();
    var optionalSignupQuestions = Model.ActiveSignupQuestions.Where(question => !question.Required).ToList();
    var accountQuestion = Model.ActiveSignupQuestions.FirstOrDefault(question => question.Type == SignupQuestionType.Account);
    var captainVolunteerQuestion = Model.ActiveSignupQuestions.FirstOrDefault(question => string.Equals(question.Label, "Captain volunteer", StringComparison.OrdinalIgnoreCase));
    var remainingPreviewQuestionCount = signupQuestionCount - (accountQuestion is null ? 0 : 1) - (captainVolunteerQuestion is null ? 0 : 1);
    var activeSort = string.IsNullOrWhiteSpace(Model.Sort) ? "ownership" : Model.Sort.ToLowerInvariant();
    var activeDirection = string.Equals(Model.Direction, "asc", StringComparison.OrdinalIgnoreCase) ? "asc" : "desc";
    const string updateTargets = "#app-notice-region, .event-participants-page";

    string StatusClass(SignupStatus status) => status switch
    {
        SignupStatus.Confirmed => "is-green",
        SignupStatus.WaitingList => "is-orange",
        SignupStatus.Withdrawn => "is-danger",
        _ => "is-muted"
    };

    string SortDirection(string key) => activeSort == key && activeDirection == "asc" ? "desc" : "asc";
}

<section class="admin-events-page event-participants-page" id="players">
    <div class="participant-settings-grid">
        <section class="participant-settings-region participant-signup-form-region" aria-labelledby="signup-settings-heading">
            <div class="participant-settings-heading">
                <div><h2 id="signup-settings-heading">@T["Signup form"]</h2><p>@T["Own the questions and form participants use to sign up."]</p></div>
            </div>
            <div class="participant-form-preview" aria-label="@T["Configured signup form preview"]">
                <p class="participant-form-summary" data-signup-question-summary="@T["{0} active questions configured.", signupQuestionCount]">@T["{0} active questions configured.", signupQuestionCount]</p>
                <ul class="participant-form-preview-list">
                    @if (accountQuestion is not null)
                    {
                        <li><span>@accountQuestion.Label</span><small>@(accountQuestion.Required ? T["Required"] : T["Optional"])</small></li>
                    }
                    @if (captainVolunteerQuestion is not null)
                    {
                        <li><span>@captainVolunteerQuestion.Label</span><small>@(captainVolunteerQuestion.Required ? T["Required"] : T["Optional"])</small></li>
                    }
                    @if (remainingPreviewQuestionCount > 0)
                    {
                        <li><span>@T["Other questions"]</span><small>@T["{0} more", remainingPreviewQuestionCount]</small></li>
                    }
                </ul>
            </div>
            <div class="participant-settings-actions">
                <a class="admin-button-secondary signup-questions-trigger" data-signup-questions-trigger="true" asp-page="Questions" asp-route-id="@eventView.Id">@T["Edit signup form"]</a>
            </div>
        </section>

        <section class="participant-settings-region participant-capacity-region" aria-labelledby="capacity-settings-heading">
            <div class="participant-settings-heading">
                <div>
                    <h2 id="capacity-settings-heading">@T["Capacity and waiting list"]</h2>
                    <span class="participant-capacity-summary">@T["{0} confirmed of {1} · {2} waiting", eventView.Confirmed, eventView.ParticipantCap, eventView.Waiting]</span>
                </div>
            </div>
            @if (eventView.DraftLocked || eventView.State is not (EventState.Draft or EventState.SignupOpen or EventState.SignupClosed))
            {
                <p class="admin-muted-note">@T["These settings are locked because participant administration has moved on."]</p>
            }
            else
            {
                <form id="signup-settings-form" method="post" asp-page-handler="SignupAdministration" class="participant-settings-form" data-update-targets="@updateTargets">
                    <input asp-for="SignupAdministration.Version" type="hidden" />
                    <input type="hidden" name="ParticipantSearch" value="@Model.ParticipantSearch" /><input type="hidden" name="ParticipantStatus" value="@Model.ParticipantStatus" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="direction" value="@Model.Direction" />
                    <div class="participant-capacity-fields">
                        <div class="admin-field event-create-field participant-capacity-field">
                            <label asp-for="SignupAdministration.ParticipantCap">@T["Maximum players"]</label>
                            <input asp-for="SignupAdministration.ParticipantCap" class="form-control" min="1" max="10000" />
                            <span asp-validation-for="SignupAdministration.ParticipantCap" class="field-error"></span>
                        </div>
                        <div class="participant-shared-row">
                            <strong id="waiting-list-enabled-heading" class="participant-shared-row-heading">@T["waiting list enabled"]</strong>
                            <label class="admin-setting-toggle participant-shared-row-content">
                                <span class="admin-setting-toggle-marker"><input asp-for="SignupAdministration.WaitingListEnabled" aria-labelledby="waiting-list-enabled-heading" aria-describedby="waiting-list-enabled-support" /></span>
                                <span id="waiting-list-enabled-support" class="admin-setting-toggle-copy"><small>@T["Keep accepting signups after capacity is reached."]</small></span>
                            </label>
                        </div>
                        @if (eventView.Waiting > 0)
                        {
                            <label class="admin-setting-toggle participant-waiting-confirm">
                                <span class="admin-setting-toggle-marker"><input asp-for="SignupAdministration.ConfirmWaitingListDisablement" /></span>
                                <span class="admin-setting-toggle-copy"><strong>@T["Confirm waiting-list disablement"]</strong><small>@T["If disabled, all {0} queued participants will be promoted in signup order; capacity will be raised to at least {1} if needed.", eventView.Waiting, eventView.Confirmed + eventView.Waiting]</small></span>
                            </label>
                        }
                    </div>
                </form>
            }
            @if (!eventView.DraftLocked && eventView.State is EventState.Draft or EventState.SignupOpen or EventState.SignupClosed)
            {
                <div class="participant-settings-actions">
                    <button class="admin-button-secondary" type="submit" form="signup-settings-form">@T["Save signup settings"]</button>
                </div>
            }
        </section>
    </div>

    <div class="admin-events-directory-controls">
        <form class="admin-events-toolbar" method="get" data-participant-filter-form>
            <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="direction" value="@Model.Direction" />
            <div class="admin-search-field admin-events-search">
                <label class="visually-hidden" for="participant-search">@T["Search participants"]</label>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                <input id="participant-search" class="admin-search-field-input form-control" type="search" name="ParticipantSearch" value="@Model.ParticipantSearch" placeholder="@T["Search participants"]" data-participant-search-input />
                <button class="admin-search-clear" type="button" data-admin-search-clear aria-label="@T["Clear participant search"]" hidden="@(string.IsNullOrWhiteSpace(Model.ParticipantSearch) ? "hidden" : null)"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg></button>
            </div>
            <div class="admin-events-state-filter admin-field">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                <label for="participant-status">@T["Status"]:</label>
                <div class="admin-events-state-select">
                    <select id="participant-status" class="admin-filter-select form-select" name="ParticipantStatus">
                        <option value="">@T["All"]</option>
                        <option value="Confirmed" selected="@(Model.ParticipantStatus == "Confirmed" ? "selected" : null)">@T["confirmed"]</option>
                        <option value="WaitingList" selected="@(Model.ParticipantStatus == "WaitingList" ? "selected" : null)">@T["Waiting list"]</option>
                        <option value="Withdrawn" selected="@(Model.ParticipantStatus == "Withdrawn" ? "selected" : null)">@T["Withdrawn"]</option>
                    </select>
                    <svg class="admin-events-state-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                </div>
            </div>
        </form>
        @if (!eventView.DraftLocked && eventView.State is EventState.SignupOpen or EventState.SignupClosed)
        {
            @if (Model.AddParticipant)
            {
                <a class="admin-button-create participant-add-route-trigger" data-participant-add-trigger data-participant-add-route-trigger hidden asp-page="Participants" asp-route-id="@eventView.Id" asp-route-addParticipant="1" asp-route-ParticipantSearch="@Model.ParticipantSearch" asp-route-ParticipantStatus="@Model.ParticipantStatus" asp-route-ParticipantPayment="@Model.ParticipantPayment" asp-route-ParticipantDiscord="@Model.ParticipantDiscord" asp-route-ParticipantCaptain="@Model.ParticipantCaptain" asp-route-ParticipantSource="@Model.ParticipantSource" asp-route-ParticipantTeamId="@Model.ParticipantTeamId" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" /></svg><span>@T["Add participant"]</span></a>
                <section class="participant-add-route-page" aria-labelledby="participant-add-route-title">
                    <a class="participant-add-route-back admin-button-secondary" asp-page="Participants" asp-route-id="@eventView.Id" asp-route-ParticipantSearch="@Model.ParticipantSearch" asp-route-ParticipantStatus="@Model.ParticipantStatus" asp-route-ParticipantPayment="@Model.ParticipantPayment" asp-route-ParticipantDiscord="@Model.ParticipantDiscord" asp-route-ParticipantCaptain="@Model.ParticipantCaptain" asp-route-ParticipantSource="@Model.ParticipantSource" asp-route-ParticipantTeamId="@Model.ParticipantTeamId" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction">@T["Back to participants"]</a>
                    <div id="participant-add-route-title" class="visually-hidden">@T["Add participant"]</div>
                    <partial name="_InternalParticipantForm" model="Model" />
                </section>
            }
            else
            {
                <div class="admin-header-actions-inline">
                    <a class="admin-button-create participant-add-route-trigger" data-participant-add-trigger asp-page="Participants" asp-route-id="@eventView.Id" asp-route-addParticipant="1" asp-route-ParticipantSearch="@Model.ParticipantSearch" asp-route-ParticipantStatus="@Model.ParticipantStatus" asp-route-ParticipantPayment="@Model.ParticipantPayment" asp-route-ParticipantDiscord="@Model.ParticipantDiscord" asp-route-ParticipantCaptain="@Model.ParticipantCaptain" asp-route-ParticipantSource="@Model.ParticipantSource" asp-route-ParticipantTeamId="@Model.ParticipantTeamId" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" /></svg><span>@T["Add participant"]</span></a>
                </div>
            }
        }
    </div>

    <div class="participant-group-list">
        @foreach (var group in new[]
        {
            (Title: T["Current signups"], Description: T["Confirmed and waiting-list entries remain together for active administration."], Rows: currentParticipants, Table: "current"),
            (Title: T["Signup history"], Description: T["Withdrawn records remain available for audit and follow-up."], Rows: historyParticipants, Table: "history")
        })
        {
            <section class="participant-group" data-participant-group>
                <header class="participant-group-heading"><div><h2>@group.Title</h2><p>@group.Description</p></div><span class="admin-badge">@group.Rows.Count</span></header>
                <div class="admin-events-table-wrap participant-table-wrap"><div class="admin-events-table-scroll">
                    <table class="event-table participant-table" data-participant-table="@group.Table" data-participant-no-matches="@T["No matching participants."]"><thead><tr>
                        @foreach (var header in new[] { (Key: "sequence", Label: "#"), (Key: "participant", Label: "Participant"), (Key: "ehb", Label: "EHB"), (Key: "status", Label: "Status"), (Key: "payment", Label: "Payment"), (Key: "signedup", Label: "Signed up"), (Key: "ownership", Label: "Team") })
                        {
                            var nextDirection = SortDirection(header.Key);
                            @if (activeSort == header.Key)
                            {
                                <th data-participant-sort-header aria-sort="@(activeDirection == "asc" ? "ascending" : "descending")"><a class="participant-sort-link" data-participant-sort data-sort-key="@header.Key" data-sort-label="@header.Label" asp-page="Participants" asp-route-id="@eventView.Id" asp-route-ParticipantSearch="@Model.ParticipantSearch" asp-route-ParticipantStatus="@Model.ParticipantStatus" asp-route-sort="@header.Key" asp-route-direction="@nextDirection" aria-label="@T["Sort by {0} {1}.", header.Label, nextDirection]">@T[header.Label]<svg class="participant-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="@(activeDirection == "asc" ? "m6 15 6-6 6 6" : "m6 9 6 6 6-6")" /></svg></a></th>
                            }
                            else
                            {
                                <th data-participant-sort-header><a class="participant-sort-link" data-participant-sort data-sort-key="@header.Key" data-sort-label="@header.Label" asp-page="Participants" asp-route-id="@eventView.Id" asp-route-ParticipantSearch="@Model.ParticipantSearch" asp-route-ParticipantStatus="@Model.ParticipantStatus" asp-route-sort="@header.Key" asp-route-direction="@nextDirection" aria-label="@T["Sort by {0} {1}.", header.Label, nextDirection]">@T[header.Label]</a></th>
                            }
                        }
                        <th class="event-actions-heading"><span class="participant-actions-heading-label">@T["Actions"]</span></th>
                    </tr></thead><tbody>
                    <tr class="participant-table-empty" hidden="@(group.Rows.Count > 0 ? "hidden" : null)"><td colspan="8">@T["No matching participants."]</td></tr>
                    @foreach (var participant in group.Rows)
                    {
                        var participantStatus = participant.Status == SignupStatus.WaitingList && participant.WaitingPosition is { } waitingPosition
                            ? T["Waiting list · #{0}", waitingPosition]
                            : T[participant.Status.ToString()];
                        var paymentLabel = participant.Payment == PaymentStatus.Paid ? T["Paid"] : T["Unpaid"];
                        var paymentNext = participant.Payment == PaymentStatus.Paid ? PaymentStatus.Unpaid : PaymentStatus.Paid;
                        <tr id="participant-row-@participant.Id" data-participant-row data-participant-id="@participant.Id" data-participant-sequence="@participant.Sequence" data-participant-name="@participant.Name" data-participant-ehb="@participant.Ehb.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-participant-status="@participant.Status" data-participant-payment="@participant.Payment" data-participant-signed-up="@participant.SignedUpAt.ToUnixTimeMilliseconds()" data-participant-ownership="@(participant.TeamName ?? "Unassigned")">
                            <td data-label="#">@participant.Sequence</td>
                            <td data-label="@T["Participant"]"><span class="participant-primary-value">@participant.Name</span><small>@(participant.WebsiteUsername ?? T["Unlinked"])</small><small>@(participant.DiscordLinked ? T["Discord linked"] : T["Discord unlinked"])</small></td>
                            <td data-label="@T["EHB"]">@participant.Ehb.ToString("0.##")</td>
                            <td data-label="@T["Status"]"><span class="admin-status-pill participant-status-pill @StatusClass(participant.Status)">@participantStatus</span></td>
                            <td data-label="@T["Payment"]">
                                @if (group.Table == "current" && eventView.CanEditParticipant)
                                {
                                    <form method="post" asp-page-handler="Payment" class="participant-payment-form" data-update-targets="@updateTargets"><input type="hidden" name="participantId" value="@participant.Id" /><input type="hidden" name="ParticipantSearch" value="@Model.ParticipantSearch" /><input type="hidden" name="ParticipantStatus" value="@Model.ParticipantStatus" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="direction" value="@Model.Direction" /><button name="payment" value="@paymentNext" class="admin-status-pill participant-status-pill participant-payment-control @StatusClass(participant.Payment == PaymentStatus.Paid ? SignupStatus.Confirmed : SignupStatus.Withdrawn)" type="submit" aria-label="@T["Mark {0} as {1}", participant.Name, paymentNext]">@paymentLabel</button></form>
                                }
                                else
                                {
                                    <span class="admin-status-pill participant-status-pill @StatusClass(participant.Payment == PaymentStatus.Paid ? SignupStatus.Confirmed : SignupStatus.Withdrawn)">@paymentLabel</span>
                                }
                            </td>
                            <td data-label="@T["Signed up"]"><span class="participant-primary-value">@participant.SignedUpAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span><small>@T[participant.Source.ToString()]</small></td>
                            <td data-label="@T["Team"]"><span class="participant-primary-value">@(participant.TeamName ?? T["Unassigned"])</span>@if (participant.CaptainVolunteer) { <small>@T["Volunteered to captain"]</small> }</td>
                            <td class="event-row-action participant-actions-cell">
                                <div class="participant-row-actions">
                                <a class="participant-edit-action" aria-label="@T["Edit {0}", participant.Name]" title="@T["Edit {0}", participant.Name]" asp-page="Participant" asp-route-id="@eventView.Id" asp-route-participantId="@participant.Id"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg><span class="visually-hidden">@T["Edit {0}", participant.Name]</span></a>
                                @if (group.Table == "current")
                                {
                                    @if (eventView.State == EventState.Live)
                                    {
                                        <a class="admin-button-secondary" asp-page="Participant" asp-route-id="@eventView.Id" asp-route-participantId="@participant.Id">@T["Manage live participant"]</a>
                                    }
                                    else if (eventView.CanEditParticipant)
                                    {
                                        <details class="admin-destructive-confirmation">
                                            <summary class="admin-button-secondary action-danger-outline">@T["Remove"]</summary>
                                            <div class="event-confirmation-box" role="alertdialog" aria-labelledby="remove-participant-@participant.Id-heading">
                                                <p><strong id="remove-participant-@participant.Id-heading">@T["Remove {0}?", participant.Name]</strong><br />@T["This withdraws the signup and keeps its history."]</p>
                                                <form method="post" asp-page-handler="Withdraw" class="event-confirmation-form" data-update-targets="@updateTargets">
                                                    <input type="hidden" name="participantId" value="@participant.Id" /><input type="hidden" name="ParticipantSearch" value="@Model.ParticipantSearch" /><input type="hidden" name="ParticipantStatus" value="@Model.ParticipantStatus" /><input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="direction" value="@Model.Direction" />
                                                    <div class="event-confirmation-actions"><button class="admin-button-secondary action-danger-outline" type="submit">@T["Remove"]</button><a class="admin-button-secondary" asp-page="Participants" asp-route-id="@eventView.Id" asp-route-ParticipantSearch="@Model.ParticipantSearch" asp-route-ParticipantStatus="@Model.ParticipantStatus" asp-route-sort="@Model.Sort" asp-route-direction="@Model.Direction">@T["Cancel"]</a></div>
                                                </form>
                                            </div>
                                        </details>
                                    }
                                    else
                                    {
                                        <small>@T["Read-only after the draft starts."]</small>
                                    }
                                }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody></table>
                </div></div>
            </section>
        }
    </div>
</section>

@section Scripts { <script src="~/js/event-manage.js" asp-append-version="true"></script> }
