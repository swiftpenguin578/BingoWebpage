@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.BoardModel
@using System.Text.Json
@{
    // U7 / Board.dc.html. The server renders the view (Board.View.cs); admin-board.js
    // paints it and runs every command in place (Board.Transport.cs, AdminFetch).
    ViewData["Title"] = T["Board"];
    ViewData["LocalizedTitle"] = T["Board"].Value;
    ViewData["PageFamily"] = "board";
    ViewData["CrumbTitle"] = T["Board"].Value;
    var labels = new Dictionary<string, string>();
    foreach (var key in Bingo.Web.Pages.Admin.Events.BoardModel.LabelKeys) labels[key] = T[key].Value;
    var view = Model.BoardView;
    var badge = Model.BoardMode switch
    {
        "draft" => ("Draft · private", "badge-neutral"),
        "approved" => ("Approved · private", "badge-success"),
        "published" => ("Published", "badge-success"),
        "correction" => ("Correction · private", "badge-warning"),
        _ => ((string?)null, "")
    };
}
@section HeaderTitle {
    <div class="bd-title-row"><h1 class="h1" id="page-h1" tabindex="-1">@T["Board"]</h1><span class="badge @badge.Item2" data-board-badge hidden="@(badge.Item1 is null)">@(badge.Item1 is null ? "" : T[badge.Item1].Value)</span></div>
}
@section HeaderSummary {
    @if (view is null)
    {
        <span>@T["No board recorded."]</span>
    }
    else
    {
        <span>@view.Rows × @view.Columns</span><span>@T["{0} of {1} tiles", Model.Tiles.Count, view.Rows * view.Columns]</span>
    }
}
@section HeaderActions { <div class="bd-head-acts" data-board-acts></div> }
<div data-board data-view="@Model.ViewJsonText()" data-labels="@JsonSerializer.Serialize(labels)">
    <form data-board-fields hidden>
        <input type="hidden" name="BoardVersion" value="@(view?.Version ?? 0)" />
        <input type="hidden" name="ApprovalCatalogueFingerprint" value="@Model.ApprovalCatalogueFingerprint" />
    </form>
    @if (view is null)
    {
        <div data-board-none></div>
    }
    <div data-board-banner></div>
    <div data-board-move></div>
    <div class="bd-work" data-board-work hidden="@(view is null)">
        <section class="card bd-board" aria-label="@T["Board layout"]">
            <div class="bgrid" id="bgrid" role="grid" aria-describedby="grid-help" style="--cols:@(view?.Columns ?? 5)">
                @for (var i = 0; i < (view is null ? 0 : view.Rows * view.Columns); i++) { <div class="bcell" aria-hidden="true"><div class="sk bd-sk"></div></div> }
            </div>
            <p class="bd-help" id="grid-help"></p>
        </section>
        <aside class="bd-side">
            <section class="card plan" aria-labelledby="plan-title" data-board-plan>
                <h2 class="sec-title" id="plan-title">@T["Planning"]</h2>
                <div class="plan-total"><b data-plan-total>@(Model.Statistics?.TotalEhb.ToString("0.#"))</b><span>@T["EHB on the board"]</span></div>
                <dl class="plan-list">
                    <div class="plan-row"><dt><label for="team-size" id="team-size-lbl">@T["Players per team"]</label></dt><dd data-plan-size></dd></div>
                    <div class="field-err" id="team-size-err" data-plan-size-err hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /><span data-text></span></div>
                    <div class="plan-row"><dt>@T["EHB per player"]</dt><dd data-plan-per-player></dd></div>
                    <div class="plan-row"><dt>@T["Per player each day"]</dt><dd data-plan-per-day></dd></div>
                    <div class="plan-row"><dt>@T["Line spread"]</dt><dd data-plan-spread></dd></div>
                </dl>
                <p class="field-hint" id="team-size-hint" data-plan-hint></p>
                <button class="disc-btn bd-plan-more" id="plan-more" type="button" aria-expanded="false" aria-controls="plan-more-list"><span class="sec-aside">@T["More figures"]</span><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></button>
                <dl class="kv" id="plan-more-list" hidden></dl>
            </section>
        </aside>
    </div>
    <p class="sr" aria-live="polite" data-board-live></p>
    <div class="menu" id="board-more-menu" role="menu" aria-label="@T["More board actions"]" hidden></div>
    @foreach (var name in new[] { "eye", "more", "plus", "minus", "move", "lock", "warning", "error", "info", "check", "close", "challenge", "drops", "arrow-up", "arrow-down", "image", "search", "chevron-down", "uncertain" })
    {
        <template data-board-icon="@name"><partial name="_AdminDesignIcon" model='new AdminDesignIcon(name, "ic")' /></template>
    }
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-board.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-board.js" asp-append-version="true" data-admin-page-script></script> }
