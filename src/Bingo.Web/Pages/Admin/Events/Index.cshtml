@page
@model Bingo.Web.Pages.Admin.Events.IndexModel
@using Bingo.Web.UI
@{
    ViewData["Title"] = T["Events"];
    ViewData["CompactNavigation"] = true;
    ViewData["AdminPageDescription"] = T["Create and manage bingo events."];
}

@if (User.IsInRole("SuperAdmin"))
{
    <span data-admin-events-control hidden></span>
}

@section Scripts {
    <script src="~/js/admin-collaboration.js" asp-append-version="true"></script>
}

<section class="admin-events-page">
    <div class="admin-events-directory-controls">
        <form class="admin-events-toolbar" method="get" data-admin-event-directory-search>
            <div class="admin-search-field admin-events-search">
                <label class="visually-hidden" for="event-search">@T["Search events by name or slug"]</label>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                <input id="event-search" class="admin-search-field-input form-control" type="search" name="search" value="@Model.ActiveSearch" placeholder="@T["Search events by title or slug…"]" data-admin-event-search-input />
                <button class="admin-search-clear" type="button" data-admin-search-clear aria-label="@T["Clear event search"]" hidden="@(string.IsNullOrWhiteSpace(Model.ActiveSearch) ? "hidden" : null)"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg></button>
            </div>
            <div class="admin-events-state-filter admin-field">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                <label for="event-state">@T["State"]:</label>
                <div class="admin-events-state-select">
                    <select id="event-state" class="admin-filter-select form-select" name="filter" data-admin-event-state-filter>
                        @foreach (var option in Model.StateOptions)
                        {
                            <option value="@option.Value" selected="@(Model.ActiveFilter == option.Value ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                    <svg class="admin-events-state-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                </div>
            </div>
        </form>
        <a class="admin-button-create" asp-page="Create">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
            <span>@T["Create New Event"]</span>
        </a>
    </div>

    <div class="admin-events-table-wrap">
        @if (Model.Events.Count == 0)
        {
            <div class="event-list-empty" role="status" aria-live="polite">
                <h2>@T["No matching events"]</h2>
                <p>@T["Change the search or state filter, or create a new event."]</p>
            </div>
        }
        else
        {
            <div class="event-list-empty admin-local-filter-empty" data-admin-event-filter-empty role="status" aria-live="polite" hidden>
                <h2>@T["No matching events"]</h2>
                <p>@T["Change the search or state filter."]</p>
            </div>
            <div class="admin-events-table-scroll">
                <table class="event-table" data-admin-event-table>
                    <thead>
                        <tr>
                            <th aria-sort='@Model.AriaSort("identity")'>
                                <a class="admin-events-sort-link" data-admin-event-sort-link data-sort-key="identity" data-sort-label='@T["Event identity"]' asp-page="Index" asp-route-search="@Model.ActiveSearch" asp-route-filter="@Model.ActiveFilter" asp-route-sort="identity" asp-route-direction='@Model.NextSortDirection("identity")' aria-label='@Model.SortAriaLabel(T["Event identity"].Value, "identity")'>
                                    @T["Event identity"]
                                    @if (Model.IsActiveSort("identity")) { <svg class="admin-events-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="@Model.SortIconPath" /></svg> }
                                </a>
                            </th>
                            <th aria-sort='@Model.AriaSort("state")'>
                                <a class="admin-events-sort-link" data-admin-event-sort-link data-sort-key="state" data-sort-label='@T["State"]' asp-page="Index" asp-route-search="@Model.ActiveSearch" asp-route-filter="@Model.ActiveFilter" asp-route-sort="state" asp-route-direction='@Model.NextSortDirection("state")' aria-label='@Model.SortAriaLabel(T["State"].Value, "state")'>
                                    @T["State"]
                                    @if (Model.IsActiveSort("state")) { <svg class="admin-events-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="@Model.SortIconPath" /></svg> }
                                </a>
                            </th>
                            <th aria-sort='@Model.AriaSort("dates")'>
                                <a class="admin-events-sort-link" data-admin-event-sort-link data-sort-key="dates" data-sort-label='@T["Event dates"]' asp-page="Index" asp-route-search="@Model.ActiveSearch" asp-route-filter="@Model.ActiveFilter" asp-route-sort="dates" asp-route-direction='@Model.NextSortDirection("dates")' aria-label='@Model.SortAriaLabel(T["Event dates"].Value, "dates")'>
                                    @T["Event dates"]
                                    @if (Model.IsActiveSort("dates")) { <svg class="admin-events-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="@Model.SortIconPath" /></svg> }
                                </a>
                            </th>
                            <th aria-sort='@Model.AriaSort("signups")'>
                                <a class="admin-events-sort-link" data-admin-event-sort-link data-sort-key="signups" data-sort-label='@T["Signups"]' asp-page="Index" asp-route-search="@Model.ActiveSearch" asp-route-filter="@Model.ActiveFilter" asp-route-sort="signups" asp-route-direction='@Model.NextSortDirection("signups")' aria-label='@Model.SortAriaLabel(T["Signups"].Value, "signups")'>
                                    @T["Signups"]
                                    @if (Model.IsActiveSort("signups")) { <svg class="admin-events-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="@Model.SortIconPath" /></svg> }
                                </a>
                            </th>
                            <th class="event-needs-attention-heading" aria-sort='@Model.AriaSort("attention")'>
                                <a class="admin-events-sort-link" data-admin-event-sort-link data-sort-key="attention" data-sort-label='@T["Needs attention"]' asp-page="Index" asp-route-search="@Model.ActiveSearch" asp-route-filter="@Model.ActiveFilter" asp-route-sort="attention" asp-route-direction='@Model.NextSortDirection("attention")' aria-label='@Model.SortAriaLabel(T["Needs attention"].Value, "attention")'>
                                    @T["Needs attention"]
                                    @if (Model.IsActiveSort("attention")) { <svg class="admin-events-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="@Model.SortIconPath" /></svg> }
                                </a>
                            </th>
                            <th class="event-actions-heading"><span class="event-actions-heading-label">@T["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Events)
                        {
                            var statePill = AdminEventStatePresentation.For(item.State, T);
                            var playerSummary = item.Waiting > 0
                                ? T["{0} / {1} players · {2} waiting", item.Confirmed, item.ParticipantCap, item.Waiting]
                                : T["{0} / {1} players", item.Confirmed, item.ParticipantCap];
                            <tr data-admin-event-row data-event-id="@item.Id" data-event-name="@item.Name" data-event-slug="@item.Slug" data-event-state="@item.State.ToString().ToLowerInvariant()" data-event-hidden="@item.IsHidden.ToString().ToLowerInvariant()" data-event-state-order="@((int)item.State)" data-event-start="@item.EventStartsAt?.UtcTicks" data-event-end="@item.EventEndsAt?.UtcTicks" data-event-confirmed="@item.Confirmed" data-event-waiting="@item.Waiting" data-event-cap="@item.ParticipantCap" data-event-attention="@item.PendingReviews">
                                <td data-label="@T["Event"]"><strong>@item.Name</strong><small>@item.Slug</small></td>
                                <td class="event-state-cell" data-label="@T["State"]"><span class="admin-status-pill @statePill.Modifier">@statePill.Label</span></td>
                                <td data-label="@T["Event dates"]" class="event-date-cell @(item.EventStartsAt is null || item.EventEndsAt is null ? "is-incomplete" : null)"><strong>@Model.FormatDate(item.EventStartsAt, item.Timezone)</strong><small>@T["to"] @Model.FormatDate(item.EventEndsAt, item.Timezone)</small></td>
                                <td data-label="@T["Signups"]" class="event-signup-cell"><strong>@Model.SignupSummary(item)</strong><small>@playerSummary</small></td>
                                <td data-label="@T["Needs attention"]">
                                    @if (item.PendingReviews > 0)
                                    {
                                        <span class="attention-count">@T["{0} to review", item.PendingReviews]</span>
                                    }
                                    else
                                    {
                                        <span class="muted-value" aria-label="@T["Nothing needs attention"]">—</span>
                                    }
                                </td>
                                <td class="event-row-action"><a class="event-overview-row-action" asp-page="Manage" asp-route-id="@item.Id" asp-route-hidden="@(item.IsHidden ? "true" : null)">@(item.IsHidden ? T["Inspect"] : T["Workspace"])</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
