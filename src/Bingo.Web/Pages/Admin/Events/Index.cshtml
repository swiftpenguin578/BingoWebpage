@page
@model Bingo.Web.Pages.Admin.Events.IndexModel
@using Bingo.Domain.Events
@inject IStringLocalizer<AdminCommunityResource> D
@{
    ViewData["Title"] = "Events";
    ViewData["LocalizedTitle"] = D["Events"].Value;
    var views = new[] { ("all", "All", Model.VisibleCount), ("current", "Current & upcoming", Model.CurrentCount), ("past", "Past", Model.PastCount) };
    var columns = new[] { ("identity", "Event", "c-name"), ("state", "Phase", ""), ("dates", "Dates", ""), ("signups", "Participants", ""), ("attention", "Needs attention", "") };
    var hasFilters = Model.ActiveSearch.Length > 0 || Model.ActiveFilter != "all" || Model.ActiveAttention;
    var emptyTitle = hasFilters ? "No matching events" : Model.ActiveView == "hidden" ? "No hidden events" : Model.VisibleCount == 0 ? "No events yet" : Model.ActiveView == "current" ? "Nothing current or upcoming" : "No past events yet";
    var emptyText = hasFilters ? "Try a different search or clear the filters." : Model.ActiveView == "hidden" ? "Quarantined events appear here. They’re excluded from every other view, count and the Dashboard." : Model.VisibleCount == 0 ? "Create your first event. It starts as a private draft, so you can set it up before anyone sees it." : Model.ActiveView == "current" ? "Live events and events in setup or signups appear here." : "Events appear here once they reach final review, finish, are archived or are cancelled.";
}
@section HeaderSummary {
    @if (Model.VisibleCount == 0) { <span>@D["No events yet"]</span> }
    else {
        <span><b class="tnum">@Model.LiveCount</b> @D["Live"].Value.ToLower(CultureInfo.CurrentCulture)</span>
        <span><b class="tnum">@Model.UpcomingCount</b> @D["upcoming or in setup"]</span>
        @if (Model.AttentionCount > 0) { <button type="button" class="summary-btn" aria-pressed="@Model.ActiveAttention.ToString().ToLowerInvariant()" data-directory-url="@Model.DirectoryUrl(attention: !Model.ActiveAttention)"><span class="dot"></span><span><b class="tnum">@Model.AttentionCount</b> @D["need attention"]</span></button> }
        else if (!Model.ActionProjectionUnavailable) { <span>@D["Nothing needs attention"]</span> }
    }
}
@section HeaderActions {
    <div class="head-actions"><a class="btn btn-primary" href="/Admin/Events/Create" data-create-event><partial name="_AdminDesignIcon" model='new AdminDesignIcon("plus")' />@D["Create event"]</a></div>
}
<div data-events-directory data-directory-canonical="@Model.DirectoryUrl(page: Model.PageNumber)" data-sort-announcement="@(Model.ActiveSort.Length == 0 ? "" : D["Sorted by {0}, {1}.", D[columns.Single(column => column.Item1 == Model.ActiveSort).Item2].Value, D[Model.ActiveSortDirection == "desc" ? "descending" : "ascending"].Value])">
<span class="sr" aria-live="polite" data-sort-status></span>
<div data-directory-banners class="directory-fragments">
@if (Model.DroppedLinkParts) { <div class="banner is-info page-banner" role="status"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("info")' /><span class="grow">@D["Some parts of this link weren’t available and were cleared. The remaining filters still apply."]</span></div> }
@if (Model.ActionProjectionUnavailable) { <div class="banner is-info page-banner" role="status"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("info")' /><span class="grow">@D["Some attention counts could not be loaded. Events are shown, but attention information may be incomplete."]</span><button type="button" class="btn btn-sm" data-directory-url="@Model.DirectoryUrl(page: Model.PageNumber)">@D["Try again"]</button></div> }
</div>
<div class="toolbar">
    <div class="tabs" role="radiogroup" aria-label="@D["Events view"]">
    @foreach (var (key, label, count) in views) {
        <label class="tab @(Model.ActiveView == key ? "is-on" : "")"><input class="sr" type="radio" name="view-tab" checked="@(Model.ActiveView == key)" data-directory-url="@Model.DirectoryUrl(view: key)"><span>@D[label]</span><span class="tab-count">@count</span></label>
    }
    @if (Model.IsSuperAdmin) { <span class="tab-sep" aria-hidden="true"></span><label class="tab @(Model.ActiveView == "hidden" ? "is-on" : "")" title="@D["SuperAdmin only: quarantined events"]"><input class="sr" type="radio" name="view-tab" checked="@(Model.ActiveView == "hidden")" data-directory-url="@Model.DirectoryUrl(view: "hidden")"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("hidden")' /><span>@D["Hidden"]</span><span class="tab-count">@Model.HiddenCount</span></label> }
    </div>
    <div class="tbar-right">
    <span data-directory-chips class="directory-fragments">
    @if (Model.ActiveAttention) { <button class="filter-chip" type="button" data-directory-url="@Model.DirectoryUrl(attention: false)" aria-label="@D["Remove filter: needs attention"]">@D["Needs attention"]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button> }
    </span>
    <div class="search @(Model.ActiveSearch.Length > 0 ? "has-clear" : "")"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("search")' /><input class="input" id="search-input" type="search" placeholder="@D["Search event names"]" aria-label="@D["Search event names"]" value="@Model.ActiveSearch" data-directory-search>
    <button class="icon-btn clear" type="button" data-directory-clear hidden="@(Model.ActiveSearch.Length == 0)" aria-label="@D["Clear search"]"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("close")' /></button>
    </div>
    <button class="btn filter-btn @(Model.ActiveFilter != "all" ? "is-active" : "")" id="phase-btn" type="button" data-menu-target="directory-phase-menu" data-menu-align="end" aria-haspopup="menu" aria-expanded="false"><span class="fb-lbl">@D["Phase"]</span>@D[Model.ActiveFilter == "all" ? "All" : Model.StateOptions.Single(option => option.Value == Model.ActiveFilter).Label]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></button>
    <div class="menu" id="directory-phase-menu" role="menu" aria-label="@D["Filter by phase"]" hidden>
    @foreach (var phase in Model.StateOptions) { <button class="menu-item" type="button" role="menuitemradio" aria-checked="@(Model.ActiveFilter == phase.Value ? "true" : "false")" data-directory-url="@Model.DirectoryUrl(phase: phase.Value)"><span class="grow">@D[phase.Label]</span>@if (Model.ActiveFilter == phase.Value) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check")' /> }</button> }
    </div>
    </div>
</div>
<div class="card"><div class="tbl-wrap" data-directory-wrap><div class="tbl ev-tbl sticky-first" role="table" aria-label="@D["Events"]" aria-rowcount="@(Model.TotalCount + 1)">
<div class="tr th-row" role="row">
@foreach (var (key, label, cls) in columns) {
    var next = Model.IsActiveSort(key) ? Model.NextSortDirection(key) : key is "attention" or "signups" ? "desc" : "asc";
    <div class="th @cls @(Model.IsActiveSort(key) ? "is-sorted" : "")" role="columnheader" aria-sort="@Model.AriaSort(key)"><button class="th-btn" id="directory-sort-@key" type="button" data-directory-url="@Model.DirectoryUrl(sort: key, direction: next)" aria-label="@D["Sort by {0}, {1}", D[label].Value, D[next == "desc" ? "descending" : "ascending"].Value]">@D[label]<svg class="ic sort-ic @(Model.IsActiveSort(key) ? Model.ActiveSortDirection == "asc" ? "is-asc" : "is-desc" : "")" viewBox="0 0 16 16"><path d="M4.5 10 8 6.5l3.5 3.5"/></svg></button></div>
}
</div>
<div data-directory-results>
@if (Model.Events.Count > 0) {
<div class="rows" role="rowgroup">
@foreach (var item in Model.Events) {
    var state = item.State switch {
        EventState.Draft => ("Setup", "badge-neutral"), EventState.SignupOpen => ("Signups open", "badge-success"),
        EventState.SignupClosed => ("Signups closed", "badge-neutral"), EventState.Live => ("Live", "badge-accent"),
        EventState.AwaitingFinalReview => ("Final review", "badge-warning"), EventState.Finalized => ("Finished", "badge-neutral"),
        EventState.Archived => ("Archived", "badge-outline"), _ => ("Cancelled", "badge-outline")
    };
    var overview = $"/Admin/Events/Manage/{item.Id}" + (item.IsHidden ? "?hidden=true" : "");
    var context = Model.ContextDate(item);
    var sub = Model.PeopleSub(item);
    var labels = Model.AttentionLabels(item);
    <div class="tr row @(item.State == EventState.Cancelled ? "is-cancelled" : "")" role="row" aria-rowindex="@(Model.FirstRow + Model.Events.ToList().IndexOf(item) + 1)" data-event-id="@item.Id" data-event-hidden="@(item.IsHidden ? "true" : "false")" data-open-url="@overview">
        <div class="td c-name" role="cell"><div class="name-line"><a class="name-btn" id="open-@item.Id" href="@overview" title="@item.Name">@item.Name</a>@if (item.Participation?.IsHistoricalImport == true) { <span class="pill is-neutral" title="@D["Imported history from before the platform"]">@D["Imported"]</span> }</div>@if (item.HiddenAt is { } hiddenAt) { <div class="sub">@D["Hidden {0}", DateTimePresentation.Format(hiddenAt, "d MMM yyyy", item.Timezone, CultureInfo.CurrentCulture)]</div> }</div>
        <div class="td" role="cell"><span class="badge @state.Item2">@D[state.Item1]</span></div>
        <div class="td td-dates" role="cell"><div class="cell-main @(item.EventStartsAt is null ? "is-muted" : "")">@Model.Range(item)</div>@if (context.Length > 0) { <div class="sub">@context</div> }</div>
        <div class="td" role="cell">
        @if (item.IsPreparation && item.ParticipantCap is { } cap) { <div class="meter" title="@D["{0} of {1} places confirmed", item.Confirmed, cap]"><div class="meter-track" style="--meter-w:44px"><div class="meter-fill" style="width:@(Bingo.Web.Pages.Admin.IndexModel.Percent(cap > 0 ? Math.Min(1m, (decimal)item.Confirmed / cap) : 0))%"></div></div><span class="meter-label @(item.State == EventState.Draft && item.Confirmed == 0 ? "is-muted" : "")">@Model.PeopleMain(item)</span></div> }
        else { <div class="cell-main tnum @(item.ParticipantCount is null || item.State == EventState.Cancelled || item.IsPreparation && item.Confirmed == 0 ? "is-muted" : "")">@Model.PeopleMain(item)</div> }
        @if (sub.Length > 0) { <div class="sub">@sub</div> }
        </div>
        <div class="td" role="cell">@if (labels.Count == 0) { <span class="attn-none" title="@D["Nothing needs attention"]"><span aria-hidden="true">—</span><span class="sr">@D["Nothing needs attention"]</span></span> }
        else { <div class="attn @(item.ScheduledStartPostponed || item.ScheduledOpeningFailed ? "is-failure" : "is-pending")"><span class="attn-main">@if (item.ScheduledStartPostponed || item.ScheduledOpeningFailed) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /> } else { <span class="dot" aria-hidden="true"></span> }<span class="attn-text">@labels[0]</span></span>@if (labels.Count > 1) { var more = string.Join(", ", labels.Skip(1)); <span class="hint attn-more tip-end" tabindex="0" aria-label="@D["{0} more: {1}", labels.Count - 1, more]">· +@(labels.Count - 1)<span class="hint-tip" aria-hidden="true">@D["Also: {0}. The event’s Overview explains everything.", more]</span></span> }</div> }</div>
    </div>
}
</div>
}
else { <div class="empty" role="row"><div role="cell" style="display:contents"><div class="empty-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon(hasFilters ? "search" : Model.ActiveView == "hidden" ? "hidden" : "calendar")' /></div><div class="empty-title">@D[emptyTitle]</div><div class="empty-text">@D[emptyText]</div>@if (hasFilters) { <button type="button" class="btn" data-directory-url="@Model.DirectoryUrl(view: Model.ActiveView == "hidden" ? "hidden" : "all", phase: "all", search: "", attention: false)">@D["Clear filters"]</button> } else if (Model.ActiveView != "hidden" && (Model.VisibleCount == 0 || Model.ActiveView == "current")) { <a class="btn @(Model.VisibleCount == 0 ? "btn-primary" : "")" href="/Admin/Events/Create" data-create-event>@D["Create event"]</a> }</div></div> }
</div></div></div>
<div data-directory-footer>
@if (Model.TotalCount > 0) { <div class="tfoot"><div class="tfoot-left"><span class="tnum" aria-live="polite">@(Model.PageCount == 1 ? D["{0} events", Model.TotalCount] : D["{0}–{1} of {2} events", Model.FirstRow, Model.LastRow, Model.TotalCount])</span>@if (Model.ActiveSort.Length > 0) { <span class="tfoot-note">· @D["Sorted by {0}", D[columns.Single(column => column.Item1 == Model.ActiveSort).Item2].Value]</span><button type="button" class="btn btn-quiet btn-sm" data-directory-url="@Model.DirectoryUrl(sort: "", direction: "asc")">@D["Default order"]</button> }</div>@if (Model.PageCount > 1) { <nav class="pager" aria-label="@D["Pagination"]"><button type="button" class="pg" aria-label="@D["Previous page"]" disabled="@(Model.PageNumber == 1)" data-directory-url="@Model.DirectoryUrl(page: Model.PageNumber - 1)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-left")' /></button>@for (var page = 1; page <= Model.PageCount; page++) { <button type="button" class="pg @(page == Model.PageNumber ? "is-current" : "")" aria-current="@(page == Model.PageNumber ? "page" : null)" aria-label="@D["Page {0}", page]" data-directory-url="@Model.DirectoryUrl(page: page)">@(page)</button> }<button type="button" class="pg" aria-label="@D["Next page"]" disabled="@(Model.PageNumber == Model.PageCount)" data-directory-url="@Model.DirectoryUrl(page: Model.PageNumber + 1)"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></button></nav> }</div> }
</div></div></div>
<partial name="_AdminEventCreateTemplate" model="Model" />
@section Styles { <link rel="stylesheet" href="~/css/admin-design-events.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-events.js" asp-append-version="true" data-admin-page-script></script> }
