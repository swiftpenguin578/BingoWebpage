@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.FinalizeModel
@using Bingo.Application.Events
@using Bingo.Domain.Events
@using Bingo.Domain.Integrations.WiseOldMan
@using Bingo.Web.UI
@{
    ViewData["Title"] = "Final review";
    ViewData["PageFamily"] = "final-review";
    var r = Model.Readiness;
    var active = Model.ActiveResult;
    var rows = Model.Rows;
    var phase = AdminDesignPhasePresentation.For(r.State);
    var nextVersion = r.History.Count == 0 ? 1 : r.History.Max(x => x.Version) + 1;
    var pubBlocked = !r.CanFinalize && Model.Checks.Any(x => x.Class == "is-blocked");
    var pubIconClass = r.CanFinalize ? "is-ready" : pubBlocked ? "is-blocked" : "is-wait";
}
@section HeaderTitle { <div class="fr-title"><h1 class="h1" id="page-h1" tabindex="-1">@T["Final review"]</h1><span class="badge @phase.BadgeClass">@Model.Badge</span></div> }
@section HeaderSummary {
    @if (Model.Official && active is not null) { <span>@T["Published {0}", Model.Fmt(active.FinalizedAt)] · </span> }
    else if (r.State == EventState.AwaitingFinalReview) { <span>@T["Ended {0}", Model.Fmt(r.EventEndsAt)] · @(r.SubmissionWindowOpen ? T["Uploads close {0}", Model.Fmt(r.SubmissionCutoff)] : T["Closed {0}", Model.Fmt(r.SubmissionCutoff)]) · </span> }
    else if (r.State == EventState.Live) { <span>@T["Ends {0}", Model.Fmt(r.EventEndsAt)] · </span> }
    <span>@T["Times in {0}", Model.EventTimezone]</span>
}
<div class="fr-content" data-final-review data-current="@Model.CurrentJson" data-labels="@Model.LabelsJson" data-event-id="@r.EventId" data-timezone="@Model.EventTimezone">
    <div class="banner is-warning" data-final-notice role="status" tabindex="-1" hidden></div>
    @if (r.State == EventState.Cancelled) { <div class="banner is-info"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("lock")' /><span>@T["This event was cancelled. Results are read-only."]</span></div> }
    @if (Model.Official)
    {
        <section class="card fr-official" aria-labelledby="official-title">
            <div class="fr-official-main"><div class="fr-official-ic" aria-hidden="true"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("trophy")' /></div><div class="grow"><h2 class="fr-pub-title" id="official-title" tabindex="-1">@(active is null ? T["Official results"] : T["Official results · version {0}", active.Version])</h2>
                @if (active is not null) { <p class="fr-pub-sub">@T["Published {0} by {1}", Model.Fmt(active.FinalizedAt), active.FinalizedByUsername ?? "—"]</p> }
                <p class="fr-pub-sub">@T[r.State == EventState.Finalized ? "Official results are read-only. Complete the legacy publication to archive the event, or reopen for corrections." : "Official results are read-only. Reopen only when a correction is needed."]</p>
            </div></div>
            @if (active?.FinalWomRefresh is { Status: not FinalWomRefreshStatus.Succeeded } refresh) { <p class="fr-official-note fr-wom-note"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("warning")' /><span>@T[FinalizeModel.FinalWomRefreshDescription(refresh)]</span></p> }
            @if (r.State == EventState.Finalized)
            {
                <form method="post" asp-page-handler="Finalize" data-final-action="publish" data-cancel-label="@T["Cancel"]" data-reason-label="@T["Reason"]" data-confirm-title="@T["Complete legacy publication"]" data-confirm-description="@T["Archive this event while retaining its existing official results."]" data-confirm-action="@T["Complete publication"]" data-confirm-field="ConfirmLifecycleAction">
                    <input type="hidden" name="ExpectedVersion" value="@r.EventVersion" /><input type="hidden" name="ConfirmLifecycleAction" value="false" data-confirm-field-value /><button class="btn btn-primary" type="submit">@T["Complete publication"]</button>
                </form>
            }
        </section>
    }
    else if (r.State != EventState.Cancelled)
    {
        <section class="card" aria-labelledby="pub-title">
            <div class="fr-pub-head"><div class="fr-pub-ic @pubIconClass" aria-hidden="true"><partial name="_AdminDesignIcon" model='new AdminDesignIcon(r.CanFinalize ? "check" : pubBlocked ? "warning" : "schedule")' /></div><div class="fr-pub-text"><h2 class="fr-pub-title" id="pub-title" tabindex="-1">@Model.PublicationTitle</h2><p class="fr-pub-sub">@T["Publishing makes these standings official as version {0} and archives the event.", nextVersion]</p></div>
                @if (r.State == EventState.AwaitingFinalReview)
                {
                    <form method="post" asp-page-handler="Finalize" class="fr-pub-act" data-final-action="publish" data-cancel-label="@T["Cancel"]" data-reason-label="@T["Reason"]" data-confirm-title="@T["Publish official results"]" data-confirm-description="@T["Publish these placements as the official results and archive the event in one step?"]" data-confirm-action="@T["Publish official results"]" data-confirm-field="ConfirmLifecycleAction">
                        <input type="hidden" name="ExpectedVersion" value="@r.EventVersion" /><input type="hidden" name="ConfirmLifecycleAction" value="false" data-confirm-field-value />
                        <button class="btn btn-primary" id="publish-btn" type="submit" disabled="@(!r.CanFinalize)" aria-describedby="pub-why">@T["Publish official results…"]</button><span class="fr-pub-why" id="pub-why">@T[r.CanFinalize ? "One confirmation. No reason needed." : "Resolve the items below first."]</span>
                    </form>
                }
            </div>
            <ul class="checklist fr-checks" aria-label="@T["Publication requirements"]">
                @foreach (var check in Model.Checks)
                {
                    <li class="check-item @check.Class"><span class="check-mark" aria-hidden="true"><partial name="_AdminDesignIcon" model='new AdminDesignIcon(check.Class == "is-done" ? "check" : check.Class == "is-wait" ? "schedule" : "error")' /></span><span class="grow"><span class="check-label">@check.Title</span><span class="check-sub">@check.Description</span></span>
                        @if (check.Link is not null) { <a class="btn btn-sm" href="@check.Link" data-shell-link>@T[check.Link.Contains("/Review", StringComparison.Ordinal) ? "Open Review" : check.Link.Contains("/Board", StringComparison.Ordinal) ? "Open Board" : "Open records"]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></a> }
                    </li>
                }
            </ul>
        </section>
    }
    <section class="card fr-standings" aria-labelledby="st-title">
        <div class="fr-card-head"><div><h2 class="sec-title" id="st-title">@T[Model.Official ? "Official results" : r.State == EventState.Live ? "Live standings" : "Provisional standings"]</h2><p class="fr-st-sub">@T[Model.Official ? "Stored exactly as published." : "Calculated from approved evidence. They change if a review decision changes."]</p></div><button type="button" class="text-btn fr-how-btn" id="how-btn" aria-expanded="false" aria-controls="how-body">@T["How placements are decided"]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-down")' /></button></div>
        <div class="fr-how" id="how-body" hidden><ol class="fr-how-list"><li>@T["Completed boards first, then earlier completion."]</li><li>@T["More completed lines, then more completed tiles."]</li><li>@T[r.PlacementRule == PlacementRule.CreditedEhbThenScoreTime ? "More credited EHB, then earlier current-score time." : "Earlier current-score time, then more credited EHB."]</li></ol><p class="fr-how-note">@T["Exact equality on every competitive input shares the place. Team names only order tied rows."]</p></div>
        @if (rows.Count > 0)
        {
            <div class="tbl-wrap is-scroll"><div class="tbl fr-tbl sticky-first" role="table" aria-label="@T["Standings"]">
                <div class="tr th-row" role="row"><div class="th c-name" role="columnheader">@T["Place and team"]</div><div class="th" role="columnheader">@T["Full board"]</div><div class="th fr-num" role="columnheader">@T["Lines"]</div><div class="th fr-num" role="columnheader">@T["Tiles"]</div><div class="th fr-num" role="columnheader">@T["Credited EHB"]</div><div class="th" role="columnheader">@T["Score reached"]</div></div>
                <div class="rows" role="rowgroup">@foreach (var row in rows) { var value = row.Value;
                    <div class="tr row" role="row"><div class="td c-name" role="cell"><div class="fr-team"><span class="place @(value.Placement <= 3 ? "is-top is-" + value.Placement : "")">@row.Place</span><div><span class="cell-main fr-team-name">@value.TeamName</span><div class="cell-sub fr-why">@row.Explanation</div></div></div></div><div class="td" role="cell"><span class="tval @(row.Decider == "board" ? "is-decider" : "")">@(value.BoardComplete ? Model.Fmt(value.CalculatedCompletedAt) : T["Not completed"])</span></div><div class="td fr-num" role="cell"><span class="tval @(row.Decider == "lines" ? "is-decider" : "")">@value.CompletedLines</span></div><div class="td fr-num" role="cell"><span class="tval @(row.Decider == "tiles" ? "is-decider" : "")">@value.CompletedTiles</span></div><div class="td fr-num" role="cell"><span class="tval @(row.Decider == "ehb" ? "is-decider" : "")">@value.EhbTiebreak.ToString("0.####")</span></div><div class="td" role="cell"><span class="tval @(row.Decider == "score" ? "is-decider" : "")">@(value.BoardComplete ? T["At completion"] : value.CurrentScoreReachedAt is null ? "—" : Model.Fmt(value.CurrentScoreReachedAt))</span></div></div>
                }</div>
            </div></div><div class="tfoot"><span>@T["{0} teams", rows.Count]@if (rows.Any(x => x.Place.StartsWith('='))) { <span> · @T["{0} shared", string.Join(", ", rows.Where(x => x.Place.StartsWith('=')).Select(x => x.Place).Distinct())]</span> }</span></div>
        }
        else { <div class="empty"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("final")' /><div class="empty-title">@T["No standings yet"]</div><div class="empty-text">@T["Standings are calculated from the published board once the event is live."]</div><a class="btn" asp-page="Board" asp-route-id="@r.EventId" data-shell-link>@T["Open Board"]</a></div> }
    </section>
    @if (r.History.Count > 0)
    {
        <section class="card fr-hist" aria-labelledby="hist-title"><div class="fr-card-head"><h2 class="sec-title" id="hist-title">@T["Publication history"]</h2><span class="sec-aside">@(r.History.Count == 1 ? T["1 version"] : T["{0} versions", r.History.Count])</span></div><ol class="tl fr-tl">
            @foreach (var version in r.History)
            {
                @if (version.UnfinalizedAt is { } reopened) { <li class="tl-item"><div class="tl-what">@T["Version {0} reopened", version.Version]</div><div class="tl-when">@Model.Fmt(reopened) · @T["Reopened by {0}", version.UnfinalizedByUsername ?? "—"]</div><div class="tl-reason">@version.UnfinalizeReason</div></li> }
                <li class="tl-item"><div class="fr-tl-row"><div><div class="tl-what">@T["Version {0} published", version.Version] <span class="pill">@T[version.Active ? "Official" : "Retained"]</span></div><div class="tl-when">@Model.Fmt(version.FinalizedAt) · @T["Published by {0}", version.FinalizedByUsername ?? "—"]</div>@if (version.FinalWomRefresh is { Status: not FinalWomRefreshStatus.Succeeded } outcome) { <div class="fr-tl-note">@T[FinalizeModel.FinalWomRefreshDescription(outcome)]</div> }</div><a class="btn btn-sm btn-quiet" href="?version=@version.Version" data-final-version="@version.Version">@T["View results"]</a></div></li>
            }
        </ol></section>
    }
    @if (Model.Official && active is not null)
    {
        <section class="card fr-reopen" aria-labelledby="reopen-title"><div class="act-row"><div class="act-text"><h2 class="sec-title" id="reopen-title">@T["Reopen for corrections"]</h2><p class="fr-reopen-text">@T["Exceptional. Returns the event to provisional final review and keeps version {0} in history. It doesn’t restart the event or reopen uploads.", active.Version]</p>
            @if (r.BlockingCurrentEvent is { } blocking) { <p id="reopen-why" class="fr-reopen-block"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("lock")' /><span>@Model.BlockingReason <a asp-page="Manage" asp-route-id="@blocking.Id" data-shell-link>@T["Open event"]</a></span></p> }
        </div><form method="post" asp-page-handler="Unfinalize" data-final-action="reopen" data-cancel-label="@T["Cancel"]" data-reason-label="@T["Reason"]" data-confirm-title="@T["Reopen for corrections"]" data-confirm-description="@T["The current official snapshot remains retained in history."]" data-confirm-action="@T["Reopen for corrections"]" data-confirm-field="ConfirmLifecycleAction" data-confirm-reason-field="Reason" data-confirm-require-reason="true"><input type="hidden" name="ExpectedVersion" value="@r.EventVersion" /><input type="hidden" name="ConfirmLifecycleAction" value="false" data-confirm-field-value /><input type="hidden" name="Reason" /><button class="btn btn-outline-danger" id="reopen-btn" type="submit" disabled="@(r.BlockingCurrentEvent is not null)" aria-describedby="@(r.BlockingCurrentEvent is null ? null : "reopen-why")">@T["Reopen for corrections…"]</button></form></div></section>
    }
    @foreach (var version in r.History)
    {
        var sharedPlaces = version.Placements.GroupBy(x => x.Placement).Where(x => x.Count() > 1).Select(x => x.Key).ToHashSet();
        <template data-final-history="@version.Version">
            <p class="choice-sub">@T[version.Active ? "Official" : "Retained"] · @T["Published {0} by {1}", Model.Fmt(version.FinalizedAt), version.FinalizedByUsername ?? "—"]</p>
            @if (version.UnfinalizedAt is { } reopened) { <p>@T["Version {0} reopened", version.Version] · @Model.Fmt(reopened) · @T["Reopened by {0}", version.UnfinalizedByUsername ?? "—"]</p><p class="tl-reason">@version.UnfinalizeReason</p> }
            @if (version.FinalWomRefresh is { Status: not FinalWomRefreshStatus.Succeeded } outcome) { <p class="banner is-warning">@T[FinalizeModel.FinalWomRefreshDescription(outcome)]</p> }
            <div class="ro-list">@foreach (var row in version.Placements) { <div class="ro-row"><div><span class="place">@(sharedPlaces.Contains(row.Placement) ? "=" : "")@row.Placement</span> <strong>@row.TeamName</strong></div><span>@T["Lines"]: @row.CompletedLines · @T["Tiles"]: @row.CompletedTiles · @T["Credited EHB"]: @row.EhbTiebreak.ToString("0.####")<br />@T["Full board"]: @(row.BoardComplete ? Model.Fmt(row.BoardCompletedAt) : T["Not completed"]) · @T["Score reached"]: @(row.CurrentScoreReachedAt is null ? "—" : Model.Fmt(row.CurrentScoreReachedAt))</span></div> }</div>
        </template>
    }
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-final-review.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-final-review.js" asp-append-version="true" data-admin-page-script></script> }
