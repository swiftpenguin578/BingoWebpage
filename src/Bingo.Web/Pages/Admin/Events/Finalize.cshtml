@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.FinalizeModel
@using Bingo.Domain.Events
@{ViewData["Title"]=$"Finalize {Model.Readiness.EventName}";}
<section class="table-page finalization-page">
<div class="page-heading"><div><p class="eyebrow">Event closeout</p><h1>@Model.Readiness.EventName</h1><p>@Model.Readiness.State · event ended @Model.Readiness.EventEndsAt.ToLocalTime().ToString("g")</p></div><a class="btn btn-outline-light" asp-page="Manage" asp-route-id="@Model.Readiness.EventId">Back to event</a></div>

@if(Model.Readiness.State==EventState.AwaitingFinalReview){
<section class="panel"><div class="page-heading"><div><h2>Final-review checklist</h2><p>Items disappear automatically when their underlying records are fixed. Overrides record a reason without changing those records.</p></div><strong>@Model.Readiness.Blockers.Count(x=>!x.Resolved) remaining</strong></div>
@if(Model.Readiness.Blockers.Count==0){<p class="success-copy">Everything is ready for finalization.</p>}
<div class="review-checklist">@foreach(var blocker in Model.Readiness.Blockers){<article class="review-check @(blocker.Resolved?"resolved":"")"><div><h3>@(blocker.Resolved?"✓ ":"")@blocker.Title</h3><p>@blocker.Description</p>@if(blocker.Resolved){<small>Resolved manually: @blocker.ResolutionReason</small>}else if(blocker.Link is not null){<a class="btn btn-sm btn-outline-light" href="@blocker.Link">Open records</a>}</div>@if(!blocker.Resolved&&blocker.CanOverride){<form method="post" asp-page-handler="Resolve" class="form-stack" onsubmit="return confirm('Mark this final-review item resolved without changing its underlying records?');"><input type="hidden" name="blockerKey" value="@blocker.Key"/><input name="Reason" required placeholder="Why is it safe to continue?"/><button class="btn btn-sm btn-warning">Mark resolved anyway</button></form>}</article>}</div>
</section>}

<section class="panel"><div class="page-heading"><div><h2>@(Model.Readiness.State is EventState.Finalized or EventState.Archived?"Official placements":"Provisional placements")</h2><p>Board completion, completed rows and columns, tiles, then EHB.</p></div></div>
<div class="table-wrap"><table><thead><tr><th>Place</th><th>Team</th><th>Board</th><th>Completion</th><th>Lines</th><th>Tiles</th><th>EHB</th><th>Correction</th></tr></thead><tbody>@foreach(var row in Model.Readiness.Placements){var shownAt=(row.CorrectedCompletedAt??row.CalculatedCompletedAt)?.ToLocalTime();<tr><td>#@row.Placement</td><td>@row.TeamName</td><td>@(row.BoardComplete?"Complete":"Incomplete")</td><td>@if(row.CorrectedCompletedAt is not null){<span class="completion-correction"><small>Originally @row.CalculatedCompletedAt?.ToLocalTime().ToString("g")</small><strong>Corrected to @row.CorrectedCompletedAt.Value.ToLocalTime().ToString("g")</strong></span>}else{@(row.CalculatedCompletedAt?.ToLocalTime().ToString("g")??"—")}</td><td>@row.CompletedLines</td><td>@row.CompletedTiles</td><td>@row.EhbTiebreak.ToString("0.##")</td><td>@if(Model.Readiness.State==EventState.AwaitingFinalReview&&row.BoardComplete&&shownAt is not null){<form method="post" asp-page-handler="CorrectCompletion" class="completion-correction-form"><input type="hidden" name="teamId" value="@row.TeamId"/><label>Completion date and time<input class="form-control" type="text" name="correctedAtLocal" value="@shownAt.Value.ToString("yyyy-MM-dd HH:mm:ss")" data-date-time-picker data-min-date="@Model.Readiness.EventStartsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")" data-max-date="@Model.Readiness.EventEndsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")" autocomplete="off" required/></label><label>Reason<input class="form-control" name="Reason" placeholder="Why is this being corrected?" required/></label><button class="btn btn-sm btn-outline-light">Correct</button></form>}</td></tr>}</tbody></table></div></section>

@if(Model.Readiness.State==EventState.AwaitingFinalReview){<form method="post" asp-page-handler="Finalize" class="panel form-stack" onsubmit="return confirm('Publish these placements as the official historical results?');"><h2>Finalize official results</h2><p>This snapshots every placement and schedules captain accounts to expire after 24 hours.</p><button class="btn btn-warning" disabled="@(!Model.Readiness.CanFinalize)">Finalize and publish results</button></form>}
@if(Model.Readiness.State==EventState.Finalized){<div class="action-grid"><form method="post" asp-page-handler="Archive" class="panel form-stack" onsubmit="return confirm('Archive this finalized event?');"><h2>Archive event</h2><p>The event remains publicly visible as history.</p><button class="btn btn-primary">Archive</button></form><form method="post" asp-page-handler="Unfinalize" class="panel form-stack" onsubmit="return confirm('Reopen official results for corrections? The current snapshot remains in history.');"><h2>Reopen for corrections</h2><input name="Reason" required placeholder="Reason for unfinalizing"/><button class="btn btn-danger">Unfinalize</button></form></div>}
@if(Model.Readiness.State==EventState.Archived){<form method="post" asp-page-handler="Unfinalize" class="panel form-stack" onsubmit="return confirm('Reopen this archived event for corrections?');"><h2>Reopen archived event</h2><input name="Reason" required placeholder="Reason for reopening"/><button class="btn btn-danger">Unfinalize</button></form>}

@if(Model.Readiness.History.Count>0){<section class="panel"><h2>Official result history</h2>@foreach(var version in Model.Readiness.History){<details open="@version.Active"><summary>Version @version.Version · @version.FinalizedAt.ToLocalTime().ToString("g") · @(version.Active?"active":"historical")</summary>@if(version.UnfinalizedAt is not null){<p>Reopened @version.UnfinalizedAt.Value.ToLocalTime().ToString("g"): @version.UnfinalizeReason</p>}<ol>@foreach(var row in version.Placements){<li>#@row.Placement @row.TeamName — @row.CompletedTiles tiles, @row.CompletedLines lines, @row.EhbTiebreak.ToString("0.##") EHB</li>}</ol></details>}</section>}
</section>
