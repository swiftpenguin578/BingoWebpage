@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.FinalizeModel
@using Bingo.Domain.Events
@using Bingo.Web.UI
@{
    ViewData["Title"] = T["Finalize {0}", Model.Readiness.EventName];
    ViewData["CompactNavigation"] = true;
    ViewData["AdminPageDescription"] = T["Review and publish official event results."];

    var outstandingBlockers = Model.Readiness.Blockers.Count(x => !x.Resolved);
    var statePill = AdminEventStatePresentation.For(Model.Readiness.State, T);
    var stateClass = Model.Readiness.State switch
    {
        EventState.AwaitingFinalReview => "is-review",
        EventState.Finalized => "is-finalized",
        EventState.Archived => "is-archived",
        _ => "is-muted"
    };
}

<section class="finalize-page @stateClass" aria-labelledby="finalize-page-heading">
    <header class="finalize-page-header">
        <div class="finalize-page-context">
            <p class="finalize-kicker">@T["Event closeout"]</p>
            <div class="finalize-title-row">
                <h1 id="finalize-page-heading">@Model.Readiness.EventName</h1>
                <span class="admin-status-pill @statePill.Modifier">@statePill.Label</span>
            </div>
            <p class="finalize-page-meta">@Model.Readiness.State · @T["Event ended"] @(Model.Readiness.EventEndsAt is { } eventEnd ? DateTimePresentation.Format(eventEnd, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture) : T["Not set"])</p>
        </div>
        <a class="admin-button-secondary finalize-back-link" asp-page="Manage" asp-route-id="@Model.Readiness.EventId">@T["Back to event workspace"]</a>
    </header>

    @if (Model.Readiness.State == EventState.AwaitingFinalReview)
    {
        <section class="finalize-surface finalize-readiness" aria-labelledby="finalize-readiness-heading">
            <header class="finalize-section-heading">
                <div>
                    <p class="finalize-kicker">@T["Readiness"]</p>
                    <h2 id="finalize-readiness-heading">@T["Final-review checklist"]</h2>
                    <p>@T["Resolve the submission and board records shown here before publishing official results. Calculated ranking facts are authoritative."]</p>
                </div>
                <div class="finalize-readiness-count" aria-label="@T["{0} remaining blockers", outstandingBlockers]">
                    <strong>@outstandingBlockers</strong>
                    <span>@T["remaining"]</span>
                </div>
            </header>

            @if (Model.Readiness.Blockers.Count == 0)
            {
                <p class="finalize-inline-status is-success" role="status">@T["Everything is ready for finalization."]</p>
            }
            else
            {
                <div class="finalize-checklist">
                    @foreach (var blocker in Model.Readiness.Blockers)
                    {
                        <article class="finalize-checklist-item @(blocker.Resolved ? "is-resolved" : "is-blocked")">
                            <div class="finalize-checklist-copy">
                            <div class="finalize-checklist-title">
                                    <span class="finalize-checklist-mark" aria-hidden="true"></span>
                                    <h3>@blocker.Title</h3>
                                </div>
                                <p>@blocker.Description</p>
                                @if (blocker.Link is not null)
                                {
                                    <a class="admin-button-secondary finalize-inline-action" href="@blocker.Link">@T["Open records"]</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    <section class="finalize-surface finalize-placements" aria-labelledby="finalize-placements-heading">
        <header class="finalize-section-heading">
            <div>
                <p class="finalize-kicker">@T["Results ledger"]</p>
                <h2 id="finalize-placements-heading">@(Model.Readiness.State is EventState.Finalized or EventState.Archived ? T["Official placements"] : T["Provisional placements"])</h2>
                <p>@T[Model.Readiness.PlacementRule == PlacementRule.CreditedEhbThenScoreTime ? "Rank order: completed boards by effective finish time, then completed rows and columns, completed tiles, EHB, and current score time." : "Rank order: completed boards by effective finish time, then completed rows and columns, completed tiles, current score time, and EHB."]</p>
            </div>
            <span class="finalize-section-note">@Model.Readiness.Placements.Count teams</span>
        </header>
        <div class="finalize-table-wrap">
            <table class="finalize-placements-table">
                <thead>
                    <tr>
                        <th scope="col">@T["Place"]</th>
                        <th scope="col">@T["Team"]</th>
                        <th scope="col">@T["board"]</th>
                        <th scope="col">@T["Completion"]</th>
                        <th scope="col">@T["Lines"]</th>
                        <th scope="col">@T["Tiles"]</th>
                        <th scope="col">@T["Score time"]</th>
                        <th scope="col">@T["EHB"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Readiness.Placements)
                    {
                        <tr>
                            <td data-label="@T["Place"]"><strong>#@row.Placement</strong></td>
                            <td data-label="@T["Team"]"><strong>@row.TeamName</strong></td>
                            <td data-label="@T["board"]"><span class="finalize-value-tone @(row.BoardComplete ? "is-success" : "is-warning")">@(row.BoardComplete ? T["Complete"] : T["Incomplete"])</span></td>
                            <td data-label="@T["Completion"]">
                                <span>@(row.CalculatedCompletedAt is { } calculated ? DateTimePresentation.Format(calculated, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture) : "—")</span>
                            </td>
                            <td data-label="@T["Lines"]"><span>@row.CompletedLines</span></td>
                            <td data-label="@T["Tiles"]"><span>@row.CompletedTiles</span></td>
                            <td data-label="@T["Score time"]"><span>@(row.CurrentScoreReachedAt is { } scoreTime ? DateTimePresentation.Format(scoreTime, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture) : "—")</span></td>
                            <td data-label="EHB"><span>@row.EhbTiebreak.ToString("0.##")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.Readiness.State == EventState.AwaitingFinalReview)
    {
        <form method="post" asp-page-handler="Finalize" class="finalize-surface finalize-publish-form" data-lifecycle-confirm data-confirm-title="@T["Publish official results"]" data-confirm-description="@T["Publish the calculated placements as immutable official history and archive this event?"]" data-confirm-action="@T["Publish and archive results"]" data-confirm-field="ConfirmLifecycleAction">
            <input type="hidden" asp-for="ExpectedVersion" value="@Model.Readiness.EventVersion" />
            <input type="hidden" name="ConfirmLifecycleAction" value="false" data-confirm-field-value />
            <div class="finalize-form-copy">
                <p class="finalize-kicker">@T["Publication"]</p>
                <h2>@T["Publish official results"]</h2>
                <p>@T["This snapshots every placement as immutable history and archives the event in the same transaction."]</p>
            </div>
            <div class="finalize-form-actions">
                <button class="admin-button-primary" type="submit" disabled="@(!Model.Readiness.CanFinalize ? "disabled" : null)">@T["Publish and archive results"]</button>
            </div>
        </form>
    }

    @if (Model.Readiness.State == EventState.Finalized)
    {
        <section class="finalize-surface finalize-lifecycle-form" aria-label="@T["Legacy lifecycle record"]">
            <div class="finalize-form-copy">
                <p class="finalize-kicker">@T["Legacy record"]</p>
                <h2>@T["Finalized event awaiting controlled transition"]</h2>
                <p>@T["This retained Finalized state is readable for compatibility. No ordinary Archive action is available."]</p>
            </div>
        </section>
        <section class="finalize-surface finalize-lifecycle-form">
            <form method="post" asp-page-handler="Unfinalize" data-lifecycle-confirm data-confirm-title="@T["Reopen official results"]" data-confirm-description="@T["Reopen this event for a new review cycle while retaining the current immutable snapshot?"]" data-confirm-action="@T["Reopen for corrections"]" data-confirm-field="ConfirmLifecycleAction" data-confirm-reason-field="Reason" data-confirm-require-reason="true">
                <input type="hidden" asp-for="ExpectedVersion" value="@Model.Readiness.EventVersion" />
                <div class="finalize-form-copy">
                    <p class="finalize-kicker">@T["Exceptional correction"]</p>
                    <h2>@T["Reopen for corrections"]</h2>
                    <p>@T["The current official snapshot remains retained in history."]</p>
                </div>
                <input type="hidden" name="Reason" />
                <input type="hidden" name="ConfirmLifecycleAction" value="false" data-confirm-field-value />
                <button class="finalize-danger-action" type="submit">@T["Unfinalize"]</button>
            </form>
        </section>
    }

    @if (Model.Readiness.State == EventState.Archived)
    {
        <form method="post" asp-page-handler="Unfinalize" class="finalize-surface finalize-lifecycle-form finalize-archived-reopen" data-lifecycle-confirm data-confirm-title="@T["Reopen archived event"]" data-confirm-description="@T["Reopen this event for a new review cycle while retaining the current immutable snapshot?"]" data-confirm-action="@T["Reopen for corrections"]" data-confirm-field="ConfirmLifecycleAction" data-confirm-reason-field="Reason" data-confirm-require-reason="true">
            <input type="hidden" asp-for="ExpectedVersion" value="@Model.Readiness.EventVersion" />
            <input type="hidden" name="ConfirmLifecycleAction" value="false" data-confirm-field-value />
            <div class="finalize-form-copy">
                <p class="finalize-kicker">@T["Exceptional correction"]</p>
                <h2>@T["Reopen archived event"]</h2>
                <p>@T["This returns the event to final review while preserving the public history and prior official snapshot."]</p>
            </div>
            <input type="hidden" name="Reason" />
            <button class="finalize-danger-action" type="submit">@T["Reopen for corrections"]</button>
        </form>
    }

    @if (Model.Readiness.History.Count > 0)
    {
        <section class="finalize-surface finalize-history" aria-labelledby="finalize-history-heading">
            <header class="finalize-section-heading">
                <div>
                    <p class="finalize-kicker">@T["Retained record"]</p>
                    <h2 id="finalize-history-heading">@T["Official result history"]</h2>
                    <p>@T["Each publication cycle remains available after reopening or replacement."]</p>
                </div>
                <span class="finalize-section-note">@Model.Readiness.History.Count cycle@(Model.Readiness.History.Count == 1 ? "" : "s")</span>
            </header>
            <div class="finalize-history-ledger">
                @foreach (var version in Model.Readiness.History)
                {
                    <details class="finalize-history-entry" open="@version.Active">
                        <summary>
                            <span class="finalize-history-summary-main"><strong>@T["Version {0}", version.Version]</strong><span>@DateTimePresentation.Format(version.FinalizedAt, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture)</span></span>
                            <span class="admin-status-pill @(version.Active ? "is-green" : "is-muted")">@(version.Active ? T["Active"] : T["Historical"])</span>
                        </summary>
                        <div class="finalize-history-body">
                            <p>@T["Published by {0}", version.FinalizedByUsername ?? version.FinalizedByAccountId?.ToString() ?? "—"]</p>
                            <p><strong>@T["Final WOM refresh"]:</strong> @T[FinalizeModel.FinalWomRefreshDescription(version.FinalWomRefresh)]
                                @if (version.FinalWomRefresh?.NextEligibleAt is { } eligibleAt)
                                {
                                    <span> · @T["Recorded next eligible time: {0}", DateTimePresentation.Format(eligibleAt, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture)]</span>
                                }
                            </p>
                            @if (version.UnfinalizedAt is not null)
                            {
                                <p class="finalize-history-reopened">@T["Reopened by {0}", version.UnfinalizedByUsername ?? version.UnfinalizedByAccountId?.ToString() ?? "—"] · @DateTimePresentation.Format(version.UnfinalizedAt.Value, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture): @version.UnfinalizeReason</p>
                            }
                            <div class="finalize-history-table-wrap">
                                <table class="finalize-history-table">
                                    <thead>
                                        <tr><th scope="col">@T["Place"]</th><th scope="col">@T["Team"]</th><th scope="col">@T["board"]</th><th scope="col">@T["Completion"]</th><th scope="col">@T["Lines"]</th><th scope="col">@T["Tiles"]</th><th scope="col">@T["Score time"]</th><th scope="col">@T["EHB"]</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in version.Placements)
                                        {
                                            <tr>
                                                <td data-label="@T["Place"]"><span>#@row.Placement</span></td>
                                                <td data-label="@T["Team"]"><strong>@row.TeamName</strong></td>
                                                <td data-label="@T["board"]"><span>@(row.BoardComplete ? T["Complete"] : T["Incomplete"])</span></td>
                                                <td data-label="@T["Completion"]"><span>@(row.BoardCompletedAt is { } completedAt ? DateTimePresentation.Format(completedAt, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture) : "—")</span></td>
                                                <td data-label="@T["Lines"]"><span>@row.CompletedLines</span></td>
                                                <td data-label="@T["Tiles"]"><span>@row.CompletedTiles</span></td>
                                                <td data-label="@T["Score time"]"><span>@(row.CurrentScoreReachedAt is { } scoreTime ? DateTimePresentation.Format(scoreTime, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture) : "—")</span></td>
                                                <td data-label="EHB"><span>@row.EhbTiebreak.ToString("0.##")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                }
            </div>
        </section>
    }
</section>
