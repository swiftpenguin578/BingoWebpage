@page "{id:guid}/Participants/{participantId:guid}"
@model Bingo.Web.Pages.Admin.Events.ParticipantModel
@using Bingo.Domain.Signups
@{
    ViewData["Title"] = Model.Name;
    ViewData["CompactNavigation"] = true;
    var partialTargets = "#app-notice-region, .participant-admin-workspace";
}

<section class="table-page participant-admin-page">
    <header class="participant-admin-heading">
        <div>
            <p class="eyebrow">@T["Participant"]</p>
            <div class="participant-admin-title-row">
                <h1>@Model.Name</h1>
                <span class="participant-status-badge status-@Model.Status.ToString().ToLowerInvariant()">@T[Model.StatusLabel]</span>
            </div>
            <p>@T["Review and correct this player's signup details."]</p>
        </div>
        <a class="btn btn-outline-light" asp-page="Manage" asp-route-id="@Model.EventId">← @T["Back to event"]</a>
    </header>

    <div class="participant-admin-workspace">
        <form method="post" class="panel participant-edit-card" data-update-targets="@partialTargets">
            <header>
                <div>
                    <h2>@T["Participant details"]</h2>
                    <p>@T["Update information supplied during signup."]</p>
                </div>
                <button class="btn btn-primary" type="submit">@T["Save changes"]</button>
            </header>

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" asp-for="Input.ExpectedResponseVersion" />
            @if (Model.Questions.Any(question => question.Active))
            {
                <section class="participant-custom-answers">
                    <header><h3>@T["Signup questions"]</h3><p>@T["Questions added after this player signed up may be unanswered."]</p></header>
                    <div class="participant-field-grid">
                        @foreach (var question in Model.Questions.Where(question => question.Active))
                        {
                            var value = Model.Input.CustomAnswers.GetValueOrDefault(question.Id);
                            var fieldName = $"Input.CustomAnswers[{question.Id}]";
                            var account = Model.Input.AccountAnswers.GetValueOrDefault(question.Id) ?? new ParticipantModel.AccountInput();
                            var accountName = $"Input.AccountAnswers[{question.Id}].CharacterName";
                            var accountEhb = $"Input.AccountAnswers[{question.Id}].Ehb";
                            <label class="@(question.Type == SignupQuestionType.Text ? "participant-wide-field" : null)" for="question-@question.Id">
                                <span>@question.Label @if (question.Required) { <small>@T["Required for new signups"]</small> }</span>
                                @if (question.Type == SignupQuestionType.Account)
                                {
                                    <input id="question-@question.Id" name="@accountName" value="@account.CharacterName" class="form-control" maxlength="100" placeholder="OSRS character" />
                                    @if (question.AccountRole == EventCharacterRole.Playing) { <input name="@accountEhb" value="@account.Ehb" class="form-control participant-short-field" type="number" min="0" step="0.01" placeholder="EHB" /> }
                                }
                                else if (question.Type == SignupQuestionType.Text)
                                {
                                    <textarea id="question-@question.Id" name="@fieldName" class="form-control" rows="3" placeholder="@T["Not answered"]">@value</textarea>
                                }
                                else if (question.Type == SignupQuestionType.YesNo)
                                {
                                    <select id="question-@question.Id" name="@fieldName" class="form-select"><option value="">@T["Not answered"]</option>@if (value == "true") { <option value="true" selected>@T["Yes"]</option> } else { <option value="true">@T["Yes"]</option> } @if (value == "false") { <option value="false" selected>@T["No"]</option> } else { <option value="false">@T["No"]</option> }</select>
                                }
                                else if (question.Type == SignupQuestionType.SingleChoice)
                                {
                                    <select id="question-@question.Id" name="@fieldName" class="form-select"><option value="">@T["Not answered"]</option>@foreach (var option in question.Options) { <option value="@option" selected="@(value == option)">@option</option> }</select>
                                }
                                else
                                {
                                    <input id="question-@question.Id" name="@fieldName" value="@value" class="form-control" type="@(question.Type == SignupQuestionType.Number ? "number" : "text")" placeholder="@T["Not answered"]" />
                                }
                            </label>
                        }
                    </div>
                </section>
            }

            @if (Model.Questions.Any(question => !question.Active))
            {
                <details class="participant-previous-answers">
                    <summary>@T["Previous signup questions"]</summary>
                    <dl>@foreach (var question in Model.Questions.Where(question => !question.Active)) { <div><dt>@question.Label</dt><dd>@(string.IsNullOrWhiteSpace(question.Value) ? T["Not answered"] : question.Value)</dd></div> }</dl>
                </details>
            }

            <footer><button class="btn btn-primary" type="submit">@T["Save changes"]</button></footer>
        </form>

        <aside class="participant-admin-sidebar">
            <form id="admin-notes" method="post" asp-page-handler="AdminNote" class="panel participant-edit-link-card" data-update-targets="#app-notice-region, .participant-admin-workspace">
                <h2>@T["Private admin notes"]</h2><p>@T["Only administrators can see these notes."]</p>
                <input type="hidden" asp-for="ExpectedAdminNote" />
                <textarea asp-for="AdminNote" class="form-control" rows="5" maxlength="2000" placeholder="@T["Only administrators can see these notes."]"></textarea>
                <div class="participant-note-actions"><span class="save-state" aria-live="polite" data-save-state>Saved</span><button class="btn btn-outline-light" type="submit">Save note</button></div>
            </form>
            <form id="payment" method="post" asp-page-handler="Payment" class="panel participant-edit-link-card participant-payment-form" data-update-targets="#app-notice-region, .participant-admin-workspace">
                <h2>Payment</h2>
                <label><span>Payment status</span><select name="payment" class="form-select" data-auto-submit data-payment-save><option value="Unpaid" selected="@(Model.Payment != PaymentStatus.Paid ? "selected" : null)">Unpaid</option><option value="Paid" selected="@(Model.Payment == PaymentStatus.Paid ? "selected" : null)">Paid</option></select></label><span class="save-state" aria-live="polite" data-save-state>Saved</span>
            </form>
            <section class="panel participant-summary-card">
                <header><h2>@T["Signup information"]</h2></header>
                <dl>
                    <div><dt>@T["Event"]</dt><dd>@Model.EventName</dd></div>
                    <div><dt>@T["Status"]</dt><dd>@T[Model.StatusLabel]</dd></div>
                    <div><dt>@T["Signed up"]</dt><dd>@Model.SignedUpAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd></div>
                    <div><dt>@T["Signup order"]</dt><dd>#@Model.SignupSequence</dd></div>
                    <div><dt>@T["Signup source"]</dt><dd>@T[Model.SourceLabel]</dd></div>
                    <div><dt>@T["Team"]</dt><dd>@(Model.TeamName ?? T["Not assigned"])</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.StatusReason)) { <div><dt>@T["Status note"]</dt><dd>@Model.StatusReason</dd></div> }
                </dl>
            </section>

            <form id="ownership" method="post" asp-page-handler="TransferOwnership" class="panel participant-edit-link-card" data-update-targets="#app-notice-region, .participant-admin-workspace">
                <h2>Transfer participant ownership</h2><p>Move this participant to an active website account. Enter its username twice to confirm.</p>
                <input type="hidden" asp-for="ExpectedOwnerAccountId" />
                <label><span>Destination username</span><input asp-for="DestinationUsername" class="form-control" autocomplete="off" /></label>
                <label><span>Confirm destination username</span><input asp-for="DestinationUsernameConfirmation" class="form-control" autocomplete="off" /></label>
                <button class="btn btn-outline-light" type="submit">Transfer ownership</button>
            </form>
            @if (Model.CanAdminWithdraw || Model.CanAdminRestore)
            {
                <section class="panel participant-edit-link-card"><h2>@T["Participant lifecycle"]</h2>
                @if (Model.CanAdminWithdraw) { <form method="post" asp-page-handler="Withdraw"><label class="check-row"><input asp-for="ConfirmLifecycleAction" /> @T["I confirm this withdrawal."]</label><label asp-for="PrivateWithdrawalNote">@T["Private Admin note (optional)"]<textarea asp-for="PrivateWithdrawalNote" class="form-control"></textarea></label><button class="btn destructive-outline-action" type="submit">@T["Withdraw participant"]</button></form> }
                @if (Model.CanAdminRestore) { <form method="post" asp-page-handler="Restore"><label class="check-row"><input asp-for="ConfirmLifecycleAction" /> @T["I confirm this restoration."]</label><button class="btn action-accent-outline" type="submit">@T["Restore participant"]</button></form> }
                </section>
            }
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/event-manage.js" asp-append-version="true"></script>
}
