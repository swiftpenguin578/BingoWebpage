@page "{id:guid}/Participants/{participantId:guid}"
@model Bingo.Web.Pages.Admin.Events.ParticipantModel
@using Bingo.Domain.Signups
@{
    ViewData["Title"] = Model.Name;
    ViewData["CompactNavigation"] = true;
    var partialTargets = "#app-notice-region, .participant-admin-workspace";
    var overlayValue = Model.IsOverlay ? "1" : null;
    var participantsUrl = Url.Page("Participants", new { id = Model.EventId });
    var editPath = Url.Page("Participant", new { id = Model.EventId, participantId = Model.RouteParticipantId });
}

<section class="event-create-page participant-admin-page @(Model.IsOverlay ? "participant-edit-dialog-page admin-dialog-page event-overview-section" : null)" data-participant-edit-page="true" data-participants-url="@participantsUrl" data-edit-path="@editPath" data-participant-id="@Model.RouteParticipantId">
    <header class="event-create-heading admin-events-heading">
        <div>
            <p class="eyebrow">@T["Participant"]</p>
            <div class="participant-admin-title-row">
                <h1>@Model.Name</h1>
                <span class="admin-status-pill @(Model.Status switch { SignupStatus.Confirmed => "is-green", SignupStatus.WaitingList => "is-orange", SignupStatus.Withdrawn => "is-danger", _ => "is-muted" })">@T[Model.StatusLabel]</span>
            </div>
            <p class="admin-module-description">@T["Review and correct this player's signup details while preserving signup history."]</p>
        </div>
        <a class="admin-button-secondary event-create-cancel" asp-page="Participants" asp-route-id="@Model.EventId">@T["Back to participants"]</a>
    </header>

    @if (Model.IsOverlay)
    {
        <div class="event-overview-section-heading admin-dialog-component-heading participant-edit-dialog-heading">
            <div><h2 id="participant-edit-dialog-title">@Model.Name</h2><p id="participant-edit-dialog-description">@T["Review and correct this player's signup details while preserving signup history."]</p></div>
            <button type="button" class="admin-route-dialog-close" data-participant-edit-close aria-label="@T["Close participant details"]"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg></button>
        </div>
    }

    <div class="participant-admin-workspace">
        <section class="panel participant-edit-component participant-summary-card">
            <header><h2>@T["Signup information"]</h2></header>
            <dl class="event-overview-dates">
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Event"]</dt><dd>@Model.EventName</dd></div></div>
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Status"]</dt><dd><span class="admin-status-pill @(Model.Status switch { SignupStatus.Confirmed => "is-green", SignupStatus.WaitingList => "is-orange", SignupStatus.Withdrawn => "is-danger", _ => "is-muted" })">@T[Model.StatusLabel]</span></dd></div></div>
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Signed up"]</dt><dd>@DateTimePresentation.Format(Model.SignedUpAt, "dd MMM yyyy, HH:mm", Model.EventTimezone)</dd></div></div>
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Signup order"]</dt><dd>#@Model.SignupSequence</dd></div></div>
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Signup source"]</dt><dd>@T[Model.SourceLabel]</dd></div></div>
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Team"]</dt><dd>@(Model.TeamName ?? T["Not assigned"])</dd></div></div>
                <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Website owner"]</dt><dd>@(Model.WebsiteOwner ?? T["Unlinked"])</dd></div></div>
                @if (!string.IsNullOrWhiteSpace(Model.StatusReason)) { <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Status note"]</dt><dd>@Model.StatusReason</dd></div></div> }
                @if (Model.CanEditParticipant)
                {
                    <div class="event-overview-date-row"><div class="event-overview-date-copy"><dt>@T["Payment"]</dt><dd>
                        <form id="payment" method="post" asp-page-handler="Payment" class="participant-payment-form" data-update-targets="#app-notice-region, .participant-admin-workspace">
                            <input type="hidden" name="overlay" value="@overlayValue" />
                            @{ var paymentLabel = Model.Payment == PaymentStatus.Paid ? T["Paid"] : T["Unpaid"]; var paymentNext = Model.Payment == PaymentStatus.Paid ? PaymentStatus.Unpaid : PaymentStatus.Paid; }
                            <button name="payment" value="@paymentNext" class="admin-status-pill participant-payment-control @(Model.Payment == PaymentStatus.Paid ? "is-green" : "is-danger")" type="submit" aria-label="@T["Toggle payment status"]">@paymentLabel</button>
                        </form>
                    </dd></div></div>
                }
            </dl>
        </section>

        @if (Model.CanEditParticipant)
        {
            <form method="post" class="panel participant-edit-card" data-update-targets="@partialTargets">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" name="overlay" value="@overlayValue" />
            <input type="hidden" asp-for="Input.ExpectedResponseVersion" />
            @if (Model.Questions.Any(question => question.Active))
            {
                    <section class="participant-edit-component participant-custom-answers">
                    <header><h3>@T["Signup questions"]</h3><p>@T["Questions added after this player signed up may be unanswered."]</p></header>
                    <div class="participant-field-grid">
                        @foreach (var question in Model.Questions.Where(question => question.Active))
                        {
                            var value = Model.Input.CustomAnswers.GetValueOrDefault(question.Id);
                            var fieldName = $"Input.CustomAnswers[{question.Id}]";
                            var account = Model.Input.AccountAnswers.GetValueOrDefault(question.Id) ?? new ParticipantModel.AccountInput();
                            var accountName = $"Input.AccountAnswers[{question.Id}].CharacterName";
                            var accountEhb = $"Input.AccountAnswers[{question.Id}].Ehb";
                            <div class="admin-field event-create-field @(question.Type == SignupQuestionType.Text ? "full-field" : null)">
                                @if (question.Type == SignupQuestionType.Account)
                                {
                                    <div class="participant-account-controls @(question.AccountRole == EventCharacterRole.Playing ? null : "is-single")">
                                        <div class="participant-account-field">
                                            <label for="question-@question.Id">@question.Label</label>
                                            <input id="question-@question.Id" name="@accountName" value="@account.CharacterName" class="form-control" maxlength="100" placeholder="@T["OSRS character"]" />
                                            <span asp-validation-for="Input.AccountAnswers[question.Id].CharacterName" class="field-error"></span>
                                        </div>
                                        @if (question.AccountRole == EventCharacterRole.Playing)
                                        {
                                            <div class="participant-account-field">
                                                <label for="question-@question.Id-ehb">@T["EHB"]</label>
                                                <input id="question-@question.Id-ehb" name="@accountEhb" value="@account.Ehb" class="form-control participant-short-field" type="number" min="0" step="0.01" placeholder="0" />
                                                <span asp-validation-for="Input.AccountAnswers[question.Id].Ehb" class="field-error"></span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <label for="question-@question.Id">@question.Label</label>
                                    @if (question.Type == SignupQuestionType.Text)
                                    {
                                        <textarea id="question-@question.Id" name="@fieldName" class="form-control" rows="3" placeholder="@T["Not answered"]">@value</textarea>
                                    }
                                    else if (question.Type == SignupQuestionType.YesNo)
                                    {
                                        <select id="question-@question.Id" name="@fieldName" class="form-select"><option value="">@T["Not answered"]</option>@if (value == "true") { <option value="true" selected>@T["Yes"]</option> } else { <option value="true">@T["Yes"]</option> } @if (value == "false") { <option value="false" selected>@T["No"]</option> } else { <option value="false">@T["No"]</option> }</select>
                                    }
                                    else if (question.Type == SignupQuestionType.SingleChoice)
                                    {
                                        <select id="question-@question.Id" name="@fieldName" class="form-select"><option value="">@T["Not answered"]</option>@foreach (var option in question.Options) { <option value="@option" selected="@(value == option)">@option</option> }</select>
                                    }
                                    else
                                    {
                                        <input id="question-@question.Id" name="@fieldName" value="@value" class="form-control" type="@(question.Type == SignupQuestionType.Number ? "number" : "text")" placeholder="@T["Not answered"]" />
                                    }
                                }
                                <span asp-validation-for="Input.CustomAnswers[question.Id]" class="field-error"></span>
                            </div>
                        }
                    </div>
                    <footer><button class="admin-button-secondary" type="submit">@T["Save changes"]</button></footer>
                </section>
            }

            @if (Model.Questions.Any(question => !question.Active))
            {
                <details class="participant-edit-component participant-previous-answers">
                    <summary>@T["Previous signup questions"]</summary>
                    <dl>@foreach (var question in Model.Questions.Where(question => !question.Active)) { <div><dt>@question.Label</dt><dd>@(string.IsNullOrWhiteSpace(question.Value) ? T["Not answered"] : question.Value)</dd></div> }</dl>
                </details>
            }

            </form>
        }
        else
        {
            <section class="panel participant-edit-card participant-edit-component participant-read-only-details">
                <header><div><h2>@T["Participant details"]</h2><p>@T["This participant is locked and can only be reviewed here."]</p></div></header>
                <div class="information-callout participant-read-only-note"><strong>@T["Participant administration is read-only"]</strong><span>@T["Details, payment, ownership, notes, and signup lifecycle changes are locked after the draft starts or when the event has moved on."]</span></div>
                <dl class="participant-detail-rows">
                    <div><dt>@T["Event"]</dt><dd>@Model.EventName</dd></div>
                    <div><dt>@T["Status"]</dt><dd>@T[Model.StatusLabel]</dd></div>
                    <div><dt>@T["Signed up"]</dt><dd>@DateTimePresentation.Format(Model.SignedUpAt, "dd MMM yyyy, HH:mm", Model.EventTimezone)</dd></div>
                    <div><dt>@T["Signup order"]</dt><dd>#@Model.SignupSequence</dd></div>
                    <div><dt>@T["Signup source"]</dt><dd>@T[Model.SourceLabel]</dd></div>
                    <div><dt>@T["Team"]</dt><dd>@(Model.TeamName ?? T["Not assigned"])</dd></div>
                    @if (!string.IsNullOrWhiteSpace(Model.StatusReason)) { <div><dt>@T["Status note"]</dt><dd>@Model.StatusReason</dd></div> }
                    @foreach (var question in Model.Questions.Where(question => question.Active))
                    {
                        var answer = question.Type == SignupQuestionType.Account
                            ? Model.Input.AccountAnswers.GetValueOrDefault(question.Id)?.CharacterName
                            : Model.Input.CustomAnswers.GetValueOrDefault(question.Id);
                        <div><dt>@question.Label</dt><dd>@(string.IsNullOrWhiteSpace(answer) ? T["Not answered"] : answer)@if (question.Type == SignupQuestionType.Account && question.AccountRole == EventCharacterRole.Playing && Model.Input.AccountAnswers.GetValueOrDefault(question.Id)?.Ehb is { } ehb) { <span> · EHB @ehb</span> }</dd></div>
                    }
                </dl>
            </section>
        }

        <aside class="participant-admin-sidebar">
            @if (Model.CanEditParticipant)
            {
            <form id="admin-notes" method="post" asp-page-handler="AdminNote" class="panel participant-edit-component participant-edit-link-card" data-update-targets="#app-notice-region, .participant-admin-workspace">
                <h2>@T["Private admin notes"]</h2><p>@T["Only administrators can see these notes."]</p>
                <input type="hidden" name="overlay" value="@overlayValue" />
                <input type="hidden" asp-for="ExpectedAdminNote" />
                <textarea asp-for="AdminNote" class="form-control" rows="3" maxlength="2000" placeholder="@T["Only administrators can see these notes."]"></textarea>
                <div class="participant-note-actions"><button class="admin-button-secondary" type="submit">@T["Save note"]</button></div>
            </form>
            }

            @if (Model.CanEditParticipant)
            {
            <form id="ownership" method="post" asp-page-handler="TransferOwnership" class="panel participant-edit-component participant-edit-link-card" data-update-targets="#app-notice-region, .participant-admin-workspace">
                <h2>@T["Transfer participant ownership"]</h2><p>@T["Move this participant to an active website account."]</p>
                <input type="hidden" name="overlay" value="@overlayValue" />
                <input type="hidden" asp-for="ExpectedOwnerAccountId" />
                <div class="admin-field event-create-field participant-owner-picker" data-owner-account-picker data-owner-account-search-url="@participantsUrl">
                    <label for="destination-owner-account-search">@T["Destination website account"]</label>
                    <input id="destination-owner-account-search" class="form-control" type="search" autocomplete="off" maxlength="100" role="combobox" aria-autocomplete="list" aria-controls="destination-owner-account-results" aria-expanded="false" data-owner-account-search />
                    <input asp-for="DestinationOwnerAccountId" type="hidden" data-owner-account-id />
                    <div id="destination-owner-account-results" role="listbox" data-owner-account-results hidden></div>
                </div>
                <div class="participant-component-actions"><button class="admin-button-secondary" type="submit">@T["Transfer ownership"]</button></div>
            </form>
            }
                @if (Model.CanFillVacancy || Model.PromotionFollowUp is not null)
                {
                    <section class="panel participant-edit-component participant-edit-link-card participant-secondary-actions-panel">
                @if (Model.CanFillVacancy)
                {
                    <h3>@T["Fill open vacancy"]</h3>
                    <p>@T["Choose an available waiting-list participant, or leave the selector blank and provide a validated internal participant. Contact remains manual."]</p>
                    <form method="post" asp-page-handler="FillVacancy" class="form-stack" data-update-targets="@partialTargets"><input type="hidden" name="overlay" value="@overlayValue" />
                        <input asp-for="VacancyMembershipId" type="hidden" /><input asp-for="VacancyMembershipVersion" type="hidden" />
                        <label><span>@T["Waiting-list participant (optional)"]</span><select asp-for="ReplacementWaitingParticipantId" class="form-select"><option value="">@T["Create internal replacement"]</option>@foreach (var candidate in Model.WaitingReplacementCandidates) { <option value="@candidate.Id">@candidate.Name · #@candidate.Sequence</option> }</select></label>
                        <label><span>@T["Internal owner username (optional)"]</span><input asp-for="InternalReplacement.OwnerUsername" class="form-control" autocomplete="off" /></label>
                        @foreach (var question in Model.Questions.Where(x => x.Active))
                        {
                            var account = Model.InternalReplacement.AccountAnswers.GetValueOrDefault(question.Id) ?? new ParticipantModel.AccountInput();
                            if (question.Type == SignupQuestionType.Account)
                            {
                                <label><span>@question.Label @if (question.Required) { <small>@T["Required"]</small> }</span><input name="InternalReplacement.AccountAnswers[@question.Id].CharacterName" value="@account.CharacterName" class="form-control" maxlength="100" placeholder="@T["OSRS character"]" />@if (question.AccountRole == EventCharacterRole.Playing) { <input name="InternalReplacement.AccountAnswers[@question.Id].Ehb" value="@account.Ehb" class="form-control" type="number" min="0" step="0.01" placeholder="@T["EHB"]" /> }</label>
                            }
                            else
                            {
                                <label><span>@question.Label @if (question.Required) { <small>@T["Required"]</small> }</span><input name="InternalReplacement.Answers[@question.Id]" value="@Model.InternalReplacement.Answers.GetValueOrDefault(question.Id)" class="form-control" /></label>
                            }
                        }
                        <button class="admin-button-secondary action-accent-outline" type="submit">@T["Confirm replacement"]</button>
                    </form>
                }
                @if (Model.PromotionFollowUp is { } followUp)
                {
                    <h3>@T["Waiting-list promotion follow-up"]</h3>
                    @if (followUp.CompletedAt is null)
                    {
                        <p>@T["Contact the participant manually, then mark this follow-up complete."]</p>
                        <form method="post" asp-page-handler="CompletePromotionFollowUp" data-update-targets="@partialTargets"><input type="hidden" name="overlay" value="@overlayValue" /><input type="hidden" name="followUpId" value="@followUp.Id" /><button class="admin-button-secondary" type="submit">@T["Mark follow-up complete"]</button></form>
                    }
                    else { <p>@T["Completed at {0}.", DateTimePresentation.Format(followUp.CompletedAt.Value, "dd MMM yyyy, HH:mm", Model.EventTimezone)]</p> }
                }
                </section>
                }
        </aside>
    </div>

    @if (Model.CanAdminWithdraw || Model.CanAdminRestore)
    {
        <div class="participant-lifecycle-footer">
            @if (Model.CanAdminRestore)
            {
                <details class="participant-confirmation-box participant-restore-confirmation">
                    <summary class="admin-button-secondary">@T["Restore participant"]</summary>
                    <div class="event-confirmation-box" role="alertdialog" aria-labelledby="restore-participant-heading">
                        <p><strong id="restore-participant-heading">@T["Restore {0}?", Model.Name]</strong><br />@T["Restore this signup using the current capacity and waiting-list rules."]</p>
                        <form method="post" asp-page-handler="Restore" class="event-confirmation-form" data-update-targets="@partialTargets">
                            <input type="hidden" name="overlay" value="@overlayValue" />
                            <input type="hidden" name="ConfirmLifecycleAction" value="true" />
                            <div class="event-confirmation-actions">
                                <button type="button" class="admin-button-secondary" data-confirmation-cancel>@T["Cancel"]</button>
                                <button class="admin-button-secondary" type="submit">@T["Confirm restoration"]</button>
                            </div>
                        </form>
                    </div>
                </details>
            }
            @if (Model.CanAdminWithdraw)
            {
            <details class="admin-destructive-confirmation participant-confirmation-box">
                <summary class="admin-button-secondary action-danger-outline">@T["Remove participant"]</summary>
                <div class="event-confirmation-box" role="alertdialog" aria-labelledby="remove-participant-heading">
                    <p><strong id="remove-participant-heading">@T["Remove {0}?", Model.Name]</strong><br />@T["This withdraws the signup and keeps its history."]</p>
                    <form method="post" asp-page-handler="Withdraw" class="event-confirmation-form">
                        <input type="hidden" name="overlay" value="@overlayValue" />
                        <input asp-for="ExpectedMembershipVersion" type="hidden" />
                        <input type="hidden" name="ConfirmLifecycleAction" value="true" />
                        <label asp-for="PrivateWithdrawalNote">@T["Private Admin note (optional)"]<textarea asp-for="PrivateWithdrawalNote" class="form-control"></textarea></label>
                        <div class="event-confirmation-actions">
                            <button type="button" class="admin-button-secondary" data-confirmation-cancel>@T["Cancel"]</button>
                            <button class="admin-button-secondary action-danger-outline" type="submit">@T["Remove participant"]</button>
                        </div>
                    </form>
                </div>
            </details>
            }
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/event-manage.js" asp-append-version="true"></script>
}
