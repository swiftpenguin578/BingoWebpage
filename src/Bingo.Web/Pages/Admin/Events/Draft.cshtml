@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.DraftModel
@using Bingo.Domain.Teams
@using Bingo.Domain.Signups
@{ ViewData["Title"] = "Teams and draft"; }
<section class="table-page draft-page">
<div class="page-heading"><div><p class="eyebrow">Private admin workspace</p><h1>@Model.EventName — teams and draft</h1><p>@(Model.Draft is null ? "Set up teams before starting the draft." : $"{Model.Draft.State} · target {Model.Draft.TargetTeamSize} players per drafted team")</p></div><a class="btn btn-outline-light" asp-page="Manage" asp-route-id="@RouteData.Values["id"]">Back to event</a></div>
@if(Model.GeneratedCredentials.Count>0){<section class="panel generated-credentials"><h2>Captain accounts created</h2><p><strong>Copy these now.</strong> Passwords are shown only once and each captain must change theirs at first sign-in.</p><div class="table-wrap"><table><thead><tr><th>Team</th><th>Role</th><th>Player</th><th>Username</th><th>Temporary password</th></tr></thead><tbody>@foreach(var credential in Model.GeneratedCredentials){<tr><td>@credential.TeamName</td><td>@credential.Role</td><td>@credential.PlayerName</td><td><code>@credential.Username</code></td><td><code>@credential.Password</code></td></tr>}</tbody></table></div></section>}

@if (Model.Draft is not null && Model.Draft.State is DraftState.Running or DraftState.Paused)
{
    <section class="panel collaboration-status" data-admin-draft-event="@RouteData.Values["id"]" data-can-control="@Model.CanControlDraft.ToString().ToLowerInvariant()">
        @if (Model.CanControlDraft)
        {
            <div><strong>You control this draft.</strong><span>Other administrators can watch live. Your control renews while this page is open.</span></div>
            <form method="post" asp-page-handler="ReleaseControl"><button class="btn btn-sm btn-outline-light">Release control</button></form>
        }
        else if (Model.DraftControllerAccountId is not null)
        {
            <div><strong>@(Model.DraftControllerName ?? "Another administrator") controls this draft.</strong><span>This page is read-only and updates when picks change.</span></div>
            <form method="post" asp-page-handler="TakeControl" onsubmit="return confirm('Take control from the current administrator? They will immediately become read-only.');"><button class="btn btn-sm btn-warning">Take over</button></form>
        }
        else
        {
            <div><strong>No administrator currently controls this draft.</strong><span>Take control to make picks or change the draft state.</span></div>
            <form method="post" asp-page-handler="TakeControl"><button class="btn btn-sm btn-primary">Take control</button></form>
        }
    </section>
}
<div class="collaboration-update" data-draft-update hidden>Another administrator changed the draft. Updating…</div>

@if (Model.Draft is null)
{
<form method="post" asp-page-handler="Setup" class="panel form-stack"><h2>Draft setup</h2><label>Number of website-drafted teams</label><input asp-for="Setup.TeamCount" class="form-control" min="2" max="20" /><label>Target players per drafted team</label><input asp-for="Setup.TargetSize" class="form-control" min="1" max="100" /><p>@Model.ConfirmedCount confirmed players. The preview updates after setup and captain assignments.</p><button class="btn btn-primary">Create draft teams</button></form>
}
else
{
<div class="action-grid">
<section class="panel"><h2>Pool preview</h2><p><strong>@Model.AvailableCount</strong> available · <strong>@Model.AssignedCount</strong> assigned · <strong>@Model.Remainder</strong> remainder after filling drafted teams</p></section>
@if(Model.Draft.State == DraftState.Setup){<form method="post" asp-page-handler="Configure" class="panel form-stack"><h2>Final draft size</h2><label>Website-drafted teams</label><input name="teamCount" type="number" min="2" max="20" value="@Model.Teams.Count(x=>x.FormationType==TeamFormationType.Drafted)" class="form-control"/><label>Target players per team</label><input name="targetSize" type="number" min="1" max="100" value="@Model.Draft.TargetTeamSize" class="form-control"/><button class="btn btn-outline-light">Update setup</button></form>}
@if(Model.Draft.State == DraftState.Setup){<form method="post" asp-page-handler="Scramble" class="panel form-stack"><h2>Draft order</h2><p>Randomly scramble only website-drafted teams.</p><button class="btn btn-primary">Scramble teams</button></form>}
@if(Model.Draft.State == DraftState.Setup){<form method="post" asp-page-handler="Start" class="panel form-stack" onsubmit="return confirm('Start and lock this draft setup?');"><h2>Start draft</h2><p>Team participation and automatic waiting-list promotion lock after the first pick.</p><button class="btn btn-warning">Start draft</button></form>}
@if(Model.Draft.State == DraftState.Running && Model.CanControlDraft){<form method="post" asp-page-handler="Pause" class="panel form-stack"><h2>Draft controls</h2><button class="btn btn-outline-light">Pause draft</button></form>}
@if(Model.Draft.State == DraftState.Paused && Model.CanControlDraft){<form method="post" asp-page-handler="Resume" class="panel form-stack"><h2>Draft controls</h2><button class="btn btn-primary">Resume draft</button></form>}
</div>

@if(Model.CurrentTurn is not null){<section class="panel current-turn"><p class="eyebrow">Pick @Model.CurrentTurn.PickNumber · round @Model.CurrentTurn.RoundNumber</p><h2>@Model.CurrentTurn.TeamName is choosing</h2></section>}

<div class="page-heading subheading"><div><h2>Teams</h2><small>Captain and co-captain accounts are generated automatically when rosters are finalized.</small></div><button type="button" class="btn btn-outline-light" onclick="document.getElementById('add-team').showModal()">Add pre-formed team</button></div>
<div class="team-grid">
@foreach(var team in Model.Teams)
{
    <article class="panel team-card @(team.IsCurrent ? "current-team" : "")">
        <div class="page-heading"><div><h3>@team.Name</h3><small>@team.FormationType @if(!string.IsNullOrWhiteSpace(team.Affiliation)){<text> · @team.Affiliation</text>}</small></div>@if(team.DraftPosition is not null){<strong>#@team.DraftPosition</strong>}</div>
        <p>@if(team.FormationType == TeamFormationType.Drafted){<text>@team.TotalEhb.ToString("0.##") EHB · </text>}@team.Members.Count member(s)</p>
        <ul>@foreach(var member in team.Members){<li><span>@member.Name <small>@member.Role @if(team.FormationType == TeamFormationType.Drafted){<text> · @member.Ehb EHB</text>}</small></span>@if(team.FormationType==TeamFormationType.Preformed){<form method="post" asp-page-handler="RemoveMember" class="inline-form" onsubmit="return confirm('Remove this member from the team?');"><input type="hidden" name="membershipId" value="@member.MembershipId"/><input name="reason" required placeholder="Reason"/><button class="btn btn-sm btn-danger">Remove</button></form>}</li>}</ul>
        <div class="dialog-actions"><button type="button" class="btn btn-sm btn-outline-light" onclick="document.getElementById('team-@team.Id').showModal()">Edit / roster</button></div>
    </article>
    <dialog id="team-@team.Id" class="tile-dialog">
        <button type="button" class="dialog-close" onclick="this.closest('dialog').close()">×</button>
        <h2>@team.Name</h2>
        <form method="post" asp-page-handler="UpdateTeam" class="form-stack"><input type="hidden" name="teamId" value="@team.Id"/><label>Name</label><input name="name" value="@team.Name" class="form-control" required/><label>Affiliation / clan</label><input name="affiliation" value="@team.Affiliation" class="form-control"/><label>Image URL</label><input name="imageUrl" value="@team.ImageUrl" class="form-control"/><button class="btn btn-primary">Save team</button></form>
        <hr/><h3>Roster roles</h3>
        @foreach(var member in team.Members)
        {
            <form method="post" asp-page-handler="ChangeRole" class="inline-form"><input type="hidden" name="membershipId" value="@member.MembershipId"/><span>@member.Name</span><select name="role" class="form-select">@foreach(var roleOption in Enum.GetValues<TeamMembershipRole>()){<option value="@roleOption" selected="@(roleOption==member.Role)">@roleOption</option>}</select><button class="btn btn-sm btn-outline-light">Save role</button></form>
            @if(team.FormationType==TeamFormationType.Preformed){<form method="post" asp-page-handler="MoveMember" class="inline-form"><input type="hidden" name="membershipId" value="@member.MembershipId"/><select name="targetTeamId" class="form-select">@foreach(var target in Model.Teams.Where(x=>x.Id!=team.Id&&x.FormationType==TeamFormationType.Preformed)){<option value="@target.Id">Move to @target.Name</option>}</select><input name="reason" required placeholder="Reason"/><button class="btn btn-sm btn-outline-light">Move</button></form>}
        }
        @if(team.FormationType == TeamFormationType.Preformed)
        {
            <hr/>
            <form method="post" asp-page-handler="AddExternalMember" class="form-stack"><input type="hidden" name="teamId" value="@team.Id"/><h3>Add externally drafted player</h3><p>This player did not use the website signup and will only belong to this outside-clan roster.</p><label>In-game name</label><input name="name" class="form-control" required/><label>Role</label><select name="role" class="form-select" asp-items="Html.GetEnumSelectList<TeamMembershipRole>()"></select><label>Reason</label><input name="reason" class="form-control" required value="Invited external roster"/><button class="btn btn-outline-light">Create and add player</button></form>
            @if(Model.Draft.State == DraftState.Setup)
            {
                <hr/>
                <details>
                    <summary>Exceptional: add a website signup to this pre-formed team</summary>
                    <p>Normally website signups must join website-drafted teams. Use this only to correct an unusual roster situation.</p>
                    <form method="post" asp-page-handler="AddMember" class="form-stack"><input type="hidden" name="teamId" value="@team.Id"/><label>Available website signup</label><select name="participantId" class="form-select"><option value="">Choose participant</option>@foreach(var player in Model.Participants.Where(x=>x.TeamId is null)){<option value="@player.Id">@player.Name (@player.Ehb EHB)</option>}</select><label>Role</label><select name="role" class="form-select" asp-items="Html.GetEnumSelectList<TeamMembershipRole>()"></select><label>Reason</label><input name="reason" class="form-control" required value="Exceptional internal roster assignment"/><button class="btn btn-outline-light">Add website signup</button></form>
                </details>
            }
        }
        else if(Model.Draft.State == DraftState.Setup)
        {
            <hr/>
            <form method="post" asp-page-handler="AddMember" class="form-stack"><input type="hidden" name="teamId" value="@team.Id"/><label>Add existing available participant</label><select name="participantId" class="form-select"><option value="">Choose participant</option>@foreach(var player in Model.Participants.Where(x=>x.TeamId is null)){<option value="@player.Id">@player.Name (@player.Ehb EHB)</option>}</select><label>Role</label><select name="role" class="form-select" asp-items="Html.GetEnumSelectList<TeamMembershipRole>()"></select><label>Reason</label><input name="reason" class="form-control" required value="Manual roster assignment"/><button class="btn btn-outline-light">Add to roster</button></form>
        }
    </dialog>
}
</div>

<div class="page-heading subheading"><h2>Participant pool</h2><form method="get"><input type="hidden" name="id" value="@RouteData.Values["id"]"/><select name="sort" class="form-select" onchange="this.form.submit()"><option value="ehb" selected="@(Model.Sort=="ehb")">EHB</option><option value="name" selected="@(Model.Sort=="name")">Name</option><option value="signup" selected="@(Model.Sort=="signup")">Signup time</option><option value="status" selected="@(Model.Sort=="status")">Draft status</option></select></form></div>
<div class="table-wrap panel"><table><thead><tr><th>Player</th><th>EHB</th><th>Signup</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var p in Model.Participants){<tr class="@(p.TeamId is null ? "" : "drafted-player")"><td>@p.Name @if(p.CaptainVolunteer){<small>captain volunteer</small>}</td><td>@p.Ehb</td><td>@p.SignedUpAt.ToLocalTime().ToString("g")</td><td>@(p.TeamName ?? "Available") @if(p.SignupStatus != SignupStatus.Confirmed){<small>signup status: @p.SignupStatus</small>}</td><td>@if(Model.CanControlDraft && Model.CurrentTurn is not null && p.TeamId is null && p.SignupStatus == SignupStatus.Confirmed){<form method="post" asp-page-handler="Pick" onsubmit="return confirm('Record @p.Name for @Model.CurrentTurn.TeamName?');"><input type="hidden" name="participantId" value="@p.Id"/><button class="btn btn-sm btn-primary">Pick for @Model.CurrentTurn.TeamName</button></form>}</td></tr>}</tbody></table></div>

@if(Model.CanControlDraft && Model.LatestPick is not null && Model.Draft.State is DraftState.Running or DraftState.Paused){<form method="post" asp-page-handler="Undo" class="panel inline-form" onsubmit="return confirm('Undo the latest pick?');"><span>Latest: #@Model.LatestPick.PickNumber @Model.LatestPick.PlayerName → @Model.LatestPick.TeamName</span><button class="btn btn-danger">Undo latest pick</button></form>}
@if(Model.CanControlDraft && Model.Draft.State is DraftState.Running or DraftState.Paused){<form method="post" asp-page-handler="Finalize" class="panel form-stack" onsubmit="return confirm('Finalize and publish all team rosters?');"><h2>Finalize rosters</h2><p>This publishes all teams together. Historical draft picks remain locked.</p><button class="btn btn-warning">Finalize and publish</button></form>}

<dialog id="add-team" class="tile-dialog"><button type="button" class="dialog-close" onclick="this.closest('dialog').close()">×</button><h2>Add pre-formed team</h2><form method="post" asp-page-handler="AddTeam" class="form-stack"><label>Team name</label><input name="name" class="form-control" required/><label>Affiliation / clan</label><input name="affiliation" class="form-control"/><label>Image URL</label><input name="imageUrl" class="form-control"/><button class="btn btn-primary">Add outside team</button></form></dialog>
}
</section>

@section Scripts {
<script src="~/js/admin-collaboration.js" asp-append-version="true"></script>
}
