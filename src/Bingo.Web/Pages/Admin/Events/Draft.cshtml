@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.DraftModel
@using Bingo.Domain.Teams
@using Bingo.Domain.Signups
@{
    ViewData["Title"] = "Teams and draft";
    var isActiveDraft = Model.Draft?.State is DraftState.Running or DraftState.Paused;
    var isPreDraft = Model.Draft?.State == DraftState.Setup;
    var isFinalizedDraft = Model.Draft?.State == DraftState.Finalized;
}
<section class="table-page draft-page @(!isActiveDraft ? "event-manage-page" : null) @(Model.Draft is null ? "draft-page-setup" : null) @(isPreDraft ? "draft-page-predraft" : null) @(isFinalizedDraft ? "draft-page-finalized" : null) @(isActiveDraft ? "draft-page-live" : null)">
@if (!isActiveDraft)
{
    <header class="compact-operational-heading draft-compact-page-heading">
        <h1>Teams and draft</h1>
    </header>
}
@if(Model.GeneratedCredentials.Count>0){<section class="panel generated-credentials"><h2>Emergency captain setup links created</h2><p><strong>Copy these now.</strong> Each link is single-use and expires in 60 minutes. Setup does not enable the credential.</p><div class="table-wrap"><table><thead><tr><th>Team</th><th>Role</th><th>Player</th><th>Username</th><th>Setup token</th></tr></thead><tbody>@foreach(var credential in Model.GeneratedCredentials){<tr><td>@credential.TeamName</td><td>@credential.Role</td><td>@credential.PlayerName</td><td><code>@credential.Username</code></td><td><code>@credential.SetupToken</code></td></tr>}</tbody></table></div></section>}

@if (Model.Draft is null)
{
<section class="panel form-stack draft-setup-card"><h2>Team setup</h2><p>Create individual Drafted or Pre-formed teams. The draft distribution is calculated from confirmed participants and drafted teams.</p><form method="post" asp-page-handler="AddTeam" class="form-stack"><label>Name<input name="name" class="form-control" required /></label><label>Formation<select name="formationType" class="form-select"><option value="Drafted">Drafted</option><option value="Preformed">Pre-formed</option></select></label><label>Affiliation / clan<input name="affiliation" class="form-control" /></label><button class="btn btn-outline-primary">Add team</button></form></section>
}
else if (isActiveDraft)
{
<div class="draft-live-shell" data-admin-draft-event="@RouteData.Values["id"]" data-can-control="@Model.CanControlDraft.ToString().ToLowerInvariant()">
    <section class="panel draft-live-toolbar">
        <div class="draft-live-toolbar-status">
            <a class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action" asp-page="Manage" asp-route-id="@RouteData.Values["id"]">← Back to event</a>
            <div class="draft-live-toolbar-copy">
            @if (Model.Draft!.State == DraftState.Paused)
            {
                <strong>Draft paused</strong>
            }
            else if (Model.CurrentTurn is not null)
            {
                <strong>Pick @Model.CurrentTurn.PickNumber · @Model.CurrentTurn.TeamName</strong>
                <span>Round @Model.CurrentTurn.RoundNumber</span>
            }
            else if (!Model.DraftOrderReady)
            {
                <strong>Ready to draw the team order</strong>
            }
            @if (Model.CanControlDraft)
            {
                <span>You control the draft</span>
            }
            else if (Model.DraftControllerAccountId is not null)
            {
                <span>@(Model.DraftControllerName ?? "Another admin") is controlling</span>
            }
            else
            {
                <span>No admin is controlling</span>
            }
            </div>
        </div>
        <div class="draft-live-toolbar-actions">
            @if (Model.CanControlDraft && !Model.DraftOrderReady)
            {
                <form method="post" asp-page-handler="Scramble" data-draft-scramble-form data-update-targets="#app-notice-region, .draft-live-shell">
                    <span class="visually-hidden" data-draft-scramble-status aria-live="polite">Team order is ready to draw.</span>
                    <button class="btn btn-sm btn-primary catalogue-compact-action" data-draft-scramble-submit>Scramble teams</button>
                </form>
            }
            @if (Model.CanControlDraft && Model.DraftOrderReady && Model.Draft.State == DraftState.Running)
            {
                <form method="post" asp-page-handler="Pause" data-update-targets="#app-notice-region, .draft-live-shell"><button class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action">Pause</button></form>
            }
            @if (Model.CanControlDraft && Model.Draft.State == DraftState.Paused)
            {
                <form method="post" asp-page-handler="Resume" data-update-targets="#app-notice-region, .draft-live-shell"><button class="btn btn-sm btn-primary catalogue-compact-action">Resume</button></form>
            }
            @if (Model.CanControlDraft && Model.LatestPick is not null)
            {
                <form method="post" asp-page-handler="Undo" data-update-targets="#app-notice-region, .draft-live-shell" onsubmit="return confirm('Undo the latest pick?');"><button class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action">Undo #@Model.LatestPick.PickNumber</button></form>
            }
            @if (Model.CanControlDraft)
            {
                <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Return this private draft to setup? All active picks will be undone and retained in draft history.');"><button class="btn btn-sm btn-outline-danger catalogue-compact-action">Cancel draft</button></form>
            }
            @if (Model.CanControlDraft)
            {
                <form method="post" asp-page-handler="ReleaseControl"><button class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action">Release control</button></form>
            }
            else if (Model.DraftControllerAccountId is not null)
            {
                <form method="post" asp-page-handler="TakeControl" onsubmit="return confirm('Take control from the current administrator? They will immediately become read-only.');"><input type="hidden" name="confirmed" value="true" /><button class="btn btn-sm btn-warning catalogue-compact-action">Take over</button></form>
            }
            else
            {
                <form method="post" asp-page-handler="AcquireControl"><button class="btn btn-sm btn-outline-primary catalogue-add-action catalogue-compact-action">Take control</button></form>
            }
        </div>
    </section>

    <div class="collaboration-update" data-draft-update hidden>Another administrator changed the draft. Updating…</div>

    @if (Model.CanControlDraft)
    {
        <form method="post" asp-page-handler="Finalize" class="draft-finalize-control" onsubmit="return confirm('Finalize this draft and publish the frozen public roster?');">
            <input type="hidden" name="confirmed" value="true" />
            <button class="btn btn-sm btn-outline-primary catalogue-compact-action">Finalize and publish rosters</button>
        </form>
    }

    <div class="draft-live-workspace">
        <section class="draft-live-teams" aria-labelledby="draft-live-teams-title">
            <header class="draft-live-section-heading">
                <div><p class="eyebrow">Draft order</p><h2 id="draft-live-teams-title">Teams and picks</h2></div>
                <span>@Model.AssignedCount picked</span>
            </header>
            <div class="draft-live-team-list" data-draft-team-grid>
                @foreach (var team in Model.Teams.Where(x => x.FormationType == TeamFormationType.Drafted))
                {
                    <article class="panel draft-live-team @(team.IsCurrent ? "current-team" : null)" data-team-id="@team.Id" data-draft-team="true">
                        <header>
                            <h3>@team.Name</h3>
                        </header>
                        @if (team.Members.Count == 0)
                        {
                            <p class="draft-live-empty">No picks yet</p>
                        }
                        else
                        {
                            <ol class="draft-live-picks">
                                @foreach (var member in team.Members)
                                {
                                    <li class="@(member.Role is TeamMembershipRole.Captain or TeamMembershipRole.CoCaptain ? "draft-live-captain" : null)">
                                        @if (member.PickNumber is not null)
                                        {
                                            <span class="draft-live-pick-number">#@member.PickNumber</span>
                                        }
                                        <strong>@member.Name</strong>
                                    </li>
                                }
                            </ol>
                        }
                        <span class="draft-live-team-count">@team.Members.Count / @team.ProjectedFinalSize</span>
                    </article>
                }
            </div>
        </section>

        <aside class="draft-live-pool" aria-labelledby="draft-live-pool-title">
            <header class="draft-live-section-heading">
                <div><p class="eyebrow">Available</p><h2 id="draft-live-pool-title">Player pool</h2></div>
                <span>@Model.AvailableCount players</span>
            </header>
            <div class="panel draft-live-player-panel">
            <div class="draft-live-player-list">
                @foreach (var player in Model.Participants.Where(x => x.TeamId is null && x.SignupStatus == SignupStatus.Confirmed))
                {
                    <div class="draft-live-player">
                        <div><strong>@player.Name</strong><span>@player.Ehb.ToString("0.##") EHB</span></div>
                        @if (Model.CurrentTurn is not null)
                        {
                            @if (Model.CanControlDraft)
                            {
                                <form method="post" asp-page-handler="Pick" data-update-targets="#app-notice-region, .draft-live-shell">
                                    <input type="hidden" name="participantId" value="@player.Id" />
                                    <button class="btn btn-sm draft-live-pick-button" aria-label="Pick @player.Name for @Model.CurrentTurn.TeamName" title="Pick @player.Name">+</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm draft-live-pick-button" disabled aria-label="Take control to pick @player.Name" title="Take control to make picks">+</button>
                            }
                        }
                    </div>
                }
                @if (!Model.Participants.Any(x => x.TeamId is null && x.SignupStatus == SignupStatus.Confirmed))
                {
                    <p class="draft-live-empty">No players remain.</p>
                }
            </div>
            </div>
        </aside>
    </div>
</div>
}
else
{
@if (isFinalizedDraft)
{
    <section class="panel draft-compact-control">
        <h2>Published roster</h2>
        <p>The public roster is frozen for this publication cycle. Reopen only before the scheduled event start to correct the existing draft ledger.</p>
        <form method="post" asp-page-handler="Reopen" class="form-stack" onsubmit="return confirm('Withdraw the public roster and reopen this draft for correction?');">
            <input type="hidden" name="confirmed" value="true" />
            <label>Admin reason <input name="reason" required maxlength="2000" /></label>
            <button class="btn btn-sm btn-outline-danger catalogue-compact-action">Reopen draft</button>
        </form>
    </section>
}
@if (!isFinalizedDraft)
{
<div class="action-grid @(Model.Draft.State == DraftState.Setup ? "draft-setup-actions" : null)">
    <section class="panel draft-pool-summary">
        <h2>Player pool</h2>
        <div class="draft-pool-counts">
            <span><strong>@Model.AvailableCount</strong> available</span>
            <span><strong>@Model.AssignedCount</strong> assigned</span>
            <span><strong>@Model.Remainder</strong> remaining</span>
        </div>
    </section>
    @if (Model.Draft.State == DraftState.Setup)
    {
        <section class="panel draft-compact-control draft-size-control"><h2>Derived distribution</h2><p>@Model.Distribution!.IncludedParticipants eligible participants across @Model.Distribution.DraftedTeamCount drafted teams: @Model.Distribution.LargerTeamCount team(s) finish at @Model.Distribution.LargerSize and @Model.Distribution.SmallerTeamCount at @Model.Distribution.SmallerSize.</p></section>
        <section class="panel draft-compact-control draft-setup-controller-control">
            <h2>Draft control</h2>
            @if (Model.CanControlDraft)
            {
                <p>You control this draft and can start it when the teams are ready.</p>
                <form method="post" asp-page-handler="ReleaseControl"><button class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action">Release control</button></form>
            }
            else if (Model.DraftControllerAccountId is not null)
            {
                <p>@(Model.DraftControllerName ?? "Another admin") is controlling this draft.</p>
                <form method="post" asp-page-handler="TakeControl" onsubmit="return confirm('Take control from the current administrator? They will immediately become read-only.');"><input type="hidden" name="confirmed" value="true" /><button class="btn btn-sm btn-warning catalogue-compact-action">Take over</button></form>
            }
            else
            {
                <p>No admin is controlling this draft. Starting it will take control.</p>
            }
        </section>
        <form method="post" asp-page-handler="Start" class="panel draft-compact-control draft-start-control" onsubmit="return confirm('Open the draft workspace and lock this setup?');">
            <div>
                <h2>Start draft</h2>
                <p>@(Model.DraftControllerAccountId is not null && !Model.CanControlDraft ? "Take over control before starting the draft." : "Open the live workspace, then scramble the teams before the first pick.")</p>
            </div>
            @if (Model.DraftControllerAccountId is not null && !Model.CanControlDraft)
            {
                <button class="btn btn-sm btn-warning catalogue-compact-action" disabled>Start draft</button>
            }
            else
            {
                <button class="btn btn-sm btn-warning catalogue-compact-action">Start draft</button>
            }
        </form>
    }
@if(Model.Draft.State == DraftState.Running && Model.CanControlDraft){<form method="post" asp-page-handler="Pause" class="panel form-stack"><h2>Draft controls</h2><button class="btn btn-outline-light neutral-outline-action">Pause draft</button></form>}
@if(Model.Draft.State == DraftState.Paused && Model.CanControlDraft){<form method="post" asp-page-handler="Resume" class="panel form-stack"><h2>Draft controls</h2><button class="btn btn-primary">Resume draft</button></form>}
</div>
}

@if(Model.CurrentTurn is not null){<section class="panel current-turn"><p class="eyebrow">Pick @Model.CurrentTurn.PickNumber · round @Model.CurrentTurn.RoundNumber</p><h2>@Model.CurrentTurn.TeamName is choosing</h2></section>}

<section class="draft-teams-section">
<div class="page-heading subheading">
    <div><h2>Teams</h2><small>Pre-formed roster membership is managed here; captain assignments are a later pass.</small></div>
    @if (Model.Draft.State is DraftState.Setup or DraftState.Finalized)
    {
        <div class="team-heading-actions">
            <button type="button" class="btn btn-sm btn-outline-primary catalogue-add-action catalogue-compact-action" onclick="document.getElementById('add-team').showModal()">＋ Add team</button>
        </div>
    }
</div>
<div class="team-grid" data-draft-team-grid>
@foreach(var team in Model.Teams)
{
    <article class="panel team-card @(isFinalizedDraft ? "finalized-team-card" : null) @(team.IsCurrent ? "current-team" : "")" data-team-id="@team.Id" data-team-name="@team.Name" data-member-count="@team.Members.Count" data-draft-team="@(team.FormationType == TeamFormationType.Drafted ? "true" : "false")">
        @if (isFinalizedDraft)
        {
            <div class="finalized-team-heading">
                <div>
                    <h3>@team.Name</h3>
                    @if (team.FormationType == TeamFormationType.Preformed)
                    {
                        <small>
                            External team
                            @if (!string.IsNullOrWhiteSpace(team.Affiliation))
                            {
                                <text> · @team.Affiliation</text>
                            }
                        </small>
                    }
                </div>
                <div class="team-card-heading-actions">
                    @if(team.DraftPosition is not null){<strong data-draft-rank>#@team.DraftPosition</strong>}
                    @if(team.FormationType==TeamFormationType.Preformed){<form method="post" asp-page-handler="RemoveExternalTeam" onsubmit="return confirm('Remove the external team @team.Name?');"><input type="hidden" name="teamId" value="@team.Id"/><button class="team-remove-button" aria-label="Remove @team.Name" title="Remove external team">×</button></form>}
                </div>
            </div>
            <ol class="finalized-roster-list">
                @foreach (var member in team.Members)
                {
                    <li class="@(member.Role is TeamMembershipRole.Captain or TeamMembershipRole.CoCaptain ? "finalized-roster-captain" : null)">
                        <span class="finalized-roster-pick">@(member.PickNumber is null ? "" : $"#{member.PickNumber}")</span>
                        <strong>@member.Name</strong>
                        @if (member.Role is TeamMembershipRole.Captain or TeamMembershipRole.CoCaptain)
                        {
                            <small>@(member.Role == TeamMembershipRole.CoCaptain ? "Co-captain" : "Captain")</small>
                        }
                    </li>
                }
            </ol>
            <footer class="finalized-team-footer">
                <button type="button" class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action" onclick="document.getElementById('team-@team.Id').showModal()">Edit roster</button>
                <span>@team.Members.Count / @team.ProjectedFinalSize</span>
            </footer>
        }
        else
        {
        <div class="page-heading"><div><h3>@team.Name</h3><small>@team.FormationType @if(!string.IsNullOrWhiteSpace(team.Affiliation)){<text> · @team.Affiliation</text>}</small></div><div class="team-card-heading-actions">@if(team.DraftPosition is not null){<strong data-draft-rank>#@team.DraftPosition</strong>}@if(Model.Draft.State==DraftState.Setup&&team.FormationType==TeamFormationType.Drafted){<form method="post" asp-page-handler="RemoveDraftTeam" onsubmit="return confirm('Remove @team.Name from the website draft?');"><input type="hidden" name="teamId" value="@team.Id"/><button class="team-remove-button" aria-label="Remove @team.Name" title="Remove draft team">×</button></form>}else if(Model.Draft.State is DraftState.Setup or DraftState.Finalized && team.FormationType==TeamFormationType.Preformed){<form method="post" asp-page-handler="RemoveExternalTeam" onsubmit="return confirm('Remove the external team @team.Name?');"><input type="hidden" name="teamId" value="@team.Id"/><button class="team-remove-button" aria-label="Remove @team.Name" title="Remove external team">×</button></form>}</div></div>
        <p>@if(team.FormationType == TeamFormationType.Drafted){<text>@team.TotalEhb.ToString("0.##") EHB · </text>}@team.Members.Count member(s)</p>
        <ul>@foreach(var member in team.Members){var memberRoleLabel=member.Role==TeamMembershipRole.CoCaptain?"Co-captain":member.Role.ToString();<li><span>@member.Name <small><span id="roster-role-@member.MembershipId">@memberRoleLabel</span>@if(team.FormationType == TeamFormationType.Drafted){<text> · @member.Ehb EHB</text>}</small></span></li>}</ul>
        <div class="dialog-actions"><button type="button" class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action" onclick="document.getElementById('team-@team.Id').showModal()">Edit / roster</button></div>
        }
    </article>
    <dialog id="team-@team.Id" class="tile-dialog team-roster-dialog" data-preserve-post-dialog>
        <header class="team-roster-dialog-header">
            <div><p class="eyebrow">Team roster</p><h2>@team.Name</h2></div>
            <button type="button" class="dialog-close" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
        </header>

        <details class="team-roster-section">
            <summary><span><strong>Team details</strong><small>Name, clan and image</small></span></summary>
            <form method="post" enctype="multipart/form-data" asp-page-handler="UpdateTeam" class="form-stack team-details-form">
                <input type="hidden" name="teamId" value="@team.Id" />
                <label>Name<input name="name" value="@team.Name" class="form-control" required /></label>
                <label>Affiliation / clan<input name="affiliation" value="@team.Affiliation" class="form-control" /></label>
                <input type="hidden" name="version" value="@team.Version" />
                @if (!string.IsNullOrWhiteSpace(team.ImageUrl))
                {
                    <img src="@team.ImageUrl" alt="Current image for @team.Name" class="team-details-image" />
                }
                <label>Image file<input name="image" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" /></label>
                <label><input name="removeImage" type="checkbox" value="true" /> Remove current image</label>
                <div class="dialog-actions"><button class="btn btn-primary">Save team</button></div>
            </form>
        </details>

        <section class="team-roster-section team-roster-roles">
            <header><h3>Roster</h3><small>Assign Captain or Co-captain only to current members. Website authority requires that member's explicit website-account ownership.</small></header>
            <p class="team-readiness-status">@(team.HasUsableCaptain ? "Usable Captain assigned." : team.HasEnabledEmergencyAccess ? "Emergency access enabled; assign a usable Captain for draft readiness." : "Captain access needs attention.") <a asp-page="/Admin/Accounts/Create" asp-route-eventId="@Model.EventId" asp-route-teamId="@team.Id">Emergency credential</a></p>
            @if (team.Members.Count == 0)
            {
                <p class="team-roster-empty">No players have been added yet.</p>
            }
            @foreach (var member in team.Members)
            {
                <div class="team-role-form">
                    <strong>@member.Name</strong>
                    <form method="post" asp-page-handler="ChangeRole" class="team-member-move-form">
                        <input type="hidden" name="membershipId" value="@member.MembershipId" />
                        <label class="visually-hidden" for="role-@member.MembershipId">Role for @member.Name</label>
                        <select id="role-@member.MembershipId" name="role" class="form-select" onchange="this.form.requestSubmit()">
                            <option value="Participant" selected="@(member.Role == TeamMembershipRole.Participant)">Participant</option>
                            <option value="Captain" selected="@(member.Role == TeamMembershipRole.Captain)">Captain</option>
                            <option value="CoCaptain" selected="@(member.Role == TeamMembershipRole.CoCaptain)">Co-captain</option>
                        </select>
                        <button class="btn btn-sm neutral-outline-action" type="submit">Save role</button>
                    </form>
                    @if (isPreDraft || (team.FormationType == TeamFormationType.Preformed && member.External))
                    {
                        <form method="post" asp-page-handler="RemoveMember" class="team-role-remove-form" onsubmit="return confirm('Remove @member.Name from this roster?');">
                            <input type="hidden" name="membershipId" value="@member.MembershipId" />
                            @if (team.FormationType == TeamFormationType.Drafted) { <input type="hidden" name="reason" value="Removed from roster" /> }
                            @if (isFinalizedDraft) { <input type="hidden" name="confirmed" value="true" /> }
                            <button class="roster-remove-button" aria-label="Remove @member.Name from roster" title="Remove from roster">×</button>
                        </form>
                    }
                </div>
                @if (team.FormationType == TeamFormationType.Preformed && Model.Teams.Any(x => x.Id != team.Id && x.FormationType == TeamFormationType.Preformed))
                {
                    <details class="team-member-move">
                        <summary>Move @member.Name to another pre-formed team</summary>
                        <form method="post" asp-page-handler="MoveMember" class="team-member-move-form">
                            <input type="hidden" name="membershipId" value="@member.MembershipId" />
                            <select name="targetTeamId" class="form-select">
                                @foreach (var target in Model.Teams.Where(x => x.Id != team.Id && x.FormationType == TeamFormationType.Preformed))
                                {
                                    <option value="@target.Id">@target.Name</option>
                                }
                            </select>
                            @if (isFinalizedDraft) { <input type="hidden" name="confirmed" value="true" /> }
                            <button class="btn btn-sm btn-outline-light catalogue-compact-action neutral-outline-action">Move player</button>
                        </form>
                    </details>
                }
            }
        </section>

        @if (team.FormationType == TeamFormationType.Preformed)
        {
            <details class="team-roster-section">
                <summary><span><strong>Add external player</strong><small>Add someone drafted outside the website</small></span></summary>
                <form method="post" asp-page-handler="AddExternalMember" class="form-stack team-add-player-form">
                    <input type="hidden" name="teamId" value="@team.Id" />
                    <label>In-game name<input name="name" class="form-control" required /></label>
                    <label>Primary EHB<input name="ehb" type="number" min="0" step="0.01" class="form-control" required /></label>
                    <label>Additional OSRS accounts (one per line)<textarea name="additionalAccounts" class="form-control"></textarea></label>
                    @if (isFinalizedDraft) { <input type="hidden" name="confirmed" value="true" /> }
                    <div class="dialog-actions"><button class="btn btn-primary">Add player</button></div>
                </form>
            </details>
            <details class="team-roster-section team-roster-advanced" @(Model.CsvPreview is not null ? "open" : null)>
                <summary><span><strong>Import external roster CSV</strong><small>Uses the same unowned Pre-formed roster records as manual entry</small></span></summary>
                <p>One row per member: <code>Account,EHB</code>, followed only by optional additional <code>Account</code> columns. Captain roles are assigned separately.</p>
                <a class="btn btn-sm btn-outline-light neutral-outline-action" asp-page-handler="RosterCsvTemplate" asp-route-id="@RouteData.Values["id"]" asp-route-teamId="@team.Id">Download CSV template</a>
                <form method="post" enctype="multipart/form-data" asp-page-handler="PreviewRosterCsv" class="form-stack team-add-player-form">
                    <input type="hidden" name="teamId" value="@team.Id" />
                    <label>Roster CSV<input name="csv" type="file" accept="text/csv,.csv" class="form-control" required /></label>
                    <div class="dialog-actions"><button class="btn btn-outline-primary">Preview import</button></div>
                </form>
                @if (Model.CsvPreview is not null)
                {
                    if (Model.CsvPreview.IsValid)
                    {
                        <section class="ui-message ui-message-success" aria-live="polite"><strong>Ready to import @Model.CsvPreview.Rows.Count members.</strong><ul>@foreach (var row in Model.CsvPreview.Rows) { <li>Row @row.Number: @string.Join(", ", row.Accounts) (@row.Ehb EHB)</li> }</ul></section>
                        <form method="post" asp-page-handler="ApplyRosterCsv" class="form-stack team-add-player-form">
                            <input type="hidden" name="teamId" value="@team.Id" /><input type="hidden" name="previewToken" value="@Model.CsvPreview.Nonce" />
                            <p>The validated preview above will be imported.</p>
                            <div class="dialog-actions"><button class="btn btn-outline-primary">Apply roster import</button></div>
                        </form>
                    }
                    else
                    {
                        <section class="ui-message ui-message-error" aria-live="assertive"><strong>CSV preview needs correction.</strong><ul>@foreach (var error in Model.CsvPreview.Errors) { <li>Row @error.Number: @error.Message</li> }</ul></section>
                    }
                }
            </details>
            @if (Model.Draft.State == DraftState.Setup)
            {
                <details class="team-roster-section team-roster-advanced">
                    <summary><span><strong>Advanced correction</strong><small>Use a website signup in this pre-formed team</small></span></summary>
                    <p>Website signups normally join website-drafted teams. Use this only to correct an unusual roster.</p>
                    <form method="post" asp-page-handler="AddMember" class="form-stack team-add-player-form">
                        <input type="hidden" name="teamId" value="@team.Id" />
                        <label>Available participant<select name="participantId" class="form-select"><option value="">Choose participant</option>@foreach (var player in Model.Participants.Where(x => x.TeamId is null)){<option value="@player.Id">@player.Name (@player.Ehb EHB)</option>}</select></label>
                        <div class="dialog-actions"><button class="btn btn-outline-light neutral-outline-action">Add website signup</button></div>
                    </form>
                </details>
            }
        }
        else if ((Model.Draft.State is DraftState.Setup or DraftState.Running) && !Model.Draft.FirstPickRecorded)
        {
            <details class="team-roster-section">
                <summary><span><strong>Add participant</strong><small>Choose someone from the available signup pool</small></span></summary>
                <form method="post" asp-page-handler="AddMember" class="form-stack team-add-player-form">
                    <input type="hidden" name="teamId" value="@team.Id" />
                    <label>Available participant<select name="participantId" class="form-select"><option value="">Choose participant</option>@foreach (var player in Model.Participants.Where(x => x.TeamId is null)){<option value="@player.Id">@player.Name (@player.Ehb EHB)</option>}</select></label>
                    <label>Reason<input name="reason" class="form-control" required value="Manual roster assignment" /></label>
                    <div class="dialog-actions"><button class="btn btn-primary">Add to roster</button></div>
                </form>
            </details>
        }
    </dialog>
}
</div>
</section>

<section class="draft-participant-section subheading" data-participant-group data-no-matches="No matching participants.">
    <div class="draft-participant-heading">
        <div>
            <h2>Participant pool</h2>
            <p>@(isFinalizedDraft ? "Search the event participants or sort a column." : "Search the pool or sort a column before starting the draft.")</p>
        </div>
        <div class="participant-group-tools">
            <input type="search" placeholder="Search participants" aria-label="Search participants" data-participant-search />
            <span class="participant-count">@Model.Participants.Count</span>
        </div>
    </div>
    <div class="participant-table-wrap panel draft-participant-table-wrap">
        <table class="participant-table">
            <thead>
                <tr>
                    <th><button type="button" class="participant-sort" data-participant-sort data-sort-type="text" data-sort-index="0">Player</button></th>
                    <th><button type="button" class="participant-sort" data-participant-sort data-sort-type="number" data-sort-index="1">EHB</button></th>
                    <th><button type="button" class="participant-sort" data-participant-sort data-sort-type="text" data-sort-index="2">Payment</button></th>
                    <th><button type="button" class="participant-sort" data-participant-sort data-sort-type="date" data-sort-index="3">Signed up</button></th>
                    <th><button type="button" class="participant-sort" data-participant-sort data-sort-type="text" data-sort-index="4">Draft status</button></th>
                    @if (isPreDraft)
                    {
                        <th><span class="visually-hidden">Actions</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in Model.Participants)
                {
                    var participantRole = participant.TeamId is null
                        ? null
                        : Model.Teams.SelectMany(team => team.Members).FirstOrDefault(member => member.Name == participant.Name)?.Role;
                    var payment = Model.ParticipantPayments.GetValueOrDefault(participant.Id, PaymentStatus.Unpaid);
                    var paymentLabel = payment.ToString();
                    <tr class="@(participant.TeamId is null ? "" : "drafted-player")" data-participant-row>
                        <td data-label="Player" data-sort-value="@participant.Name">
                            <strong>@participant.Name</strong>
                            @if (participantRole == TeamMembershipRole.Captain)
                            {
                                <small>Captain</small>
                            }
                            else if (participantRole == TeamMembershipRole.CoCaptain)
                            {
                                <small>Co-captain</small>
                            }
                            else if (participant.CaptainVolunteer)
                            {
                                <small>Captain volunteer</small>
                            }
                        </td>
                        <td data-label="EHB" data-sort-value="@participant.Ehb.ToString(System.Globalization.CultureInfo.InvariantCulture)">@participant.Ehb.ToString("0.##")</td>
                        <td data-label="Payment" data-sort-value="@paymentLabel">@paymentLabel</td>
                        <td data-label="Signed up" data-sort-value="@participant.SignedUpAt.ToUnixTimeSeconds()">@participant.SignedUpAt.ToLocalTime().ToString("g")</td>
                        <td data-label="Draft status" data-sort-value="@(participant.TeamName ?? "Available")">
                            @(participant.TeamName ?? "Available")
                            @if (participant.SignupStatus != SignupStatus.Confirmed)
                            {
                                <small>Signup status: @participant.SignupStatus</small>
                            }
                        </td>
                        @if (isPreDraft)
                        {
                            <td data-label="Actions" class="participant-row-actions">
                            @if (participant.TeamId is null)
                            {
                                <form method="post" asp-page-handler="WithdrawParticipant" onsubmit="return confirm('Withdraw this participant from the event? The first eligible player on the waiting list will be promoted if a place becomes available.');">
                                    <input type="hidden" name="participantId" value="@participant.Id" />
                                    <button class="roster-remove-button" aria-label="Withdraw @participant.Name from event" title="Withdraw participant">×</button>
                                </form>
                            }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if(Model.CanControlDraft && Model.LatestPick is not null && Model.Draft.State is DraftState.Running or DraftState.Paused){<form method="post" asp-page-handler="Undo" class="panel inline-form" onsubmit="return confirm('Undo the latest pick?');"><span>Latest: #@Model.LatestPick.PickNumber @Model.LatestPick.PlayerName → @Model.LatestPick.TeamName</span><button class="btn btn-danger">Undo latest pick</button></form>}

<dialog id="add-team" class="tile-dialog team-roster-dialog external-team-dialog">
    <header class="team-roster-dialog-header">
        <div><p class="eyebrow">Team setup</p><h2>Add team</h2></div>
        <button type="button" class="dialog-close" aria-label="Close" onclick="this.closest('dialog').close()">×</button>
    </header>
    <p class="external-team-dialog-intro">Choose whether this is a website-drafted or pre-formed team. Pre-formed teams never receive draft turns.</p>
    <section class="team-roster-section team-roster-form-section">
        <header><h3>Team details</h3><small>Only the team name is required.</small></header>
        <form method="post" asp-page-handler="AddTeam" class="form-stack">
            <label>Team name<input name="name" class="form-control" required /></label>
            <label>Formation<select name="formationType" class="form-select"><option value="Drafted">Drafted</option><option value="Preformed">Pre-formed</option></select></label>
            <label>Affiliation / clan<input name="affiliation" class="form-control" /></label>
            @if (isFinalizedDraft) { <input type="hidden" name="confirmed" value="true" /> }
            <div class="dialog-actions"><button class="btn btn-outline-primary">Add team</button></div>
        </form>
    </section>
</dialog>
}
</section>

@section Scripts {
<script src="~/js/admin-collaboration.js" asp-append-version="true"></script>
<script src="~/js/draft-scramble.js" asp-append-version="true"></script>
<script src="~/js/event-manage.js" asp-append-version="true"></script>
}
