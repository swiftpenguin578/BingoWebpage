@section HeaderSummary {<span data-draft-summary>@Model.Summary</span>}
@section HeaderActions {<div class="td-head-acts" data-draft-head></div>}
<div data-draft data-event-id="@state.EventId" data-account-id="@Model.CurrentAccountId" data-labels="@labelJson">
    <script type="application/json" data-draft-state>@Html.Raw(stateJson)</script>
    <div class="td-body" data-draft-body>
        <partial name="_AdminDraftSkeleton" />
    </div>
    <div class="menu td-menu" id="draft-menu" role="menu" aria-label="@T["Team actions"]" hidden data-draft-menu-panel></div>
    <template data-draft-icons>@foreach (var name in icons) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon(name, name == "more" ? "ic-fill" : "ic")' /> }</template>
</div>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-draft.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-draft.js" asp-append-version="true" data-admin-page-script></script> }
