@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.ManageModel
@using Bingo.Domain.Events
@using Bingo.Domain.Signups
@{
    ViewData["Title"] = Model.EventView?.Name ?? "Event";
}
<section class="table-page">
<div class="page-heading"><div><p class="eyebrow">Event workspace</p><h1>@Model.EventView!.Name</h1><p class="form-intro">@Model.EventView.State · signup URL: <a href="/Events/@Model.EventView.Slug/Signup">/Events/@Model.EventView.Slug/Signup</a></p></div><a class="btn btn-outline-light" asp-page="Index">All events</a></div>
<div class="action-grid">
<section class="panel form-stack"><h2>Event operation</h2><p>@Model.EventView.StartsAt.ToLocalTime().ToString("g") – @Model.EventView.EndsAt.ToLocalTime().ToString("g")</p>@if(Model.EventView.State is not(EventState.Live or EventState.AwaitingFinalReview or EventState.Finalized or EventState.Archived)){<form method="post" asp-page-handler="StartEvent" onsubmit="return confirm('Start this event and open captain submissions?');"><button class="btn btn-primary">Start event</button></form>}@if(Model.EventView.State==EventState.Live){<form method="post" asp-page-handler="EndEvent" onsubmit="return confirm('End the event and enter final review?');"><button class="btn btn-warning">End event</button></form>}<p>Submission cutoff: @Model.EventView.SubmissionCutoff.ToLocalTime().ToString("g")</p>@if(Model.EventView.ReopenedCutoff is not null){<p>Reopened until: @Model.EventView.ReopenedCutoff.Value.ToLocalTime().ToString("g")</p>}@if(Model.EventView.State==EventState.AwaitingFinalReview){<form method="post" asp-page-handler="ReopenSubmissions" class="form-stack"><label asp-for="ReopenUntil"></label><input asp-for="ReopenUntil" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local"/><label asp-for="StateReason"></label><input asp-for="StateReason" required/><button class="btn btn-outline-light">Reopen submissions</button></form>}<a class="btn btn-outline-light" asp-page="/Admin/Review/Index">Open evidence review</a>@if(Model.EventView.State is EventState.AwaitingFinalReview or EventState.Finalized or EventState.Archived){<a class="btn btn-primary" asp-page="Finalize" asp-route-id="@Model.EventView.Id">Final review and results</a>}</section>
<section class="panel form-stack"><div class="page-heading"><h2>Screenshot verification codes</h2><form method="post" asp-page-handler="EvidenceCodeMode"><input type="hidden" name="enabled" value="@(!Model.EventView.EvidenceCodeEnabled)"/><button class="btn btn-sm @(Model.EventView.EvidenceCodeEnabled?"btn-warning":"btn-primary")">@(Model.EventView.EvidenceCodeEnabled?"Disable":"Enable")</button></form></div><p>Separate from the signup code. Reviewers compare the code active at immutable submission time.</p><fieldset disabled="@(!Model.EventView.EvidenceCodeEnabled)" class="form-stack"><form method="post" asp-page-handler="CreateEvidenceCode" class="form-stack"><label asp-for="NewEvidenceCode"></label><input asp-for="NewEvidenceCode" placeholder="Your fun custom code"/><label asp-for="EvidenceCodeActivatesAt"></label><input asp-for="EvidenceCodeActivatesAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local"/><label asp-for="EvidenceCodeNote"></label><input asp-for="EvidenceCodeNote"/><div><button class="btn btn-primary">Save custom code</button><button class="btn btn-outline-light" asp-page-handler="GenerateEvidenceCode">Generate code instead</button></div></form></fieldset><ul class="code-history">@foreach(var code in Model.EvidenceCodes){<li><strong>@code.Code</strong><span>@code.ActivatesAt.ToLocalTime().ToString("g") → @(code.RetiresAt?.ToLocalTime().ToString("g")??"active indefinitely")</span>@if(code.Note is not null){<small>@code.Note</small>}</li>}</ul></section>
</div>
<div class="action-grid">
<form method="post" asp-page-handler="State" class="panel form-stack"><h2>Signup publication</h2><p>Opening signups publishes only event information and the signup form. It does not publish teams or the board.</p><input type="hidden" name="target" value="@(Model.EventView.State == EventState.SignupOpen ? EventState.SignupClosed : EventState.SignupOpen)" />@if(Model.EventView.State==EventState.SignupClosed&&!Model.EventView.DraftLocked){<label asp-for="StateReason"></label><input asp-for="StateReason" class="form-control" required />}<button class="btn btn-primary" type="submit" disabled="@Model.EventView.DraftLocked">@(Model.EventView.State == EventState.SignupOpen ? "Close signups" : "Open signups")</button>@if(Model.EventView.DraftLocked){<small>Signups are permanently closed for this draft.</small>}</form>
<form method="post" asp-page-handler="Capacity" class="panel form-stack"><h2>Capacity</h2><p>@Model.EventView.Confirmed confirmed · @Model.EventView.Waiting waiting · cap @Model.EventView.ParticipantCap</p><label asp-for="NewCap"></label><input asp-for="NewCap" class="form-control" min="@Model.EventView.ParticipantCap" disabled="@Model.EventView.DraftLocked" /><button class="btn btn-primary" type="submit" disabled="@Model.EventView.DraftLocked">Increase and promote</button>@if(Model.EventView.DraftLocked){<small>The participant pool is locked because the draft has started.</small>}</form>
<form method="post" asp-page-handler="Extend" class="panel form-stack"><h2>Extend signups</h2><p>Current close: @Model.EventView.SignupClosesAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><label asp-for="NewSignupClosing"></label><input asp-for="NewSignupClosing" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" step="1800" /><button class="btn btn-primary" type="submit">Extend closing time</button></form>
@if(Model.IsDevelopment){<form method="post" asp-page-handler="AddTestSignups" class="panel form-stack" onsubmit="return confirm('Add the 60 published-sheet participants to this event? Existing account names will be skipped.');"><h2>Development test data</h2><p>Add all 60 participants from the published legacy signup sheet. Capacity is respected, so overflow enters the waiting list.</p><button class="btn btn-warning">Add 60 test signups</button></form>}
</div>
<div class="page-heading subheading"><h2>Participants</h2><div><a class="btn btn-outline-light" asp-page="Draft" asp-route-id="@Model.EventView.Id">Teams and draft</a> <a class="btn btn-outline-light" asp-page="Board" asp-route-id="@Model.EventView.Id">Board editor</a> <a class="btn btn-outline-light" asp-page="Questions" asp-route-id="@Model.EventView.Id">Signup questions</a> <a class="btn btn-outline-light" asp-page="Csv" asp-route-id="@Model.EventView.Id">CSV import</a></div></div>
@{
    var participantGroups = new[]
    {
        (Title: "Confirmed participants", Description: "These players are in the website draft pool.", Rows: Model.Participants.Where(p => p.Status == SignupStatus.Confirmed).ToList()),
        (Title: "Waiting list", Description: "These players are not available to the draft unless promoted before it starts.", Rows: Model.Participants.Where(p => p.Status == SignupStatus.WaitingList).ToList()),
        (Title: "Inactive signups", Description: "Withdrawn and removed signup records.", Rows: Model.Participants.Where(p => p.Status is SignupStatus.Withdrawn or SignupStatus.Removed).ToList())
    };
}
@foreach (var group in participantGroups)
{
    <div class="page-heading subheading"><div><h3>@group.Title</h3><p>@group.Description</p></div><strong>@group.Rows.Count</strong></div>
    <div class="table-wrap panel"><table><thead><tr><th>#</th><th>Player</th><th>EHB</th><th>Status</th><th>Payment</th><th>Signed up</th><th>Actions</th></tr></thead><tbody>
    @if (group.Rows.Count == 0) { <tr><td colspan="7"><small>No players in this section.</small></td></tr> }
    @foreach (var p in group.Rows) { <tr><td>@p.Sequence</td><td><a asp-page="Participant" asp-route-id="@Model.EventView.Id" asp-route-participantId="@p.Id">@p.Name</a> @if(p.CaptainVolunteer){<small>captain</small>}</td><td>@p.Ehb</td><td>@p.Status @if(p.WaitingPosition is not null){<small>#@p.WaitingPosition</small>}</td><td>@p.Payment</td><td>@p.SignedUpAt.ToLocalTime().ToString("g")</td><td>@if(p.Status is SignupStatus.Confirmed or SignupStatus.WaitingList){@if(Model.EventView.DraftLocked){<small>Locked for draft</small>}else{<form method="post" class="inline-form"><input type="hidden" name="participantId" value="@p.Id" /><input name="reason" required placeholder="Reason" /><button asp-page-handler="Withdraw" class="btn btn-sm btn-outline-light">Withdraw</button><button asp-page-handler="Remove" class="btn btn-sm btn-danger">Remove</button></form>}}</td></tr> }
    </tbody></table></div>
}
</section>
