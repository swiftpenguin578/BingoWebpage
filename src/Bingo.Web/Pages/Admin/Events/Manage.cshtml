@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.ManageModel
@using Bingo.Domain.Events
@using Bingo.Domain.Signups
@{
    ViewData["Title"] = Model.EventView?.Name ?? T["Event"];
    ViewData["CompactNavigation"] = true;

    var eventView = Model.EventView!;
    var metricProfile = ManageModel.MetricsFor(eventView.State);
    var signupAndPlayersLocked = eventView.DraftLocked || eventView.State is EventState.Live or EventState.AwaitingFinalReview or EventState.Finalized or EventState.Archived;
    var showSignupControls = !signupAndPlayersLocked && eventView.State is EventState.Draft or EventState.SignupOpen or EventState.SignupClosed;
    var showStartControl = eventView.State == EventState.SignupClosed;
    var showLiveControls = eventView.State == EventState.Live;
    var showFinalReviewControls = eventView.State == EventState.AwaitingFinalReview;
    var showResultsControl = eventView.State is EventState.Finalized or EventState.Archived;
    var showDestructivePreLiveControl = eventView.State is EventState.Draft or EventState.SignupOpen or EventState.SignupClosed;
    var partialUpdateTargets = "#app-notice-region, .event-manage-heading, .event-control-workspace";
    var teamSizeLabel = eventView.ActualTeamSize ?? (eventView.ExpectedTeamSize is { } expectedTeamSize ? $"{expectedTeamSize} players/team" : null);
    var boardSizeLabel = eventView.ActualBoardSize ?? eventView.ExpectedBoardSize;
    var signupUrl = Url.Page("/Events/Signup", null, new { slug = eventView.Slug }, Request.Scheme, Request.Host.Value);
    var signupTableUrl = Url.Page("/Events/Signups", null, new { slug = eventView.Slug }, Request.Scheme, Request.Host.Value);
    var publicBoardUrl = Url.Page("/Events/Board", null, new { slug = eventView.Slug }, Request.Scheme, Request.Host.Value);
    var showPublicBoard = eventView.FirstPublicAt is not null && eventView.BoardPublished;
    var signupProgress = ManageModel.SignupProgressPercent(eventView.Confirmed, eventView.ParticipantCap);
    var boardGridLabel = eventView.BoardRows is { } boardRows && eventView.BoardColumns is { } boardColumns
        ? $"{boardRows} × {boardColumns} {T["Board grid"]}"
        : T["Board grid"].Value;
    var boardTileSummary = eventView.ConfiguredBoardTileCount is { } configuredTiles && eventView.ExpectedBoardCellCount is { } expectedTiles
        ? $"{configuredTiles} / {expectedTiles}"
        : null;
}

<section class="table-page event-manage-page">
    <header class="event-manage-heading event-overview-hero">
        <div class="event-overview-heading-copy">
            <div class="event-overview-badges">
                <span class="event-overview-slug">@eventView.Slug</span>
            </div>
            <h1>@eventView.Name</h1>
            @if (!string.IsNullOrWhiteSpace(eventView.Description))
            {
                <p class="event-overview-context">@eventView.Description</p>
            }
            <div class="event-overview-meta" aria-label="@T["Event context"]">
                @if (eventView.StartsAt is not null || eventView.EndsAt is not null)
                {
                    <span class="event-overview-meta-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>@Model.EventDate(eventView.StartsAt, T["Not set"]) — @Model.EventDate(eventView.EndsAt, T["Not set"])</span>
                }
                @if (teamSizeLabel is not null)
                {
                    <span class="event-overview-meta-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm9 10v-2a4 4 0 0 0-3-3.87m-1-11.13a4 4 0 0 1 0 7.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>@teamSizeLabel</span>
                }
                @if (boardSizeLabel is not null)
                {
                    <span class="event-overview-meta-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" /><rect x="14" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" /><rect x="3" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" /><rect x="14" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" /></svg>@boardSizeLabel @T["board"]</span>
                }
                <span class="event-overview-meta-item">@eventView.Timezone</span>
            </div>
        </div>
        <div class="event-overview-heading-action">
            @if (Model.OverviewBlockers.Count > 0)
            {
                <a class="btn event-overview-header-action event-overview-header-action-warning" href="#readiness">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M12 9v4m0 4h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>
                    @T["Blockers ({0})", Model.OverviewBlockers.Count]
                </a>
            }
            else if (eventView.State == EventState.Draft)
            {
                <a class="btn event-overview-header-action" asp-page="Schedule" asp-route-id="@eventView.Id">@T["Review setup"]</a>
            }
            else if (eventView.State == EventState.SignupOpen)
            {
                <a class="btn event-overview-header-action" asp-page="Participants" asp-route-id="@eventView.Id">@T["Review signups"]</a>
            }
            else if (eventView.State == EventState.SignupClosed)
            {
                <a class="btn event-overview-header-action" asp-page="Draft" asp-route-id="@eventView.Id">@T["Review teams and draft"]</a>
            }
            else if (eventView.State == EventState.Live)
            {
                <a class="btn event-overview-header-action" asp-page="/Admin/Review/Index" asp-route-eventId="@eventView.Id">@T["Review submissions"]</a>
            }
            else if (eventView.State == EventState.AwaitingFinalReview)
            {
                <a class="btn event-overview-header-action" asp-page="Finalize" asp-route-id="@eventView.Id">@T["Open final review"]</a>
            }
            else if (eventView.State is EventState.Finalized or EventState.Archived)
            {
                <a class="btn event-overview-header-action" asp-page="Finalize" asp-route-id="@eventView.Id">@T["View results"]</a>
            }
            else
            {
                <a class="btn event-overview-header-action" asp-page="Index">@T["All events"]</a>
            }
        </div>
    </header>

    <section class="event-overview" aria-label="@T["Operational overview"]" data-manage-overview>
        <div class="event-overview-summary" aria-label="@T["Event summary"]">
            @if (metricProfile == ManageModel.OverviewMetricProfile.DraftOrSignupOpen)
            {
                <article class="event-overview-metric"><span>@T["Signups / capacity"]</span><strong>@eventView.Confirmed <small>/ @eventView.ParticipantCap @T["max"]</small></strong>@if (signupProgress is { } percent) { <div class="event-overview-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent" aria-label="@T["Signup capacity used"]"><span style="width: @percent%"></span></div> }</article>
                <article class="event-overview-metric"><span>@T["Waiting list"]</span><strong>@eventView.Waiting</strong><small>@T["Queued participants"]</small></article>
                <article class="event-overview-metric"><span>@T["Signup closes"]</span><strong>@Model.EventDate(eventView.SignupClosesAt, T["Not set"])</strong><small>@eventView.Timezone</small></article>
                <article class="event-overview-metric"><span>@boardGridLabel</span>@if (boardTileSummary is { } tileSummary) { <strong>@tileSummary <small>@T["Tiles"]</small></strong><small>@T["Configured tiles / expected cells"]</small> } else { <strong>@T["Not configured"]</strong><small>@T["Board dimensions are not configured"]</small> }</article>
            }
            else if (metricProfile == ManageModel.OverviewMetricProfile.SignupClosed)
            {
                <article class="event-overview-metric"><span>@T["Confirmed players"]</span><strong>@eventView.Confirmed <small>/ @eventView.ParticipantCap @T["max"]</small></strong><small>@T["Roster candidates"]</small></article>
                <article class="event-overview-metric"><span>@T["Teams & roster"]</span><strong>@(eventView.ActualTeamCount > 0 ? eventView.ActualTeamCount : eventView.ExpectedTeamCount ?? 0) <small>@T["teams"]</small></strong><small>@T["Current draft structure"]</small></article>
                <article class="event-overview-metric"><span>@T["Start readiness"]</span><strong>@(Model.StartReadiness?.Blockers.Count ?? 0) <small>@T["blockers"]</small></strong><small>@T["Playing, access and setup checks"]</small></article>
                <article class="event-overview-metric"><span>@boardGridLabel</span>@if (boardTileSummary is { } tileSummary) { <strong>@tileSummary <small>@T["Tiles"]</small></strong> } else { <strong>@T["Not configured"]</strong> }<small>@T["Published board"]</small></article>
            }
            else if (metricProfile == ManageModel.OverviewMetricProfile.Live)
            {
                var syncLabel = Model.CompetitionIntegration is not { Configured: true }
                    ? T["Not configured"]
                    : Model.CompetitionIntegration.Complete == true
                        ? T["Complete"]
                        : Model.CompetitionIntegration.MissingAccounts.Count > 0 ? T["Missing accounts"] : T["Needs attention"];
                <article class="event-overview-metric"><span>@T["Teams & roster"]</span><strong>@eventView.ActualTeamCount <small>@T["teams"]</small></strong><small>@T["Active competition"]</small></article>
                <article class="event-overview-metric"><span>@boardGridLabel</span>@if (boardTileSummary is { } tileSummary) { <strong>@tileSummary <small>@T["Tiles"]</small></strong> } else { <strong>@T["Not configured"]</strong> }<small>@T["Live board"]</small></article>
                <article class="event-overview-metric"><span>@T["Evidence queue"]</span><strong>@Model.PendingReviewCount <small>@T["pending"]</small></strong><small>@T["Awaiting review"]</small></article>
                <article class="event-overview-metric"><span>@T["Competition sync"]</span><strong>@syncLabel</strong><small>@T["Wise Old Man status"]</small></article>
            }
            else if (metricProfile == ManageModel.OverviewMetricProfile.FinalReview)
            {
                <article class="event-overview-metric"><span>@T["Evidence queue"]</span><strong>@Model.PendingReviewCount <small>@T["pending"]</small></strong><small>@T["Awaiting review"]</small></article>
                <article class="event-overview-metric"><span>@T["Submission cutoff"]</span><strong>@Model.EventDate(eventView.SubmissionCutoffAt, T["Not set"])</strong><small>@eventView.Timezone</small></article>
                <article class="event-overview-metric"><span>@T["Approved placements"]</span><strong>@(Model.FinalReviewReadiness?.Placements.Count ?? 0)</strong><small>@T["Calculated result"]</small></article>
                <article class="event-overview-metric"><span>@T["Finalization blockers"]</span><strong>@(Model.FinalReviewReadiness?.Blockers.Count(x => !x.Resolved) ?? 0)</strong><small>@T["Official result readiness"]</small></article>
            }
            else if (eventView.State == EventState.Cancelled)
            {
                <article class="event-overview-metric"><span>@T["Confirmed players"]</span><strong>@eventView.Confirmed</strong><small>@T["Affected participants"]</small></article>
                <article class="event-overview-metric"><span>@T["Waiting list"]</span><strong>@eventView.Waiting</strong><small>@T["Affected participants"]</small></article>
                <article class="event-overview-metric"><span>@T["Teams"]</span><strong>@eventView.ActualTeamCount</strong><small>@T["Recorded roster"]</small></article>
                <article class="event-overview-metric"><span>@T["Cancelled"]</span><strong>@Model.EventDate(eventView.CancelledAt, T["Not set"])</strong><small>@eventView.Timezone</small></article>
            }
            else
            {
                <article class="event-overview-metric"><span>@T["Confirmed players"]</span><strong>@eventView.Confirmed</strong><small>@T["Recorded roster"]</small></article>
                <article class="event-overview-metric"><span>@T["Teams & roster"]</span><strong>@eventView.ActualTeamCount <small>@T["teams"]</small></strong><small>@T["Final roster"]</small></article>
                <article class="event-overview-metric"><span>@boardGridLabel</span>@if (boardTileSummary is { } tileSummary) { <strong>@tileSummary <small>@T["Tiles"]</small></strong> } else { <strong>@T["Not configured"]</strong> }<small>@T["Recorded board"]</small></article>
                <article class="event-overview-metric"><span>@(eventView.State == EventState.Archived ? T["Archived"] : T["Finalized"])</span><strong>@Model.EventDate(eventView.State == EventState.Archived ? eventView.ArchivedAt : eventView.FinalizedAt, T["Not set"])</strong><small>@eventView.Timezone</small></article>
            }
        </div>

        <section id="readiness" class="event-overview-section event-overview-readiness-panel" aria-labelledby="event-readiness-heading">
            <div class="event-overview-section-heading">
                <div class="event-overview-heading-label">
                    @if (Model.OverviewBlockers.Count > 0)
                    {
                        <svg class="event-overview-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M12 9v4m0 4h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>
                    }
                    else
                    {
                        <svg class="event-overview-icon is-healthy" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>
                    }
                    <h2 id="event-readiness-heading">@T["Readiness checks"]</h2>
                </div>
                @if (Model.OverviewBlockers.Count > 0) { <a class="event-overview-blocker-link" href="#event-next-step-heading">@T["{0} blockers", Model.OverviewBlockers.Count]</a> }
            </div>
            @if (Model.OverviewBlockers.Count == 0)
            {
                <div class="event-overview-row event-overview-row-healthy">
                    <svg class="event-overview-row-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>
                    <div><strong>@T["No unresolved lifecycle blockers"]</strong><p>@T["The current state can use its available next action."]</p></div>
                </div>
            }
            else
            {
                @foreach (var blocker in Model.OverviewBlockers)
                {
                    <div class="event-overview-row event-overview-row-blocked">
                        <svg class="event-overview-row-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M12 9v4m0 4h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>
                        <div><strong>@blocker.Description</strong><p>@T["This is reported by the lifecycle readiness check."]</p></div>
                        @if (blocker.Route is not null) { <a href="@blocker.Route" data-signup-questions-trigger="@(blocker.Route.Contains("/Admin/Events/Questions/", StringComparison.OrdinalIgnoreCase) ? "true" : null)">@T[ManageModel.BlockerActionLabel(blocker)]</a> }
                    </div>
                }
            }
        </section>

        <section class="event-overview-section event-overview-dates-panel" aria-labelledby="event-dates-heading">
            <div class="event-overview-section-heading">
                <div class="event-overview-heading-label">
                    <svg class="event-overview-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg>
                    <h2 id="event-dates-heading">@T["Important information"]</h2>
                </div>
            </div>
            <dl class="event-overview-dates">
                @foreach (var row in Model.EffectiveTimeline)
                {
                    <div><dt>@T[row.Label]</dt><dd>@Model.EventDate(row.At)</dd></div>
                }
                <div><dt>@T["Wise Old Man sync"]</dt><dd>@(Model.CompetitionIntegration?.Configured == true ? T["Enabled"] : T["Not configured"])</dd></div>
            </dl>
            <div class="event-public-pages" aria-labelledby="event-public-pages-heading">
                <h3 id="event-public-pages-heading">@T["Public pages"]</h3>
                <div class="event-public-page-row"><a href="@signupUrl">@T["Signup form"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@signupUrl" aria-label="@T["Copy signup form link"]"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg></button></div>
                <div class="event-public-page-row"><a href="@signupTableUrl">@T["Public signup table"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@signupTableUrl" aria-label="@T["Copy public signup table link"]"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg></button></div>
                @if (showPublicBoard)
                {
                    <div class="event-public-page-row"><a href="@publicBoardUrl">@T["Public board"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@publicBoardUrl" aria-label="@T["Copy public board link"]"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg></button></div>
                }
            </div>
        </section>
    </section>

    <section id="operations" class="event-manage-section event-admin-lower">
        <div class="event-control-workspace">
            <article class="panel event-admin-controls">
                <header class="admin-section-heading event-overview-section-heading"><h2>@T["Event controls"]</h2><p>@T["Only actions available at this stage are shown."]</p></header>

                @if (Model.ScheduledAction is not null)
                {
                    <section class="event-admin-control-group">
                        <div><h3>@Model.ScheduledAction.Title</h3><p>@T["Scheduled for"] @Model.ScheduledAction.ScheduledFor.ToLocalTime().ToString("dd MMM yyyy, HH:mm"); @T["attempted"] @Model.ScheduledAction.AttemptedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm").</p></div>
                        @if (Model.ScheduledAction.Blockers.Count == 0)
                        {
                            <p class="event-control-status">@T["All start blockers are resolved. Confirm to start the event now."]</p>
                        }
                        else
                        {
                            <p class="event-control-status">@T["{0} blockers remain.", Model.ScheduledAction.Blockers.Count] <a href="#readiness">@T["Review readiness"]</a></p>
                        }
                    </section>
                }

                @if (showSignupControls)
                {
                    <section class="event-admin-control-group event-signup-group">
                        <div class="event-control-copy">
                            <h3>@T["Manual signup control"]</h3>
                            <p>@(eventView.State == EventState.SignupOpen ? T["Close signups now. Players already on the list are not affected."] : T["Open signups now after completing the schedule and readiness checks."])</p>
                            <p class="event-control-status event-control-supporting"><a asp-page="Schedule" asp-route-id="@eventView.Id">@T["Edit the event schedule and review signup readiness"]</a></p>
                            @if (eventView.ActualSignupOpenedAt is { } actualOpening) { <p class="event-control-status event-control-supporting"><strong>Actual signup opening:</strong> @actualOpening.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p> }
                            else if (eventView.ScheduledSignupOpeningEnabled && eventView.SignupOpensAt is { } scheduledOpening) { <p class="event-control-status event-control-supporting"><strong>Automatic signup opening scheduled for:</strong> @scheduledOpening.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p> }
                            else { <p class="event-control-status event-control-supporting"><strong>No automatic signup opening scheduled.</strong></p> }
                        </div>
                        <div class="event-admin-event-actions">
                            @if (Model.ConfirmationAction == "signup")
                            {
                                <p class="event-control-status event-control-supporting">@T["Confirmation required"]</p>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="PrepareSignupConfirmation" data-update-targets="@partialUpdateTargets"><button class="btn event-create-cancel" type="submit" disabled="@(signupAndPlayersLocked ? "disabled" : null)">@(eventView.State == EventState.SignupOpen ? T["Close now"] : eventView.State == EventState.SignupClosed ? T["Reopen now"] : T["Open now"])</button></form>
                            }
                            @if (Model.ConfirmationAction == "signup")
                            {
                                <div class="event-confirmation-box" data-confirmation-box tabindex="-1">
                                    <p>@(eventView.State == EventState.SignupOpen ? T["Close signups now? Players already on the list are not affected."] : T["Review the signup consequences below before continuing."])</p>
                                    @if (eventView.State != EventState.SignupOpen && Model.SignupReadiness?.Warnings.Count > 0)
                                    {
                                        <ul class="event-confirmation-list" aria-label="@T["Signup warnings"]">
                                            @foreach (var warning in Model.SignupReadiness.Warnings)
                                            {
                                                <li>@warning.Description</li>
                                            }
                                        </ul>
                                    }
                                    @if (Model.SignupCloseRequiresAcceptance)
                                    {
                                        <p class="event-confirmation-supporting"><strong>@T["Proposed signup close:"]</strong> @Model.EventDate(Model.SignupReadiness!.CloseDecision.ProposedClose) @eventView.Timezone</p>
                                    }
                                    <form method="post" asp-page-handler="ConfirmSignup" class="event-confirmation-form" data-update-targets="@partialUpdateTargets">
                                        <input asp-for="EventVersion" type="hidden" />
                                        <div class="event-confirmation-actions">
                                            @if (eventView.State != EventState.SignupOpen && Model.SignupReadiness?.Warnings.Count > 0 && !Model.SignupWarningAcknowledged) { <button class="btn event-create-cancel" type="submit" name="AcknowledgeSignupWarnings" value="true">@T["Confirm warnings"]</button> }
                                            @if (Model.SignupCloseRequiresAcceptance && !Model.SignupCloseAcknowledged) { <button class="btn event-create-cancel" type="submit" name="AcceptProposedClose" value="true">@T["Accept proposed close"]</button> }
                                            @if ((eventView.State == EventState.SignupOpen || Model.SignupReadiness?.Warnings.Count == 0 || Model.SignupWarningAcknowledged) && (!Model.SignupCloseRequiresAcceptance || Model.SignupCloseAcknowledged)) { <button class="btn event-create-cancel" type="submit">@T["Confirm"]</button> }
                                            <a class="btn event-create-cancel" asp-page="Manage" asp-route-id="@eventView.Id">@T["Cancel"]</a>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>
                    </section>

                    @if (Model.SignupReadiness is not null)
                    {
                        <section class="event-admin-control-group"><div><h3>@T["Signup readiness"]</h3><p>@T["Resolve setup issues before changing signup state."]</p></div><p class="event-control-status">@T["{0} blockers · {1} warnings", Model.SignupReadiness.Blockers.Count, Model.SignupReadiness.Warnings.Count] <a href="#readiness">@T["Review readiness"]</a></p></section>
                    }

                }

                @if (showStartControl || showLiveControls || showFinalReviewControls || showResultsControl)
                {
                    <section class="event-admin-control-group">
                    <div>
                        <h3>@T["Event"]</h3>
                        <p>
                            @if (showLiveControls) { @T["The bingo is currently live."] }
                            else if (showFinalReviewControls) { @T["Finish reviewing submissions before publishing the results."] }
                            else if (showResultsControl) { @T["The official results are available."] }
                            else { @T["Start the bingo when the board and teams are ready."] }
                        </p>
                    </div>
                    <div class="event-admin-event-actions">
                        @if (showStartControl)
                        {
                            @if (Model.StartReadiness?.Blockers.Count > 0) { <p class="event-control-status">@T["{0} blockers remain.", Model.StartReadiness.Blockers.Count] <a href="#readiness">@T["Review readiness"]</a></p> }
                            @if (Model.ConfirmationAction == "start")
                            {
                                <div class="event-confirmation-box" data-confirmation-box tabindex="-1"><p>@T["Starting now changes the event to Live and preserves the configured schedule."]</p><form method="post" asp-page-handler="StartEvent" class="event-confirmation-form" data-update-targets="@partialUpdateTargets"><input asp-for="EventVersion" type="hidden" /><div class="event-create-field"><label asp-for="StartReason">@T["Reason (required before the configured start)"]</label><input asp-for="StartReason" class="form-control" /></div><div class="event-confirmation-actions"><button class="btn event-create-cancel" type="submit" name="ConfirmStartEvent" value="true">@T["Confirm start"]</button><a class="btn event-create-cancel" asp-page="Manage" asp-route-id="@eventView.Id">@T["Cancel"]</a></div></form></div>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="PrepareStartConfirmation" data-update-targets="@partialUpdateTargets"><button class="btn event-create-cancel" type="submit">@T["Start event now"]</button></form>
                            }
                        }
                        @if (showLiveControls)
                        {
                            <a class="btn event-create-cancel" asp-page="/Admin/Review/Index" asp-route-eventId="@eventView.Id">@T["Review submissions"]</a>
                            @if (Model.ConfirmationAction == "end")
                            {
                                <div class="event-confirmation-box" data-confirmation-box tabindex="-1"><p>@T["Ending now moves the event to final review; the configured end remains recorded."]</p><form method="post" asp-page-handler="EndEvent" class="event-confirmation-form" data-update-targets="@partialUpdateTargets"><input asp-for="EventVersion" type="hidden" /><div class="event-create-field"><label asp-for="EndReason">@T["Reason (required before the configured end)"]</label><input asp-for="EndReason" class="form-control" /></div><div class="event-confirmation-actions"><button class="btn event-create-cancel" type="submit" name="ConfirmEndEvent" value="true">@T["Confirm end"]</button><a class="btn event-create-cancel" asp-page="Manage" asp-route-id="@eventView.Id">@T["Cancel"]</a></div></form></div>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="PrepareEndConfirmation" data-update-targets="@partialUpdateTargets"><button class="btn event-create-cancel" type="submit">@T["End event"]</button></form>
                            }
                        }
                        @if (showFinalReviewControls)
                        {
                            <a class="btn event-create-cancel" asp-page="/Admin/Review/Index" asp-route-eventId="@eventView.Id">@T["Review submissions"]</a>
                            <a class="btn event-create-cancel" asp-page="Finalize" asp-route-id="@eventView.Id">@T["Final review and results"]</a>
                        }
                        @if (showResultsControl)
                        {
                            <a class="btn event-create-cancel" asp-page="Finalize" asp-route-id="@eventView.Id">@T["View results"]</a>
                        }
                    </div>
                    @if (showFinalReviewControls)
                    {
                        <form method="post" asp-page-handler="ReopenSubmissions" class="event-reopen-form" data-update-targets="@partialUpdateTargets">
                            <div class="event-create-field"><label asp-for="ReopenUntil"><span>@T["Reopen submissions until"]</span></label><input asp-for="ReopenUntil" asp-format="{0:yyyy-MM-ddTHH:mm:ss.fffzzz}" type="text" class="form-control" data-event-manage-datetime-picker data-time-label="@T["Time"]" /></div>
                            <div class="event-create-field"><label asp-for="StateReason"><span>@T["Reason"]</span></label><input asp-for="StateReason" class="form-control" required /></div>
                            <button class="btn event-create-cancel" type="submit">@T["Reopen submissions"]</button>
                        </form>
                        @if (eventView.ReopenedCutoff is not null) { <small class="event-reopened-note">@T["Submissions reopened until"] @eventView.ReopenedCutoff.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small> }
                        <section class="event-admin-control-group event-control-subsection" aria-labelledby="resume-event-heading">
                            <div class="event-control-copy">
                                <h3 id="resume-event-heading">Resume premature end</h3>
                                <p>The prior end remains in immutable history. Choose a future replacement end to return this event to live play.</p>
                            </div>
                            <div class="event-admin-event-actions">
                                @if (Model.ConfirmationAction == "resume")
                                {
                                    <div class="event-confirmation-box" data-confirmation-box tabindex="-1"><p>The prior end remains in immutable history. Confirm the replacement end to resume live play.</p><form method="post" asp-page-handler="ResumeEvent" class="form-stack event-confirmation-form" data-update-targets="@partialUpdateTargets"><input asp-for="EventVersion" type="hidden" /><div class="event-create-field"><label asp-for="ReplacementEventEndsAt"><span>Replacement event end</span></label><input asp-for="ReplacementEventEndsAt" asp-format="{0:yyyy-MM-ddTHH:mm:ss.fffzzz}" type="text" class="form-control" data-event-manage-datetime-picker data-time-label="Time" required /></div><div class="event-create-field"><label asp-for="ResumeReason"><span>Reason (required)</span></label><textarea asp-for="ResumeReason" class="form-control" rows="3" required></textarea></div><div class="event-confirmation-actions"><button class="btn event-create-cancel" type="submit" name="ConfirmResumeEvent" value="true">Confirm resume</button><a class="btn event-create-cancel" asp-page="Manage" asp-route-id="@eventView.Id">@T["Cancel"]</a></div></form></div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="PrepareResumeConfirmation" data-update-targets="@partialUpdateTargets"><button class="btn event-create-cancel" type="submit">Resume event</button></form>
                                }
                            </div>
                        </section>
                    }
                    </section>
                }

                @if (eventView.State == EventState.Live && Model.StartReadiness?.Blockers.Any(item => item.Code == "TEAM_ACCESS_MISSING") == true)
                {
                    <section class="event-admin-control-group">
                        <div><h3>Captain access needs attention</h3><p>The event remains Live. Assign a usable Captain or explicitly enable team-scoped emergency access.</p></div>
                        <p class="event-control-status">@T["{0} access checks need attention.", Model.StartReadiness.Blockers.Count(item => item.Code == "TEAM_ACCESS_MISSING")] <a asp-page="Draft" asp-route-id="@eventView.Id">@T["Review teams and draft"]</a></p>
                    </section>
                }

                @if (eventView.State is EventState.Draft or EventState.SignupClosed or EventState.Live)
                {
                <section class="event-admin-control-group event-admin-code-group">
                    <div>
                        <h3>@T["Verification codes"]</h3>
                        <p>@T["Captains include the active code in screenshots so reviewers know when the evidence was captured."]</p>
                    </div>
                    <form method="post" asp-page-handler="@(eventView.EvidenceCodeEnabled ? "DisableEvidenceCodes" : "EnableEvidenceCodes")" class="event-code-toggle-form" data-update-targets="@partialUpdateTargets">
                        <button class="btn event-create-cancel" type="submit">@(eventView.EvidenceCodeEnabled ? T["Disable codes"] : T["Enable codes"])</button>
                    </form>

                    @if (eventView.EvidenceCodeEnabled)
                    {
                        <div class="event-evidence-content">
                            <form method="post" asp-page-handler="CreateEvidenceCode" class="event-evidence-form" data-update-targets="@partialUpdateTargets">
                                <div class="event-create-field"><label asp-for="NewEvidenceCode">@T["Code"]</label><input asp-for="NewEvidenceCode" class="form-control" placeholder="@T["Your custom code"]" /></div>
                                <div class="event-create-field"><label asp-for="EvidenceCodeActivatesAt">@T["Active from"]</label><input asp-for="EvidenceCodeActivatesAt" asp-format="{0:yyyy-MM-ddTHH:mm:ss.fffzzz}" type="text" class="form-control" data-event-manage-datetime-picker data-time-label="@T["Time"]" /></div>
                                <div class="event-evidence-note event-create-field"><label asp-for="EvidenceCodeNote">@T["Note"]</label><input asp-for="EvidenceCodeNote" class="form-control" /></div>
                                <div class="event-evidence-actions"><button class="btn event-create-cancel" type="submit">@T["Save code"]</button><button class="btn event-create-cancel" type="button" onclick="var field=this.closest('form').querySelector('[name=&quot;NewEvidenceCode&quot;]');var chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';field.value='';for(var i=0;i&lt;6;i++)field.value+=chars.charAt(Math.floor(Math.random()*chars.length));field.focus();">@T["Generate code"]</button></div>
                            </form>
                            <div class="event-code-history">
                                <h3>@T["Code history"]</h3>
                                @if (Model.EvidenceCodes.Count == 0) { <p>@T["No codes have been added yet."]</p> }
                                else
                                {
                                    <ul>@foreach (var code in Model.EvidenceCodes) { <li><strong>@code.Code</strong><span>@code.ActivatesAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span><small>@(code.RetiresAt is null ? T["Currently active"] : $"{T["Ended"]} {code.RetiresAt.Value.ToLocalTime():dd MMM yyyy, HH:mm}")</small>@if (!string.IsNullOrWhiteSpace(code.Note)) { <small>@code.Note</small> }</li> }</ul>
                                }
                            </div>
                        </div>
                    }
                </section>
                }

                @if (eventView.State == EventState.Cancelled)
                {
                    <section class="event-admin-control-group"><div><h3>@T["Event cancelled"]</h3><p>@T["This event is terminal and no scheduled or ordinary event action can reactivate it."]</p></div><p class="event-control-status"><strong>@T["Private Admin reason:"]</strong> @Model.PrivateCancellationReason</p></section>
                }
                @{ var integration = Model.CompetitionIntegration; var integrationEditable = eventView.State is EventState.Draft or EventState.SignupOpen or EventState.SignupClosed or EventState.Live; var integrationStatusClass = integration is null || !integration.Configured || !string.IsNullOrWhiteSpace(integration.LastError) ? "event-wom-status-danger" : integration.Complete == true ? "event-wom-status-success" : integration.RetryDueAt is not null ? "event-wom-status-warning" : "event-wom-status-info"; var hasRequestBudget = integration?.RequestStatus.ObservedRemaining is not null || integration?.RequestStatus.ObservedLimit is not null || integration?.RequestStatus.ResetAt is not null; }
                <section class="event-admin-control-group event-wom-section" aria-labelledby="competition-integration-heading">
                    <div class="event-wom-header">
                        <h3 id="competition-integration-heading">Wise Old Man competition</h3>
                        <p>Link a competition to sync EHB activity. Wise Old Man remains read-only.</p>
                    @if (integration is null || !integration.Configured)
                    {
                        <p class="event-control-status event-wom-status"><strong>Status:</strong> <span class="event-wom-status-value @integrationStatusClass">Not configured.</span></p>
                    }
                    else
                    {
                        <p class="event-control-status event-wom-status"><strong>Status:</strong> <span class="event-wom-status-value @integrationStatusClass"><strong>@integration.CompetitionTitle</strong> · @integration.CompetitionId · @(integration.Complete == true ? "Complete" : integration.Complete == false && integration.MissingAccounts.Count > 0 ? "Partial" : integration.Complete == false ? "Incomplete" : "Waiting")@(integration.LastSuccessfulAt is { } synced ? $" · {synced.ToLocalTime():g}" : string.Empty)@(integration.RetryDueAt is not null ? " · Retry scheduled" : string.Empty)@(integration.MissingAccounts.Count > 0 ? $" · {integration.MissingAccounts.Count} accounts missing" : string.Empty)@(!string.IsNullOrWhiteSpace(integration.LastError) ? $" · {integration.LastError}" : string.Empty)</span></p>
                    }
                    </div>
                    <div class="event-control-static">
                    @if (integrationEditable)
                    {
                        <form method="post" asp-page-handler="Competition" class="form-stack event-wom-form">
                            <input asp-for="EventVersion" type="hidden" />
                            <div class="event-create-field"><label asp-for="CompetitionId">Competition ID</label><input asp-for="CompetitionId" class="form-control" inputmode="numeric" /></div>
                            @if (eventView.State is EventState.Draft or EventState.SignupOpen or EventState.SignupClosed)
                            {
                                <div class="event-wom-schedule-field"><div class="event-create-field"><label asp-for="SynchronizeCompetitionSchedule">Schedule handling</label><select asp-for="SynchronizeCompetitionSchedule" class="form-select"><option value="false">Keep current schedule</option><option value="true">Use competition dates</option></select></div><small>Without this option, both event instants must already be within five minutes.</small></div>
                            }
                            <button class="btn admin-button-secondary" type="submit">@(integration?.Configured == true ? eventView.State == EventState.Live ? "Replace and validate competition" : "Change and validate competition" : "Validate and link competition")</button>
                        </form>
                        @if (integration?.Configured == true && eventView.State is not EventState.Live)
                        {
                            <form method="post" asp-page-handler="ClearCompetition" class="form-stack"><input asp-for="EventVersion" type="hidden" /><button class="btn event-create-cancel" type="submit">Clear competition</button></form>
                        }
                        @if (eventView.State == EventState.Live && integration?.Configured == true)
                        {
                            <form method="post" asp-page-handler="RefreshCompetition"><button class="btn event-create-cancel" type="submit">Refresh cached activity</button></form>
                            @if (Model.ShowDevelopmentCompetitionControl)
                            {
                                <form method="post" asp-page-handler="MakeDevelopmentCompetitionDue" class="form-stack"><button class="btn event-create-cancel" type="submit">Make next refresh due (Development TEST 15)</button></form>
                            }
                        }
                    }
                    @if (hasRequestBudget)
                    {
                        <p class="event-wom-budget"><small>Request budget: @(integration?.RequestStatus.ObservedRemaining?.ToString() ?? "—") remaining@(integration?.RequestStatus.ObservedLimit is { } limit ? $" of {limit}" : string.Empty)@(integration?.RequestStatus.ResetAt is { } reset ? $" · reset {reset.ToLocalTime():g}" : string.Empty)</small></p>
                    }
                    </div>
                </section>

                @if (showDestructivePreLiveControl)
                {
                    <section class="event-danger-zone-container event-danger-zone" aria-labelledby="event-danger-heading">
                        <div class="event-danger-zone-copy">
                            <h2 id="event-danger-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="M12 8v4m0 4h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" /></svg>@T["Danger zone — destructive lifecycle actions"]</h2>
                            <p>@(Model.CanDiscard ? T["Remove disposable setup and preserve only the event tombstone and audit history."] : T["Preserve all event history and stop every scheduled lifecycle action."])</p>
                        </div>
                        @if (Model.ConfirmationAction == "destructive")
                        {
                            <div class="event-danger-zone-form"><p>@(Model.CanDiscard ? T["Discarding removes this empty setup permanently."] : T["Cancelling preserves history but stops the event permanently."])</p>@if (Model.CanDiscard) { <form method="post" asp-page-handler="Discard" class="form-stack" data-update-targets="@partialUpdateTargets"><input asp-for="EventVersion" type="hidden" /><div class="event-confirmation-actions"><button class="btn event-create-cancel action-danger-outline" type="submit" name="ConfirmDestructiveAction" value="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="m4.9 4.9 14.2 14.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" /></svg>@T["Confirm discard"]</button><a class="btn event-create-cancel" asp-page="Manage" asp-route-id="@eventView.Id">@T["Cancel"]</a></div></form> } else { <form method="post" asp-page-handler="Cancel" class="form-stack" data-update-targets="@partialUpdateTargets"><input asp-for="EventVersion" type="hidden" /><div class="event-create-field"><label asp-for="CancellationReason">@T["Cancellation reason"]</label><textarea asp-for="CancellationReason" class="form-control" rows="2" required></textarea></div><div class="event-confirmation-actions"><button class="btn event-create-cancel action-danger-outline" type="submit" name="ConfirmDestructiveAction" value="true"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="m4.9 4.9 14.2 14.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" /></svg>@T["Confirm cancellation"]</button><a class="btn event-create-cancel" asp-page="Manage" asp-route-id="@eventView.Id">@T["Cancel"]</a></div></form> }</div>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="PrepareDestructiveConfirmation" data-update-targets="@partialUpdateTargets"><button class="btn event-create-cancel action-danger-outline" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="m4.9 4.9 14.2 14.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" /></svg>@(Model.CanDiscard ? T["Discard event"] : T["Cancel event"])</button></form>
                        }
                    </section>
                }
            </article>

        </div>
    </section>

</section>

@section Scripts {
    <script src="~/js/event-manage.js" asp-append-version="true"></script>
}
