@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.ManageModel
@using System.Text.Json
@{
    // U4 / OS-1: Overview.dc.html. Dialogs come from data-current (OverviewPresenter);
    // admin-overview.js renders them and posts through AdminFetch.
    var v = Model.Overview!;
    ViewData["Title"] = v.Name;
    ViewData["LocalizedTitle"] = v.Name;
    ViewData["PageFamily"] = "overview";
    ViewData["CrumbTitle"] = T["Overview"].Value;
    var labels = new Dictionary<string, string>();
    foreach (var key in new[] {
        "Cancel", "Close", "Check again", "Checking…", "Working…", "Saving…", "Add code", "Copy", "Copied", "Link copied.", "Couldn’t copy automatically. Select the link and copy it.",
        "Finish the requirements listed first.", "Wait for the action to finish.",
        "Couldn’t complete this. Nothing changed, and your entries are still here.",
        "The event changed while this was open: {0}. The details below are up to date. Check them and confirm again.",
        "The event changed while this was open. The details below are up to date. Check them and confirm again.",
        "The event changed while this was open: {0}. {1} no longer applies, so nothing was done.",
        "The event changed while this was open. {0} no longer applies, so nothing was done.",
        "Checking the event…", "We couldn’t confirm whether this happened. Check before trying again, so it doesn’t happen twice.",
        "The event is unchanged, so it didn’t happen. You can try again.",
        "Enter a reason.", "Choose a date and time.", "Choose a time in the future.", "Choose a time after the event start.", "Use a 5-minute step.",
        "Enter or generate a code.", "Choose when it becomes active.", "Another code already starts at that exact time.", "Turn on evidence codes first.",
        "Couldn’t save the code. Nothing changed; your entries are still here.", "That local time does not exist because the clocks change at that time.", "That local time is ambiguous because the clocks change at that time. Choose another time.", "Couldn’t confirm the save. Close and reopen to see the current codes before trying again.",
        "Evidence codes", "Captains include the active code in screenshots, so reviewers can tell when evidence was captured. Each code is retired when the next one starts.",
        "Require evidence codes", "Codes", "New code", "Generate", "Active from", "Note", "optional, admins only", "Calendar", "Choose {0} from a calendar", "{0}, date", "{0}, time (24-hour)" })
        labels[key] = T[key].Value;
}
@section HeaderTitle {
    <div class="ov-title"><h1 class="h1" id="page-h1" tabindex="-1">@v.Name</h1><span class="badge @v.BadgeClass">@v.Phase</span></div>
}
@section HeaderSummary { <span>@v.Summary</span> }
<div data-overview data-current="@Model.CurrentJson" data-labels="@JsonSerializer.Serialize(labels)" data-timezone="@Model.EventTimezone" data-now="@Model.CurrentInstant.ToString("O", CultureInfo.InvariantCulture)">
<input type="hidden" name="EventVersion" value="@Model.EventVersion" />
@if (v.Hidden is { } hidden)
{
    <div class="banner is-warning page-banner" role="status"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("hidden")' /><span class="grow"><b>@T["Hidden event · limited inspection."]</b> @T["It’s excluded from every ordinary page and count. Only SuperAdmins can see this view."]</span></div>
    <div class="card panel">
        <div class="panel-head"><h2 class="panel-title" id="now-title" tabindex="-1">@T["Quarantine"]</h2></div>
        <dl class="facts">
            <div class="fact"><dt class="fact-label">@T["Retained stage"]</dt><dd class="fact-value">@hidden.Stage</dd></div>
            <div class="fact"><dt class="fact-label">@T["Hidden"]</dt><dd class="fact-value">@hidden.When</dd></div>
            <div class="fact"><dt class="fact-label">@T["Reason"]</dt><dd class="fact-value ov-reason">@hidden.Reason</dd></div>
        </dl>
        <form method="post" asp-page-handler="RestoreHidden" asp-route-id="@Model.EventId" class="act-group" data-overview-restore>
            <input type="hidden" name="EventVersion" value="@Model.EventVersion" /><input type="hidden" name="ConfirmDestructiveAction" value="true" />
            <div class="act-row"><div class="act-text"><div class="act-title">@T["Restore event"]</div><div class="act-sub">@T["Returns it to the directory, the Dashboard and its public pages as before. No notifications are sent."]</div></div><button class="btn" id="act-restore" type="submit" data-overview-action="restore">@T["Restore…"]</button></div>
        </form>
        @if (Model.QuarantineAuditHistory.Count > 0)
        {
            @* U4-Q3 (c): the quarantine history list is kept (not in the reference). *@
            <div class="ov-history">
                <h3 class="sec-title">@T["Quarantine history"]</h3>
                <div class="ro-list">
                    @foreach (var row in Model.QuarantineAuditHistory)
                    {
                        <div class="ro-row"><span class="grow">@(row.Action == "event.hidden" ? T["Hidden"] : T["Restored"]) · @Model.Fmt(row.OccurredAt) · @row.ActorUsername@if (!string.IsNullOrWhiteSpace(row.Details)) { <span class="choice-sub" style="display:block">@row.Details</span> }</span></div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <section class="card" aria-label="@T["Event progression"]">
        <ol class="stages" style="--stage-count:@v.Stages.Count">
            @foreach (var s in v.Stages)
            {
                <li class="stage @s.Cls" aria-current="@(s.Current ? "step" : null)">
                    <span class="stage-mark"><span class="stage-dot">@if (s.Done) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check")' /> }@if (s.Ended) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("ended")' /> }</span></span>
                    <span class="stage-text"><span class="stage-name">@s.Name</span><span class="stage-when">@s.When</span><span class="sr">@s.Sr</span></span>
                </li>
            }
        </ol>
    </section>
    @if (v.Issues.Count > 0)
    {
        <section class="card ov-attn" aria-labelledby="issues-title">
            <div class="panel-head ov-issues-head"><h2 class="panel-title" id="issues-title">@T["Needs attention"]</h2></div>
            @foreach (var i in v.Issues)
            {
                <div class="issue is-@i.Kind">
                    @if (i.Kind == "failure") { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("error", "ic issue-ic")' /> } else { <span class="dot" aria-hidden="true"></span> }
                    <div><div class="issue-title">@i.Title</div><div class="issue-text">@i.Text</div></div>
                    @if (i.ActionKey is not null) { <button class="btn btn-sm" type="button" data-overview-action="@i.ActionKey" aria-disabled="@(i.ActionInert ? "true" : "false")" aria-describedby="@(i.ActionInert ? "checklist" : null)" title="@(i.ActionInert ? T["Finish the requirements below first"].Value : null)">@i.ActionLabel</button> }
                    else if (i.ActionHref is not null) { <a class="btn btn-sm" href="@i.ActionHref" data-shell-link>@i.ActionLabel</a> }
                </div>
            }
        </section>
    }
    <div class="ov-grid">
        <div class="ov-main">
            <section class="card panel" aria-labelledby="now-title">
                <div class="panel-head"><h2 class="panel-title" id="now-title" tabindex="-1">@v.Now.Title</h2>@if (v.Now.Aside is not null) { <span class="panel-aside">@v.Now.Aside</span> }</div>
                <p class="ov-lead">@v.Now.Lead</p>
                @if (v.Now.Winner is not null)
                {
                    <div class="highlight">
                        <div class="highlight-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("trophy")' /></div>
                        <div style="min-width:0;flex:1"><div class="highlight-label">@T["Official winner"]</div><div class="highlight-value">@v.Now.Winner</div><div class="highlight-sub">@v.Now.WinnerSub</div></div>
                    </div>
                    <dl class="facts ov-placings">@foreach (var p in v.Now.Placings) { <div class="fact"><dt class="fact-label">@p.Label</dt><dd class="fact-value">@p.Value</dd></div> }</dl>
                }
                @if (v.Now.CancelWhen is not null)
                {
                    <dl class="facts">
                        <div class="fact"><dt class="fact-label">@T["Cancelled"]</dt><dd class="fact-value">@v.Now.CancelWhen</dd></div>
                        <div class="fact"><dt class="fact-label">@T["Private admin reason"]</dt><dd class="fact-value ov-reason">@v.Now.CancelReason</dd></div>
                    </dl>
                }
                @if (v.Now.Transition is { } tr)
                {
                    <div class="transition @tr.Cls">
                        <span class="transition-ic"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("schedule")' /></span>
                        <div class="transition-text"><div class="transition-title">@tr.Title</div><div class="transition-sub">@tr.Sub</div></div>
                        <div class="transition-actions">
                            @if (tr.HasSchedule) { <a class="btn btn-quiet btn-sm" href="@Bingo.Web.Navigation.SharedShellService.AdminDesignEventUrl("/Admin/Events/Schedule", Model.EventId)" data-shell-link>@T["Schedule"]</a> }
                            @foreach (var a in tr.Actions)
                            {
                                <button class="btn @a.Cls" id="act-@a.Key" type="button" data-overview-action="@a.Key" aria-disabled="@(a.Inert ? "true" : "false")" aria-describedby="@(a.Inert ? (a.Key == "reopen" ? "reopen-checklist" : "checklist") : null)" title="@(a.Inert ? T["Finish the requirements below first"].Value : null)">@a.Label</button>
                            }
                        </div>
                    </div>
                }
                @foreach (var (id, title, checks) in new[] { ("checklist", v.Now.CheckTitle, v.Now.Checks), ("reopen-checklist", v.Now.SecondCheckTitle, v.Now.SecondChecks) })
                {
                    if (title is null) { continue; }
                    <div class="ov-check">
                        <h3 class="sec-title" id="@id-title">@title</h3>
                        <ul class="checklist" aria-labelledby="@id-title" id="@id">
                            @foreach (var c in checks)
                            {
                                <li class="check-item @(c.Done ? "is-done" : null)">
                                    <span class="check-mark" aria-hidden="true">@if (c.Done) { <partial name="_AdminDesignIcon" model='new AdminDesignIcon("check")' /> }</span>
                                    <span><span class="check-label">@c.Label</span><span class="sr">@(c.Done ? T["(done)"] : T["(to do)"])</span>@if (c.Sub is not null) { <span class="check-sub">@c.Sub</span> }</span>
                                    @if (!c.Done && c.LinkHref is not null) { <a class="text-btn" href="@c.LinkHref" data-shell-link>@c.LinkLabel</a> }
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (v.Now.Later is not null) { <p class="later-note"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("schedule")' /><span>@v.Now.Later</span></p> }
                @if (v.Now.FootLabel is not null)
                {
                    <div class="panel-foot ov-foot"><span class="panel-note">@v.Now.FootNote</span><a class="btn @v.Now.FootCls" id="now-foot" href="@v.Now.FootHref" data-shell-link>@v.Now.FootLabel</a></div>
                }
            </section>
            @if (v.More.Count > 0)
            {
                <section class="card panel ov-section" aria-labelledby="more-title">
                    <div class="panel-head"><h2 class="panel-title" id="more-title">@T["Other actions"]</h2></div>
                    @foreach (var g in v.More)
                    {
                        <div class="ov-act-group">
                            <div class="act-group-label">@g.Label</div>
                            @foreach (var r in g.Rows)
                            {
                                <div class="act-row"><div class="act-text"><div class="act-title">@r.Title</div><div class="act-sub">@r.Sub</div></div><button class="btn @r.Cls" id="act-@r.Key" type="button" data-overview-action="@r.Key">@r.Label</button></div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
        <aside class="ov-aside">
            <section class="card panel" aria-labelledby="glance-title">
                <div class="panel-head"><h2 class="panel-title" id="glance-title">@T["At a glance"]</h2></div>
                <dl class="facts">
                    @foreach (var g in v.Glance)
                    {
                        <div class="fact">
                            <dt class="fact-label">
                                @if (g.Codes) { <button class="text-btn ov-fact-btn" type="button" data-overview-codes title="@g.LinkTitle">@g.Label<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></button> }
                                else if (g.LinkHref is not null) { <a class="text-btn ov-fact-btn" href="@g.LinkHref" data-shell-link title="@g.LinkTitle">@g.Label<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")' /></a> }
                                else { @g.Label }
                            </dt>
                            <dd class="fact-value"><span class="@(g.Mono ? "mono" : null)">@g.Value</span>@if (g.Sub is not null) { <span class="fact-sub">@g.Sub</span> }</dd>
                        </div>
                    }
                </dl>
            </section>
            @if (v.LinksShow)
            {
                <section class="card panel ov-section" aria-labelledby="links-title">
                    <div class="panel-head"><h2 class="panel-title" id="links-title">@T["Public links"]</h2></div>
                    @if (v.LinksPrivate) { <p class="ov-muted">@T["Not public yet. These pages become available when signups open."]</p> }
                    <div class="ov-links">
                        @foreach (var l in v.Links)
                        {
                            <div class="ov-link"><div class="lbl" id="lnk-@l.Key">@l.Label</div><div class="copy-field" role="group" aria-labelledby="lnk-@l.Key"><span class="mono" id="lnkv-@l.Key" title="@l.Url">@l.Path</span><button class="btn btn-sm btn-quiet" type="button" data-overview-copy="@l.Url" aria-describedby="lnkv-@l.Key"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("copy")' /><span data-copy-label>@T["Copy"]</span></button></div>@if (l.Note is not null) { <div class="field-hint">@l.Note</div> }</div>
                        }
                    </div>
                </section>
            }
        </aside>
    </div>
}
</div>
<partial name="_AdminDesignDateTimeTemplates" />
<template data-overview-icon="error"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("error")' /></template>
<template data-overview-icon="calendar"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("calendar")' /></template>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-overview.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-overview.js" asp-append-version="true" data-admin-page-script></script> }
