@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.IdentityModel
@using Bingo.Domain.Events
@using Bingo.Web.UI
@{
    ViewData["Title"] = T["Identity"];
    ViewData["AdminPageDescription"] = T["Edit the event details and public presentation."];
    var eventStatus = AdminEventStatePresentation.For(Model.EventState, T);
    var signupUrl = Url.Page("/Events/Signup", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
    var signupTableUrl = Url.Page("/Events/Signups", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
    var publicBoardUrl = Url.Page("/Events/Board", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
}

<section class="identity-editor-page" data-identity-editor data-identity-save-error="@T["The identity update could not be confirmed. Check your connection and try again."]">
    <div class="identity-editor-layout">
        <main class="identity-editor-main">
            <form method="post" class="identity-editor-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary app-notice notice-error"></div>
                <input asp-for="Input.Version" type="hidden" />
                <input asp-for="Input.TimezoneConfirmationOriginal" type="hidden" />
                <input asp-for="Input.TimezoneConfirmationProposed" type="hidden" />

                @if (Model.HasUnresolvableTimezone)
                {
                    <div class="app-notice notice-warning identity-timezone-warning" role="status">
                        <strong>@T["Stored timezone unavailable"]</strong>
                        <span>@T["The stored timezone ID {0} is retained. Dates below use an explicit UTC fallback until a supported timezone is selected.", Model.StoredTimezoneId]</span>
                    </div>
                }

                <fieldset class="identity-editor-group identity-primary-group" disabled="@(!Model.CanEditIdentity ? "disabled" : null)">
                    <legend>@T["Public identity"]</legend>
                    <p class="identity-group-description">@T["Name, description, buy-in information and the permanent event link are managed here."]</p>
                    <div class="identity-primary-fields">
                        <div class="admin-field"><label asp-for="Input.Name">@T["Event name"]</label><input asp-for="Input.Name" class="form-control" maxlength="50" /><span asp-validation-for="Input.Name" class="field-error"></span></div>
                        <div class="admin-field"><label>@T["Permanent event link"]</label><div class="form-control identity-permanent-slug" aria-readonly="true"><code>@Model.EventSlug</code></div><small>@T["This link is server-owned and remains stable when the name changes."]</small></div>
                        <div class="admin-field identity-timezone-field">
                            <label asp-for="Input.Timezone">@T["Timezone"]</label>
                            <select asp-for="Input.Timezone" class="form-select" disabled="@(!Model.CanEditTimezone ? "disabled" : null)">
                                @foreach (var timezone in Model.Timezones)
                                {
                                    <option value="@timezone.Id">@timezone.Label</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Timezone" class="field-error"></span>
                            <small>@T["Stored UTC instants are preserved when this display timezone changes. It locks after the first Live transition."]</small>
                        </div>
                        <div class="admin-field identity-description-field"><label asp-for="Input.Description">@T["Description"]</label><textarea asp-for="Input.Description" class="form-control" rows="5"></textarea><span asp-validation-for="Input.Description" class="field-error"></span></div>
                        <div class="admin-field identity-description-field"><label asp-for="Input.BuyInDescription">@T["Buy-in information"]</label><textarea asp-for="Input.BuyInDescription" class="form-control" rows="3"></textarea><span asp-validation-for="Input.BuyInDescription" class="field-error"></span></div>
                    </div>
                </fieldset>
                @if (!Model.CanEditTimezone)
                {
                    <input type="hidden" name="Input.Timezone" value="@Model.Input.Timezone" />
                }

                @if (Model.TimezonePreview.Count > 0)
                {
                    <section class="identity-timezone-review" data-identity-timezone-preview data-title="@T["Confirm timezone change"]" data-action-label="@T["Confirm timezone change"]" aria-labelledby="identity-timezone-review-heading">
                        <h2 id="identity-timezone-review-heading">@T["Review timezone change"]</h2>
                        <p data-identity-timezone-consequence>@T["Stored UTC instants will not move. Participants will see the same moments in the new timezone, including each UTC offset."]</p>
                        <ul class="identity-timezone-review-list">
                            @foreach (var preview in Model.TimezonePreview)
                            {
                                <li data-identity-timezone-row><span>@T[preview.Label]</span><strong>@preview.Current</strong><small>@preview.New</small></li>
                            }
                        </ul>
                        <span asp-validation-for="Input.ConfirmTimezoneChange" class="field-error"></span>
                        <div class="identity-timezone-review-actions"><button class="admin-button-secondary" type="submit" name="Input.ConfirmTimezoneChange" value="true" data-identity-timezone-confirm>@T["Confirm timezone change"]</button><a class="admin-button-secondary" data-identity-timezone-cancel data-identity-cancel asp-page="Manage" asp-route-id="@RouteData.Values["id"]">@T["Cancel"]</a></div>
                    </section>
                }

                <div class="identity-editor-actions">
                    <a class="admin-button-secondary" data-identity-cancel asp-page="Manage" asp-route-id="@RouteData.Values["id"]">@T["Cancel"]</a>
                    @if (Model.CanEditIdentity)
                    {
                        <button class="admin-button-secondary" type="submit" data-identity-save>@T["Save identity"]</button>
                    }
                    else
                    {
                        <span class="admin-form-note">@T["Identity editing is unavailable in this event state."]</span>
                    }
                </div>
            </form>
        </main>

        <aside class="event-overview-section event-overview-dates-panel identity-event-information-rail" aria-labelledby="event-information-heading">
            <div class="event-overview-section-heading"><div class="event-overview-heading-label"><h2 id="event-information-heading">@T["Event information"]</h2></div></div>
            <dl class="event-overview-dates">
                <div class="event-overview-date-row event-overview-information-summary"><div class="event-overview-information-name"><dt class="visually-hidden">@T["Event name"]</dt><dd>@Model.EventName</dd></div><div class="event-overview-information-status"><dt class="visually-hidden">@T["Status"]</dt><dd><span class="admin-status-pill @eventStatus.Modifier">@eventStatus.Label</span></dd></div></div>
                @foreach (var row in Model.EffectiveTimeline)
                {
                    var timelineTone = row.Label switch
                    {
                        "Signup opens" or "Signup closes" => "is-cyan",
                        "Submission cutoff" => "is-yellow",
                        "Signups opened" or "Signups closed" or "Event starts" or "Event started" or "Event ends" or "Event ended" or "Submissions closed" => "is-green",
                        _ => "is-muted"
                    };
                    <div class="event-overview-date-row @timelineTone"><div class="event-overview-date-copy"><dt>@T[row.Label]</dt><dd>@Model.EventDate(row.At)</dd></div></div>
                }
            </dl>
            <div class="event-public-pages" aria-labelledby="event-public-pages-heading">
                <h3 id="event-public-pages-heading">@T["Public pages"]</h3>
                <div class="event-public-page-row"><a href="@signupUrl">@T["Signup form"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@signupUrl" aria-label="@T["Copy signup form link"]">⧉</button></div>
                <div class="event-public-page-row"><a href="@signupTableUrl">@T["Public signup table"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@signupTableUrl" aria-label="@T["Copy public signup table link"]">⧉</button></div>
                @if (Model.ShowPublicBoard)
                {
                    <div class="event-public-page-row"><a href="@publicBoardUrl">@T["Public board"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@publicBoardUrl" aria-label="@T["Copy public board link"]">⧉</button></div>
                }
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/event-manage.js" asp-append-version="true"></script>
    <script src="~/js/event-identity.js" asp-append-version="true"></script>
}
