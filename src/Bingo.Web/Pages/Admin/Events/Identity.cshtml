@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.IdentityModel
@using Bingo.Domain.Events
@{
    ViewData["Title"] = T["Identity"];
    var signupTableUrl = Url.Page("/Events/Signups", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
    var status = TempData.Peek("StatusMessage") as string;
    var saved = status == T["Event identity updated."].Value || status == T["No identity changes were made."].Value;
}
<section class="card form-card" data-identity-editor data-identity-event-id="@Model.EventId" data-identity-current-version="@Model.CurrentVersion"
    data-identity-editable="@Model.CanEditIdentity.ToString().ToLowerInvariant()" data-identity-public="@Model.HasPublicExposure.ToString().ToLowerInvariant()"
    data-identity-save-uncertain="@Model.SaveOutcomeUncertain.ToString().ToLowerInvariant()" data-identity-schedule-stale="@Model.TimezoneScheduleStale.ToString().ToLowerInvariant()"
    data-identity-review-required="@((Model.TimezonePreview.Count > 0).ToString().ToLowerInvariant())"
    data-name-required="@T["Enter an event name."]" data-validation-summary="@T["{0} fields need attention before you can save."]"
    data-name-limit="@T["Event names must be 50 characters or fewer."]" data-description-limit="@T["Description must be 4000 characters or fewer."]" data-buy-in-description-limit="@T["Buy-in information must be 2000 characters or fewer."]"
    data-identity-conflicts="@string.Join(",", Model.FieldConflicts)" data-label-name="@T["Event name"]" data-label-description="@T["Description"]" data-label-buy-in-description="@T["Buy-in information"]" data-label-timezone="@T["Timezone"]" data-save="@T["Save changes"]" data-saved="@T["Saved"]"
    data-no-changes="@T["No changes to save"]" data-up-to-date-note="@T["Up to date"]" data-check-again="@T["Check again"]" data-unknown="@T["The save outcome is uncertain. Check again to read the current values; your draft is retained."]"
    data-up-to-date="@T["Up to date. The event now has the expected values. This does not confirm which request saved them."]"
    data-not-applied="@T["The event still has its earlier values, so your changes weren't applied. They are still here; save again when you are ready."]"
    data-stale="@T["Another admin saved this event while you were editing. Where you both changed a field, yours is kept and theirs is shown beside it. Review, then save again."]"
    data-refused="@T["This event is read-only in its current lifecycle state."]" data-use-theirs="@T["Use theirs"]" data-theirs="@T["Their value: {0}"]"
    data-leave-title="@T["Leave before checking?"]" data-leave-message="@T["Your changes may already have been saved. Check again before leaving, or leave anyway without retrying the save."]" data-leave="@T["Leave anyway"]"
    data-keep-editing="@T["Keep editing"]" data-timezone-title="@T["Show this event’s times in {0}?"]" data-timezone-action="@T["Save with {0}"]"
    data-timezone-consequence="@T["Stored UTC instants will not move. Participants will see the same moments in the new timezone, including each UTC offset."]"
    data-saved-together="@T["Also saved with this change: {0}."]" data-unsaved="@T["Unsaved changes"]" data-copied="@T["Link copied"]" data-copy-failed="@T["The link could not be copied. Select and copy it manually."]">
    <form method="post" class="identity-editor-form">
        <div class="form-banners">
            <div asp-validation-summary="ModelOnly" class="validation-summary banner is-error"></div>
            <div class="banner is-error" data-client-validation role="alert" hidden></div>
            <div class="banner is-warning" data-identity-feedback role="status" tabindex="-1" hidden></div>
            @if (!Model.CanEditIdentity)
            {
                <p class="banner is-info" data-identity-readonly>@(Model.EventState switch
                {
                    EventState.Cancelled => T["{0} was cancelled, so its identity cannot be changed.", Model.EventName],
                    EventState.Finalized => T["{0} is finalized, so its identity cannot be changed.", Model.EventName],
                    _ => T["{0} is archived, so its identity cannot be changed.", Model.EventName]
                })</p>
            }
        </div>
        <input asp-for="Input.Version" type="hidden" />
        <input asp-for="Input.HasBaseline" type="hidden" />
        <input asp-for="Input.OriginalName" type="hidden" />
        <input asp-for="Input.OriginalDescription" type="hidden" />
        <input asp-for="Input.OriginalBuyInDescription" type="hidden" />
        <input asp-for="Input.OriginalTimezone" type="hidden" />
        <input asp-for="Input.HasReviewedValues" type="hidden" />
        <input asp-for="Input.ReviewedName" type="hidden" />
        <input asp-for="Input.ReviewedDescription" type="hidden" />
        <input asp-for="Input.ReviewedBuyInDescription" type="hidden" />
        <input asp-for="Input.ReviewedTimezone" type="hidden" />
        <input asp-for="Input.NameResolution" type="hidden" />
        <input asp-for="Input.DescriptionResolution" type="hidden" />
        <input asp-for="Input.BuyInDescriptionResolution" type="hidden" />
        <input asp-for="Input.TimezoneResolution" type="hidden" />
        <input asp-for="Input.TimezoneConfirmationSchedule" type="hidden" />
        <input asp-for="Input.TimezoneConfirmationOriginal" type="hidden" />
        <input asp-for="Input.TimezoneConfirmationProposed" type="hidden" />
        <section class="form-sec" aria-labelledby="identity-details">
            <div class="form-sec-head"><h2 class="form-sec-title" id="identity-details">@T["Public details"]</h2><p class="form-sec-sub">@T["The event's name and the text players read about it."]</p></div>
            <div class="form-fields">
                <div class="field" data-identity-field="Name">
                    <div class="lbl-row"><label class="lbl" asp-for="Input.Name">@T["Event name"]</label><span class="field-count" data-count-for="Name" aria-live="polite" hidden></span></div>
                    @if (Model.CanEditIdentity)
                    {
                        <input asp-for="Input.Name" class="input id-name" data-codepoint-limit="50" autocomplete="off" aria-describedby="error-Name" />
                    }
                    else
                    {
                        <div class="ro-value" data-readonly-value="Name">@Model.Input.Name</div>
                    }
                    <span asp-validation-for="Input.Name" class="field-err" id="error-Name"></span>
                    <div class="field-note" data-conflict-for="Name" hidden></div>
                </div>
                <div class="field" data-identity-field="Description">
                    <div class="lbl-row"><label class="lbl" asp-for="Input.Description">@T["Description"]</label><span class="field-count" data-count-for="Description" aria-live="polite" hidden></span></div>
                    @if (Model.CanEditIdentity)
                    {
                        <textarea asp-for="Input.Description" class="textarea id-desc" maxlength="4000" aria-describedby="error-Description"></textarea>
                    }
                    else
                    {
                        <div class="ro-value" data-readonly-value="Description">@Model.Input.Description</div>
                    }
                    <span asp-validation-for="Input.Description" class="field-err" id="error-Description"></span>
                    <div class="field-note" data-conflict-for="Description" hidden></div>
                </div>
                <div class="field" data-identity-field="BuyInDescription">
                    <div class="lbl-row"><label class="lbl" asp-for="Input.BuyInDescription">@T["Buy-in information"]</label><span class="field-count" data-count-for="BuyInDescription" aria-live="polite" hidden></span></div>
                    @if (Model.CanEditIdentity)
                    {
                        <textarea asp-for="Input.BuyInDescription" class="textarea id-buyin" maxlength="2000" aria-describedby="error-BuyInDescription"></textarea>
                    }
                    else
                    {
                        <div class="ro-value" data-readonly-value="BuyInDescription">@Model.Input.BuyInDescription</div>
                    }
                    <span asp-validation-for="Input.BuyInDescription" class="field-err" id="error-BuyInDescription"></span>
                    <div class="field-note" data-conflict-for="BuyInDescription" hidden></div>
                    @if (Model.CanEditIdentity) { <div class="field-hint">@T["Explain the entry payment in words: how much, and how to pay. It is not a price field and takes no payments; payments are tracked on Participants."]</div> }
                </div>
            </div>
        </section>
        <section class="form-sec" aria-labelledby="identity-timezone">
            <div class="form-sec-head"><h2 class="form-sec-title" id="identity-timezone">@T["Timezone"]</h2><p class="form-sec-sub">@T["How this event's dates and times are shown. Changing it never moves a scheduled moment."]</p></div>
            <div class="field field-narrow" data-identity-field="Timezone">
                <label class="lbl" asp-for="Input.Timezone">@T["Timezone"]</label>
                @if (Model.CanEditTimezone)
                {
                    <select asp-for="Input.Timezone" class="select select-field" aria-describedby="error-Timezone">
                        @foreach (var timezone in Model.Timezones) { <option value="@timezone.Id">@timezone.Label</option> }
                    </select>
                }
                else
                {
                    <div class="ro-value">@Model.Timezones.First(option => option.Id == Model.Input.Timezone).Label</div>
                    <input type="hidden" name="Input.Timezone" value="@Model.Input.Timezone" />
                    @if (Model.CanEditIdentity) { <p class="field-lock">@T["The timezone cannot change after the event first goes Live."]</p> }
                }
                @if (!Model.HasPublicExposure && Model.CanEditTimezone) { <div class="field-note">@T["This event has not been public yet. A timezone change saves directly without a confirmation."]</div> }
                @if (Model.HasUnresolvableTimezone) { <div class="field-note">@T["The stored timezone ID {0} is retained. Dates below use an explicit UTC fallback until a supported timezone is selected.", Model.StoredTimezoneId]</div> }
                <span asp-validation-for="Input.Timezone" class="field-err" id="error-Timezone"></span>
                <span asp-validation-for="Input.ConfirmTimezoneChange" class="field-err"></span>
                <div class="field-note" data-conflict-for="Timezone" hidden></div>
            </div>
        </section>
        <section class="form-sec" aria-labelledby="identity-link">
            <div class="form-sec-head"><h2 class="form-sec-title" id="identity-link">@T["Permanent event link"]</h2><p class="form-sec-sub">@T["Permanent. It was created with the event and stays the same when you rename it."]</p></div>
            <div class="copy-field" role="group" aria-label="@T["Event link"]"><span class="mono" id="event-link">@signupTableUrl</span><button type="button" class="btn btn-sm btn-quiet" data-copy-url="@signupTableUrl" aria-describedby="event-link">@T["Copy"]</button></div>
            <div class="field-hint">@T["The one link to share. It opens the signup list, which moves visitors on to teams and the board as the event is published. While the event is private, it is not publicly available."]</div>
        </section>
        @if (Model.CanEditIdentity)
        {
            <div class="form-bar"><span class="saved-note" data-identity-state role="status">@(saved ? T["Saved"] : "")</span><button type="submit" class="btn btn-primary" data-identity-save>@T["Save changes"]</button></div>
        }
        @foreach (var pair in Model.TimezonePreviews)
        {
            var scheduled = pair.Value.Where(row => row.Scheduled).ToList();
            var unset = pair.Value.Where(row => !row.Scheduled).Select(row => T[row.Label].Value.ToLower(System.Globalization.CultureInfo.CurrentCulture)).ToList();
            var unsetNames = string.Join(", ", unset);
            if (unsetNames.Length > 0) { unsetNames = char.ToUpper(unsetNames[0], System.Globalization.CultureInfo.CurrentCulture) + unsetNames[1..]; }
            <template data-identity-timezone-preview data-zone="@pair.Key"><div class="m-body"><p>@T["{0} has been public, so players may already have seen its times. Every scheduled moment stays the same; only how it’s shown changes.", Model.EventName]</p>
                @if (scheduled.Count > 0)
                {
                    <div class="compare" role="table" aria-label="@T["Scheduled times before and after the change"]">
                        <div class="compare-head" role="row"><span role="columnheader">@T["Scheduled"]</span><span role="columnheader">@T["Now"] · @Model.Input.TimezoneConfirmationOriginal</span><span role="columnheader">@T["After"] · @pair.Key</span></div>
                        @foreach (var row in scheduled) { <div class="compare-row" role="row" data-identity-timezone-row><span class="compare-label" role="rowheader">@T[row.Label]</span><span class="compare-old" role="cell"><span class="compare-k">@T["Now"]</span>@row.Current</span><span class="compare-new" role="cell"><span class="compare-k">@T["After"]</span>@row.New</span></div> }
                    </div>
                }
                @if (scheduled.Count == 0) { <p class="compare-foot" data-identity-timezone-unset>@T["Nothing is scheduled yet, so no shown times change."]</p> }
                else if (unset.Count > 0) { <p class="compare-foot" data-identity-timezone-unset>@T["Not scheduled yet: {0}.", unsetNames]</p> }
            </div></template>
        }
    </form>
</section>
<template data-page-loading-template="identity">
    <div class="card form-card" aria-busy="true" aria-label="@T["Loading identity"]">
        <div class="sk-block"><div class="sk" style="width:22%"></div><div class="sk" style="width:100%;height:34px;margin-top:14px;border-radius:8px"></div><div class="sk" style="width:100%;height:120px;margin-top:18px;border-radius:8px"></div></div>
        <div class="sk-block"><div class="sk" style="width:18%"></div><div class="sk" style="width:46%;height:34px;margin-top:14px;border-radius:8px"></div></div>
        <div class="sk-block" style="border-bottom:0"><div class="sk" style="width:16%"></div><div class="sk" style="width:70%;height:34px;margin-top:14px;border-radius:8px"></div></div>
    </div>
</template>
@section Styles {
    <link rel="stylesheet" href="~/css/admin-design-identity.css" asp-append-version="true" data-admin-page-style />
}
@section Scripts {
    <script type="module" src="~/js/event-identity.js" asp-append-version="true" data-admin-page-script></script>
}
