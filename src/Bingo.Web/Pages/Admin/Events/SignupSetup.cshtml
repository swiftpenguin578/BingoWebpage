@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.SignupSetupModel
@using System.Text.Json
@{
 ViewData["Title"] = T["Signup setup"];
 ViewData["PageFamily"] = "signupsetup";
 var formTab = Request.Query["tab"] == "form";
}
@section HeaderSummary {<span class="ss-owners">@T["Dates are on"] <a class="text-btn" asp-page="Schedule" asp-route-id="@Model.EventId">@T["Schedule"]</a>; @T["opening and closing signups on"] <a class="text-btn" asp-page="Manage" asp-route-id="@Model.EventId">@T["Overview"]</a>.</span>}
<partial name="_AdminSignupSetupText"/>
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(key => key.StartsWith("Input.", StringComparison.Ordinal))) {
 <div class="banner is-error" asp-validation-summary="All"></div>
 <input type="hidden" name="Input.Label" value="@Model.Input.Label"/>
 <div hidden data-add-recovery data-draft="@JsonSerializer.Serialize(new { label=Model.Input.Label, helpText=Model.Input.HelpText, type=Model.Input.Type.ToString(), required=Model.Input.Required, options=Model.Input.Options }, new JsonSerializerOptions(JsonSerializerDefaults.Web))"></div>
}
<input type="hidden" name="expectedFormVersion" value="@Model.FormVersion"/>
<div class="ss-wrap" data-signup-setup data-current="@JsonSerializer.Serialize(Model.CurrentSnapshot, new JsonSerializerOptions(JsonSerializerDefaults.Web))">
 @foreach(var kind in new[]{"playing","alt","custom"}) { <input type="hidden" data-add-id="@kind" name="addRequestId" value="@(kind == "custom" ? Model.CustomAddRequestId : Guid.NewGuid())"/> }
 <div class="tabs ss-tabs" role="tablist" aria-label="@T["Signup setup"]">
 @foreach (var tab in new[] { "settings", "form" }) { var selected = (tab == "form") == formTab;
 <button class="tab @(selected ? "is-on" : null)" role="tab" type="button" id="tab-@tab" data-tab="@tab" aria-selected="@selected.ToString().ToLowerInvariant()" aria-controls="panel-@tab" tabindex="@(selected ? 0 : -1)"><span>@T[tab == "form" ? "Signup form" : "Settings"]</span><span class="dot tab-dot" data-tab-dirty hidden></span><span class="sr" data-tab-dirty hidden>@T["Unsaved changes"]</span></button> }
 </div>
 <div class="banner is-info page-banner" data-setup-lock hidden="@Model.CanEdit"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("lock")'/><span>@T["The signup settings and form can no longer change because the draft has started or the event has moved on."]</span></div>
 @if (TempData["StatusMessage"] is string status) { <div class="banner is-info page-banner" role="status">@status</div> }
 <div class="ss-panel" role="tabpanel" id="panel-settings" aria-labelledby="tab-settings" hidden="@formTab">
  <section class="card form-card" aria-labelledby="cap-title"><form method="post" asp-page-handler="SignupAdministration" id="signup-settings-form" novalidate>
   <input asp-for="SignupAdministration.Version" type="hidden" />
   <div class="form-sec is-last"><div class="form-sec-head"><h2 class="form-sec-title" id="cap-title">@T["Participant capacity"]</h2><p class="form-sec-sub">@T["How many players can be confirmed. Everyone who signs up after that joins the waiting list."]</p></div>
    <div class="banner is-warning ss-card-banner" data-card-banner="cap" role="status" tabindex="-1" hidden></div>
    <div class="ss-cap"><div class="field"><label class="lbl" for="cap-input">@T["Maximum confirmed players"]</label><input class="input ss-num" id="cap-input" name="SignupAdministration.ParticipantCap" type="number" min="1" max="10000" step="1" value="@Model.Settings.ParticipantCap" disabled="@(!Model.CanEdit)" placeholder="@T["Not set"]" aria-describedby="cap-err cap-note cap-hint"/><div class="ro-value" data-cap-readonly hidden="@Model.CanEdit">@Model.Settings.ParticipantCap</div><div class="field-err" id="cap-err" hidden></div></div>
    <dl class="facts ss-counts" aria-label="@T["Current signups"]"><div class="fact"><dt class="fact-label">@T["confirmed"]</dt><dd class="fact-value" data-confirmed>@Model.ConfirmedCount</dd></div><div class="fact"><dt class="fact-label">@T["Waiting list"]</dt><dd class="fact-value" data-waiting>@Model.WaitingCount</dd></div><div class="fact ss-counts-link"><dt class="sr">@T["More"]</dt><dd class="fact-value"><a class="text-btn ss-fact-btn" asp-page="Participants" asp-route-id="@Model.EventId">@T["See them on Participants"]<partial name="_AdminDesignIcon" model='new AdminDesignIcon("chevron-right")'/></a></dd></div></dl></div>
    <div class="field-note ss-note" id="cap-note" role="status" hidden></div><div class="field-hint ss-always" id="cap-hint">@T["The waiting list is always on. Players join it in waiting-list order once every place is taken."]</div>
   </div><div class="form-bar is-inline" data-card-bar="cap" hidden="@(!Model.CanEdit)"><span class="dirty" data-card-dirty="cap" hidden><span class="dot"></span>@T["Unsaved changes"]</span><span class="saved-note" data-card-saved="cap" role="status"></span><button class="btn btn-primary" id="cap-save" type="submit" style="min-width:132px">@T["Save capacity"]</button></div>
  </form></section>
  <section class="card form-card" aria-labelledby="code-title"><form method="post" asp-page-handler="SignupCode" id="signup-code-settings-form" novalidate>
   <input asp-for="SignupCode.Version" type="hidden"/><div class="form-sec is-last"><div class="form-sec-head"><h2 class="form-sec-title" id="code-title">@T["Signup code"]</h2><p class="form-sec-sub">@T["Ask for a code before anyone can sign up, for example one you share in Discord. Not to be confused with evidence codes, which are on Overview."]</p></div>
    <div class="banner is-warning ss-card-banner" data-card-banner="code" role="status" tabindex="-1" hidden></div><div class="ro-value" data-code-readonly hidden="@Model.CanEdit">@T[Model.Settings.RequireSignupCode ? "Required · a code is set" : "Not required"]</div><div class="form-fields" data-code-editable hidden="@(!Model.CanEdit)"><label class="check-row"><input id="code-on" name="SignupCode.RequireSignupCode" type="checkbox" checked="@Model.SignupCode.RequireSignupCode" disabled="@(!Model.CanEdit)"/><span><span class="choice-title">@T["Require a signup code"]</span><span class="choice-sub" style="display:block">@T["Players need the code to sign up."]</span></span></label>
    <div class="ro-list" data-code-stored hidden="@(!Model.Settings.HasSignupCode)"><div class="ro-row"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("lock")'/><span class="grow">@T["A code is set"]<span class="choice-sub" style="display:block">@T["It’s stored securely, so it can’t be shown or copied here."]</span></span></div></div>
    <div class="field field-narrow signup-code-control" data-code-field hidden="@(!Model.SignupCode.RequireSignupCode)"><div class="lbl-row"><label class="lbl" for="code-new">@T["New signup code"]</label><span class="field-count" data-code-count></span></div><input class="input mono" id="code-new" name="SignupCode.NewSignupCode" value="" autocomplete="off" spellcheck="false" disabled="@(!Model.CanEdit)" aria-describedby="signup-code-help signup-code-error"/><span class="field-err" id="signup-code-error" asp-validation-for="SignupCode.NewSignupCode" hidden="@(ViewData.ModelState["SignupCode.NewSignupCode"]?.Errors.Count is not > 0)"></span><div class="field-hint" id="signup-code-help">@T["Leave blank to keep the current code."]</div></div></div>
   </div><div class="form-bar is-inline" data-card-bar="code" hidden="@(!Model.CanEdit)"><span class="dirty" data-card-dirty="code" hidden><span class="dot"></span>@T["Unsaved changes"]</span><span class="saved-note" data-card-saved="code" role="status"></span><button class="btn btn-primary" id="code-save" type="submit" style="min-width:132px">@T["Save code"]</button></div>
  </form></section>
 </div>
 <div class="ss-panel" role="tabpanel" id="panel-form" aria-labelledby="tab-form" hidden="@(!formTab)"><div class="card form-card"><div class="form-banners"><div class="banner is-info" data-response-note hidden="@(!Model.HasFirstResponse)">@T["Players have answered. Existing answer types, choices and required settings are locked. New questions are optional."]</div><div class="banner is-warning" data-form-banner role="status" tabindex="-1" hidden><span class="grow"></span><button class="banner-btn" data-check-form type="button" hidden>@T["Check form"]</button></div></div><div class="form-sec is-last" data-form-absent hidden="@Model.HasForm">@T["No signup form was recorded for this imported event."]</div><div data-question-sections></div></div></div>
 <p class="sr" data-form-announcement aria-live="polite"></p>
</div>
@section Styles {<link rel="stylesheet" href="~/css/admin-design-signupsetup.css" asp-append-version="true" data-admin-page-style/>}
@section Scripts {<script type="module" src="~/js/admin-signup-setup.js" asp-append-version="true" data-admin-page-script></script>}
