@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.CsvModel
@{
    ViewData["Title"] = "CSV import";
}
<section class="table-page"><p class="eyebrow">Signup fallback</p><h1>CSV import</h1><p class="form-intro">Use the fixed template. Website signup remains the primary workflow.</p>
<p><a class="btn btn-outline-light" asp-page-handler="Template">Download template</a></p>
<form method="post" asp-page-handler="Preview" enctype="multipart/form-data" class="panel form-stack"><label asp-for="Upload"></label><input asp-for="Upload" class="form-control" accept=".csv,text/csv" /><button class="btn btn-primary">Preview CSV</button></form>
@if(Model.PreviewRows.Count>0){<div class="panel">@foreach(var warning in Model.Warnings){<p class="form-hint">@warning</p>}<p>@Model.PreviewRows.Count row(s) ready for validation/import.</p></div>
<div class="table-wrap panel"><table><thead><tr><th>Player</th><th>EHB</th><th>Second account</th><th>Discord</th><th>Captain</th></tr></thead><tbody>@foreach(var row in Model.PreviewRows){<tr><td>@row.PrimaryAccountName</td><td>@row.Ehb</td><td>@row.SecondAccountName</td><td>@row.DiscordIdentity</td><td>@row.CaptainVolunteer</td></tr>}</tbody></table></div>
<form method="post" asp-page-handler="Import"><textarea asp-for="CsvContent" hidden></textarea><button class="btn btn-primary">Import these rows</button></form>}
<p><a asp-page="Manage" asp-route-id="@RouteData.Values["id"]">Back to event</a></p></section>
