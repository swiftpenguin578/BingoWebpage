@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.ScheduleModel
@using Bingo.Domain.Events
@using Bingo.Web.UI
@{
    ViewData["Title"] = T["Schedule"];
    ViewData["AdminPageDescription"] = T["Set the signup, event, and draft times."];
    var eventStatus = AdminEventStatePresentation.For(Model.EventState, T);
    var signupUrl = Url.Page("/Events/Signup", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
    var signupTableUrl = Url.Page("/Events/Signups", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
    var publicBoardUrl = Url.Page("/Events/Board", null, new { slug = Model.EventSlug }, Request.Scheme, Request.Host.Value);
}

<section class="schedule-editor-page" data-schedule-editor>
    <div class="schedule-editor-layout">
        <main class="schedule-editor-main">
            <form method="post" class="schedule-editor-form" data-schedule-form data-participants-rely="@(Model.ParticipantsRelyOnSchedule || Model.EventState == EventState.Live ? "true" : "false")" data-live="@(Model.EventState == EventState.Live ? "true" : "false")"
                  data-schedule-title="@T["Save schedule changes?"]" data-schedule-live-title="@T["Change the Live event end?"]"
                  data-schedule-description-prefix="@T["This changes"]" data-schedule-description-suffix="@T["Existing participants will see the new schedule."]" data-schedule-action="@T["Save schedule"]">
                <div asp-validation-summary="ModelOnly" class="validation-summary app-notice notice-error"></div>
                <input asp-for="Input.Version" type="hidden" />
                <input asp-for="Input.ConfirmChanges" type="hidden" value="false" data-schedule-confirm />
                <input asp-for="Input.EventEndReason" type="hidden" data-schedule-end-reason />
                @if (Model.Readiness?.Warnings is { Count: > 0 })
                {
                    <section class="schedule-editor-warning" aria-labelledby="signup-warning-heading">
                        <h2 id="signup-warning-heading">@T["Signup warnings"]</h2>
                        <ul class="admin-signup-warning-list" aria-label="@T["Signup warnings"]">
                            @foreach (var warning in Model.Readiness.Warnings)
                            {
                                <li>@T[warning.Description]</li>
                            }
                        </ul>
                    </section>
                }
                <section class="schedule-editor-panel">
            <div class="event-schedule-groups">
                <section class="event-schedule-group" aria-labelledby="signup-window-heading">
                    <div class="event-schedule-group-heading">
                        <div><h3 id="signup-window-heading">@T["Signup window"]</h3><p>@T["When players can sign up."]</p></div>
                    </div>
                    <div class="event-create-fields">
                        @if (Model.CanEditScheduledOpening)
                        {
                            <div class="admin-field event-create-field event-datetime-field" data-datetime-control>
                                <label asp-for="Input.SignupOpensLocal">@T["Signup opens"]</label>
                                <div class="event-datetime-visual" aria-label="@T["Signup opens"]">
                                    <label class="event-datetime-part"><span>@T["Date"]</span><span class="event-datetime-input"><input type="date" data-datetime-date aria-label="@T["Signup opens date"]" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg></span></label>
                                    <label class="event-datetime-part"><span>@T["Time"]</span><span class="event-datetime-input"><input type="time" step="300" data-datetime-time aria-label="@T["Signup opens time"]" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span></label>
                                </div>
                                <input asp-for="Input.SignupOpensLocal" type="datetime-local" step="300" class="form-control event-datetime-canonical" data-datetime-canonical data-schedule-boundary="Signup opens" />
                                <span asp-validation-for="Input.SignupOpensLocal" class="field-error"></span>
                            </div>
                        }
                        else
                        {
                            <div class="schedule-locked-value"><span>@T["Signup opening (read-only)"]</span><strong>@(Model.ActualSignupOpened ?? Model.ScheduledSignupOpening)</strong></div>
                        }
                        @if (Model.CanEditSignupClosing)
                        {
                        <div class="admin-field event-create-field event-datetime-field" data-datetime-control>
                            <label asp-for="Input.SignupClosesLocal">@T["Signup closes"]</label>
                            <div class="event-datetime-visual" aria-label="@T["Signup closes"]">
                                <label class="event-datetime-part"><span>@T["Date"]</span><span class="event-datetime-input"><input type="date" data-datetime-date aria-label="@T["Signup closes date"]" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg></span></label>
                                <label class="event-datetime-part"><span>@T["Time"]</span><span class="event-datetime-input"><input type="time" step="300" data-datetime-time aria-label="@T["Signup closes time"]" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span></label>
                            </div>
                            <input asp-for="Input.SignupClosesLocal" type="datetime-local" step="300" class="form-control event-datetime-canonical" data-datetime-canonical data-schedule-boundary="Signup closes" />
                            <span asp-validation-for="Input.SignupClosesLocal" class="field-error"></span>
                        </div>
                        }
                        else
                        {
                            <div class="schedule-locked-value"><span>@T["Signup closing (read-only)"]</span><strong>@Model.ScheduledSignupClosing</strong></div>
                        }
                    </div>
                    @if (Model.CanEditScheduledOpening)
                    {
                        <p class="schedule-scheduled-state"><strong>@(Model.ScheduledSignupOpeningEnabled ? T["Automatic signup opening scheduled for"] : T["No automatic signup opening scheduled."])</strong>@if (Model.ScheduledSignupOpeningEnabled) { <text> @Model.ScheduledSignupOpening</text> }</p>
                    }
                    @if (Model.EventState == EventState.SignupClosed)
                    {
                        <p class="schedule-actual-time"><strong>@T["Signup closed"]:</strong> @Model.ActualSignupClosed</p>
                    }
                </section>

                <section class="event-schedule-group" aria-labelledby="event-window-heading">
                    <div class="event-schedule-group-heading">
                        <div><h3 id="event-window-heading">@T["Event schedule"]</h3><p>@T["When the bingo starts, ends, and is drafted."]</p></div>
                    </div>
                    <div class="event-create-fields">
                        <div class="admin-field event-create-field event-datetime-field" data-datetime-control>
                            <label asp-for="Input.EventStartsLocal">@T["Event starts"]</label>
                            <div class="event-datetime-visual" aria-label="@T["Event starts"]">
                                    <label class="event-datetime-part"><span>@T["Date"]</span><span class="event-datetime-input"><input type="date" data-datetime-date aria-label="@T["Event starts date"]" disabled="@(!Model.CanEditEventStart)" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg></span></label>
                                <label class="event-datetime-part"><span>@T["Time"]</span><span class="event-datetime-input"><input type="time" step="300" data-datetime-time aria-label="@T["Event starts time"]" disabled="@(!Model.CanEditEventStart)" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span></label>
                            </div>
                            <input asp-for="Input.EventStartsLocal" type="datetime-local" step="300" class="form-control event-datetime-canonical" data-datetime-canonical data-schedule-boundary="Event starts" disabled="@(!Model.CanEditEventStart)" />
                            <span asp-validation-for="Input.EventStartsLocal" class="field-error"></span>
                        </div>
                        <div class="admin-field event-create-field event-datetime-field" data-datetime-control>
                            <label asp-for="Input.EventEndsLocal">@T["Event ends"]</label>
                            <div class="event-datetime-visual" aria-label="@T["Event ends"]">
                                    <label class="event-datetime-part"><span>@T["Date"]</span><span class="event-datetime-input"><input type="date" data-datetime-date aria-label="@T["Event ends date"]" disabled="@(!Model.CanEditEventEnd)" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg></span></label>
                                <label class="event-datetime-part"><span>@T["Time"]</span><span class="event-datetime-input"><input type="time" step="300" data-datetime-time aria-label="@T["Event ends time"]" disabled="@(!Model.CanEditEventEnd)" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span></label>
                            </div>
                            <input asp-for="Input.EventEndsLocal" type="datetime-local" step="300" class="form-control event-datetime-canonical" data-datetime-canonical data-schedule-boundary="Event ends" disabled="@(!Model.CanEditEventEnd)" />
                            <span asp-validation-for="Input.EventEndsLocal" class="field-error"></span>
                        </div>
                    </div>
                    <div class="event-create-fields schedule-draft-field">
                        <div class="admin-field event-create-field event-datetime-field" data-datetime-control>
                            <label asp-for="Input.DraftLocal">@T["Draft time"]</label>
                            <div class="event-datetime-visual" aria-label="@T["Draft time"]">
                                    <label class="event-datetime-part"><span>@T["Date"]</span><span class="event-datetime-input"><input type="date" data-datetime-date aria-label="@T["Draft date"]" disabled="@(!Model.CanEditDraftTime)" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></svg></span></label>
                                <label class="event-datetime-part"><span>@T["Time"]</span><span class="event-datetime-input"><input type="time" step="300" data-datetime-time aria-label="@T["Draft time"]" disabled="@(!Model.CanEditDraftTime)" /><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span></label>
                            </div>
                            <input asp-for="Input.DraftLocal" type="datetime-local" step="300" class="form-control event-datetime-canonical" data-datetime-canonical data-schedule-boundary="Draft time" disabled="@(!Model.CanEditDraftTime)" />
                            <span asp-validation-for="Input.DraftLocal" class="field-error"></span>
                        </div>
                    </div>
                </section>

            </div>

            <div class="schedule-editor-actions">
                <a class="admin-button-secondary event-create-cancel" asp-page="Manage" asp-route-id="@Model.EventId">@T["Cancel"]</a>
                <button class="admin-button-secondary" type="submit">@T["Save schedule"]</button>
            </div>

                </section>
            </form>
        </main>

        <aside class="event-overview-section event-overview-dates-panel identity-event-information-rail schedule-event-information-rail" aria-labelledby="event-information-heading">
            <div class="event-overview-section-heading">
                <div class="event-overview-heading-label"><h2 id="event-information-heading">@T["Event information"]</h2></div>
            </div>
            <dl class="event-overview-dates">
                <div class="event-overview-date-row event-overview-information-summary">
                    <div class="event-overview-information-name"><dt class="visually-hidden">@T["Event name"]</dt><dd>@Model.EventName</dd></div>
                    <div class="event-overview-information-status"><dt class="visually-hidden">@T["Status"]</dt><dd><span class="admin-status-pill @eventStatus.Modifier">@eventStatus.Label</span></dd></div>
                </div>
                @foreach (var row in Model.EffectiveTimeline)
                {
                    var timelineTone = row.Label switch
                    {
                        "Signup opens" or "Signup closes" => "is-cyan",
                        "Submission cutoff" => "is-yellow",
                        "Signups opened" or "Signups closed" or "Event starts" or "Event started" or "Event ends" or "Event ended" or "Submissions closed" => "is-green",
                        _ => "is-muted"
                    };
                    <div class="event-overview-date-row @timelineTone"><div class="event-overview-date-copy"><dt>@T[row.Label]</dt><dd>@Model.EventDate(row.At)</dd></div></div>
                }
            </dl>
            <div class="event-public-pages" aria-labelledby="event-public-pages-heading">
                <h3 id="event-public-pages-heading">@T["Public pages"]</h3>
                <div class="event-public-page-row"><a href="@signupUrl">@T["Signup form"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@signupUrl" aria-label="@T["Copy signup form link"]"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg></button></div>
                <div class="event-public-page-row"><a href="@signupTableUrl">@T["Public signup table"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@signupTableUrl" aria-label="@T["Copy public signup table link"]"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg></button></div>
                @if (Model.ShowPublicBoard)
                {
                    <div class="event-public-page-row"><a href="@publicBoardUrl">@T["Public board"]</a><button type="button" class="icon-button event-copy-link" data-copy-url="@publicBoardUrl" aria-label="@T["Copy public board link"]"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></svg></button></div>
                }
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/event-create-datetime.js" asp-append-version="true"></script>
    <script>
        window.bingoEventDateTime.initializeControls(document.querySelector("[data-schedule-editor]"), window.flatpickr);
        (() => {
            const form = document.querySelector("[data-schedule-form]");
            if (!form || !window.adminConfirmation) return;
            let submitting = false;
            form.addEventListener("submit", async event => {
                if (submitting || form.dataset.participantsRely !== "true") return;
                const changed = [...form.querySelectorAll("[data-schedule-boundary]:not([disabled])")]
                    .filter(field => field.value !== field.defaultValue)
                    .map(field => ({
                        label: field.dataset.scheduleBoundary,
                        oldValue: field.defaultValue,
                        newValue: field.value
                    }));
                const consequenceChanges = changed.filter(change => change.label !== "Draft time");
                if (consequenceChanges.length === 0) return;
                event.preventDefault();
                const isLive = form.dataset.live === "true";
                const format = value => window.bingoEventDateTime?.format(value) || value || "—";
                const changes = consequenceChanges
                    .map(change => `${change.label}: ${format(change.oldValue)} → ${format(change.newValue)}`)
                    .join("; ");
                const result = await window.adminConfirmation.open({
                    title: isLive ? form.dataset.scheduleLiveTitle : form.dataset.scheduleTitle,
                    description: `${form.dataset.scheduleDescriptionPrefix} ${changes}; ${form.dataset.scheduleDescriptionSuffix}`,
                    actionLabel: form.dataset.scheduleAction,
                    requireReason: isLive && consequenceChanges.some(change => change.label === "Event ends"),
                    onConfirm: ({ reason }) => {
                        if (isLive && consequenceChanges.some(change => change.label === "Event ends")) {
                            const reasonField = form.querySelector("[data-schedule-end-reason]");
                            if (reasonField) reasonField.value = reason;
                        }
                        const confirmation = form.querySelector("[data-schedule-confirm]");
                        if (confirmation) confirmation.value = "true";
                        submitting = true;
                        HTMLFormElement.prototype.submit.call(form);
                        return true;
                    }
                });
                if (result !== true) submitting = false;
            });
        })();
    </script>
}
