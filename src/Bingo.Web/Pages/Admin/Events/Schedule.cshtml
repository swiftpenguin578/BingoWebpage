@page "{id:guid}"
@model Bingo.Web.Pages.Admin.Events.ScheduleModel
@using Bingo.Domain.Events
@using System.Text.Json
@{
    ViewData["Title"] = T["Schedule"];
    ViewData["PageFamily"] = "schedule";
    var editable = Model.CanEditEventStart || Model.CanEditEventEnd;
    var fields = new[] {
        new { Name = "SignupOpensLocal", Key = "signupOpensAt", Label = "Signup opening", Value = Model.Input.SignupOpensLocal, Editable = Model.CanEditScheduledOpening, Hint = string.IsNullOrEmpty(Model.Input.SignupOpensLocal) ? "Not scheduled. Signups open when you open them on Overview, or set a time to open them automatically." : Model.ScheduledSignupOpeningEnabled ? "Signups open automatically at this time if the event is ready then. Overview lists anything still missing." : "Planned only: automatic opening is off for this older schedule, so signups open when you open them on Overview. Choosing a new time turns automatic opening on." },
        new { Name = "SignupClosesLocal", Key = "signupClosesAt", Label = "Signup closing", Value = Model.Input.SignupClosesLocal, Editable = Model.CanEditSignupClosing, Hint = string.IsNullOrEmpty(Model.Input.SignupClosesLocal) ? "No closing time. Signups stay open until you close them on Overview." : "Signups close automatically at this time." },
        new { Name = "DraftLocal", Key = "draftAt", Label = "Team draft", Value = Model.Input.DraftLocal, Editable = Model.CanEditDraftTime, Hint = "For planning and players’ information. It doesn’t start the team draft." },
        new { Name = "EventStartsLocal", Key = "eventStartsAt", Label = "Event start", Value = Model.Input.EventStartsLocal, Editable = Model.CanEditEventStart, Hint = "The event starts automatically at this time if it’s ready then. If something is missing, the start is postponed and admins are told." },
        new { Name = "EventEndsLocal", Key = "eventEndsAt", Label = "Event end", Value = Model.Input.EventEndsLocal, Editable = Model.CanEditEventEnd, Hint = Model.EventState == EventState.Live ? "Changing the end while the event is live needs a reason." : "Must be after the event starts." }
    };
    var sections = new[] {
        new { Title = "Signups", Sub = "When players can sign up.", Start = 0, Count = 2 },
        new { Title = "Team draft", Sub = "When captains draft their teams. Optional, and the draft is still started by hand on Teams / Draft.", Start = 2, Count = 1 },
        new { Title = "Event", Sub = "When the bingo runs.", Start = 3, Count = 2 }
    };
}
@section HeaderSummary {
    <span class="sc-owners">@T["Times are in {0}; change it on", Model.EventTimezoneLabel] <a class="text-btn" data-shell-link asp-page="Identity" asp-route-id="@Model.EventId">@T["Identity"]</a>. @T["Open, close or start by hand on"] <a class="text-btn" data-shell-link asp-page="Manage" asp-route-id="@Model.EventId">@T["Overview"]</a>.</span>
}
@if (Model.HasUnresolvableTimezone)
{
    <div class="banner is-info page-banner" data-timezone-fallback role="status"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("info")' /><span>@T["The stored timezone ID {0} is retained. Dates on this page use an explicit UTC fallback.", Model.EventTimezone] <a class="text-btn" data-shell-link asp-page="Identity" asp-route-id="@Model.EventId">@T["Choose a supported timezone on Identity."]</a></span></div>
}
@if (Model.ScheduleNotice.Length > 0)
{
    <partial name="_AdminDesignBanner" model='new AdminDesignBanner("is-info page-banner form-card", "lock", Model.ScheduleNotice)' />
}
<section class="card form-card" data-schedule-editor data-now="@Model.CurrentInstant.ToString("O", CultureInfo.InvariantCulture)" data-current="@JsonSerializer.Serialize(Model.CurrentSnapshot)" data-published="@Model.HasPublicExposure.ToString().ToLowerInvariant()"
 data-save="@T["Save changes"]" data-saved="@T["Saved"]" data-saving="@T["AdminDesign.Saving…"]" data-checking="@T["AdminDesign.Checking…"]" data-check-again="@T["Check again"]"
 data-unknown="@T["AdminDesign.We couldn’t confirm whether your changes were saved."]" data-stale="@T["AdminDesign.Another admin saved this event while you were editing. Untouched fields have been updated. Your changes are kept; review before saving again."]"
 data-theirs="@T["You both changed this. Their saved time:"]" data-mine-kept="@T["Yours is kept until you choose."]" data-updated="@T["Updated to their saved time."]" data-use-theirs="@T["Use theirs"]" data-up-to-date="@T["AdminDesign.The event now has the values you entered."]" data-unchanged="@T["Your changes weren’t applied. They’re still here; save again when you’re ready."]"
 data-readonly="@T["This event is read-only in its current lifecycle state."]" data-no-changes="@T["No changes to save"]" data-none="@T["Not scheduled"]"
 data-published-title="@T["Change the published schedule?"]" data-live-title="@T["Change when the event ends?"]" data-confirm-body="@T["Players may already have seen these times. Review what changes before saving."]" data-live-body="@T["Teams keep playing until the new end. Uploads close 30 minutes later."]"
 data-now-label="@T["Now"]" data-after="@T["After saving"]" data-time="@T["Time"]" data-uploads="@T["Uploads close"]" data-keep-editing="@T["Keep editing"]" data-reason="@T["Reason for changing the end"]"
 data-reason-hint="@T["This reason is recorded in the event’s history."]" data-reason-required="@T["Enter a reason for changing the Live event end."]" data-reason-limit="@T["Use 2,000 characters or fewer."]"
 data-date-invalid="@T["Choose a valid local date and time."]" data-date-skipped="@T["That local time does not exist because the clocks change at that time."]" data-date-ambiguous="@T["That local time is ambiguous because the clocks change at that time. Choose another time."]"
 data-leave-title="@T["AdminDesign.Leave before checking your save?"]" data-leave-message="@T["AdminDesign.We couldn’t confirm your last save, and it may already have gone through. Check again to find out, or leave now: anything that wasn’t saved will be lost, and you won’t know which until you come back."]" data-leave="@T["Leave anyway"]"
 data-draft-together="@T["The team draft time is saved at the same time."]">
    <form method="post" novalidate>
        <input asp-for="Input.Version" type="hidden" />
        <input asp-for="Input.ConfirmChanges" type="hidden" /><span asp-validation-for="Input.ConfirmChanges" hidden></span>
        <input asp-for="Input.EventEndReason" type="hidden" /><span data-schedule-reason-error asp-validation-for="Input.EventEndReason" hidden>@(ViewData.ModelState["Input.EventEndReason"]?.Errors.FirstOrDefault()?.ErrorMessage)</span>
        <div class="form-banners"><partial name="_AdminDesignBanner" model='new AdminDesignBanner("is-error", "error", string.Join(" ", ViewData.ModelState[string.Empty]?.Errors.Select(error => error.ErrorMessage) ?? []), Hidden: !(ViewData.ModelState[string.Empty]?.Errors.Any() ?? false))' /><div class="banner is-warning" data-schedule-feedback role="status" tabindex="-1" hidden></div></div>
        @foreach (var section in sections)
        {
            <section class="form-sec @(!editable && section.Start == 3 ? "is-last" : null)" aria-labelledby="section-@(section.Start)">
                <div class="form-sec-head"><h2 class="form-sec-title" id="section-@(section.Start)">@T[section.Title]</h2><p class="form-sec-sub">@T[section.Sub]</p></div>
                <div class="sc-pair @(section.Count == 1 ? "is-single" : null)">
                    @foreach (var field in fields.Skip(section.Start).Take(section.Count))
                    {
                        var id = "schedule-" + field.Key;
                        <div class="field sc-field" data-schedule-field="@field.Key" data-local-name="@field.Name" data-label="@T[field.Label]">
                            <div class="lbl" id="label-@id">@T[field.Label] @if (field.Key == "draftAt") { <span class="opt">· @T["AdminDesign.optional"]</span> }</div>
                            <input type="hidden" id="Input_@field.Name" name="Input.@field.Name" value="@field.Value" />
                            @if (field.Editable)
                            {
                                <div class="dtp" id="@id-field" data-date-time="@id" data-label="@T[field.Label]" data-timezone="@Model.DisplayTimezone" data-now="@Model.CurrentInstant.ToString("O", CultureInfo.InvariantCulture)" data-clearable="@((!Model.HasPublicExposure || field.Key is not ("eventStartsAt" or "eventEndsAt")).ToString().ToLowerInvariant())" role="group" aria-labelledby="label-@id">
                                    <input class="dtp-date" id="@id-date" placeholder="dd mmm yyyy" autocomplete="off" spellcheck="false" aria-label="@T["{0}, date", T[field.Label]]" aria-describedby="error-@field.Name hint-@id" />
                                    <span class="dtp-sep" aria-hidden="true"></span>
                                    <input class="dtp-time" id="@id-time" placeholder="hh:mm" inputmode="numeric" autocomplete="off" aria-label="@T["{0}, time (24-hour)", T[field.Label]]" aria-describedby="error-@field.Name hint-@id" />
                                    <button class="icon-btn dtp-btn" id="@id-btn" type="button" aria-label="@T["Choose {0} from a calendar", T[field.Label]]" title="@T["Calendar"]" aria-haspopup="dialog" aria-expanded="false"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("calendar")' /></button>
                                </div>
                            }
                            else
                            {
                                <div class="ro-value @(string.IsNullOrEmpty(field.Value) ? "is-empty" : null)" aria-labelledby="label-@id">@(string.IsNullOrEmpty(field.Value) ? T["Not scheduled"].Value : Model.LocalDate(field.Value))</div>
                                <partial name="_AdminDesignFieldLock" model='new AdminDesignFieldLock(Model.FieldLock(field.Key))' />
                            }
                            <partial name="_AdminDesignFieldError" model='new AdminDesignFieldError(field.Name, ViewData.ModelState["Input." + field.Name]?.Errors.FirstOrDefault()?.ErrorMessage ?? "")' />
                            <div class="field-note" data-schedule-conflict hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("info")' /><span data-conflict-text></span></div>
                            @if (field.Key == "eventStartsAt" && field.Editable) { <div class="sc-warn" data-overdue-start hidden><partial name="_AdminDesignIcon" model='new AdminDesignIcon("warning")' /><span>@T["This start time has passed and the event hasn’t started. Choose a new time, or start it on Overview."]</span></div> }
                            @if (field.Editable) { <div class="field-hint" id="hint-@id">@T[field.Hint]</div> }
                        </div>
                    }
                </div>
                @if (section.Start == 3) { <div class="sc-derived" hidden="@(string.IsNullOrEmpty(Model.Input.EventEndsLocal))"><partial name="_AdminDesignIcon" model='new AdminDesignIcon("upload")' /><span>@T[Model.EventState is EventState.AwaitingFinalReview or EventState.Archived ? "Normal uploads closed" : "Uploads close 30 minutes after the end:"] <b data-uploads-close></b>@T[Model.EventState is EventState.AwaitingFinalReview or EventState.Archived ? ", 30 minutes after the end." : ". This follows the end; it isn’t set separately."]</span></div> }
            </section>
        }
        @if (editable) { <partial name="_AdminDesignSaveBar" model='new AdminDesignSaveBar(T["Save changes"].Value, T["No changes to save"].Value, T["Unsaved changes"].Value, TempData.Peek("StatusMessage") is not null ? T["Saved"].Value : null, MinWidth: 136)' /> }
    </form>
    <partial name="_AdminDesignDateTimeTemplates" />
</section>
@section Styles { <link rel="stylesheet" href="~/css/admin-design-schedule.css" asp-append-version="true" data-admin-page-style /> }
@section Scripts { <script type="module" src="~/js/admin-schedule.js" asp-append-version="true" data-admin-page-script></script> }
