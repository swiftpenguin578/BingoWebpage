@page
@model Bingo.Web.Pages.Admin.Events.CreateModel
@{
    ViewData["Title"] = "Create event";
}
<section class="form-page wide-form"><p class="eyebrow">Event setup</p><h1>Create event</h1><p class="form-intro">This creates a private draft. You can open signups before its board exists.</p>
<form method="post" class="panel form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="field-error"></span>
<label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
<label asp-for="Input.Timezone"></label><input asp-for="Input.Timezone" class="form-control" />
<div class="form-grid"><div><label asp-for="Input.SignupOpensDate"></label><input asp-for="Input.SignupOpensDate" class="form-control" /><label asp-for="Input.SignupOpensTime"></label><select asp-for="Input.SignupOpensTime" class="form-select">@foreach(var time in Model.HalfHourTimes){<option value="@time">@time</option>}</select></div><div><label asp-for="Input.SignupClosesDate"></label><input asp-for="Input.SignupClosesDate" class="form-control" /><label asp-for="Input.SignupClosesTime"></label><select asp-for="Input.SignupClosesTime" class="form-select">@foreach(var time in Model.HalfHourTimes){<option value="@time">@time</option>}</select></div><div><label asp-for="Input.EventStartsDate"></label><input asp-for="Input.EventStartsDate" class="form-control" /><label asp-for="Input.EventStartsTime"></label><select asp-for="Input.EventStartsTime" class="form-select">@foreach(var time in Model.HalfHourTimes){<option value="@time">@time</option>}</select></div><div><label asp-for="Input.EventEndsDate"></label><input asp-for="Input.EventEndsDate" class="form-control" /><label asp-for="Input.EventEndsTime"></label><select asp-for="Input.EventEndsTime" class="form-select">@foreach(var time in Model.HalfHourTimes){<option value="@time">@time</option>}</select></div><div><label asp-for="Input.ParticipantCap"></label><input asp-for="Input.ParticipantCap" class="form-control" /></div></div>
<label class="check-row"><input asp-for="Input.WaitingListEnabled" /> Enable waiting list</label><span class="check-row"><label><input asp-for="Input.AllowPrivateEditing" /> Allow private signup editing</label><span class="info-icon" tabindex="0" role="img" aria-label="Participants receive a private link after signup that lets them correct their own signup without an account." data-tooltip="Participants receive a private link after signup that lets them correct their own signup without an account.">i</span></span><label class="check-row"><input asp-for="Input.RequireSignupCode" /> Require event code</label>
<label asp-for="Input.SignupCode"></label><input asp-for="Input.SignupCode" class="form-control" autocomplete="off" disabled="@(!Model.Input.RequireSignupCode)" /><span asp-validation-for="Input.SignupCode" class="field-error"></span>
<h2>Planning estimates</h2><div class="form-grid"><div><label asp-for="Input.ExpectedTeamCount"></label><input asp-for="Input.ExpectedTeamCount" class="form-control" /></div><div><label asp-for="Input.ExpectedTeamSize"></label><input asp-for="Input.ExpectedTeamSize" class="form-control" /></div><div><label asp-for="Input.ExpectedBoardRows"></label><input asp-for="Input.ExpectedBoardRows" class="form-control" /></div><div><label asp-for="Input.ExpectedBoardColumns"></label><input asp-for="Input.ExpectedBoardColumns" class="form-control" /></div></div>
<button class="btn btn-primary" type="submit">Create private event</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.getElementById('Input_RequireSignupCode')?.addEventListener('change',function(){document.getElementById('Input_SignupCode').disabled=!this.checked;});</script> }
