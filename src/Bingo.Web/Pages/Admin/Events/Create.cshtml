@page
@model Bingo.Web.Pages.Admin.Events.CreateModel
@{
    ViewData["Title"] = T["Create event"];
    ViewData["AdminPageDescription"] = T["Start a private event draft and complete setup when ready."];
}

<section class="event-create-page" aria-labelledby="create-event-heading">
    <form method="post" class="event-create-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary app-notice notice-error"></div>
        <div class="panel event-create-workspace">
            <div class="admin-section-heading event-create-panel-heading">
                <div><p class="step-kicker">@T["Private draft"]</p><h1 id="create-event-heading">@T["Create event"]</h1></div>
                <p>@T["Start with the event name and timezone. You can configure the private draft afterward."]</p>
            </div>
            <fieldset class="event-create-group">
                <legend>@T["Event identity"]</legend>
                <div class="event-create-fields">
                    <div class="admin-field event-create-field">
                        <label asp-for="Input.Name">@T["Event name"]</label>
                        <input asp-for="Input.Name" class="form-control" maxlength="50" autocomplete="off" autofocus />
                        <span asp-validation-for="Input.Name" class="field-error"></span>
                    </div>
                    <div class="admin-field event-create-field">
                        <label asp-for="Input.Timezone">@T["Timezone"]</label>
                        <select asp-for="Input.Timezone" class="form-select">
                            @foreach (var timezone in Model.Timezones)
                            {
                                <option value="@timezone.Id">@timezone.Label</option>
                            }
                        </select>
                        <span asp-validation-for="Input.Timezone" class="field-error"></span>
                        <small>@T["All event times use this timezone. The default is Europe/Copenhagen."]</small>
                    </div>
                </div>
            </fieldset>
            <div class="information-callout">
                <div class="information-callout-heading"><strong>@T["What is created"]</strong></div>
                <span>@T["The event starts as a private Draft with a unique permanent link, the standard signup questions, and an empty 5 × 5 board. No schedule, banner, competition, or optional planning data is imported."]</span>
            </div>
            <div class="identity-editor-actions">
                <a class="admin-button-secondary" asp-page="Index">@T["Cancel"]</a>
                <button class="admin-button-create" type="submit">@T["Create private event"]</button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
