@page
@{
    ViewData["Title"] = T["How to"];
    ViewData["BodyClass"] = "public-ui-pass2";
}

<section class="public-pass2-page public-pass2-how-to-page" aria-labelledby="how-to-heading">
    <header class="public-pass2-masthead public-masthead-copy">
        <span class="public-pass2-kicker public-masthead-kicker">@T["HOW TO PAGE"]</span>
        <h1 id="how-to-heading" class="public-masthead-title">@T["WORK IN PROGRESS"]</h1>
        <p class="public-masthead-support">@T["Guides for joining events, using bingo boards, submitting drops, and following results will appear here."]</p>
    </header>
</section>
