@page
@model IndexModel
@using Bingo.Domain.Events
@{
    ViewData["Title"] = T["Bingo events"];
    ViewData["CompactNavigation"] = true;
}

<section class="public-home">
    <header class="public-hero">
        <p class="eyebrow">@T["OSRS Community Bingo"]</p>
        <h1>@T["Follow every team, tile and drop."]</h1>
        <p>@T["Open an event to see how every team is doing, then choose a team to view their board and completed tiles."]</p>
    </header>

    @if (Model.Events.Count == 0)
    {
        <section class="panel empty-public-state">
            <h2>@T["No public boards yet"]</h2>
            <p>@T["The next board will appear here as soon as the draft is completed and the board is published."]</p>
        </section>
    }
    else
    {
        <div class="public-event-list" aria-label="Public bingo events">
            @foreach (var bingoEvent in Model.Events)
            {
                var status = bingoEvent.State switch
                {
                    EventState.SignupOpen => T["Signups open"],
                    EventState.Live => T["Live now"],
                    EventState.AwaitingFinalReview => T["Final review"],
                    EventState.Finalized => T["Finished"],
                    EventState.Archived => T["Archived"],
                    _ => T["Upcoming"]
                };
                <a class="public-event-card panel" asp-page="/Events/Board" asp-route-slug="@bingoEvent.Slug">
                    <span class="public-event-status state-@bingoEvent.State.ToString().ToLowerInvariant()">@status</span>
                    <span class="public-event-title">@bingoEvent.Name</span>
                    <span class="public-event-meta">@T["{0} × {1} board", bingoEvent.Rows, bingoEvent.Columns] · @(bingoEvent.StartsAt?.ToString("d MMM yyyy, HH:mm") ?? T["Not set"])</span>
                    <span class="public-event-action">@T["View bingo"] <span aria-hidden="true">→</span></span>
                </a>
            }
        </div>
    }
</section>

@if (Model.PreviousEvents.Count > 0)
{
    <section class="public-home"><header class="public-hero"><p class="eyebrow">@T["History"]</p><h2>@T["Previous events"]</h2></header><div class="public-event-list">
    @foreach (var bingoEvent in Model.PreviousEvents)
    {
        <a class="public-event-card panel" asp-page="/Events/Board" asp-route-slug="@bingoEvent.Slug"><span class="public-event-status state-archived">@T["Archived"]</span><span class="public-event-title">@bingoEvent.Name</span><span class="public-event-meta">@T["{0} × {1} board", bingoEvent.Rows, bingoEvent.Columns]</span><span class="public-event-action">@T["View history"] <span aria-hidden="true">→</span></span></a>
    }
    </div></section>
}
