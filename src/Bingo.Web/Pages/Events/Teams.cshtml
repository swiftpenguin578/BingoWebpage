@page "/Events/{slug}/Teams"
@model Bingo.Web.Pages.Events.TeamsModel
@using Bingo.Domain.Teams
@{ ViewData["Title"] = $"{Model.EventName} teams"; }
@if(!string.IsNullOrWhiteSpace(Model.CurrentEvidenceCode)){<aside class="evidence-code-banner" aria-label="Current evidence verification code"><span>Current evidence code</span><strong>@Model.CurrentEvidenceCode</strong></aside>}
<section class="table-page"><div class="page-heading"><div><p class="eyebrow">Final rosters</p><h1>@Model.EventName teams</h1></div><a asp-page="/Index">Home</a></div><div class="team-grid">@foreach(var team in Model.Teams){<article class="panel team-card">@if(!string.IsNullOrWhiteSpace(team.ImageUrl)){<img src="@team.ImageUrl" alt="@team.Name"/>}<h2>@team.Name</h2>@if(!string.IsNullOrWhiteSpace(team.Affiliation)){<p>@team.Affiliation</p>}@if(team.FormationType==TeamFormationType.Drafted){<p>@team.TotalEhb.ToString("0.##") combined signup EHB</p>}<ul>@foreach(var member in team.Members){<li><span>@member.Name <small>@member.Role</small></span>@if(team.FormationType==TeamFormationType.Drafted){<strong>@member.Ehb</strong>}</li>}</ul></article>}</div>@if(Model.Picks.Count>0){<div class="page-heading subheading"><h2>Draft history</h2></div><div class="table-wrap panel"><table><thead><tr><th>Pick</th><th>Round</th><th>Team</th><th>Player</th></tr></thead><tbody>@foreach(var pick in Model.Picks){<tr><td>#@pick.PickNumber</td><td>@pick.RoundNumber</td><td>@pick.TeamName</td><td>@pick.PlayerName</td></tr>}</tbody></table></div>}</section>
