@page "/Events/{slug}/Teams"
@model Bingo.Web.Pages.Events.TeamsModel
@using Bingo.Domain.Events
@using Bingo.Domain.Teams
@{ ViewData["Title"] = $"{Model.EventName} teams"; }
<section class="table-page"><div class="page-heading"><div><p class="eyebrow">@T["Final rosters"]</p><h1>@T["{0} teams", Model.EventName]</h1></div><a asp-page="/Index">@T["Home"]</a></div>
@if (Model.ParticipantContext is { } context)
{
    <section class="panel participant-live-context" aria-label="@T["Your event context"]">
        <p class="eyebrow">@T["Your event context"]</p>
        <h2>@context.TeamName</h2>
        <p>@T["Lifecycle"]: @context.EventState · @T["Role"]: @context.TeamRole · @T["Planned starting account"]: <strong>@context.PlannedCharacterName</strong></p>
        @if (context.EventEndsAt is { } eventEnd) { <p>@T["Event ends"]: <time datetime="@eventEnd.ToUniversalTime().ToString("O")">@eventEnd.ToUniversalTime().ToString("dd MMM yyyy HH:mm 'UTC'")</time></p> }
    </section>
}
<div class="team-grid">@foreach(var team in Model.Teams){<article class="panel team-card">@if(!string.IsNullOrWhiteSpace(team.ImageUrl)){<img src="@team.ImageUrl" alt="@team.Name"/>}<h2>@team.Name</h2>@if(!string.IsNullOrWhiteSpace(team.Affiliation)){<p>@team.Affiliation</p>}<ul>@foreach(var member in team.Members){<li><span>@member.Name <small>@member.Role</small></span></li>}</ul></article>}</div>@if(Model.Picks.Count>0){<div class="page-heading subheading"><h2>@T["Draft results"]</h2></div><div class="table-wrap panel"><table><thead><tr><th>@T["Pick"]</th><th>@T["Team"]</th><th>@T["Player"]</th></tr></thead><tbody>@foreach(var pick in Model.Picks){<tr><td>#@pick.PickNumber</td><td>@pick.TeamName</td><td>@pick.PlayerName</td></tr>}</tbody></table></div>}</section>
