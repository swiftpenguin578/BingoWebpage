@page "/Events/{slug}/Teams"
@model Bingo.Web.Pages.Events.TeamsModel
@using Bingo.Domain.Teams
@{ ViewData["Title"] = $"{Model.EventName} teams"; }
@if(!string.IsNullOrWhiteSpace(Model.CurrentEvidenceCode)){<aside class="evidence-code-banner" aria-label="@T["Current evidence verification code"]"><span>@T["Current evidence code"]</span><strong>@Model.CurrentEvidenceCode</strong></aside>}
<section class="table-page"><div class="page-heading"><div><p class="eyebrow">@T["Final rosters"]</p><h1>@T["{0} teams", Model.EventName]</h1></div><a asp-page="/Index">@T["Home"]</a></div><div class="team-grid">@foreach(var team in Model.Teams){<article class="panel team-card">@if(!string.IsNullOrWhiteSpace(team.ImageUrl)){<img src="@team.ImageUrl" alt="@team.Name"/>}<h2>@team.Name</h2>@if(!string.IsNullOrWhiteSpace(team.Affiliation)){<p>@team.Affiliation</p>}@if(team.FormationType==TeamFormationType.Drafted){<p>@T["{0} combined signup EHB", team.TotalEhb.ToString("0.##")]</p>}<ul>@foreach(var member in team.Members){<li><span>@member.Name <small>@member.Role</small></span>@if(team.FormationType==TeamFormationType.Drafted){<strong>@member.Ehb</strong>}</li>}</ul></article>}</div>@if(Model.Picks.Count>0){<div class="page-heading subheading"><h2>@T["Draft history"]</h2></div><div class="table-wrap panel"><table><thead><tr><th>@T["Pick"]</th><th>@T["Round"]</th><th>@T["Team"]</th><th>@T["Player"]</th></tr></thead><tbody>@foreach(var pick in Model.Picks){<tr><td>#@pick.PickNumber</td><td>@pick.RoundNumber</td><td>@pick.TeamName</td><td>@pick.PlayerName</td></tr>}</tbody></table></div>}</section>
