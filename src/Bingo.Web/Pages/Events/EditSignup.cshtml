@page "/Events/{slug}/Signup/Edit/{token}"
@model Bingo.Web.Pages.Events.EditSignupModel
@using Bingo.Domain.Signups
@{
    ViewData["Title"] = T["Edit signup"];
}
<section class="form-page"><p class="eyebrow">@T["Private signup link"]</p><h1>@T["Edit signup"]</h1><p class="form-intro">@T["Your queue time and position do not change when you correct these details."]</p>
<form method="post" class="panel form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<label asp-for="Input.PrimaryAccountName">@T["In-game name"]</label><input asp-for="Input.PrimaryAccountName" class="form-control" />
<label asp-for="Input.Ehb">@T["EHB (Wise Old Man)"]</label><input asp-for="Input.Ehb" class="form-control" />
<label asp-for="Input.SecondAccountName">@T["Second account"]</label><input asp-for="Input.SecondAccountName" class="form-control" />
<label asp-for="Input.DiscordIdentity">@T["Discord name"]</label><input asp-for="Input.DiscordIdentity" class="form-control" />
<label asp-for="Input.Comments">@T["Comments"]</label><textarea asp-for="Input.Comments" class="form-control" rows="4"></textarea>
<label class="check-row"><input asp-for="Input.CaptainVolunteer" /> @T["I am willing to be a captain"]</label>
@foreach (var question in Model.Questions) {
<label for="question-@question.Id">@question.Label @if(question.Required){<span aria-hidden="true">*</span>}</label>
@if(question.Type == SignupQuestionType.LongText){<textarea id="question-@question.Id" name="Input.CustomAnswers[@question.Id]" class="form-control" rows="3">@Model.Input.CustomAnswers.GetValueOrDefault(question.Id)</textarea>}
else if(question.Type == SignupQuestionType.YesNo){<select id="question-@question.Id" name="Input.CustomAnswers[@question.Id]" class="form-select"><option value="">@T["Choose…"]</option>@if(Model.Input.CustomAnswers.GetValueOrDefault(question.Id)=="Yes"){<option selected>@T["Yes"]</option>}else{<option>@T["Yes"]</option>}@if(Model.Input.CustomAnswers.GetValueOrDefault(question.Id)=="No"){<option selected>@T["No"]</option>}else{<option>@T["No"]</option>}</select>}
else if(question.Type == SignupQuestionType.SingleChoice){<select id="question-@question.Id" name="Input.CustomAnswers[@question.Id]" class="form-select"><option value="">@T["Choose…"]</option>@foreach(var option in question.OptionList){if(Model.Input.CustomAnswers.GetValueOrDefault(question.Id)==option){<option selected>@option</option>}else{<option>@option</option>}}</select>}
else {<input id="question-@question.Id" name="Input.CustomAnswers[@question.Id]" value="@Model.Input.CustomAnswers.GetValueOrDefault(question.Id)" class="form-control" type="@(question.Type == SignupQuestionType.Number ? "number" : "text")" />}
}
<button class="btn btn-primary" type="submit">@T["Save corrections"]</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
