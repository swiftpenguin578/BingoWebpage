@page "/Events/{slug}/Board/{teamSlug}/{**tileRoute}"
@model Bingo.Web.Pages.Events.TeamBoardModel
@using Bingo.Domain.Events
@using Bingo.Web.Catalogue
@inject OsrsWikiImageCache WikiImages
@{
    ViewData["Title"] = $"{Model.Team.TeamName} · {Model.Board.EventName}";
    var totalTiles = Model.Board.Rows * Model.Board.Columns;
    var completedLines = Model.Team.Progress.CompletedRows.Count + Model.Team.Progress.CompletedColumns.Count;
    var completionPercent = totalTiles == 0 ? 0 : Model.Team.Progress.CompletedTiles * 100 / totalTiles;
    var publicContributors = Model.Team.Progress.Players
        .OrderByDescending(player => player.EstimatedEhb)
        .ThenByDescending(player => player.ApprovedContribution)
        .ThenBy(player => player.PlayerName)
        .ToList();
    var activityStateText = Model.Activity.State switch
    {
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.NotConfigured => T["Activity tracking is not configured."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.WaitingForFirstSync => T["Waiting for the first Wise Old Man sync."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Partial => T["Activity is provisional: {0} of {1} team accounts matched.", Model.TeamActivity?.MatchedAccountCount ?? 0, Model.TeamActivity?.ExpectedAccountCount ?? 0],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Incomplete => T["Activity rankings are unavailable until the current account set is synchronized."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Stale => T["Cached activity is stale."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.TemporarilyUnavailable => Model.Activity.HasRankings
            ? T["Wise Old Man is temporarily unavailable. Showing the last available cache."]
            : T["Wise Old Man is temporarily unavailable."],
        _ => T["Activity cache is current."]
    };
    var publicBossArtwork = new[]
    {
        "/images/public-board/bosses/chambers-of-xeric.png",
        "/images/public-board/bosses/vorkath.png",
        "/images/public-board/bosses/araxxor.png"
    };
    ViewData["BodyClass"] = "public-event-shell public-ui-pass1 public-team-board-route";
}
@if (Model.Focus is { IsVisible: true })
{
    <script src="~/js/team-focus.js" asp-append-version="true"
            data-event-id="@Model.Board.EventId" data-team-id="@Model.Team.TeamId"
            data-inspect="@Model.InspectFocus.ToString().ToLowerInvariant()"></script>
}
<section class="public-team-board" data-progress-event="@Model.Board.EventId"
         style="--public-board-columns:@Model.Board.Columns">
    <header class="public-team-masthead public-masthead-copy">
        <p class="public-masthead-kicker">@Model.Board.EventName</p>
        <h1 class="public-masthead-title">@Model.Team.TeamName</h1>
        <a class="public-team-back" asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug"
           asp-route-transitionTeam="@Model.Team.TeamId.ToString("N")">← @T["View all teams"]</a>
        @if (!string.IsNullOrWhiteSpace(Model.Team.Affiliation))
        {
            <p class="public-masthead-support"><span>@Model.Team.Affiliation · </span></p>
        }
    </header>

    <div class="progress-update" data-progress-update hidden role="status"><span>@T["New progress is available."]</span> <button type="button" class="public-ui-action public-ui-action--text public-ui-action--forward" data-progress-refresh><span>@T["Refresh now"]</span></button></div>

    <div class="public-team-workspace">
        @if (Model.SelectedTile is { } selectedTile)
        {
            <partial name="_TileSidebar" model="new TileSidebarView(selectedTile, Model.CanSubmit, Model.Board.EventId, Model.Team.TeamId, Model.Team.Tiles.ToList().FindIndex(value => value.TileId == selectedTile.TileId) + 1)" />
        }
        else
        {
        <aside class="public-team-sidebar public-ui-surface public-ui-surface--charcoal public-ui-sectioned-surface" aria-label="@T["Team statistics"]">
            @if (Model.ParticipantContext is { } participantContext)
            {
                <section class="team-account-strip" aria-label="@T["Active account"]">
                    <div class="team-account-heading"><span class="team-account-label">@T["Active account"]</span><strong class="team-account-name">@(participantContext.ActiveCharacterName ?? T["Not active yet"])</strong></div>
                    @if (participantContext.CanSwap)
                    {
                        <details class="team-account-switch">
                            <summary><span>@T["Switch"]</span><span aria-hidden="true">→</span></summary>
                            <form method="post" asp-page-handler="Swap" class="participant-account-swap">
                                <input type="hidden" asp-for="Input.ParticipantId" value="@participantContext.ParticipantId" />
                                <input type="hidden" asp-for="Input.ExpectedCurrentCharacterId" value="@participantContext.PlayingCharacters.Single(character => character.IsActive).CharacterId" />
                                <label asp-for="Input.NextCharacterId">
                                    @T["Switch active account"]
                                    <select asp-for="Input.NextCharacterId" class="public-ui-control-visual public-ui-control-visual--select">
                                        @foreach (var character in participantContext.PlayingCharacters.Where(character => !character.IsActive))
                                        {
                                            <option value="@character.CharacterId">@character.Name</option>
                                        }
                                    </select>
                                    <span class="public-ui-select-chevron" aria-hidden="true"></span>
                                </label>
                                <button type="submit" class="public-ui-action public-ui-action--standard public-ui-action--compact">@T["Swap next minute"]</button>
                            </form>
                        </details>
                    }
                </section>
            }
            <section class="team-sidebar-section team-progress-section">
                <h2 class="team-rail-heading">@T["Team progress"]</h2>
                <dl class="team-progress-summary">
                    <div class="team-progress-row"><dt class="team-progress-label">@T["Completion"]</dt><dd class="team-progress-value">@completionPercent%</dd></div>
                    <div class="team-progress-row"><dt class="team-progress-label">@T["Tiles"]</dt><dd class="team-progress-value">@Model.Team.Progress.CompletedTiles / @totalTiles</dd></div>
                    <div class="team-progress-row"><dt class="team-progress-label">@T["rows"]</dt><dd class="team-progress-value">@completedLines</dd></div>
                </dl>
                <div class="public-ui-progress-meter team-progress-meter" aria-label="@T["{0} percent complete", completionPercent]"><span style="width:@completionPercent%"></span></div>
                @if (Model.CanOpenSubmissionWorkspace || Model.Focus is { CanInspect: true, IsVisible: false } || Model.Focus is { IsInspection: true })
                {
                    <div class="team-progress-actions">
                        @if (Model.CanOpenSubmissionWorkspace)
                        {
                            <a class="public-ui-action public-ui-action--standard public-ui-action--compact team-progress-action team-progress-action--secondary" href="@Url.Page("/Submissions/Index", new { eventId = Model.Board.EventId, teamId = Model.Team.TeamId })"
                               data-submission-history-link>
                                @T["Team history"]
                            </a>
                        }
                        @if (Model.CanOpenSubmissionWorkspace && Model.Board.SubmissionsOpen)
                        {
                            <a class="public-ui-action public-ui-action--commit public-ui-action--compact team-progress-action team-progress-action--primary" href="@Url.Page("/Captain/Submit", new { eventId = Model.Board.EventId, teamId = Model.Team.TeamId })"
                               data-open-submission-drawer>
                                @T["Submit drop"]
                            </a>
                        }
                        @if (Model.Focus is { CanInspect: true, IsVisible: false })
                        {
                            <a class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact team-focus-rail-action" asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Team.TeamSlug" asp-route-inspectFocus="true">@T["Inspect team focus"]</a>
                        }
                        @if (Model.Focus is { IsInspection: true })
                        {
                            <span class="team-focus-rail-state">@T["Read-only focus"]</span>
                            <a class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-action--compact team-focus-rail-action" asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Team.TeamSlug">@T["Stop inspecting"]</a>
                        }
                    </div>
                }
            </section>

            <section class="team-sidebar-section team-ehb-section">
                <h2 class="team-rail-heading">@T["Drop EHB"]</h2>
                <p class="team-rail-supporting">@T["Approved bingo progress"] · @T["Combined expected tile effort"]</p>
                <dl class="team-metric-list">
                    <div class="team-metric-row"><dt>@T["Team total"]</dt><dd class="team-metric-value">@if (Model.Team.Progress.EhbTiebreak == 0) { <span>-</span> } else { <span class="public-ui-positive-delta--success">@Model.Team.Progress.EhbTiebreak.ToString("+0.00;-0.00;0.00")</span> }</dd></div>
                </dl>
                @if (publicContributors.Count > 0)
                {
                    <details class="team-contributor-block">
                        <summary class="team-rail-subheading"><span>@T["Contributors"]</span><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></summary>
                        <ol class="team-contributor-list" aria-label="@T["Contributors"]">
                            @for (var index = 0; index < publicContributors.Count; index++)
                            {
                                var player = publicContributors[index];
                                <li><span class="team-contributor-rank" aria-hidden="true">@((index + 1).ToString("00"))</span><span class="team-contributor-name">@player.PlayerName</span><strong class="team-contributor-value public-ui-positive-delta--success">@(player.EstimatedEhb == 0 ? "-" : player.EstimatedEhb.ToString("+0.00;-0.00;0.00"))</strong></li>
                            }
                        </ol>
                    </details>
                }
            </section>

            <section class="team-sidebar-section team-activity-section">
                <h2 class="team-rail-heading">@T["EHB"]</h2>
                <p class="team-rail-supporting">@T["Wise Old Man"] · @activityStateText</p>
                @if (Model.Activity.HasRankings &&
                     Model.TeamActivity is not null &&
                     Model.TeamActivity.MatchedAccountCount < Model.TeamActivity.ExpectedAccountCount &&
                     (Model.Activity.State == Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Partial ||
                      Model.Activity.State == Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.TemporarilyUnavailable))
                {
                    <p class="team-rail-supporting">@T["Provisional coverage"]: @Model.TeamActivity.MatchedAccountCount/@Model.TeamActivity.ExpectedAccountCount @T["team accounts matched"] · @Model.TeamActivity.ContributingParticipantCount/@Model.TeamActivity.ExpectedParticipantCount @T["participants contributing"]</p>
                }
                @if (Model.TeamActivity is null || !Model.Activity.HasRankings)
                {
                    <dl class="team-metric-list" aria-label="@T["EHB is not available yet"]">
                        <div class="team-metric-row"><dt>@T["Team total"]</dt><dd class="team-metric-value">-</dd></div>
                    </dl>
                }
                else
                {
                    <dl class="team-metric-list" aria-label="@T["EHB"]">
                        <div class="team-metric-row"><dt>@T["Team total"]</dt><dd class="team-metric-value">@if (Model.TeamActivity.TotalGainedEhb == 0) { <span>-</span> } else { <span class="public-ui-positive-delta--success">@Model.TeamActivity.TotalGainedEhb.ToString("+0.00;-0.00;0.00")</span> }</dd></div>
                    </dl>
                    @if (Model.TeamActivity.Participants.Count > 0)
                    {
                        <details class="team-contributor-block">
                            <summary class="team-rail-subheading"><span>@T["Contributors"]</span><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></summary>
                            <ol class="team-contributor-list" aria-label="@T["Contributors"]">
                                @for (var index = 0; index < Model.TeamActivity.Participants.Count; index++)
                                {
                                    var participant = Model.TeamActivity.Participants[index];
                                    <li><span class="team-contributor-rank" aria-hidden="true">@((index + 1).ToString("00"))</span><span class="team-contributor-name">@participant.ParticipantName</span><strong class="team-contributor-value public-ui-positive-delta--success">@(participant.TotalGainedEhb == 0 ? "-" : participant.TotalGainedEhb.ToString("+0.00;-0.00;0.00"))</strong></li>
                                }
                            </ol>
                        </details>
                    }
                }
            </section>
        </aside>
        }

        <div class="public-team-board-legend" aria-label="@T["Board state legend"]">
            <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--complete" aria-hidden="true"></i>@T["Completed"]</span>
            <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--progress" aria-hidden="true"></i>@T["In progress"]</span>
            <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--remaining" aria-hidden="true"></i>@T["remaining"]</span>
        </div>

        <div class="public-board-scroll public-ui-auto-hide-scrollbar" tabindex="0" aria-label="@T["{0} bingo board", Model.Team.TeamName]">
            <div class="public-full-board">
            @foreach (var tile in Model.Team.Tiles)
            {
                var progressPercent = tile.Target == 0 ? 0 : Math.Min(100, tile.Approved * 100 / tile.Target);
                var stateLabel = tile.Complete ? T["Complete"] : tile.Approved > 0 ? T["In progress"] : T["Not started"];
                var tileStateClass = tile.Complete ? "public-ui-team-board-tile--complete" : tile.Approved > 0 ? "public-ui-team-board-tile--in-progress" : "public-ui-team-board-tile--not-started";
                var isBossTile = tile.BossImageUrls.Count > 0;
                var bossArtwork = isBossTile
                    ? tile.Name switch
                    {
                        var name when string.Equals(name, "Chambers of Xeric", StringComparison.OrdinalIgnoreCase) => publicBossArtwork[0],
                        var name when string.Equals(name, "Vorkath", StringComparison.OrdinalIgnoreCase) => publicBossArtwork[1],
                        var name when string.Equals(name, "Araxxor", StringComparison.OrdinalIgnoreCase) => publicBossArtwork[2],
                        _ => null
                    }
                    : null;
                var focusPresentation = TeamBoardModel.GetFocusPresentation(tile, Model.Focus?.Markers ?? []);
                <a class="public-tile public-ui-nested-container public-ui-team-board-tile @tileStateClass @(focusPresentation.Tile ? "public-ui-team-board-tile--focused" : null) @(focusPresentation.Row ? "public-ui-team-board-tile--row-focused" : null) @(focusPresentation.Column ? "public-ui-team-board-tile--column-focused" : null)"
                   aria-label="@T["{0}. {1}, {2} of {3}.", tile.Name, stateLabel, tile.Approved, tile.Target]"
                   asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Team.TeamSlug" asp-route-tileRoute="@($"Tiles/{tile.TileId}")">
                    <span class="public-ui-team-board-tile__number" aria-hidden="true">@((tile.Row * Model.Board.Columns + tile.Column + 1).ToString("00"))</span>
                    <span class="public-ui-team-board-tile__art" aria-hidden="true">
                        @if (bossArtwork is not null)
                        {
                            <img class="public-ui-team-board-tile__art-image" src="@bossArtwork" alt="" loading="lazy" />
                        }
                        else if (!string.IsNullOrWhiteSpace(tile.ImageUrl))
                        {
                            <img class="public-ui-team-board-tile__art-image" src="@WikiImages.GetPublicUrl(tile.ImageUrl)" alt="" loading="lazy" />
                        }
                        else if (tile.BossImageUrls.Count > 0)
                        {
                            <span class="public-ui-team-board-tile__boss-art-grid public-ui-team-board-tile__boss-art-grid--count-@tile.BossImageUrls.Count">
                                @foreach (var imageUrl in tile.BossImageUrls)
                                {
                                    <img src="@WikiImages.GetPublicUrl(imageUrl)" alt="" loading="lazy" />
                                }
                            </span>
                        }
                        else
                        {
                            <span class="public-ui-team-board-tile__placeholder">▦</span>
                        }
                    </span>
                    <span class="public-ui-team-board-tile__shade" aria-hidden="true"></span>
                    <span class="public-ui-team-board-tile__copy">
                        <span class="public-ui-team-board-tile__position">R@(tile.Row + 1) · C@(tile.Column + 1)</span>
                        <strong class="public-ui-team-board-tile__title">@tile.Name</strong>
                        <span class="public-ui-team-board-tile__progress-row">
                            @if (tile.Complete)
                            {
                                <span class="public-ui-team-board-tile__completion-check" aria-hidden="true">✓</span>
                            }
                            <span class="public-ui-team-board-tile__progress" aria-hidden="true"><span style="width:@progressPercent%"></span></span>
                            <span>@tile.Approved/@tile.Target</span>
                        </span>
                    </span>
                </a>
            }
            </div>
        </div>
    </div>

    <nav class="public-team-switcher" aria-label="@T["Switch team"]">
        @if (Model.Previous is not null)
        {
            <a asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Previous.TeamSlug"><small>@T["Previous team"]</small><strong>← #@Model.Previous.Rank @Model.Previous.TeamName</strong></a>
        }
        else { <span></span> }
        @if (Model.Next is not null)
        {
            <a class="next" asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Next.TeamSlug"><small>@T["Next team"]</small><strong>#@Model.Next.Rank @Model.Next.TeamName →</strong></a>
        }
    </nav>
</section>
<dialog class="public-lightbox public-evidence-viewer" data-public-lightbox data-evidence-dialog data-evidence-empty="@T["Evidence"]" data-evidence-default-source="@T["Recent drops"]" data-enlarged-evidence="@T["Enlarged approved evidence"]">
    <button type="button" class="public-ui-viewport-close" data-evidence-close aria-label="@T["Close enlarged evidence"]"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    <div class="public-evidence-viewer__layout">
        <figure class="public-evidence-viewer__figure"><img data-evidence-dialog-image alt="" /></figure>
        <aside class="public-evidence-viewer__meta" aria-label="@T["Evidence details"]">
            <span class="public-ui-overline">@T["Approved evidence"]</span>
            <strong class="public-ui-component-title" data-evidence-dialog-drop>@T["Evidence"]</strong>
            <dl class="public-evidence-viewer__facts">
                <div><dt>@T["Player"]</dt><dd data-evidence-dialog-player>—</dd></div>
                <div><dt>@T["Team"]</dt><dd data-evidence-dialog-team>—</dd></div>
                <div><dt>@T["Source"]</dt><dd data-evidence-dialog-source>@T["Recent drops"]</dd></div>
            </dl>
        </aside>
    </div>
</dialog>
@section Scripts {
    <partial name="_PublicProgressScripts" model="Model.Board.EventId" />
    <script src="~/js/captain-evidence-input.js" asp-append-version="true"></script>
    <script src="~/js/team-board-drawer.js" asp-append-version="true"></script>
    <script src="~/js/public-evidence.js" asp-append-version="true"></script>
}
