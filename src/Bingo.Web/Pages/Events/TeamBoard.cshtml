@page "/Events/{slug}/Board/{teamSlug}"
@model Bingo.Web.Pages.Events.TeamBoardModel
@using Bingo.Web.Catalogue
@inject OsrsWikiImageCache WikiImages
@{
    ViewData["Title"] = $"{Model.Team.TeamName} · {Model.Board.EventName}";
    var totalTiles = Model.Board.Rows * Model.Board.Columns;
    var completedLines = Model.Team.Progress.CompletedRows.Count + Model.Team.Progress.CompletedColumns.Count;
    var completionPercent = totalTiles == 0 ? 0 : Model.Team.Progress.CompletedTiles * 100 / totalTiles;
    var publicContributors = Model.Team.Progress.Players
        .OrderByDescending(player => player.EstimatedEhb)
        .ThenByDescending(player => player.ApprovedContribution)
        .ThenBy(player => player.PlayerName)
        .ToList();
    var dropMvp = publicContributors.FirstOrDefault();
    var overlayMode = string.Equals(ViewContext.HttpContext.Request.Query["overlay"], "true", StringComparison.OrdinalIgnoreCase);
    ViewData["OverlayMode"] = overlayMode;
    if (overlayMode) { ViewData["BodyClass"] = "public-event-shell team-board-overlay-document"; }
}
@if (!overlayMode)
{
    <script src="~/js/team-board-overlay-redirect.js" asp-append-version="true"
            data-overview-url="@Url.Page("/Events/Board", new { slug = Model.Board.EventSlug })"></script>
}
<section class="public-team-board" data-progress-event="@Model.Board.EventId"
         style="--public-board-columns:@Model.Board.Columns">
    @if (!overlayMode)
    {
    <header class="public-team-masthead">
        <a class="public-team-back" asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug"
           asp-route-transitionTeam="@Model.Team.TeamId.ToString("N")">← @T["View all teams"]</a>
        <div class="public-team-heading">
            <div class="rank-medallion rank-@Math.Min(Model.Team.Rank, 4)">#@Model.Team.Rank</div>
            <div>
                <p class="feature-kicker">@Model.Board.EventName</p>
                <h1>@Model.Team.TeamName</h1>
                <p>
                    @if (!string.IsNullOrWhiteSpace(Model.Team.Affiliation)) { <span>@Model.Team.Affiliation · </span> }
                    <span>@T["{0} of {1} tiles complete", Model.Team.Progress.CompletedTiles, totalTiles]</span>
                </p>
            </div>
            @if (Model.Team.ProvisionalWinner) { <strong class="winner-label">@T["Provisional winner"]</strong> }
        </div>
    </header>
    }

    <div class="progress-update" data-progress-update hidden role="status">@T["New approved progress is available."] <button type="button" data-progress-refresh>@T["Refresh now"]</button></div>

    <div class="public-team-workspace">
        <aside class="public-team-sidebar panel" aria-label="@T["Team statistics"]">
            <section class="team-sidebar-section team-progress-section">
                <header><span class="feature-kicker">@T["Bingo progress"]</span><strong>@completionPercent%</strong></header>
                <div class="team-progress-meter" aria-label="@T["{0} percent complete", completionPercent]"><span style="width:@completionPercent%"></span></div>
                <dl class="team-progress-stats">
                    <div><dt>@T["Tiles"]</dt><dd>@Model.Team.Progress.CompletedTiles/@totalTiles</dd></div>
                    <div><dt>@T["Rows"]</dt><dd>@completedLines</dd></div>
                </dl>
            </section>

            <section class="team-sidebar-section team-ehb-section">
                <header><span class="feature-kicker">@T["Drop EHB"]</span></header>
                <div class="team-metric-source">
                    <span class="team-mvp-mark" aria-hidden="true">◆</span>
                    <span><strong>@T["Approved bingo progress"]</strong><small>@T["Combined expected tile effort"]</small></span>
                </div>
                <div class="team-metric-values">
                    <span><small>@T["Team total"]</small><strong>@Model.Team.Progress.EhbTiebreak.ToString("N0")</strong></span>
                    <span>
                        <small>@T["Team MVP"]</small>
                        @if (dropMvp is not null)
                        {
                            <strong>@dropMvp.PlayerName</strong><b>@dropMvp.EstimatedEhb.ToString("N0") EHB</b>
                        }
                        else
                        {
                            <strong>—</strong>
                        }
                    </span>
                </div>
            </section>

            <section class="team-sidebar-section team-activity-section">
                <header><span class="feature-kicker">@T["Activity EHB"]</span></header>
                <div class="team-metric-source">
                    <span class="team-activity-mark" aria-hidden="true">↗</span>
                    <span><strong>@T["Wise Old Man"]</strong><small>@T["Awaiting event synchronization"]</small></span>
                </div>
                <div class="team-metric-values" aria-label="@T["Activity EHB is not available yet"]">
                    <span><small>@T["Team total"]</small><strong>—</strong></span>
                    <span><small>@T["Activity MVP"]</small><strong>—</strong></span>
                </div>
            </section>

            @if (publicContributors.Count > 1)
            {
                <section class="team-sidebar-section team-contributors-section">
                    <header><span class="feature-kicker">@T["Team contributions"]</span><small>@T["Drop EHB"]</small></header>
                    <ol class="auto-hide-scrollbar">
                        @for (var index = 0; index < publicContributors.Count; index++)
                        {
                            var player = publicContributors[index];
                            <li><span class="contributor-rank">@(index + 1)</span><strong>@player.PlayerName</strong><b>@player.EstimatedEhb.ToString("N0")</b></li>
                        }
                    </ol>
                </section>
            }
        </aside>

        <div class="public-board-scroll auto-hide-scrollbar" tabindex="0" aria-label="@T["{0} bingo board", Model.Team.TeamName]">
            <div class="public-full-board">
            @foreach (var tile in Model.Team.Tiles)
            {
                var progressPercent = tile.Target == 0 ? 0 : Math.Min(100, tile.Approved * 100 / tile.Target);
                var stateLabel = tile.Complete ? T["Complete"] : tile.Approved > 0 ? T["In progress"] : T["Not started"];
                <a class="public-tile panel @(tile.Complete ? "complete" : tile.Approved > 0 ? "in-progress" : null)"
                   aria-label="@T["{0}. {1}, {2} of {3}.", tile.Name, stateLabel, tile.Approved, tile.Target]"
                   asp-page="/Events/Tile" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Team.TeamSlug" asp-route-tileId="@tile.TileId">
                    <span class="public-tile-art" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(tile.ImageUrl))
                        {
                            <img class="custom-art" src="@WikiImages.GetPublicUrl(tile.ImageUrl)" alt="" loading="lazy" />
                        }
                        else if (tile.BossImageUrls.Count > 0)
                        {
                            <span class="boss-art-grid boss-art-count-@tile.BossImageUrls.Count">
                                @foreach (var imageUrl in tile.BossImageUrls)
                                {
                                    <img src="@WikiImages.GetPublicUrl(imageUrl)" alt="" loading="lazy" />
                                }
                            </span>
                        }
                        else
                        {
                            <span class="tile-art-placeholder">▦</span>
                        }
                    </span>
                    <span class="public-tile-shade" aria-hidden="true"></span>
                    <span class="public-tile-copy">
                        <span class="tile-position">R@(tile.Row + 1) · C@(tile.Column + 1)</span>
                        <strong>@tile.Name</strong>
                        <span class="public-tile-progress-row">
                            <span class="tile-progress" aria-hidden="true"><span style="width:@progressPercent%"></span></span>
                            <span>@tile.Approved/@tile.Target</span>
                        </span>
                    </span>
                </a>
            }
            </div>
        </div>
    </div>

    @if (!overlayMode)
    {
    <nav class="public-team-switcher" aria-label="@T["Switch team"]">
        @if (Model.Previous is not null)
        {
            <a asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Previous.TeamSlug"><small>@T["Previous team"]</small><strong>← #@Model.Previous.Rank @Model.Previous.TeamName</strong></a>
        }
        else { <span></span> }
        @if (Model.Next is not null)
        {
            <a class="next" asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@Model.Next.TeamSlug"><small>@T["Next team"]</small><strong>#@Model.Next.Rank @Model.Next.TeamName →</strong></a>
        }
    </nav>
    }
</section>
@section Scripts { <partial name="_PublicProgressScripts" model="Model.Board.EventId" /> }
