@page "/Events/{slug}/Signup/Confirmation"
@model Bingo.Web.Pages.Events.ConfirmationModel
@{
    ViewData["Title"] = T["Signup confirmed"];
}
<section class="content-page"><p class="eyebrow">@T["Signup received"]</p><h1>@Model.EventName</h1><div class="panel"><h2>@T[Model.Status]</h2>@if(Model.WaitingPosition is not null){<p>@T["You are currently number {0} on the waiting list.", Model.WaitingPosition]</p>}else{<p>@T["Your place is confirmed."]</p>}
@if(Model.EditToken is not null){<p>@T["Save this private link if you need to correct your signup:"]</p><p class="private-link"><a href="/Events/@RouteData.Values["slug"]/Signup/Edit/@Model.EditToken">@T["Edit my signup"]</a></p><p class="form-hint">@T["Anyone with this link can edit your signup. Do not share it publicly."]</p>}</div></section>
