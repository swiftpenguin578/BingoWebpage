                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </details>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        }
                                    </table>
                                </div>
                            </div>
                            <div id="public-leaderboard-drops" data-public-leaderboard-panel="drops" aria-labelledby="public-leaderboard-drops-link" hidden="@(Model.ActiveRanking == "drops" ? null : "hidden")">
