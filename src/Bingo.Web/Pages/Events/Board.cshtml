@page "/Events/{slug}/Board"
@model Bingo.Web.Pages.Events.BoardModel
@using Bingo.Domain.Events
@{
    ViewData["Title"] = T["{0} board", Model.Board.EventName];
    ViewData["HideBreadcrumbs"] = true;
    ViewData["CompactNavigation"] = true;
    ViewData["BodyClass"] = "public-event-shell";
    var totalTiles = Model.Board.Rows * Model.Board.Columns;
    var isMission = Model.ActiveView == "mission";
    var isDrops = Model.ActiveView == "drops";
    var isLeaderboards = Model.ActiveView == "leaderboards";
    var activityStateText = Model.Activity.State switch
    {
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.NotConfigured => T["Activity tracking is not configured."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.WaitingForFirstSync => T["Waiting for the first Wise Old Man sync."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Partial => T["Activity is provisional: {0} of {1} current accounts matched.", Model.Activity.MatchedAccountCount, Model.Activity.ExpectedAccountCount],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Incomplete => T["Activity rankings are unavailable until the current account set is synchronized."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Stale => T["Cached activity is stale."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.TemporarilyUnavailable => Model.Activity.HasRankings
            ? T["Wise Old Man is temporarily unavailable. Showing the last available cache."]
            : T["Wise Old Man is temporarily unavailable."],
        _ => T["Activity cache is current."]
    };
}

<section class="public-event-dashboard" data-progress-event="@Model.Board.EventId">
    <div class="public-dashboard-masthead">
        <header class="public-dashboard-hero">
            <div class="public-event-mark" aria-hidden="true">▦</div>
            <div class="public-dashboard-title">
                <h1>@Model.Board.EventName</h1>
                <p><span class="event-status-dot"></span>@Model.Board.EventState <span aria-hidden="true">·</span> @T["Bingo"] <span aria-hidden="true">·</span> @T["{0} teams", Model.Board.Teams.Count]</p>
            </div>
        </header>

        <nav class="public-dashboard-tabs auto-hide-scrollbar" aria-label="@T["Bingo views"]">
            <a class="@(isMission ? "active" : null)" aria-current="@(isMission ? "page" : null)"
               asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug">
                @T["View bingo"]
            </a>
            <a class="@(isDrops ? "active" : null)" aria-current="@(isDrops ? "page" : null)"
               asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="drops">
                @T["Recent drops"]
            </a>
            <a class="@(isLeaderboards ? "active" : null)" aria-current="@(isLeaderboards ? "page" : null)"
               asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="leaderboards">
                @T["Leaderboards"]
            </a>
        </nav>
    </div>

    <div class="progress-update" data-progress-update hidden role="status">
        @T["New approved progress is available."] <button type="button" data-progress-refresh>@T["Refresh now"]</button>
    </div>

    @if (isMission)
    {
        <section class="public-dashboard-view mission-control-view" aria-label="Team bingo boards">
            <div class="mission-grid" aria-label="Team board overview">
                @foreach (var team in Model.Board.Teams)
                {
                    var lineCount = team.Progress.CompletedRows.Count + team.Progress.CompletedColumns.Count;
                    var completion = totalTiles == 0 ? 0 : team.Progress.CompletedTiles * 100 / totalTiles;
                    <a class="mission-team-card panel @(team.ProvisionalWinner ? "provisional-winner" : null)"
                       asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@team.TeamSlug">
                        <header>
                            <span class="rank-medallion rank-@team.Rank">#@team.Rank</span>
                            <span class="mission-team-identity">
                                <strong>@team.TeamName</strong>
                            </span>
                        </header>
                        <div class="mini-board"
                             style="--public-board-columns:@Model.Board.Columns; --public-board-rows:@Model.Board.Rows"
                             aria-label="@team.TeamName board, @team.Progress.CompletedTiles of @totalTiles tiles completed">
                            @foreach (var tile in team.Tiles)
                            {
                                <span class="mini-tile @(tile.Complete ? "complete" : tile.Approved > 0 ? "in-progress" : null)" title="@tile.Name: @tile.Approved/@tile.Target">
                                    <span class="visually-hidden">@tile.Name @tile.Approved of @tile.Target</span>
                                </span>
                            }
                        </div>
                        <div class="mission-completion" aria-label="@completion percent complete"><span style="width:@completion%"></span></div>
                        <footer>
                            <span><strong>@team.Progress.CompletedTiles/@totalTiles</strong> @T["tiles"]</span>
                            <span><strong>@lineCount</strong> @(lineCount == 1 ? "row" : "rows")</span>
                            <span title="@T["Estimated Drop EHB from approved contributions"]"><strong>@team.Progress.EhbTiebreak.ToString("N0")</strong> @T["Drop EHB"]</span>
                        </footer>
                    </a>
                }
            </div>
        </section>
    }
    else if (isDrops)
    {
        <section class="public-dashboard-view recent-drops-view" aria-labelledby="drops-heading">
            <header class="public-view-heading">
                <div><p class="eyebrow">@T["Approved moments"]</p><h2 id="drops-heading">@T["Recent drops"]</h2></div>
                <p>@T["The newest approved contributions across every team."]</p>
            </header>
            @if (Model.Board.RecentDrops.Count == 0)
            {
                <div class="public-feature-empty panel"><span aria-hidden="true">◇</span><h3>@T["The feed is waiting for its first drop"]</h3><p>@T["Approved public evidence will appear here as the event unfolds."]</p></div>
            }
            else
            {
                <div class="recent-drop-grid">
                    @foreach (var drop in Model.Board.RecentDrops)
                    {
                        <article class="recent-drop-card panel">
                            @if (drop.EvidenceAssetId is Guid assetId)
                            {
                                <button type="button" class="recent-drop-image evidence-image-button" data-evidence-image="/Evidence/@assetId" data-evidence-alt="Approved evidence from @drop.PlayerName">
                                    <img src="/Evidence/@assetId" alt="Approved evidence from @drop.PlayerName" loading="lazy" />
                                </button>
                            }
                            else
                            {
                                <div class="recent-drop-placeholder" aria-hidden="true">◆</div>
                            }
                            <div class="recent-drop-copy">
                                <span class="recent-drop-team">@drop.TeamName</span>
                                <h3>@(drop.DropName ?? drop.TileName)</h3>
                                <p>@if (!string.IsNullOrWhiteSpace(drop.PlayerName)) { <strong>@drop.PlayerName</strong><text> · </text> }@drop.TileName</p>
                                <footer><span>@T["Counts for {0}", drop.Contribution]</span><time datetime="@drop.ApprovedAt.ToString("O")">@drop.ApprovedAt.ToString("d MMM, HH:mm")</time></footer>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else
    {
        <section class="public-dashboard-view leaderboards-view" aria-labelledby="leaderboards-heading">
            <header class="public-view-heading">
                <div><p class="eyebrow">@T["Performance"]</p><h2 id="leaderboards-heading">@T["Leaderboards"]</h2></div>
                <p>@T["Official bingo position stays visible while you explore player performance."]</p>
            </header>
            <div class="public-leaderboard-layout">
                <main class="performance-leaderboard panel">
                    <nav class="performance-tabs" aria-label="@T["EHB leaderboard"]">
                        <a class="@(Model.ActiveRanking == "drops" ? "active" : null)" aria-current="@(Model.ActiveRanking == "drops" ? "page" : null)"
                           asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="leaderboards" asp-route-ranking="drops">@T["Drop EHB"]</a>
                        <a class="@(Model.ActiveRanking == "activity" ? "active" : null)" aria-current="@(Model.ActiveRanking == "activity" ? "page" : null)"
                           asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="leaderboards" asp-route-ranking="activity">@T["Activity EHB"]</a>
                    </nav>
                    @if (Model.ActiveRanking == "activity")
                    {
                        <div class="activity-ehb-preview" data-activity-state="@Model.Activity.State">
                            <span class="feature-kicker">@T["Wise Old Man integration"]</span>
                            <h3>@T["Activity EHB"]</h3>
                            <p>@activityStateText</p>
                            @if (Model.Activity.FetchedAt is { } fetchedAt)
                            {
                                <p class="form-hint">@T["Fetched from Wise Old Man"]: <time datetime="@fetchedAt.ToUniversalTime().ToString("O")">@fetchedAt.ToLocalTime().ToString("g")</time></p>
                            }
                            @if (Model.Activity.HasRankings &&
                                 Model.Activity.MatchedAccountCount < Model.Activity.ExpectedAccountCount &&
                                 (Model.Activity.State == Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Partial ||
                                  Model.Activity.State == Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.TemporarilyUnavailable))
                            {
                                <p class="form-hint">@T["Provisional coverage"]: @Model.Activity.MatchedAccountCount/@Model.Activity.ExpectedAccountCount @T["current accounts matched"]</p>
                            }
                            @if (!Model.Activity.HasRankings)
                            {
                                <div class="activity-preview-table" aria-label="@T["Activity EHB status"]">
                                    <span>@T["Rankings"]</span><strong>@T["No matched current activity is available yet"]</strong>
                                </div>
                            }
                            else
                            {
                                <div class="activity-preview-table" role="table" aria-label="@T["Activity EHB leaderboard"]">
                                    <span role="columnheader">@T["Rank"]</span><span role="columnheader">@T["Team"]</span><span role="columnheader">@T["Total gained"]</span><span role="columnheader">@T["Average / participant"]</span><span role="columnheader">@T["MVP"]</span>
                                    @foreach (var team in Model.Board.Teams.OrderBy(value => value.Rank))
                                    {
                                        var activityTeam = Model.Activity.Teams.SingleOrDefault(value => value.TeamId == team.TeamId);
                                        if (activityTeam is null) { continue; }
                                        <span role="cell">#@activityTeam.Rank</span><strong role="cell">@activityTeam.TeamName</strong><span role="cell">@activityTeam.TotalGainedEhb.ToString("N2")</span><span role="cell">@activityTeam.AverageGainedEhb.ToString("N2")</span><span role="cell">@string.Join(", ", activityTeam.MvpNames)</span>
                                        <details class="activity-participant-breakdown">
                                            <summary>@T["Participant and account breakdown"]</summary>
                                            @foreach (var participant in activityTeam.Participants)
                                            {
                                                <div class="activity-participant-row"><strong>@participant.ParticipantName</strong><b>@participant.TotalGainedEhb.ToString("N2") EHB</b><span>@participant.MatchedAccountCount/@participant.ExpectedAccountCount @T["accounts matched"] · @string.Join(" · ", participant.Accounts.Select(account => $"{account.CharacterName}: {account.GainedEhb:N2}"))</span></div>
                                            }
                                        </details>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (Model.Board.PlayerLeaderboard.Count == 0)
                    {
                        <div class="public-feature-empty"><span aria-hidden="true">◇</span><h3>@T["No public player contributions yet"]</h3><p>@T["Drop EHB appears after evidence is approved and the credited player is public."]</p></div>
                    }
                    else
                    {
                        <header class="leaderboard-table-heading"><div><span class="feature-kicker">@T["Approved contributions"]</span><h3>@T["Player drop EHB"]</h3></div><span>@T["Private players excluded"]</span></header>
                        <div class="public-ranking-list" role="table" aria-label="@T["Player drop EHB leaderboard"]">
                            <div class="public-ranking-row heading" role="row"><span role="columnheader">@T["Rank"]</span><span role="columnheader">@T["Player"]</span><span role="columnheader">@T["Team"]</span><span role="columnheader">@T["Drop EHB"]</span><span role="columnheader">@T["Approvals"]</span></div>
                            @foreach (var player in Model.Board.PlayerLeaderboard)
                            {
                                <div class="public-ranking-row" role="row"><span role="cell" class="ranking-number">#@player.Rank</span><strong role="cell">@player.PlayerName</strong><span role="cell">@player.TeamName</span><span role="cell" class="ranking-value">@player.EstimatedEhb.ToString("N0")</span><span role="cell">@player.ApprovedSubmissions</span></div>
                            }
                        </div>
                    }
                </main>
                <aside class="bingo-standings panel" aria-labelledby="standings-heading">
                    <header><span class="feature-kicker">@T["Always live"]</span><h3 id="standings-heading">@T["Bingo standings"]</h3></header>
                    <ol>
                        @foreach (var team in Model.Board.Teams.OrderBy(value => value.Rank))
                        {
                            var lines = team.Progress.CompletedRows.Count + team.Progress.CompletedColumns.Count;
                            <li class="@(team.Rank == 1 ? "leader" : null)">
                                <span class="standings-rank">@team.Rank</span>
                                <span><strong>@team.TeamName</strong><small>@lines @(lines == 1 ? T["row"] : T["rows"]) · @team.Progress.CompletedTiles/@totalTiles @T["tiles"]</small></span>
                                <strong>@team.Progress.EhbTiebreak.ToString("N0")</strong>
                            </li>
                        }
                    </ol>
                </aside>
            </div>
        </section>
    }
</section>

@if (isMission)
{
    <dialog class="team-board-overlay" data-team-board-overlay aria-label="@T["Team board"]">
        <button type="button" class="team-board-overlay-close" data-team-board-overlay-close aria-label="@T["Close team board"]">×</button>
        <div class="team-board-overlay-content auto-hide-scrollbar" data-team-board-overlay-content></div>
    </dialog>
}

<dialog class="public-lightbox" data-public-lightbox data-evidence-dialog data-enlarged-evidence="@T["Enlarged approved evidence"]"><button type="button" data-evidence-close aria-label="@T["Close enlarged evidence"]">×</button><img data-evidence-dialog-image alt="" /></dialog>

@section Scripts {
    <partial name="_PublicProgressScripts" model="Model.Board.EventId" />
    @if (isMission)
    {
        <script src="~/js/public-evidence.js" asp-append-version="true"></script>
        <script src="~/js/captain-evidence-input.js" asp-append-version="true"></script>
        <script src="~/js/team-board-overlay.js" asp-append-version="true"></script>
    }
    @if (isDrops) { <script src="~/js/public-evidence.js" asp-append-version="true"></script> }
}
