                                                            <summary class="public-ui-leaderboard-detail-summary"><span class="public-ui-supporting-text">@T["Show {0} details", team.TeamName]</span></summary>
                                                                <table class="public-ui-table public-ui-table--nested public-ui-table--nested-drop-ehb" data-public-leaderboard-sort-table aria-label="@T["{0} player details", team.TeamName]">
                                                                    <thead><tr><th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="rank" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Rank"]" aria-label="@T["Sort by Rank"]"><span>@T["Rank"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th><th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="player" data-public-leaderboard-sort-type="text" data-public-leaderboard-sort-label="@T["Player"]" aria-label="@T["Sort by Player"]"><span>@T["Player"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th><th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="drop-ehb" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Drop EHB"]" aria-label="@T["Sort by Drop EHB"]"><span>@T["Drop EHB"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th><th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="total-drops" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Total drops"]" aria-label="@T["Sort by Total drops"]"><span>@T["Total drops"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th><th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="team-share" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Team share"]" aria-label="@T["Sort by Team share"]"><span>@T["Team share"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th><th class="public-ui-supporting-text" scope="col">@T["Drops"]</th></tr></thead>
                                                                    <tbody>
                                                                    @for (var playerIndex = 0; playerIndex < team.Players.Count; playerIndex++)
                                                                    {
                                                                        var player = team.Players[playerIndex];
                                                                        var playingAccountNames = player.PlayingAccountNames is { Count: > 0 } ? player.PlayingAccountNames : [player.PlayerName];
                                                                        var primaryAccountName = playingAccountNames[0];
                                                                        var dropSearch = string.Join(" + ", playingAccountNames);
                                                                        var teamShareValue = team.TotalDrops == 0 ? 0m : player.ApprovedSubmissions / (decimal)team.TotalDrops * 100m;
                                                                        var teamShare = team.TotalDrops == 0 ? "—" : $"{teamShareValue:0.0}%";
                                                                        <tr data-public-leaderboard-sort-row data-sort-rank="@(player.ApprovedSubmissions > 0 ? (playerIndex + 1).ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" data-sort-player="@primaryAccountName" data-sort-drop-ehb="@(player.ApprovedSubmissions > 0 ? player.DropEhb.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" data-sort-total-drops="@player.ApprovedSubmissions" data-sort-team-share="@teamShareValue.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                                            <td><strong class="public-ui-section-heading">@(player.ApprovedSubmissions > 0 ? (playerIndex + 1).ToString("00") : "—")</strong></td>
                                                                            <td><strong class="public-ui-section-heading">@primaryAccountName</strong>@if (playingAccountNames.Count > 1) { <small class="public-ui-supporting-text public-ui-leaderboard-detail-secondary">@string.Join(" · ", playingAccountNames.Skip(1))</small> }</td>
                                                                            <td><strong class="public-ui-section-heading @(player.ApprovedSubmissions > 0 ? "public-ui-positive-delta--success" : null)">@(player.ApprovedSubmissions > 0 ? player.DropEhb.ToString("+0.00;-0.00;0.00") : "—")</strong></td>
                                                                            <td><strong class="public-ui-section-heading">@player.ApprovedSubmissions</strong></td>
                                                                            <td><strong class="public-ui-section-heading">@teamShare</strong></td>
                                                                            <td><a class="public-ui-action public-ui-action--text public-ui-action--hyperlink" asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="drops" asp-route-dropSearch="@dropSearch">@T["Drops"]</a></td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </details>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                    <section id="public-leaderboard-players" data-public-leaderboard-panel="players" aria-labelledby="public-leaderboard-players-heading" hidden="@(Model.ActiveRanking == "players" ? null : "hidden")">
                        <div class="public-ui-section">
                            <table class="public-ui-table public-ui-table--players" data-public-leaderboard-table data-public-leaderboard-sort-table data-public-leaderboard-players-table aria-label="@T["Players leaderboard"]">
                                <thead>
                                    <tr>
                                        <th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="rank" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Rank"]" aria-label="@T["Sort by Rank"]"><span>@T["Rank"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th>
                                        <th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="player" data-public-leaderboard-sort-type="text" data-public-leaderboard-sort-label="@T["Player"]" aria-label="@T["Sort by Player"]"><span>@T["Player"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th>
                                        <th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="team" data-public-leaderboard-sort-type="text" data-public-leaderboard-sort-label="@T["Team"]" aria-label="@T["Sort by Team"]"><span>@T["Team"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th>
                                        <th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="ehb-gained" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["EHB gained"]" aria-label="@T["Sort by EHB gained"]"><span>@T["EHB gained"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th>
                                        <th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="drop-ehb" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Drop EHB"]" aria-label="@T["Sort by Drop EHB"]"><span>@T["Drop EHB"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th>
                                        <th class="public-ui-supporting-text" scope="col" aria-sort="none"><button type="button" class="public-ui-table-sort-control" data-public-leaderboard-sort-control data-public-leaderboard-sort-key="total-drops" data-public-leaderboard-sort-type="number" data-public-leaderboard-sort-label="@T["Total drops"]" aria-label="@T["Sort by Total drops"]"><span>@T["Total drops"]</span><svg class="public-ui-table-sort-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></button></th>
                                        <th class="public-ui-supporting-text" scope="col">@T["WOM"]</th>
                                    </tr>
                                </thead>
                                @if (Model.Players.Count == 0)
                                {
                                    <tbody><tr><td colspan="7"><strong class="public-ui-supporting-text">@T["No activity players are available yet"]</strong></td></tr></tbody>
                                }
                                else
                                {
                                    <tbody>
                                        @foreach (var player in Model.Players)
                                        {
                                            var participant = player.Participant;
                                            var playingAccountNames = participant.PlayingAccountNames is { Count: > 0 } ? participant.PlayingAccountNames : [participant.ParticipantName];
                                            var accountActivities = participant.Accounts.ToDictionary(value => value.CharacterName, StringComparer.OrdinalIgnoreCase);
                                            var primaryAccountName = playingAccountNames[0];
                                            <tr data-public-leaderboard-sort-row data-sort-rank="@(player.HasActivity ? player.Rank.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" data-sort-player="@primaryAccountName" data-sort-team="@player.TeamName" data-sort-ehb-gained="@(player.HasActivity ? participant.TotalGainedEhb.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" data-sort-drop-ehb="@(player.TotalDrops > 0 ? player.DropEhb.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)" data-sort-total-drops="@player.TotalDrops">
                                                <td><strong class="public-ui-section-heading">@(player.HasActivity ? player.Rank.ToString("00") : "—")</strong></td>
                                                <td>
                                                    @for (var accountIndex = 0; accountIndex < playingAccountNames.Count; accountIndex++)
                                                    {
                                                        var account = accountActivities.GetValueOrDefault(playingAccountNames[accountIndex]);
                                                        var gainedEhb = account?.GainedEhb.ToString("+0.00;-0.00;0.00") ?? "—";
                                                        var startEhb = account?.StartEhb is { } startValue ? startValue.ToString("0.00;-0.00;0.00") : "—";
                                                        var endEhb = account?.EndEhb is { } endValue ? endValue.ToString("0.00;-0.00;0.00") : "—";
                                                        if (accountIndex == 0) { <strong class="public-ui-section-heading">@playingAccountNames[accountIndex]</strong> }
                                                        else { <small class="public-ui-supporting-text public-ui-leaderboard-detail-secondary">@playingAccountNames[accountIndex]</small> }
                                                    }
                                                </td>
                                                <td><strong class="public-ui-section-heading">@player.TeamName</strong></td>
                                                <td>
                                                    @for (var accountIndex = 0; accountIndex < playingAccountNames.Count; accountIndex++)
                                                    {
                                                        var account = accountActivities.GetValueOrDefault(playingAccountNames[accountIndex]);
                                                        var gainedEhb = account?.GainedEhb.ToString("+0.00;-0.00;0.00") ?? "—";
                                                        if (accountIndex == 0) { <strong class="public-ui-section-heading @(player.HasActivity ? "public-ui-positive-delta--success" : null)">@gainedEhb</strong> }
                                                        else { <small class="public-ui-supporting-text @(player.HasActivity ? "public-ui-positive-delta--success" : null) public-ui-leaderboard-detail-secondary">@gainedEhb</small> }
                                                    }
                                                </td>
                                                <td><strong class="public-ui-section-heading @(player.TotalDrops > 0 ? "public-ui-positive-delta--success" : null)">@(player.TotalDrops > 0 ? player.DropEhb.ToString("+0.00;-0.00;0.00") : "—")</strong></td>
                                                <td><strong class="public-ui-section-heading">@player.TotalDrops</strong></td>
                                                <td><small class="public-ui-supporting-text">@for (var accountIndex = 0; accountIndex < playingAccountNames.Count; accountIndex++) { var accountName = playingAccountNames[accountIndex]; var womUrl = eventStart is not null && eventEnd is not null ? $"https://wiseoldman.net/players/{Uri.EscapeDataString(accountName)}/gained?metric=ehb&startDate={Uri.EscapeDataString(eventStart)}&endDate={Uri.EscapeDataString(eventEnd)}" : $"https://wiseoldman.net/players/{Uri.EscapeDataString(accountName)}"; if (accountIndex > 0) { <span aria-hidden="true"> · </span> } <a class="public-ui-action public-ui-action--text public-ui-action--hyperlink" href="@womUrl" target="_blank" rel="noopener noreferrer">@accountName</a> }</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                            </table>
                            <nav class="public-ui-leaderboard-pagination" data-public-leaderboard-pagination hidden aria-label="@T["Players pages"]">
                                <span class="public-ui-supporting-text" data-public-leaderboard-page-label>@T["Page {0} of {1}", 1, 1]</span>
                                <span class="public-ui-leaderboard-pagination-controls">
                                    <button type="button" class="public-ui-leaderboard-pagination-control" data-public-leaderboard-page-control="first" aria-label="@T["First page"]" aria-disabled="true" disabled><svg class="public-ui-leaderboard-pagination-icon public-ui-leaderboard-pagination-icon--first" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 6v12" /><path d="m15 6-6 6 6 6" /></svg></button>
                                    <button type="button" class="public-ui-leaderboard-pagination-control" data-public-leaderboard-page-control="previous" aria-label="@T["Previous page"]" aria-disabled="true" disabled><svg class="public-ui-leaderboard-pagination-icon public-ui-leaderboard-pagination-icon--previous" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m15 6-6 6 6 6" /></svg></button>
                                    <button type="button" class="public-ui-leaderboard-pagination-control" data-public-leaderboard-page-control="next" aria-label="@T["Next page"]" aria-disabled="false"><svg class="public-ui-leaderboard-pagination-icon public-ui-leaderboard-pagination-icon--next" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg></button>
                                    <button type="button" class="public-ui-leaderboard-pagination-control" data-public-leaderboard-page-control="last" aria-label="@T["Last page"]" aria-disabled="false"><svg class="public-ui-leaderboard-pagination-icon public-ui-leaderboard-pagination-icon--last" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m9 6 6 6-6 6" /><path d="M20 6v12" /></svg></button>
                                </span>
                            </nav>
                        </div>
                    </section>
                    </div>
                    </section>
                </div>
                <div class="public-ui-leaderboards-sidebar public-ui-recent-drops-sidebar public-ui-recent-drops-sidebar--flush">
                <section class="public-ui-standings public-ui-surface public-ui-surface--charcoal" aria-labelledby="standings-heading">
                        <div class="public-ui-surface-content">
                            <header class="public-ui-component-header public-ui-leaderboards-sidebar-header">
                                <div class="public-ui-component-header__copy">
                                    <button type="button" class="public-ui-leaderboards-rail-toggle" data-public-leaderboards-rail-toggle aria-expanded="true" aria-controls="public-leaderboards-rail-body" aria-label="@T["Collapse Bingo standings"]" data-expanded-label="@T["Collapse Bingo standings"]" data-collapsed-label="@T["Expand Bingo standings"]">
                                        <strong id="standings-heading" class="public-ui-component-title">@T["Bingo standings"]</strong>
                                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"><path d="m10 8 4 4-4 4" /></svg>
                                    </button>
                                </div>
                            </header>
                            <div id="public-leaderboards-rail-body" data-public-leaderboards-rail-body>
                            <ol>
                                @foreach (var team in Model.Board.Teams.OrderBy(value => value.Rank))
                                {
                                    var lines = team.Progress.CompletedRows.Count + team.Progress.CompletedColumns.Count;
                                    var activityTeam = activityTeamsById.GetValueOrDefault(team.TeamId);
                                    var dropEhbTeam = dropEhbTeamsById.GetValueOrDefault(team.TeamId);
                                    var hasActivityMetric = activityTeam is not null && activityTeam.Participants.Count > 0;
                                    var activityMetricClass = hasActivityMetric ? "public-ui-section-heading public-ui-positive-delta--success" : "public-ui-section-heading";
                                    var dropEhbMetricClass = dropEhbTeam is null ? "public-ui-section-heading" : "public-ui-section-heading public-ui-positive-delta--success";
                                    <li>
                                        <strong class="public-ui-data-value">@team.Rank.ToString("00")</strong>
                                        <div>
                                            <strong class="public-ui-section-heading">@team.TeamName</strong>
                                            <small class="public-ui-supporting-text">@lines @(lines == 1 ? T["row"] : T["rows"]) · @team.Progress.CompletedTiles/@totalTiles @T["Tiles"]</small>
                                        </div>
                                        <strong data-public-leaderboard-standings-metric="activity" class="@activityMetricClass" hidden="@(Model.ActiveRanking == "activity" ? null : "hidden")">@(hasActivityMetric ? $"{activityTeam!.TotalGainedEhb.ToString("+0.00;-0.00;0.00")} EHB" : "— EHB")</strong>
                                        <strong data-public-leaderboard-standings-metric="drops" class="@dropEhbMetricClass" hidden="@(Model.ActiveRanking == "drops" ? null : "hidden")">@(dropEhbTeam is null ? "— DEHB" : $"{dropEhbTeam.DropEhb.ToString("+0.00;-0.00;0.00")} DEHB")</strong>
                                    </li>
                                }
                            </ol>
                            </div>
                        </div>
                </section>
                </div>
            </div>
        </section>
    }
</section>

<dialog class="public-lightbox public-evidence-viewer" data-public-lightbox data-evidence-dialog data-evidence-empty="@T["Evidence"]" data-evidence-default-source="@T["Recent drops"]" data-enlarged-evidence="@T["Enlarged approved evidence"]">
    <button type="button" class="public-ui-viewport-close" data-evidence-close aria-label="@T["Close enlarged evidence"]"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    <div class="public-evidence-viewer__layout">
        <figure class="public-evidence-viewer__figure">
            <div class="public-evidence-viewer__viewport" data-evidence-viewport><img data-evidence-dialog-image alt="" tabindex="0" /></div>
        </figure>
        <aside class="public-evidence-viewer__meta" aria-label="@T["Evidence details"]">
            <span class="public-ui-overline">@T["Approved evidence"]</span>
            <strong class="public-ui-component-title" data-evidence-dialog-drop>@T["Evidence"]</strong>
            <dl class="public-evidence-viewer__facts">
                <div><dt>@T["Player"]</dt><dd data-evidence-dialog-player>—</dd></div>
                <div><dt>@T["Team"]</dt><dd data-evidence-dialog-team>—</dd></div>
                <div><dt>@T["Source"]</dt><dd data-evidence-dialog-source>@T["Recent drops"]</dd></div>
            </dl>
        </aside>
    </div>
</dialog>

@section Scripts {
    @if (Model.Board.EventEndsAt is not null)
    {
        <script src="~/js/public-countdown.js" asp-append-version="true"></script>
    }
    <partial name="_PublicProgressScripts" model="Model.Board.EventId" />
    @if (isMission || isDrops)
    {
        <script src="~/js/public-evidence.js" asp-append-version="true"></script>
    }
    @if (isDrops)
    {
        <script src="~/js/public-recent-drops.js" asp-append-version="true"></script>
    }
    <script src="~/js/public-leaderboards.js" asp-append-version="true"></script>
}
