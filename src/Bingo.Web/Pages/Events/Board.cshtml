@page "/Events/{slug}/Board"
@model Bingo.Web.Pages.Events.BoardModel
@using Bingo.Application.Boards
@using Bingo.Domain.Events
@if (Model.Board.EventState == EventState.Cancelled)
{
    ViewData["Title"] = T["Event cancelled"];
    ViewData["PublicEventCancelled"] = true;
    ViewData["HideBreadcrumbs"] = true;
    <partial name="_EventCancelled" model="Model.Board.EventName" />
    return;
}
@{
    ViewData["Title"] = T["{0} board", Model.Board.EventName];
    ViewData["HideBreadcrumbs"] = true;
    ViewData["CompactNavigation"] = true;
    ViewData["BodyClass"] = "public-event-shell public-ui-pass1 public-board-page public-board-overview";
    var totalTiles = Model.Board.Rows * Model.Board.Columns;
    var eventStart = Model.Board.EventStartsAt?.ToUniversalTime().ToString("O");
    var eventEnd = Model.Board.EventEndsAt?.ToUniversalTime().ToString("O");
    var isMission = Model.ActiveView == "mission";
    var isDrops = Model.ActiveView == "drops";
    var isLeaderboards = Model.ActiveView == "leaderboards";
    var dropEhbTeams = Model.Board.DropEhbTeams ?? Array.Empty<PublicDropEhbTeam>();
    var activityTeamsById = Model.Activity.Teams.ToDictionary(value => value.TeamId);
    var dropEhbTeamsById = dropEhbTeams.ToDictionary(value => value.TeamId);
    var metricTeamsById = Model.MetricLeaderboard.Teams.ToDictionary(value => value.TeamId);
    var selectedMetricValue = Model.SelectedMetric ?? "default";
    var recentActivity = Model.Board.RecentDrops.Take(3).ToList();
    var activityStateText = Model.Activity.State switch
    {
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.NotConfigured => T["Activity tracking is not configured."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.WaitingForFirstSync => T["Waiting for the first Wise Old Man sync."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Partial => T["Activity is provisional: {0} of {1} current accounts matched.", Model.Activity.MatchedAccountCount, Model.Activity.ExpectedAccountCount],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Incomplete => T["Activity rankings are unavailable until the current account set is synchronized."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Stale => T["Cached activity is stale."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.TemporarilyUnavailable => Model.Activity.HasRankings
            ? T["Wise Old Man is temporarily unavailable. Showing the last available cache."]
            : T["Wise Old Man is temporarily unavailable."],
        _ => T["Activity cache is current."]
    };
    var elapsedNow = DateTimeOffset.UtcNow;

}

<section class="public-event-dashboard" data-progress-event="@Model.Board.EventId">
    <partial name="_EventMasthead" model="Model.Masthead" />

    @if (isMission)
    {
        <section class="public-dashboard-view mission-control-view" aria-label="@T["Team bingo boards"]">
            <div class="public-board-content-transition">
                <aside class="public-board-legend" aria-label="@T["Board state legend"]">
                    <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--complete" aria-hidden="true"></i>@T["Completed"]</span>
                    <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--progress" aria-hidden="true"></i>@T["In progress"]</span>
                    <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--remaining" aria-hidden="true"></i>@T["remaining"]</span>
                </aside>
            </div>
            <div class="mission-grid @(Model.Board.Teams.Count > 3 ? "mission-grid--wide-rows" : null) @(Model.Board.Teams.Count > 2 ? "mission-grid--constrained-rows" : null) @(Model.Board.Teams.Count > 1 ? "mission-grid--mobile-rows" : null)" aria-label="@T["Team board overview"]">
                @foreach (var (team, teamIndex) in Model.Board.Teams.Select((value, index) => (value, index)))
                {
                    var lineCount = team.Progress.CompletedRows.Count + team.Progress.CompletedColumns.Count;
                    var completion = totalTiles == 0 ? 0 : team.Progress.CompletedTiles * 100 / totalTiles;
                    var wideRowBoundary = ((teamIndex / 3) + 1) * 3 < Model.Board.Teams.Count;
                    var constrainedRowBoundary = ((teamIndex / 2) + 1) * 2 < Model.Board.Teams.Count;
                    var wideColumnDivider = teamIndex % 3 != 2;
                    var constrainedColumnDivider = teamIndex % 2 != 1;
                    <a class="mission-team-card public-ui-surface public-ui-surface--charcoal @(team.ProvisionalWinner ? "provisional-winner" : null) @(wideRowBoundary ? "mission-team-card--wide-boundary" : null) @(constrainedRowBoundary ? "mission-team-card--constrained-boundary" : null)"
                       asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@team.TeamSlug">
                        <div class="mission-card-rank-column">
                            @if (team.ProvisionalWinner)
                            {
                                <span class="mission-team-kicker">@T["In the lead"]</span>
                            }
                            <span class="mission-card-rank public-ui-section-heading rank-@team.Rank">@team.Rank.ToString("00")</span>
                        </div>
                        <div class="mission-card-content">
                            <div class="mission-card-board">
                                <div class="mission-card-title">
                                    <strong class="mission-team-name public-ui-section-heading" title="@team.TeamName">@team.TeamName</strong>
                                </div>
                                <div class="mini-board"
                                     style="--public-board-columns:@Model.Board.Columns; --public-board-rows:@Model.Board.Rows"
                                     aria-label="@team.TeamName board, @team.Progress.CompletedTiles of @totalTiles tiles completed">
                                    @foreach (var tile in team.Tiles)
                                    {
                                        <span class="public-ui-board-tile @(tile.Complete ? "is-finished" : tile.Approved > 0 ? "is-in-progress" : "is-not-started")" title="@tile.Name: @tile.Approved/@tile.Target">
                                            <span class="visually-hidden">@tile.Name @tile.Approved of @tile.Target</span>
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (wideColumnDivider || constrainedColumnDivider)
                            {
                                <span class="mission-card-column-divider @(wideColumnDivider ? "mission-card-column-divider--wide" : null) @(constrainedColumnDivider ? "mission-card-column-divider--constrained" : null)" aria-hidden="true"></span>
                            }
                            <footer class="mission-card-stats">
                                <span class="mission-stat mission-stat--completion"><strong class="public-ui-data-value">@completion%</strong></span>
                                <div class="mission-stat-details">
                                    <span class="mission-stat mission-stat--detail"><strong class="public-ui-data-value">@team.Progress.CompletedTiles / @totalTiles</strong> <span class="public-ui-supporting-text">@T["Tiles"]</span></span>
                                    <span class="mission-stat mission-stat--detail"><strong class="public-ui-data-value">@lineCount</strong> <span class="public-ui-supporting-text">@(lineCount == 1 ? T["row"] : T["rows"])</span></span>
                                    <span class="mission-stat mission-stat--detail" title="@T["Estimated Drop EHB from approved contributions"]"><strong class="public-ui-data-value">@team.Progress.EhbTiebreak.ToString("N0")</strong> <span class="public-ui-supporting-text">@T["Drop EHB"]</span></span>
                                </div>
                            </footer>
                        </div>
                        <div class="mission-completion" aria-label="@completion percent complete"><span class="public-ui-data-line" style="width:@completion%"></span></div>
                    </a>
                }
            </div>
            <section class="public-board-activity" aria-labelledby="public-board-activity-heading">
                <header class="public-board-activity__header">
                    <div class="public-board-activity__header-copy">
                        <h2 id="public-board-activity-heading">@T["Recent activity"]</h2>
                    </div>
                    <a class="public-ui-action public-ui-action--text public-ui-action--forward" asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="drops">@T["View all activity"]</a>
                </header>
                @if (recentActivity.Count == 0)
                {
                    <p class="public-board-activity__empty public-ui-supporting-text">@T["No approved activity yet"]</p>
                }
                else
                {
                    <div class="public-board-activity__items">
                        @foreach (var activity in recentActivity)
                        {
                            var activityPlayer = string.IsNullOrWhiteSpace(activity.PlayerName) ? T["Participant"] : activity.PlayerName;
                            var activityName = activity.DropName ?? activity.TileName;
                            <article class="public-board-activity__item" data-public-board-activity-submission-id="@activity.SubmissionId">
                                <span class="public-board-activity__marker" aria-hidden="true">✓</span>
                                <div class="public-board-activity__copy">
                                    <strong>@activityPlayer</strong>
                                    <span class="public-board-activity__drop">@activityName</span>
                                    <span class="public-board-activity__meta public-board-activity__team">@activity.TeamName</span>
                                    <span class="public-board-activity__meta public-board-activity__time">@BoardModel.FormatElapsed(activity.SubmittedAt, elapsedNow)</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </section>
    }
    else if (isDrops)
    {
        <section class="public-dashboard-view recent-drops-view" aria-label="@T["Recent drops"]">
            @{
                var recentDropStats = Model.Board.RecentDropSummary ?? new PublicRecentDropSummary(0, 0, 0, 0, 0, null, null);
                var lastHourCutoff = elapsedNow.AddHours(-1);
                var last24HoursCutoff = elapsedNow.AddHours(-24);
                var recentDropGroups = new[]
                {
                    (Key: "last-hour", Heading: T["Last hour"], HeadingId: "live-recent-drops-last-hour-heading", Drops: Model.Board.RecentDrops.Where(drop => drop.SubmittedAt >= lastHourCutoff).ToList()),
                    (Key: "last-24-hours", Heading: T["Last 24 hours"], HeadingId: "live-recent-drops-last-24-hours-heading", Drops: Model.Board.RecentDrops.Where(drop => drop.SubmittedAt < lastHourCutoff && drop.SubmittedAt >= last24HoursCutoff).ToList()),
                    (Key: "older", Heading: T["Older drops"], HeadingId: "live-recent-drops-older-heading", Drops: Model.Board.RecentDrops.Where(drop => drop.SubmittedAt < last24HoursCutoff).ToList())
                };
                var totalRecentDrops = recentDropStats.TotalDrops;
                var filteredRecentDropTotal = Model.Board.RecentDropFilteredTotal ?? totalRecentDrops;
                var hasDropFilters = Model.DropSearch is not null || Model.DropTeam is not null;
                var toolbarResultText = hasDropFilters ? $"{filteredRecentDropTotal} matches" : $"{filteredRecentDropTotal} drops";
                var visibleRecentDropCount = Model.Board.RecentDrops.Count;
                var hasMoreRecentDrops = visibleRecentDropCount < filteredRecentDropTotal;
                var showBackToLatest = visibleRecentDropCount > BoardModel.DefaultRecentDropCount;
                var nextRecentDropCount = hasMoreRecentDrops
                    ? Math.Min(filteredRecentDropTotal, visibleRecentDropCount + BoardModel.RecentDropPageSize)
                    : visibleRecentDropCount;
                var visibleRecentDropGroups = recentDropGroups.Where(group => group.Drops.Count > 0).ToList();
            }
            @if (Model.SelectedDrop is { } selectedDrop)
            {
                var selectedTitle = selectedDrop.DropName ?? selectedDrop.TileName;
                var selectedHeading = string.IsNullOrWhiteSpace(selectedDrop.BossName) ? selectedTitle : $"{selectedTitle} · {selectedDrop.BossName}";
                var selectedPlayer = string.IsNullOrWhiteSpace(selectedDrop.PlayerName) ? T["Participant"] : selectedDrop.PlayerName;
                @if (selectedDrop.EvidenceAssetId is Guid selectedAssetId)
                {
                    <a class="visually-hidden" data-evidence-image="/Evidence/@selectedAssetId" data-evidence-alt="@T["Approved evidence from {0}", selectedPlayer]" data-evidence-drop="@selectedHeading" data-evidence-player="@selectedPlayer" data-evidence-team="@selectedDrop.TeamName" data-evidence-source="@T["Recent drops"]" data-evidence-submission-id="@selectedDrop.SubmissionId" data-evidence-event-id="@Model.Board.EventId" data-evidence-open-on-load="true" href="/Evidence/@selectedAssetId">@T["Open approved evidence"]</a>
                }
            }
            <div class="public-ui-recent-drops-layout">
                @if (visibleRecentDropGroups.Count > 0)
                {
                    var firstRecentDropGroup = visibleRecentDropGroups[0];
                    <h3 id="@firstRecentDropGroup.HeadingId" class="public-ui-recent-drop-divider public-ui-recent-drops-shared-divider" data-public-recent-drops-first-divider data-public-recent-drops-group-heading="@firstRecentDropGroup.Key"><span>@firstRecentDropGroup.Heading</span></h3>
                }
                else
                {
                    <h3 id="live-recent-drops-empty-heading" class="public-ui-recent-drop-divider public-ui-recent-drops-shared-divider" data-public-recent-drops-first-divider data-public-recent-drops-group-heading=""><span>@T["Drops"]</span></h3>
                }
                @if (Model.NewDropCount > 0 && User.Identity?.IsAuthenticated == true)
                {
                    <button type="button" class="public-ui-action public-ui-action--text public-ui-action--compact public-ui-recent-drops-clear-new" data-drop-clear-all data-drop-event-id="@Model.Board.EventId">@T["Clear all new"]</button>
                }
                <div class="public-ui-recent-drops-main">
                <div id="recent-drops-latest" class="public-ui-recent-drop-region" data-public-recent-drops data-public-recent-drops-since="@Model.RecentDropsReconcileSince.ToUniversalTime().ToString("O")" data-new-label="@T["NEW"]" data-participant-label="@T["Participant"]" data-evidence-alt-template="@T["Approved evidence from {0}"]" data-just-now-label="@T["Just now"]" data-drops-label="@T["Drops"]" data-last-hour-label="@T["Last hour"]" data-last-24-hours-label="@T["Last 24 hours"]" data-older-drops-label="@T["Older drops"]" aria-live="polite" tabindex="-1">
                    @if (visibleRecentDropGroups.Count == 0)
                    {
                        @if (hasDropFilters && totalRecentDrops > 0)
                        {
                        <div class="public-ui-surface public-ui-surface--charcoal public-feature-empty"><h3 class="public-ui-section-heading">@T["No drops match these filters"]</h3><p class="public-ui-supporting-text">@T["Try a different search or team."]</p></div>
                        }
                        else
                        {
                            <div class="public-ui-surface public-ui-surface--charcoal public-feature-empty"><h3 class="public-ui-section-heading">@T["The feed is waiting for its first drop"]</h3><p class="public-ui-supporting-text">@T["Approved public evidence will appear here as the event unfolds."]</p></div>
                        }
                    }
                    else
                    {
                        <div class="public-ui-recent-drop-feed">
                        @for (var groupIndex = 0; groupIndex < visibleRecentDropGroups.Count; groupIndex++)
                        {
                            var group = visibleRecentDropGroups[groupIndex];
                            <section class="public-ui-recent-drop-group" data-public-recent-drop-group="@group.Key" aria-labelledby="@group.HeadingId">
                                @if (groupIndex > 0)
                                {
                                    <h3 id="@group.HeadingId" class="public-ui-recent-drop-divider" data-public-recent-drops-group-heading="@group.Key"><span>@group.Heading</span></h3>
                                }
                                <div class="public-ui-recent-drop-grid">
                            @foreach (var drop in group.Drops)
                            {
                                var dropTitle = drop.DropName ?? drop.TileName;
                                var dropHeading = string.IsNullOrWhiteSpace(drop.BossName) ? dropTitle : $"{dropTitle} · {drop.BossName}";
                                var dropContext = !string.IsNullOrWhiteSpace(drop.BossName) ? drop.BossName : (drop.DropName is not null ? drop.TileName : null);
                                var playerName = string.IsNullOrWhiteSpace(drop.PlayerName) ? T["Participant"].Value : drop.PlayerName;
                                    <article class="public-ui-surface public-ui-surface--charcoal public-ui-recent-drop-card" data-public-recent-drop-id="@drop.SubmissionId" data-public-recent-drop-submitted-at="@drop.SubmittedAt.ToUniversalTime().ToString("O")" data-public-recent-drop-reviewed-at="@drop.ReviewedAt?.ToUniversalTime().ToString("O")">
                                    @if (drop.EvidenceAssetId is Guid assetId)
                                    {
                                        <a href="/Evidence/@assetId" class="public-ui-recent-drop-thumbnail" data-evidence-image="/Evidence/@assetId" data-evidence-alt="@T["Approved evidence from {0}", playerName]" data-evidence-drop="@dropHeading" data-evidence-player="@playerName" data-evidence-team="@drop.TeamName" data-evidence-source="@T["Recent drops"]" data-evidence-submission-id="@drop.SubmissionId" data-evidence-event-id="@Model.Board.EventId">
                                            <img src="/Evidence/@assetId" alt="@T["Approved evidence from {0}", playerName]" loading="lazy" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="public-ui-recent-drop-thumbnail public-ui-recent-drop-placeholder" aria-hidden="true">◆</div>
                                    }
                                    <div class="public-ui-recent-drop-row-content">
                                        <strong class="public-ui-component-title public-ui-recent-drop-title">@dropTitle @if (Model.NewSubmissionIds.Contains(drop.SubmissionId)) { <span class="public-drop-new">@T["NEW"]</span> }</strong>
                                        @if (!string.IsNullOrWhiteSpace(dropContext))
                                        {
                                            <span class="public-ui-supporting-text public-ui-recent-drop-activity">@dropContext</span>
                                        }
                                        <strong class="public-ui-recent-drop-progression" title="@T["{0} progress", drop.TileName]">@drop.ProgressAfter/@drop.Target</strong>
                                        <div class="public-ui-recent-drop-metadata">
                                            <span class="public-ui-supporting-text public-ui-recent-drop-player">@playerName · @BoardModel.FormatElapsed(drop.SubmittedAt, elapsedNow)</span>
                                            <a class="public-ui-action public-ui-action--text public-ui-action--hyperlink public-ui-recent-drop-team-link"
                                               asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@drop.TeamSlug">@drop.TeamName</a>
                                        </div>
                                    </div>
                                </article>
                            }
                                </div>
                            </section>
                        }
                        </div>
                    }
                    @if (visibleRecentDropCount > 0)
                    {
                        <footer class="public-ui-recent-drop-footer" aria-label="@T["Recent drops pagination"]">
                            <span class="public-ui-recent-drop-footer-summary">@T["Showing {0} of {1} drops", visibleRecentDropCount, filteredRecentDropTotal]</span>
                            <div class="public-ui-recent-drop-footer-actions">
                                @if (hasMoreRecentDrops)
                                {
                                    <a class="public-ui-action public-ui-recent-drop-load" data-public-recent-drops-nav data-public-recent-drops-focus="load" data-public-recent-drops-focus-target="load"
                                       asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="drops" asp-route-dropCount="@nextRecentDropCount" asp-route-dropSearch="@Model.DropSearch" asp-route-dropTeam="@Model.DropTeam">@T["Load 25 more ↓"]</a>
                                }
                                @if (showBackToLatest)
                                {
                                    <a class="public-ui-action public-ui-action--text public-ui-recent-drop-back" data-public-recent-drops-focus="back" href="#recent-drops-latest">@T["Back to latest"]</a>
                                }
                            </div>
                        </footer>
                    }
                </div>
                </div>
                <div class="public-ui-recent-drops-sidebar">
                <aside class="public-ui-surface public-ui-surface--charcoal public-ui-recent-drop-stats" aria-labelledby="live-recent-drop-stats-heading">
                    <h3 id="live-recent-drop-stats-heading" class="public-ui-recent-drop-divider"><span>@T["Drop statistics"]</span></h3>
                    <dl class="public-ui-recent-drop-stats-list">
                        <div><dt class="public-ui-supporting-text">@T["Total drops"]</dt><dd class="public-ui-recent-drop-stats-value">@recentDropStats.TotalDrops</dd></div>
                        <div><dt class="public-ui-supporting-text">@T["Drops last 24 hours"]</dt><dd class="public-ui-recent-drop-stats-value">@recentDropStats.DropsLast24Hours</dd></div>
                        <div><dt class="public-ui-supporting-text">@T["Total Drop EHB"]</dt><dd class="public-ui-recent-drop-stats-value">@recentDropStats.TotalDropEhb.ToString("0")</dd></div>
                        <div><dt class="public-ui-supporting-text">@T["Unique players with a drop"]</dt><dd class="public-ui-recent-drop-stats-value">@recentDropStats.UniqueDroppers/@recentDropStats.TotalParticipants</dd></div>
                        <div><dt class="public-ui-supporting-text">@T["Highest Drop EHB team"]</dt><dd class="public-ui-recent-drop-stats-value public-ui-recent-drop-stats-team-value"><span>@(recentDropStats.HighestDropEhbTeamName ?? "—")</span> @if (recentDropStats.HighestDropEhbTeamValue is { } highestDropEhbTeamValue) { <span class="public-ui-positive-delta">@highestDropEhbTeamValue.ToString("0") EHB</span> }</dd></div>
                        <div><dt class="public-ui-supporting-text">@T["Most individual drops team"]</dt><dd class="public-ui-recent-drop-stats-value public-ui-recent-drop-stats-team-value"><span>@(recentDropStats.MostIndividualDropsTeamName ?? "—")</span> @if (recentDropStats.MostIndividualDropsTeamDropCount is { } mostIndividualDropsTeamDropCount) { <span class="public-ui-positive-delta">@mostIndividualDropsTeamDropCount @(mostIndividualDropsTeamDropCount == 1 ? T["drop"] : T["Drops"])</span> }</dd></div>
                    </dl>
                    <div class="public-ui-recent-drop-stats-divider" aria-hidden="true"></div>
                </aside>
                <form class="public-ui-surface public-ui-surface--charcoal public-ui-recent-drops-toolbar" method="get" data-public-recent-drops-toolbar data-public-recent-drops-filter-form>
                    <input type="hidden" name="view" value="drops" />
                    <input type="hidden" name="dropCount" value="@BoardModel.DefaultRecentDropCount" />
                    <h3 class="public-ui-recent-drop-divider public-ui-recent-drops-filter-heading"><span>@T["Filter drops"]</span></h3>
                    <label class="public-ui-overline public-ui-recent-drops-field-label" for="public-recent-drops-search">@T["Search drops"]</label>
                    <div class="public-ui-recent-drops-search">
                        <div class="public-ui-recent-drops-search-control">
                            <svg class="public-ui-recent-drops-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="m16 16 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" /></svg>
                            <input id="public-recent-drops-search" class="public-ui-recent-drops-search-input" data-public-recent-drops-search name="dropSearch" type="search" value="@Model.DropSearch" placeholder="@T["Search drops, players, teams or tiles…"]" autocomplete="off" />
                            <button type="button" class="public-ui-recent-drops-search-clear" data-public-recent-drops-clear aria-label="@T["Clear search"]" hidden="@(Model.DropSearch is null ? "hidden" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 18 18M18 6 6 18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" /></svg></button>
                        </div>
                    </div>
                    <span class="public-ui-recent-drops-result-count visually-hidden" data-public-recent-drops-result aria-live="polite">@toolbarResultText</span>
                    <div class="public-ui-recent-drops-filter-group">
                        <label class="public-ui-overline public-ui-recent-drops-field-label" for="public-recent-drops-team">@T["Team"]</label>
                        <span class="public-ui-recent-drops-filter-wrap">
                            <select id="public-recent-drops-team" class="public-ui-select public-ui-select--accent" data-public-recent-drops-team name="dropTeam">
                                <option value="" selected="@(Model.DropTeam is null ? "selected" : null)">@T["All teams"]</option>
                                @foreach (var team in Model.Board.Teams.OrderBy(value => value.TeamName, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@team.TeamSlug" selected="@(string.Equals(Model.DropTeam, team.TeamSlug, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@team.TeamName</option>
                                }
                            </select>
                            <span class="public-ui-select-chevron" aria-hidden="true"></span>
                        </span>
                    </div>
                </form>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="public-dashboard-view" aria-label="@T["Leaderboards"]">
            <div class="public-ui-leaderboards-layout" data-public-leaderboards-layout data-public-leaderboards-mode="@(Model.IsMetricMode ? "metric" : "default")">
                <div class="public-ui-leaderboards-tabs">
                    <nav class="public-ui-view-switcher @(Model.IsMetricMode ? "public-ui-view-switcher--two" : null)" aria-label="@T["Leaderboard table views"]" data-public-leaderboard-switcher>
                        @if (Model.IsMetricMode)
                        {
                            <a id="public-leaderboard-metric-teams-link" class="public-ui-view-switcher-item @(Model.ActiveRanking == "teams" ? "is-current" : null)" aria-current="@(Model.ActiveRanking == "teams" ? "page" : null)" aria-controls="public-leaderboard-metric-teams"
                               data-public-leaderboard-view="teams" asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="leaderboards" asp-route-ranking="teams" asp-route-metric="@Model.SelectedMetric">@T["Teams"]</a>
