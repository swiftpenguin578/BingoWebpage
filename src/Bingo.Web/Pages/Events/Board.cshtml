@page "/Events/{slug}/Board"
@model Bingo.Web.Pages.Events.BoardModel
@using Bingo.Application.Boards
@using Bingo.Domain.Events
@{
    ViewData["Title"] = T["{0} board", Model.Board.EventName];
    ViewData["HideBreadcrumbs"] = true;
    ViewData["CompactNavigation"] = true;
    ViewData["BodyClass"] = "public-event-shell public-ui-pass1 public-board-page public-board-overview";
    var totalTiles = Model.Board.Rows * Model.Board.Columns;
    var isMission = Model.ActiveView == "mission";
    var isDrops = Model.ActiveView == "drops";
    var isLeaderboards = Model.ActiveView == "leaderboards";
    var dropEhbTeams = Model.Board.DropEhbTeams ?? Array.Empty<PublicDropEhbTeam>();
    var activityTeamsById = Model.Activity.Teams.ToDictionary(value => value.TeamId);
    var dropEhbTeamsById = dropEhbTeams.ToDictionary(value => value.TeamId);
    var recentActivity = Model.Board.RecentDrops.Take(3).ToList();
    var eventStart = Model.Board.EventStartsAt?.ToUniversalTime().ToString("O");
    var eventEnd = Model.Board.EventEndsAt?.ToUniversalTime().ToString("O");
    var eventStatus = Model.Board.EventState switch
    {
        EventState.Live => T["Live"],
        EventState.AwaitingFinalReview or EventState.Finalized or EventState.Archived or EventState.Cancelled => T["Ended"],
        _ => T["Upcoming"]
    };
    var activityStateText = Model.Activity.State switch
    {
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.NotConfigured => T["Activity tracking is not configured."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.WaitingForFirstSync => T["Waiting for the first Wise Old Man sync."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Partial => T["Activity is provisional: {0} of {1} current accounts matched.", Model.Activity.MatchedAccountCount, Model.Activity.ExpectedAccountCount],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Incomplete => T["Activity rankings are unavailable until the current account set is synchronized."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.Stale => T["Cached activity is stale."],
        Bingo.Application.Integrations.WiseOldMan.EventCompetitionActivityState.TemporarilyUnavailable => Model.Activity.HasRankings
            ? T["Wise Old Man is temporarily unavailable. Showing the last available cache."]
            : T["Wise Old Man is temporarily unavailable."],
        _ => T["Activity cache is current."]
    };
    var elapsedNow = DateTimeOffset.UtcNow;
    var showSubmitDrop = Model.Board.SubmissionsOpen;
    var hasDualMastheadActions = showSubmitDrop && Model.Board.WiseOldManCompetitionId is not null;
    var leadResult = Model.Board.EventResult;
    if (leadResult is null && Model.Board.EventState == EventState.Live)
    {
        var currentLeader = Model.Board.Teams.FirstOrDefault(value => value.Rank == 1);
        if (currentLeader is not null)
        {
            leadResult = new PublicEventResult(currentLeader.TeamName, currentLeader.TeamSlug, false);
        }
    }
    var resultTeams = leadResult?.Teams ?? (leadResult is { } result ? [new PublicEventResultTeam(result.TeamName, result.TeamSlug)] : []);
    var leadTeam = resultTeams.Count == 1
        ? (!string.IsNullOrWhiteSpace(resultTeams[0].TeamSlug)
            ? Model.Board.Teams.FirstOrDefault(team => string.Equals(team.TeamSlug, resultTeams[0].TeamSlug, StringComparison.OrdinalIgnoreCase))
            : null)
            ?? Model.Board.Teams.FirstOrDefault(team => string.Equals(team.TeamName, resultTeams[0].TeamName, StringComparison.OrdinalIgnoreCase))
        : null;
    var leadCompletionText = resultTeams.Count > 1
        ? T["Tied for first"]
        : leadTeam is null
        ? T["Completion unavailable"]
        : T["{0}% complete", totalTiles == 0 ? 0 : leadTeam.Progress.CompletedTiles * 100 / totalTiles];
    var leadLabel = leadResult?.IsOfficial == true ? (resultTeams.Count > 1 ? T["Tie"] : T["Winner"]) : leadResult is not null ? T["In the lead"] : T["Results pending"];
    var boardOverviewUrl = Url.Page("/Events/Board", new { slug = Model.Board.EventSlug });
    var submissionHref = User.Identity?.IsAuthenticated != true
        ? Url.Page("/Account/Login", new { ReturnUrl = boardOverviewUrl })
        : Model.SubmissionTeamSlug is not null
            ? Url.Page("/Events/TeamBoard", new { slug = Model.Board.EventSlug, teamSlug = Model.SubmissionTeamSlug, submission = true })
            : boardOverviewUrl;
}

<section class="public-event-dashboard" data-progress-event="@Model.Board.EventId">
    <div class="public-board-masthead">
        <header class="public-board-masthead__hero">
            <div class="public-board-masthead__identity">
                <div class="public-masthead-copy">
                    <span class="public-ui-overline public-masthead-kicker">@T["Event overview"]</span>
                    <h1 class="public-board-masthead__title public-masthead-title">@Model.Board.EventName</h1>
                </div>
            </div>

            <div class="landing-hero__art public-board-masthead__art" aria-hidden="true">
                <div class="landing-hero__background"></div>
                <img class="landing-hero__mark landing-hero__mark--light" src="~/images/branding/login-artwork.svg" asp-append-version="true" alt="" />
                <img class="landing-hero__mark landing-hero__mark--dark" src="~/images/branding/login-artwork-dark.svg" asp-append-version="true" alt="" />
            </div>

            <div class="public-board-masthead__facts">
                @if (Model.Board.EventEndsAt is not null)
                {
                    <section class="public-board-masthead__fact public-board-masthead__countdown public-ui-countdown"
                             data-public-countdown data-countdown-start="@eventStart" data-countdown-end="@eventEnd"
                             role="group" aria-label="@T["Ends in"]"
                             data-countdown-live-label="@T["Live"]" data-countdown-upcoming-label="@T["Starts in"]" data-countdown-ended-label="@T["Event ended"]"
                             data-countdown-days-label="@T["DAYS"]" data-countdown-hours-label="@T["HRS"]" data-countdown-minutes-label="@T["MIN"]" data-countdown-seconds-label="@T["SEC"]">
                        <span class="public-board-masthead__live-status" aria-hidden="true"><span class="public-board-masthead__live-dot"></span>@T["Live"]</span>
                        <span class="public-ui-overline" data-countdown-label aria-hidden="true" hidden>@T["Ends in"]</span>
                        <div class="public-ui-countdown-values" aria-hidden="true">
                            <span class="public-ui-countdown-segment">
                                <strong class="public-ui-data-value public-ui-countdown-value" data-countdown-value="days">00</strong>
                                <span class="public-ui-countdown-unit-label">@T["DAYS"]</span>
                            </span>
                            <span class="public-ui-countdown-separator" aria-hidden="true">:</span>
                            <span class="public-ui-countdown-segment">
                                <strong class="public-ui-data-value public-ui-countdown-value" data-countdown-value="hours">00</strong>
                                <span class="public-ui-countdown-unit-label">@T["HRS"]</span>
                            </span>
                            <span class="public-ui-countdown-separator" aria-hidden="true">:</span>
                            <span class="public-ui-countdown-segment">
                                <strong class="public-ui-data-value public-ui-countdown-value" data-countdown-value="minutes">00</strong>
                                <span class="public-ui-countdown-unit-label">@T["MIN"]</span>
                            </span>
                        </div>
                        <div class="public-ui-countdown-compatibility" hidden>
                            <strong class="public-ui-countdown-value" data-countdown-value="seconds">00</strong>
                        </div>
                        <div class="public-ui-countdown-progress" aria-hidden="true" hidden>
                            <span class="public-ui-data-line" data-countdown-progress></span>
                        </div>
                    </section>
                }
                else
                {
                    <section class="public-board-masthead__fact public-board-masthead__countdown" role="group" aria-label="@T["Event status"]">
                        <span class="public-ui-overline">@T["Status"]</span>
                        <strong class="public-board-masthead__status-value">@eventStatus</strong>
                    </section>
                }

                <section class="public-board-masthead__fact public-board-masthead__result" aria-label="@T["Current result"]">
                    <span class="public-ui-overline">@leadLabel</span>
                    @if (leadResult is { } currentResult)
                    {
                        <div class="public-board-masthead__result-row">
                            <strong class="public-board-masthead__rank">01</strong>
                            <div>
                                <strong class="public-board-masthead__fact-title">@currentResult.TeamName</strong>
                                <span class="public-ui-supporting-text">@leadCompletionText</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <span class="public-ui-supporting-text">@T["Results pending"]</span>
                    }
                </section>

                <section class="public-board-masthead__fact public-board-masthead__metric" aria-label="@T["Player ranking metric"]">
                @if (Model.Activity.HasRankings)
                {
                    <details class="public-ui-masthead-metric-selector" data-public-ui-compact-dropdown data-public-masthead-metric-selector data-public-masthead-event="@Model.Board.EventId">
                        <summary class="public-ui-overline public-ui-compact-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="public-masthead-metric-options">
                            <span data-public-ui-dropdown-label>@T["Most spooned"]</span>
                            <svg class="public-ui-masthead-metric-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
                        </summary>
                        <div id="public-masthead-metric-options" class="public-ui-compact-dropdown-menu" role="listbox" aria-label="@T["Player ranking metric"]" tabindex="-1">
                            <button type="button" class="public-ui-compact-dropdown-option" role="option" data-public-ui-dropdown-option="spooned" data-public-ui-dropdown-label="@T["Most spooned"]" aria-selected="true"><span>@T["Most spooned"]</span><svg data-public-ui-dropdown-check aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" hidden><path d="m5 12 4 4L19 6" /></svg></button>
                            <button type="button" class="public-ui-compact-dropdown-option" role="option" data-public-ui-dropdown-option="drops" data-public-ui-dropdown-label="@T["Highest DEHB"]" aria-selected="false"><span>@T["Highest DEHB"]</span><svg data-public-ui-dropdown-check aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" hidden><path d="m5 12 4 4L19 6" /></svg></button>
                            <button type="button" class="public-ui-compact-dropdown-option" role="option" data-public-ui-dropdown-option="ehb" data-public-ui-dropdown-label="@T["Highest EHB"]" aria-selected="false"><span>@T["Highest EHB"]</span><svg data-public-ui-dropdown-check aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" hidden><path d="m5 12 4 4L19 6" /></svg></button>
                        </div>
                    </details>
                }
                else
                {
                    <span class="public-ui-overline">@T["Highest DEHB"]</span>
                }
                <div class="public-ui-masthead-metric" data-public-masthead-metric="spooned" hidden="@(Model.Activity.HasRankings ? null : "hidden")">
                        @if (Model.MostSpooned is { } mostSpooned)
                        {
                            <div class="public-board-masthead__metric-row">
                                <strong class="public-board-masthead__metric-value">@mostSpooned.TotalDrops.ToString("0")</strong>
                                <div>
                                    <strong class="public-board-masthead__fact-title">@mostSpooned.Participant.ParticipantName</strong>
                                    <span class="public-ui-supporting-text">@mostSpooned.TeamName</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="public-ui-supporting-text">@T["No activity data available"]</span>
                        }
                    </div>
                <div class="public-ui-masthead-metric" data-public-masthead-metric="drops" hidden="@(Model.Activity.HasRankings ? "hidden" : null)">
                        @if (Model.HighestDropEhb is { } highestDropEhb)
                        {
                            <div class="public-board-masthead__metric-row">
                                <strong class="public-board-masthead__metric-value">@highestDropEhb.DropEhb.ToString("0;-0;0")</strong>
                                <div>
                                    <strong class="public-board-masthead__fact-title">@highestDropEhb.Participant.ParticipantName</strong>
                                    <span class="public-ui-supporting-text">@highestDropEhb.TeamName</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="public-ui-supporting-text">@T["No activity data available"]</span>
                        }
                    </div>
                <div class="public-ui-masthead-metric" data-public-masthead-metric="ehb" hidden>
                        @if (Model.HighestEhb is { } highestEhb)
                        {
                            <div class="public-board-masthead__metric-row">
                                <strong class="public-board-masthead__metric-value">@highestEhb.Participant.TotalGainedEhb.ToString("0;-0;0")</strong>
                                <div>
                                    <strong class="public-board-masthead__fact-title">@highestEhb.Participant.ParticipantName</strong>
                                    <span class="public-ui-supporting-text">@highestEhb.TeamName</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="public-ui-supporting-text">@T["No activity data available"]</span>
                        }
                </div>
                </section>

                <div class="public-ui-action-list public-board-masthead__actions @(hasDualMastheadActions ? "public-board-masthead__actions--dual" : null)" aria-label="@T["Actions"]">
                @if (showSubmitDrop)
                {
                    <a class="public-ui-action public-ui-action--commit" href="@submissionHref" data-open-submission-workspace>@T["Submit drop"] →</a>
                }
                @if (Model.Board.WiseOldManCompetitionId is { } competitionId)
                {
                    <a class="public-ui-action public-ui-action--standard public-ui-action--hyperlink" href="https://wiseoldman.net/competitions/@competitionId" target="_blank" rel="noopener noreferrer" aria-label="@T["View Wise Old Man competition"]" title="@T["View Wise Old Man competition"]">@T["WOM"] →</a>
                }
                @if (!showSubmitDrop && Model.Board.WiseOldManCompetitionId is null)
                {
                    <span class="public-ui-supporting-text">@T["No actions available"]</span>
                }
                </div>
            </div>

        </header>
    </div>

    <div class="progress-update" data-progress-update hidden role="status">
        <span>@T["New progress is available."]</span>
        <button type="button" class="public-ui-action public-ui-action--text public-ui-action--forward" data-progress-refresh><span>@T["Refresh now"]</span></button>
    </div>

    @if (isMission)
    {
        <section class="public-dashboard-view mission-control-view" aria-label="@T["Team bingo boards"]">
            <div class="public-board-content-transition">
                <aside class="public-board-legend" aria-label="@T["Board state legend"]">
                    <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--complete" aria-hidden="true"></i>@T["Completed"]</span>
                    <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--progress" aria-hidden="true"></i>@T["In progress"]</span>
                    <span class="public-board-legend__item"><i class="public-board-legend__swatch public-board-legend__swatch--remaining" aria-hidden="true"></i>@T["remaining"]</span>
                </aside>
            </div>
            <div class="mission-grid @(Model.Board.Teams.Count > 3 ? "mission-grid--wide-rows" : null) @(Model.Board.Teams.Count > 2 ? "mission-grid--constrained-rows" : null) @(Model.Board.Teams.Count > 1 ? "mission-grid--mobile-rows" : null)" aria-label="@T["Team board overview"]">
                @foreach (var (team, teamIndex) in Model.Board.Teams.Select((value, index) => (value, index)))
                {
                    var lineCount = team.Progress.CompletedRows.Count + team.Progress.CompletedColumns.Count;
                    var completion = totalTiles == 0 ? 0 : team.Progress.CompletedTiles * 100 / totalTiles;
                    var wideRowBoundary = ((teamIndex / 3) + 1) * 3 < Model.Board.Teams.Count;
                    var constrainedRowBoundary = ((teamIndex / 2) + 1) * 2 < Model.Board.Teams.Count;
                    var wideColumnDivider = teamIndex % 3 != 0;
                    var constrainedColumnDivider = teamIndex % 2 != 0;
                    <a class="mission-team-card public-ui-surface public-ui-surface--charcoal @(team.ProvisionalWinner ? "provisional-winner" : null) @(wideRowBoundary ? "mission-team-card--wide-boundary" : null) @(constrainedRowBoundary ? "mission-team-card--constrained-boundary" : null)"
                       asp-page="/Events/TeamBoard" asp-route-slug="@Model.Board.EventSlug" asp-route-teamSlug="@team.TeamSlug">
                        <div class="mission-card-rank-column">
                            @if (team.ProvisionalWinner)
                            {
                                <span class="mission-team-kicker">@T["In the lead"]</span>
                            }
                            <span class="mission-card-rank public-ui-section-heading rank-@team.Rank">@team.Rank.ToString("00")</span>
                        </div>
                        <div class="mission-card-content">
                            <div class="mission-card-board">
                                <div class="mission-card-title">
                                    <strong class="mission-team-name public-ui-section-heading" title="@team.TeamName">@team.TeamName</strong>
                                </div>
                                <div class="mini-board"
                                     style="--public-board-columns:@Model.Board.Columns; --public-board-rows:@Model.Board.Rows"
                                     aria-label="@team.TeamName board, @team.Progress.CompletedTiles of @totalTiles tiles completed">
                                    @foreach (var tile in team.Tiles)
                                    {
                                        <span class="public-ui-board-tile @(tile.Complete ? "is-finished" : tile.Approved > 0 ? "is-in-progress" : "is-not-started")" title="@tile.Name: @tile.Approved/@tile.Target">
                                            <span class="visually-hidden">@tile.Name @tile.Approved of @tile.Target</span>
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (wideColumnDivider || constrainedColumnDivider)
                            {
                                <span class="mission-card-column-divider @(wideColumnDivider ? "mission-card-column-divider--wide" : null) @(constrainedColumnDivider ? "mission-card-column-divider--constrained" : null)" aria-hidden="true"></span>
                            }
                            <footer class="mission-card-stats">
                                <span class="mission-stat mission-stat--completion"><strong class="public-ui-data-value">@completion%</strong></span>
                                <div class="mission-stat-details">
                                    <span class="mission-stat mission-stat--detail"><strong class="public-ui-data-value">@team.Progress.CompletedTiles / @totalTiles</strong> <span class="public-ui-supporting-text">@T["Tiles"]</span></span>
                                    <span class="mission-stat mission-stat--detail"><strong class="public-ui-data-value">@lineCount</strong> <span class="public-ui-supporting-text">@(lineCount == 1 ? T["row"] : T["rows"])</span></span>
                                    <span class="mission-stat mission-stat--detail" title="@T["Estimated Drop EHB from approved contributions"]"><strong class="public-ui-data-value">@team.Progress.EhbTiebreak.ToString("N0")</strong> <span class="public-ui-supporting-text">@T["Drop EHB"]</span></span>
                                </div>
                            </footer>
                        </div>
                        <div class="mission-completion" aria-label="@completion percent complete"><span class="public-ui-data-line" style="width:@completion%"></span></div>
                    </a>
                }
            </div>
            <section class="public-board-activity" aria-labelledby="public-board-activity-heading">
                <header class="public-board-activity__header">
                    <div class="public-board-activity__header-copy">
                        <h2 id="public-board-activity-heading">@T["Recent activity"]</h2>
                    </div>
                    <a class="public-ui-action public-ui-action--text public-ui-action--forward" asp-page="/Events/Board" asp-route-slug="@Model.Board.EventSlug" asp-route-view="drops">@T["View all activity"]</a>
                </header>
                @if (recentActivity.Count == 0)
                {
                    <p class="public-board-activity__empty public-ui-supporting-text">@T["No approved activity yet"]</p>
                }
                else
                {
                    <div class="public-board-activity__items">
                        @foreach (var activity in recentActivity)
                        {
                            var activityPlayer = string.IsNullOrWhiteSpace(activity.PlayerName) ? T["Participant"] : activity.PlayerName;
                            var activityName = activity.DropName ?? activity.TileName;
                            <article class="public-board-activity__item">
                                <span class="public-board-activity__marker" aria-hidden="true">✓</span>
                                <div class="public-board-activity__copy">
                                    <strong>@activityPlayer</strong>
                                    <span class="public-board-activity__drop">@activityName</span>
                                    <span class="public-board-activity__meta public-board-activity__team">@activity.TeamName</span>
                                    <span class="public-board-activity__meta public-board-activity__time">@BoardModel.FormatElapsed(activity.ApprovedAt, elapsedNow)</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </section>
    }
    else if (isDrops)
    {
        <section class="public-dashboard-view recent-drops-view" aria-label="@T["Recent drops"]">
            @{
                var recentDropStats = Model.Board.RecentDropSummary ?? new PublicRecentDropSummary(0, 0, 0, 0, 0, null, null);
                var lastHourCutoff = elapsedNow.AddHours(-1);
                var last24HoursCutoff = elapsedNow.AddHours(-24);
                var recentDropGroups = new[]
                {
                    (Heading: T["Last hour"], HeadingId: "live-recent-drops-last-hour-heading", Drops: Model.Board.RecentDrops.Where(drop => drop.ApprovedAt >= lastHourCutoff).ToList()),
                    (Heading: T["Last 24 hours"], HeadingId: "live-recent-drops-last-24-hours-heading", Drops: Model.Board.RecentDrops.Where(drop => drop.ApprovedAt < lastHourCutoff && drop.ApprovedAt >= last24HoursCutoff).ToList()),
                    (Heading: T["Older drops"], HeadingId: "live-recent-drops-older-heading", Drops: Model.Board.RecentDrops.Where(drop => drop.ApprovedAt < last24HoursCutoff).ToList())
                };
                var totalRecentDrops = recentDropStats.TotalDrops;
                var filteredRecentDropTotal = Model.Board.RecentDropFilteredTotal ?? totalRecentDrops;
                var hasDropFilters = Model.DropSearch is not null || Model.DropTeam is not null;
                var toolbarResultText = hasDropFilters ? $"{filteredRecentDropTotal} matches" : $"{filteredRecentDropTotal} drops";
                var visibleRecentDropCount = Model.Board.RecentDrops.Count;
                var hasMoreRecentDrops = visibleRecentDropCount < filteredRecentDropTotal;
                var showBackToLatest = visibleRecentDropCount > BoardModel.DefaultRecentDropCount;
                var nextRecentDropCount = hasMoreRecentDrops
                    ? Math.Min(filteredRecentDropTotal, visibleRecentDropCount + BoardModel.RecentDropPageSize)
                    : visibleRecentDropCount;
                var visibleRecentDropGroups = recentDropGroups.Where(group => group.Drops.Count > 0).ToList();
            }
            <div class="public-ui-recent-drops-layout">
                @if (visibleRecentDropGroups.Count > 0)
                {
                    var firstRecentDropGroup = visibleRecentDropGroups[0];
                    <h3 id="@firstRecentDropGroup.HeadingId" class="public-ui-recent-drop-divider public-ui-recent-drops-shared-divider"><span>@firstRecentDropGroup.Heading</span></h3>
                }
                else
                {
                    <h3 id="live-recent-drops-empty-heading" class="public-ui-recent-drop-divider public-ui-recent-drops-shared-divider"><span>@T["Drops"]</span></h3>
                }
                <div class="public-ui-recent-drops-main">
                <div id="recent-drops-latest" class="public-ui-recent-drop-region" data-public-recent-drops aria-live="polite" tabindex="-1">
                    @if (visibleRecentDropGroups.Count == 0)
                    {
                        @if (hasDropFilters && totalRecentDrops > 0)
                        {
                        <div class="public-ui-surface public-ui-surface--charcoal public-feature-empty"><h3 class="public-ui-section-heading">@T["No drops match these filters"]</h3><p class="public-ui-supporting-text">@T["Try a different search or team."]</p></div>
                        }
                        else
                        {
                            <div class="public-ui-surface public-ui-surface--charcoal public-feature-empty"><h3 class="public-ui-section-heading">@T["The feed is waiting for its first drop"]</h3><p class="public-ui-supporting-text">@T["Approved public evidence will appear here as the event unfolds."]</p></div>
                        }
                    }
                    else
                    {
                        <div class="public-ui-recent-drop-feed">
                        @for (var groupIndex = 0; groupIndex < visibleRecentDropGroups.Count; groupIndex++)
                        {
                            var group = visibleRecentDropGroups[groupIndex];
                            <section class="public-ui-recent-drop-group" aria-labelledby="@group.HeadingId">
                                @if (groupIndex > 0)
                                {
                                    <h3 id="@group.HeadingId" class="public-ui-recent-drop-divider"><span>@group.Heading</span></h3>
                                }
                                <div class="public-ui-recent-drop-grid">
                            @foreach (var drop in group.Drops)
                            {
                                var dropTitle = drop.DropName ?? drop.TileName;
