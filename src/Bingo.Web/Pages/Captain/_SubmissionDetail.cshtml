@model Bingo.Web.Pages.Submissions.SubmissionModel
@{
    var tileOptions = Model.Requirements.GroupBy(requirement => new { requirement.TileId, requirement.Tile }).Select(group => group.First()).ToList();
}

<section class="public-pass2-page public-pass2-form-page captain-submission-page" aria-labelledby="captain-submission-heading">
    <header class="public-pass2-masthead public-masthead-copy captain-submission-masthead">
        <span class="public-pass2-kicker public-masthead-kicker">@T["Submission details"]</span>
        <h1 id="captain-submission-heading" class="public-masthead-title">@Model.Details.Tile</h1>
        <p class="public-masthead-support">@T["Submitted"] @T["for"] @Model.Details.Player</p>
    </header>

    <section class="captain-submission-section captain-submission-status-section" aria-labelledby="captain-submission-status-heading">
        <header class="public-pass2-ledger-heading"><h2 id="captain-submission-status-heading">@T["Submission status"]</h2><span aria-hidden="true"></span></header>
        <div class="captain-submission-status-row">
            <div class="captain-submission-status-facts"><div class="captain-submission-status-fact"><span class="public-ui-role-label public-ui-submission-fact-label">@T["Status"]</span><strong class="captain-submission-status-value captain-ledger-status--@Model.Details.DisplayStatus.ToLowerInvariant()">@T[Model.Details.DisplayStatus]</strong></div><span class="captain-submission-status-divider" aria-hidden="true"></span><div class="captain-submission-status-fact"><span class="public-ui-role-label public-ui-submission-fact-label">@T["Submitted"]</span><strong class="captain-submission-status-value">@DateTimePresentation.Format(Model.Details.SubmittedAt, "dd MMM yyyy, HH:mm", Model.EventTimezone, CultureInfo.CurrentCulture)</strong></div></div>
            <nav class="captain-submission-navigation" aria-label="@T["Submission navigation"]">
                @if (Model.IsArchivedFormerOwner) { <a class="public-pass2-action public-pass2-action--outline" asp-page="/Account/MyEvents">@T["Back to my events"]</a> }
                else if (Model.CanOpenTeamLedger) { <a class="public-pass2-action public-pass2-action--outline" asp-page="@Model.LedgerPage" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId">@T["Back to team history"]</a> }
                else { <a class="public-pass2-action public-pass2-action--outline" asp-page="/Events/TeamBoard" asp-route-slug="@Model.EventSlug" asp-route-teamSlug="@Model.TeamSlug">@T["Back to team board"]</a> }
                @if (!Model.IsArchivedFormerOwner && Model.Details.PriorSubmissionId is { } priorId) { <a class="public-pass2-action public-pass2-action--outline" asp-page="@Model.DetailPage" asp-route-id="@priorId" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId">@T["View prior submission"]</a> }
                @if (!Model.IsArchivedFormerOwner && Model.Details.ReplacementSubmissionId is { } replacementId) { <a class="public-pass2-action public-pass2-action--outline" asp-page="@Model.DetailPage" asp-route-id="@replacementId" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId">@T["View replacement submission"]</a> }
            </nav>
        </div>
    </section>

    <section class="captain-submission-section captain-submission-details-section" aria-labelledby="captain-submission-details-heading">
        <header class="public-pass2-ledger-heading"><h2 id="captain-submission-details-heading">@T["Submission details"]</h2><span aria-hidden="true"></span></header>
        @if (Model.Details.Feedback is not null) { <section class="captain-submission-feedback" role="status" aria-labelledby="captain-feedback-heading"><h3 id="captain-feedback-heading">@T["Reviewer feedback"]</h3><p>@Model.Details.Feedback</p></section> }
        @if (Model.Details.Editable)
        {
            var selectedTileId = Model.Input.BoardTileId == Guid.Empty ? Model.Details.TileId : Model.Input.BoardTileId;
            var selectedRequirementId = Model.Input.RequirementId == Guid.Empty ? Model.Details.RequirementId : Model.Input.RequirementId;
            var selectedTargetId = Model.Input.DropSnapshotId is { } dropId ? $"drop:{dropId}" : Model.Requirements.Any(requirement => requirement.Id == selectedRequirementId && requirement.Manual) ? $"manual:{selectedRequirementId}" : string.Empty;
            @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="public-pass2-validation"></div> }
            <form id="captain-submission-correct-form" method="post" enctype="multipart/form-data" asp-page-handler="Correct" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId" class="public-ui-submission-form public-ui-submission-form--shared captain-submission-form" data-submission-detail-form>
                <div class="public-ui-submission-row"><div class="public-pass2-field"><label for="captain-correct-tile">@T["Tile"]</label><select id="captain-correct-tile" asp-for="Input.BoardTileId" data-submission-detail-tile required>@foreach (var tile in tileOptions) { <option value="@tile.TileId" selected="@(tile.TileId == selectedTileId ? "selected" : null)">@tile.Tile</option> }</select></div><div class="public-pass2-field"><label for="captain-correct-drop">@T["Drop"]</label><select id="captain-correct-drop" data-submission-detail-target data-submission-detail-selected-target="@selectedTargetId" required><option value="" selected="@(string.IsNullOrEmpty(selectedTargetId) ? "selected" : null)">@T["Choose a drop"]</option>@foreach (var requirement in Model.Requirements) { <optgroup label="@requirement.Description" data-submission-detail-tile="@requirement.TileId">@foreach (var drop in Model.Drops.Where(x => x.RequirementId == requirement.Id)) { <option value="drop:@drop.Id" data-tile-id="@requirement.TileId" data-requirement-id="@requirement.Id" data-drop-id="@drop.Id" selected="@(selectedTargetId == $"drop:{drop.Id}" ? "selected" : null)">@drop.Item (@drop.Rate)</option> } @if (requirement.Manual) { <option value="manual:@requirement.Id" data-tile-id="@requirement.TileId" data-requirement-id="@requirement.Id" selected="@(selectedTargetId == $"manual:{requirement.Id}" ? "selected" : null)">@requirement.Description</option> }</optgroup>}</select></div></div>
                <div class="public-ui-submission-row"><div class="public-pass2-field"><label for="captain-correct-player">@T["Player"]</label><input id="captain-correct-player" type="text" value="@Model.Details.Player" readonly /></div></div>
                <input asp-for="Input.ExpectedVersion" type="hidden" /><input asp-for="Input.RequirementId" type="hidden" data-submission-detail-requirement /><input asp-for="Input.DropSnapshotId" type="hidden" data-submission-detail-drop /><input asp-for="Input.CreditedParticipantId" type="hidden" /><input asp-for="Input.ClaimedWeight" type="hidden" />
                <div class="public-pass2-field captain-submission-field--wide"><label for="captain-correct-note">@T["Note"]</label><textarea id="captain-correct-note" asp-for="Input.Note"></textarea></div><label class="public-ui-submission-upload-field"><span class="public-pass2-field-label">@T["Screenshot"]</span>@{ ViewData["EvidenceOptional"] = true; ViewData["EvidencePreviewUrl"] = Model.Details.AssetId is { } assetId ? $"/Evidence/{assetId}" : null; }<partial name="/Pages/Captain/_EvidenceUpload.cshtml" model="@("Input.Evidence")" /></label>
            </form>
            <div class="captain-submission-actions"><button type="submit" form="captain-submission-correct-form" class="public-pass2-action public-pass2-action--outline">@T["Save changes"]</button><form method="post" asp-page-handler="Withdraw" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId" class="captain-submission-destructive-form" onsubmit="return confirm('@T["Withdraw this submission?"]');"><input asp-for="Input.ExpectedVersion" type="hidden" /><button type="submit" class="public-pass2-action public-pass2-action--danger">@T["Withdraw mistaken submission"]</button></form></div>
        }
        else if (Model.CanResubmit)
        {
            var selectedTileId = Model.Resubmission.BoardTileId == Guid.Empty ? Model.Details.TileId : Model.Resubmission.BoardTileId;
            var selectedRequirementId = Model.Resubmission.RequirementId == Guid.Empty ? Model.Details.RequirementId : Model.Resubmission.RequirementId;
            var selectedTargetId = Model.Resubmission.DropSnapshotId is { } dropId ? $"drop:{dropId}" : Model.Requirements.Any(requirement => requirement.Id == selectedRequirementId && requirement.Manual) ? $"manual:{selectedRequirementId}" : string.Empty;
            @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="public-pass2-validation"></div> }
            <form method="post" enctype="multipart/form-data" asp-page-handler="Resubmit" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId" class="public-ui-submission-form public-ui-submission-form--shared captain-submission-form" data-submission-detail-form>
                <div class="public-ui-submission-row"><div class="public-pass2-field"><label for="captain-resubmit-tile">@T["Tile"]</label><select id="captain-resubmit-tile" asp-for="Resubmission.BoardTileId" data-submission-detail-tile required>@foreach (var tile in tileOptions) { <option value="@tile.TileId" selected="@(tile.TileId == selectedTileId ? "selected" : null)">@tile.Tile</option> }</select></div><div class="public-pass2-field"><label for="captain-resubmit-drop">@T["Drop"]</label><select id="captain-resubmit-drop" data-submission-detail-target data-submission-detail-selected-target="@selectedTargetId" required><option value="" selected="@(string.IsNullOrEmpty(selectedTargetId) ? "selected" : null)">@T["Choose a drop"]</option>@foreach (var requirement in Model.Requirements) { <optgroup label="@requirement.Description" data-submission-detail-tile="@requirement.TileId">@foreach (var drop in Model.Drops.Where(x => x.RequirementId == requirement.Id)) { <option value="drop:@drop.Id" data-tile-id="@requirement.TileId" data-requirement-id="@requirement.Id" data-drop-id="@drop.Id" selected="@(selectedTargetId == $"drop:{drop.Id}" ? "selected" : null)">@drop.Item (@drop.Rate)</option> } @if (requirement.Manual) { <option value="manual:@requirement.Id" data-tile-id="@requirement.TileId" data-requirement-id="@requirement.Id" selected="@(selectedTargetId == $"manual:{requirement.Id}" ? "selected" : null)">@requirement.Description</option> }</optgroup>}</select></div></div>
                <div class="public-ui-submission-row"><div class="public-pass2-field"><label for="captain-resubmit-player">@T["Player"]</label><input id="captain-resubmit-player" type="text" value="@Model.Details.Player" readonly /></div></div><input asp-for="Resubmission.ExpectedVersion" type="hidden" /><input asp-for="Resubmission.RequirementId" type="hidden" data-submission-detail-requirement /><input asp-for="Resubmission.DropSnapshotId" type="hidden" data-submission-detail-drop /><div class="public-pass2-field captain-submission-field--wide"><label for="captain-resubmit-note">@T["Note"]</label><textarea id="captain-resubmit-note" asp-for="Resubmission.Note"></textarea></div><label class="public-ui-submission-upload-field"><span class="public-pass2-field-label">@T["Screenshot"]</span><partial name="/Pages/Captain/_EvidenceUpload.cshtml" model="@("Resubmission.Evidence")" /></label><div class="captain-submission-actions"><button type="submit" class="public-pass2-action public-pass2-action--outline">@T["Submit linked resubmission"]</button></div>
            </form>
        }
        else
        {
            <div class="public-ui-submission-form public-ui-submission-form--shared captain-submission-form captain-submission-readonly"><div class="public-ui-submission-row"><div class="public-pass2-field"><label for="captain-readonly-tile">@T["Tile"]</label><input id="captain-readonly-tile" type="text" value="@Model.Details.Tile" readonly /></div><div class="public-pass2-field"><label for="captain-readonly-drop">@T["Drop"]</label><input id="captain-readonly-drop" type="text" value="@(Model.Details.Drop ?? T["Manual objective / no drop"] )" readonly /></div></div><div class="public-ui-submission-row"><div class="public-pass2-field"><label for="captain-readonly-player">@T["Player"]</label><input id="captain-readonly-player" type="text" value="@Model.Details.Player" readonly /></div></div><div class="public-pass2-field captain-submission-field--wide"><label for="captain-readonly-note">@T["Note"]</label><textarea id="captain-readonly-note" readonly>@Model.Details.CaptainNote</textarea></div><label class="public-ui-submission-upload-field"><span class="public-pass2-field-label">@T["Screenshot"]</span>@if (Model.Details.AssetId is { } assetId) { <a class="captain-submission-evidence" href="/Evidence/@assetId" target="_blank" data-evidence-image="/Evidence/@assetId" data-evidence-alt="@T["Submitted evidence"]"><img src="/Evidence/@assetId" alt="@T["Submitted evidence"]" /></a> }</label></div>
        }
    </section>
</section>

<dialog class="public-lightbox public-evidence-viewer captain-submission-lightbox" data-public-lightbox data-evidence-dialog data-evidence-empty="@T["Evidence"]" data-evidence-default-source="@T["Submission details"]" data-enlarged-evidence="@T["Enlarged approved evidence"]"><button type="button" class="public-ui-viewport-close" data-evidence-close aria-label="@T["Close enlarged evidence"]"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m6 6 12 12M18 6 6 18" /></svg></button><div class="public-evidence-viewer__layout"><figure class="public-evidence-viewer__figure"><img data-evidence-dialog-image alt="" /></figure><aside class="public-evidence-viewer__meta" aria-label="@T["Evidence details"]"><span class="public-ui-overline">@T["Submitted evidence"]</span><strong class="public-ui-component-title" data-evidence-dialog-drop>@T["Evidence"]</strong><dl class="public-evidence-viewer__facts"><div><dt>@T["Player"]</dt><dd data-evidence-dialog-player>—</dd></div><div><dt>@T["Team"]</dt><dd data-evidence-dialog-team>—</dd></div><div><dt>@T["Source"]</dt><dd data-evidence-dialog-source>@T["Submission details"]</dd></div></dl></aside></div></dialog>
