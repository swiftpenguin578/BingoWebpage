@page "/Captain/Submissions/{id:guid}"
@model Bingo.Web.Pages.Captain.SubmissionModel
@{ViewData["Title"]=$"Submission {Model.Details.Tile}";}
<section class="form-page"><div class="page-heading"><div><p class="eyebrow">@Model.Details.Status</p><h1>@Model.Details.Tile</h1><p>@T["Submitted"] @Model.Details.SubmittedAt.ToLocalTime().ToString("g") @T["for"] @Model.Details.Player</p></div><a asp-page="Index">@T["Back to team history"]</a></div>
@if(Model.Details.Feedback is not null){<section class="status-message"><strong>@T["Reviewer feedback"]</strong><p>@Model.Details.Feedback</p></section>}
<div class="action-grid"><section class="panel"><h2>@T["Submission"]</h2><dl><div><dt>@T["Requirement"]</dt><dd>@Model.Details.Requirement</dd></div><div><dt>@T["Claimed"]</dt><dd>@Model.Details.ClaimedWeight</dd></div><div><dt>@T["Approved"]</dt><dd>@Model.Details.Approved</dd></div><div><dt>@T["Expected code"]</dt><dd>@(Model.Details.ExpectedCode??T["Disabled"])</dd></div></dl>@if(Model.Details.AssetId is not null){<a href="/Evidence/@Model.Details.AssetId" target="_blank"><img class="evidence-preview" src="/Evidence/@Model.Details.AssetId" alt="@T["Submitted evidence"]"/></a>}</section></div>
@if(Model.Details.Editable){<div asp-validation-summary="All" class="validation-summary"></div><form method="post" enctype="multipart/form-data" asp-page-handler="Correct" class="panel form-stack"><h2>@(Model.Details.Status==Bingo.Domain.Evidence.SubmissionStatus.ChangesRequested?T["Correct and resubmit"]:T["Edit pending submission"])</h2><label>@T["Tile and requirement"]</label><select asp-for="Input.RequirementId" class="form-select">@foreach(var group in Model.Requirements.GroupBy(x=>x.Tile)){<optgroup label="@group.Key">@foreach(var req in group){<option value="@req.Id" data-tile="@req.TileId">@req.Description</option>}</optgroup>}</select><input asp-for="Input.BoardTileId" type="hidden"/><input asp-for="Input.ClaimedWeight" type="hidden"/><label>@T["Eligible drop"]</label><select asp-for="Input.DropSnapshotId" class="form-select"><option value="">@T["Manual objective / no drop"]</option>@foreach(var group in Model.Drops.GroupBy(x=>x.Boss)){<optgroup label="@group.Key">@foreach(var drop in group){<option value="@drop.Id">@drop.Item (@drop.Rate)</option>}</optgroup>}</select><label>@T["Player"]</label><select asp-for="Input.CreditedParticipantId" class="form-select">@foreach(var p in Model.Players){<option value="@p.Id">@p.Name</option>}</select><p class="requirement-rule">@T["Contribution is set by the selected board requirement."]</p><label>@T["Note"]</label><textarea asp-for="Input.Note" class="form-control"></textarea><label class="checkbox-row"><input asp-for="Input.RequestPublicPrivacy"/> @T["Hide the screenshot and player name if this submission is approved"]</label><label>@T["Replacement screenshot (optional)"]</label><div class="evidence-drop" tabindex="0"><strong>@T["Paste or drag replacement here"]</strong><input asp-for="Input.Replacement" type="file" accept="image/png,image/jpeg,image/webp"/><img alt="@T["Replacement preview"]" hidden/></div><button class="btn btn-primary">@T["Save"] @(Model.Details.Status==Bingo.Domain.Evidence.SubmissionStatus.ChangesRequested?T["and resubmit"]:T["changes"])</button></form><form method="post" asp-page-handler="Withdraw" onsubmit="return confirm('@T["Withdraw this submission?"]');"><button class="btn btn-danger">@T["Withdraw mistaken submission"]</button></form>}
</section>
@section Scripts{<script>const requirement=document.getElementById('Input_RequirementId');const tile=document.getElementById('Input_BoardTileId');requirement?.addEventListener('change',()=>tile.value=requirement.selectedOptions[0].dataset.tile);document.querySelectorAll('.evidence-drop').forEach(zone=>{const input=zone.querySelector('input');const preview=zone.querySelector('img');const show=file=>{if(!file)return;const dt=new DataTransfer();dt.items.add(file);input.files=dt.files;preview.src=URL.createObjectURL(file);preview.hidden=false};zone.addEventListener('dragover',e=>e.preventDefault());zone.addEventListener('drop',e=>{e.preventDefault();show([...e.dataTransfer.files].find(x=>x.type.startsWith('image/')))});zone.addEventListener('paste',e=>show([...e.clipboardData.files].find(x=>x.type.startsWith('image/'))));input.addEventListener('change',()=>show(input.files[0]));});</script>}
