@page "/Captain/Submissions/{id:guid}"
@model Bingo.Web.Pages.Captain.SubmissionModel
@{ ViewData["Title"] = $"Submission {Model.Details.Tile}"; }
<section class="form-page"><div class="page-heading"><div><p class="eyebrow">@Model.Details.Status</p><h1>@Model.Details.Tile</h1><p>@T["Submitted"] @Model.Details.SubmittedAt.ToLocalTime().ToString("g") @T["for"] @Model.Details.Player</p></div><a asp-page="Index" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId">@T["Back to team history"]</a></div>
@if (Model.Details.Feedback is not null) { <section class="status-message"><strong>@T["Reviewer feedback"]</strong><p>@Model.Details.Feedback</p></section> }
<div class="action-grid"><section class="panel"><h2>@T["Submission"]</h2><dl><div><dt>@T["Requirement"]</dt><dd>@Model.Details.Requirement</dd></div><div><dt>@T["Claimed"]</dt><dd>@Model.Details.ClaimedWeight</dd></div><div><dt>@T["Approved"]</dt><dd>@Model.Details.Approved</dd></div><div><dt>@T["Expected code"]</dt><dd>@(Model.Details.ExpectedCode ?? T["Disabled"])</dd></div></dl>@if (Model.Details.AssetId is not null) { <a href="/Evidence/@Model.Details.AssetId" target="_blank"><img class="evidence-preview" src="/Evidence/@Model.Details.AssetId" alt="@T["Submitted evidence"]" /></a> }</section></div>
@if (Model.Details.Editable) { <div asp-validation-summary="All" class="validation-summary"></div><form method="post" asp-page-handler="Correct" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId" class="panel form-stack"><h2>@T["Edit pending submission"]</h2><input asp-for="Input.ExpectedVersion" type="hidden" /><input asp-for="Input.CreditedParticipantId" type="hidden" /><label>@T["Tile and requirement"]</label><select asp-for="Input.RequirementId" class="form-select">@foreach (var group in Model.Requirements.GroupBy(x => x.Tile)) { <optgroup label="@group.Key">@foreach (var req in group) { <option value="@req.Id" data-tile="@req.TileId">@req.Description</option> }</optgroup> }</select><input asp-for="Input.BoardTileId" type="hidden" /><input asp-for="Input.ClaimedWeight" type="hidden" /><label>@T["Eligible drop"]</label><select asp-for="Input.DropSnapshotId" class="form-select"><option value="">@T["Manual objective / no drop"]</option>@foreach (var group in Model.Drops.GroupBy(x => x.Boss)) { <optgroup label="@group.Key">@foreach (var drop in group) { <option value="@drop.Id">@drop.Item (@drop.Rate)</option> }</optgroup> }</select><p class="requirement-rule">@T["The credited player, character snapshot, contribution weight, and active screenshot remain unchanged."]</p><label>@T["Note"]</label><textarea asp-for="Input.Note" class="form-control"></textarea><button class="btn action-accent-outline">@T["Save changes"]</button></form><form method="post" asp-page-handler="Withdraw" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId" onsubmit="return confirm('@T["Withdraw this submission?"]');"><input asp-for="Input.ExpectedVersion" type="hidden" /><button class="btn btn-danger">@T["Withdraw mistaken submission"]</button></form> }
@if (Model.CanResubmit) { <div asp-validation-summary="All" class="validation-summary"></div><form method="post" enctype="multipart/form-data" asp-page-handler="Resubmit" asp-route-eventId="@Model.EventId" asp-route-teamId="@Model.TeamId" class="panel form-stack"><h2>@T["Create linked resubmission"]</h2><p>@T["This rejected attempt stays in history. The new submission keeps its credited participant and character and requires a new screenshot."]</p><input asp-for="Resubmission.ExpectedVersion" type="hidden" /><label>@T["Tile and requirement"]</label><select asp-for="Resubmission.RequirementId" class="form-select">@foreach (var group in Model.Requirements.GroupBy(x => x.Tile)) { <optgroup label="@group.Key">@foreach (var req in group) { <option value="@req.Id" data-tile="@req.TileId">@req.Description</option> } </optgroup> }</select><input asp-for="Resubmission.BoardTileId" type="hidden" /><label>@T["Eligible drop"]</label><select asp-for="Resubmission.DropSnapshotId" class="form-select"><option value="">@T["Manual objective / no drop"]</option>@foreach (var group in Model.Drops.GroupBy(x => x.Boss)) { <optgroup label="@group.Key">@foreach (var drop in group) { <option value="@drop.Id">@drop.Item (@drop.Rate)</option> } </optgroup> }</select><label>@T["Note"]</label><textarea asp-for="Resubmission.Note" class="form-control"></textarea><label>@T["New screenshot"]</label><partial name="_EvidenceUpload" model="@("Resubmission.Evidence")" /><button class="btn action-accent-outline">@T["Submit linked resubmission"]</button></form> }
</section>
@section Scripts { <script src="~/js/captain-evidence-input.js" asp-append-version="true"></script><script>document.querySelectorAll('select[name$="RequirementId"]').forEach(requirement => requirement.addEventListener('change', () => { const tile = requirement.form?.querySelector('input[name$="BoardTileId"]'); if (tile) tile.value = requirement.selectedOptions[0]?.dataset.tile ?? tile.value; }));</script> }
