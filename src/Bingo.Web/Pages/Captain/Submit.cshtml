@page "/Captain/Submit/{tileId:guid}"
@model Bingo.Web.Pages.Captain.SubmitModel
@{ ViewData["Title"] = $"{T["Submit evidence"]}: {Model.Tile.Name}"; }
<section class="form-page">
    <div class="page-heading">
        <div><p class="eyebrow">@T["Submit one screenshot"]</p><h1>@Model.Tile.Name</h1><p>@Model.Tile.Description</p></div>
        <a asp-page="Index">@T["Back to board"]</a>
    </div>
    <partial name="_SubmissionForms" model="Model" />
</section>
@section Scripts { <script src="~/js/captain-evidence-input.js" asp-append-version="true"></script> }
