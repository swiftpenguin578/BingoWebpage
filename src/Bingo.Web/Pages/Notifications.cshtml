@page "/notifications"
@model Bingo.Web.Pages.NotificationsModel
@{ ViewData["Title"] = T["Notifications"]; }
<section class="form-page wide-form"><p class="eyebrow">@T["Notifications"]</p><h1>@T["Notifications"]</h1>
@if(!Model.Notifications.Any()){<div class="panel"><p>@T["No notifications."]</p></div>}else{<div class="panel"><ul class="details-list">@foreach(var notification in Model.Notifications){<li><a href="/notifications?read=@notification.Id"><strong>@Model.Title(notification.Type)</strong><span>@Model.Detail(notification.Type, notification.Detail)</span><small>@notification.CreatedAt.ToLocalTime().ToString("g") · @(notification.ReadAt is null ? T["Unread"] : T["Read"])</small></a></li>}</ul></div>}
@if(User.IsInRole("Admin") || User.IsInRole("SuperAdmin")){<div class="panel"><h2>Admin actions (@Model.AdminActions.Count)</h2>@if(Model.AdminActions.Items.Count==0){<p>No unresolved Admin actions.</p>}else{<ul class="details-list">@foreach(var action in Model.AdminActions.Items){<li><a href="@action.Url"><strong>@action.Title</strong><span>@action.Detail</span></a></li>}</ul>}<a class="btn btn-outline-light" href="/Admin">Open Admin tools</a></div>}
</section>
