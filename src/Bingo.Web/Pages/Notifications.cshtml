@page "/notifications"
@model Bingo.Web.Pages.NotificationsModel
@{ ViewData["Title"] = T["Notifications"]; }
<section class="form-page wide-form"><p class="eyebrow">@T["Notifications"]</p><h1>@T["Notifications"]</h1>
@if(!Model.Notifications.Any()){<div class="panel"><p>@T["No notifications."]</p></div>}else{<div class="panel"><ul class="details-list">@foreach(var notification in Model.Notifications){<li><a href="/notifications?read=@notification.Id"><strong>@Model.Title(notification.Type)</strong><span>@Model.Detail(notification.Type, notification.Detail)</span><small>@notification.CreatedAt.ToLocalTime().ToString("g") · @(notification.ReadAt is null ? T["Unread"] : T["Read"])</small></a></li>}</ul></div>}</section>
