@page
@model Bingo.Web.Pages.Account.SetupModel
@{
    ViewData["Title"] = "Create first admin";
}

<section class="form-page">
    <p class="eyebrow">Local development only</p>
    <h1>Create the first admin</h1>
    <p class="form-intro">This page stops working after the first administrator exists.</p>
    <form method="post" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.Username"></label>
        <input asp-for="Input.Username" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.Username" class="field-error"></span>
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        <button type="submit" class="btn btn-primary">Create admin</button>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
