@page "{token}"
@model Bingo.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = T["Reset password"]; }
<section class="form-page"><p class="eyebrow">@T["Account recovery"]</p><h1>@T["Choose a new password"]</h1><form method="post" class="panel form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.Password" class="field-error"></span><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.ConfirmPassword" class="field-error"></span><button class="btn btn-primary">@T["Reset password"]</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
