@page "{token}"
@model Bingo.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = T["Reset password"];
    ViewData["BodyClass"] = "public-ui-pass2";
}

<section class="public-pass2-page public-pass2-form-page public-pass2-form-page--narrow" aria-labelledby="reset-password-heading">
    <header class="public-pass2-masthead">
        <span class="public-pass2-kicker">@T["Account security"]</span>
        <h1 id="reset-password-heading">@T["Choose a new password"]</h1>
        <p>@T["Set a new password for your account."]</p>
    </header>
    <form method="post" class="public-pass2-form">
        <div asp-validation-summary="ModelOnly" class="public-pass2-validation"></div>
        <section class="public-pass2-worksection" aria-labelledby="reset-fields-heading">
            <div class="public-pass2-index" aria-hidden="true">01</div>
            <div class="public-pass2-worksection__body">
                <h2 id="reset-fields-heading">@T["New password"]</h2>
                <div class="public-pass2-field">
                    <label asp-for="Input.Password">@T["Password"]</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="public-pass2-field-error"></span>
                </div>
                <div class="public-pass2-field">
                    <label asp-for="Input.ConfirmPassword">@T["Confirm password"]</label>
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="public-pass2-field-error"></span>
                </div>
                <p class="public-pass2-note">@T["Passwords must be between 10 and 200 characters."]</p>
            </div>
        </section>
        <div class="public-pass2-form-actions">
            <button type="submit" class="public-pass2-action public-pass2-action--danger">@T["Reset password"] <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
