@page
@model Bingo.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = T["Forgot password?"];
    ViewData["BodyClass"] = "public-ui-pass2";
}

<section class="public-pass2-page public-pass2-form-page public-pass2-form-page--narrow" aria-labelledby="forgot-password-heading">
    <header class="public-pass2-masthead">
        <span class="public-pass2-kicker">@T["Account security"]</span>
        <h1 id="forgot-password-heading">@T["Forgot password?"]</h1>
        <p>@T["Contact an administrator through the community channel. They can verify you and provide a single-use reset link."]</p>
    </header>
    <div class="public-pass2-editorial-note">
        <p>@T["For privacy, this page does not look up usernames or accounts."]</p>
    </div>
    <a class="public-pass2-action public-pass2-action--outline" asp-page="Login">@T["Back to sign in"] <span aria-hidden="true">→</span></a>
</section>
