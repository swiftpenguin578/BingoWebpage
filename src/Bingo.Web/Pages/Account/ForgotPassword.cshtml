@page
@model Bingo.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = T["Forgot password?"]; }
<section class="form-page"><p class="eyebrow">@T["Account recovery"]</p><h1>@T["Forgot password?"]</h1><div class="panel form-stack"><p>@T["Contact an administrator through the community channel. They can verify you and provide a single-use reset link."]</p><p>@T["For privacy, this page does not look up usernames or accounts."]</p><a class="btn btn-outline-light" asp-page="Login">@T["Back to sign in"]</a></div></section>
