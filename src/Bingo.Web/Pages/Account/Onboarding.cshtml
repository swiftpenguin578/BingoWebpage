@page
@model Bingo.Web.Pages.Account.OnboardingModel
@{ ViewData["Title"] = T["Create your account"]; }
<section class="form-page"><p class="eyebrow">@T["Account setup"]</p><h1>@T["Create your website account"]</h1><p class="form-intro">@T["Your website username is your public password-login identity. Most people use their primary OSRS character, but the two values do not need to match."]</p><form method="post" class="panel form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary" tabindex="-1"></div><label asp-for="Input.Username">@T["Website username"]</label><input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus/><span asp-validation-for="Input.Username" class="field-error"></span><label asp-for="Input.OsrsCharacterName">@T["First OSRS character"]</label><p class="form-hint">@T["Use the exact OSRS character spelling. We do not validate ownership, availability, or existence."]</p><input asp-for="Input.OsrsCharacterName" class="form-control"/><span asp-validation-for="Input.OsrsCharacterName" class="field-error"></span><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.Password" class="field-error"></span><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.ConfirmPassword" class="field-error"></span><button class="btn action-accent-outline">@T["Create account"]</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
