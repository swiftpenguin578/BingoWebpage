@page
@model Bingo.Web.Pages.Account.OnboardingModel
@{ ViewData["Title"] = T["Create your account"]; }
<section class="form-page"><p class="eyebrow">@T["Account setup"]</p><h1>@T["Create your website account"]</h1><p class="form-intro">@T["Enter your exact OSRS account name. We do not validate account ownership or availability."]</p><form method="post" class="panel form-stack"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Input.Username">@T["Public username / OSRS account name"]</label><input asp-for="Input.Username" class="form-control" autofocus/><span asp-validation-for="Input.Username" class="field-error"></span><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.Password" class="field-error"></span><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="Input.ConfirmPassword" class="field-error"></span><button class="btn btn-primary">@T["Create account"]</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
