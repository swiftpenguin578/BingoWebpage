@page
@model Bingo.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="form-page">
    <p class="eyebrow">Protected access</p>
    <h1>Sign in</h1>
    <p class="form-intro">Admin and captain accounts only. Participants do not need an account.</p>

    <form method="post" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Input.Username"></label>
        <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Username" class="field-error"></span>
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <label class="check-row"><input asp-for="Input.RememberMe" /> Remember me on this device</label>
        <button type="submit" class="btn btn-primary">Sign in</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
