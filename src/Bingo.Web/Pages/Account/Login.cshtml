@page
@model Bingo.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = T["Sign in"];
}

<section class="form-page">
    <p class="eyebrow">@T["Protected access"]</p>
    <h1>@T["Sign in"]</h1>
    <p class="form-intro">@T["Use your public username and password, or continue with Discord when it is available."]</p>

    <form method="post" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Input.Username"></label>
        <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Username" class="field-error"></span>
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <label class="check-row"><input asp-for="Input.RememberMe" /> @T["Remember me on this device"]</label>
        <button type="submit" class="btn btn-primary">@T["Sign in"]</button>
        <a class="btn btn-outline-light" asp-page="ForgotPassword">@T["Forgot password?"]</a>
    </form>
    <p><a class="btn btn-outline-light" asp-page="DiscordLogin" asp-route-returnUrl="@Model.ReturnUrl">@T["Continue with Discord"]</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
