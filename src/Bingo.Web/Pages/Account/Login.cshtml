@page
@model Bingo.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = T["Log in or sign up"];
    ViewData["BodyClass"] = "public-login-page";
}

<section class="login-sheet" aria-labelledby="login-heading">
    <div class="login-sheet__column">
        <span class="login-sheet__kicker">@T["Welcome back"]</span>
        <h1 id="login-heading">@T["Log in or sign up"]</h1>
        <p>@T["Follow live boards, manage your signups and submit evidence from one account."]</p>
        <partial name="_LoginForm" model="Model" />
    </div>
    <div class="login-sheet__artwork" aria-hidden="true">
        <div class="login-sheet__background"></div>
        <img class="login-sheet__mark login-sheet__mark--light" src="~/images/branding/login-artwork.svg" asp-append-version="true" alt="" />
        <img class="login-sheet__mark login-sheet__mark--dark" src="~/images/branding/login-artwork-dark.svg" asp-append-version="true" alt="" />
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
