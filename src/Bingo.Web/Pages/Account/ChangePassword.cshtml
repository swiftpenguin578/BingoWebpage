@page
@model Bingo.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<section class="form-page">
    <p class="eyebrow">Account security</p>
    <h1>Change password</h1>
    <form method="post" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.CurrentPassword"></label>
        <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        <button type="submit" class="btn btn-primary">Update password</button>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
