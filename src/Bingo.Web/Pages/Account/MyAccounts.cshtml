@page
@model Bingo.Web.Pages.Account.MyAccountsModel
@{
    ViewData["Title"] = T["My accounts"];
}

<section class="form-page wide-form my-accounts-page">
    <p class="eyebrow">@T["My accounts"]</p>
    <h1>@T["Your OSRS characters"]</h1>
    <p class="form-intro">@T["Keep a personal ordered list of OSRS characters for future signups."]</p>
    <div asp-validation-summary="ModelOnly" class="validation-summary" tabindex="-1"></div>

    <section class="panel form-stack" aria-labelledby="add-character-heading">
        <h2 id="add-character-heading">@T["Add OSRS character"]</h2>
        <p class="form-hint">@T["Use the exact OSRS character spelling. We do not validate ownership, availability, or existence."]</p>
        <form method="post" asp-page-handler="Add" class="account-entry-form">
            <label asp-for="Add.CharacterName"></label>
            <input asp-for="Add.CharacterName" class="form-control" />
            <span asp-validation-for="Add.CharacterName" class="field-error"></span>
            <label asp-for="Add.PersonalLabel"></label>
            <input asp-for="Add.PersonalLabel" class="form-control" />
            <span asp-validation-for="Add.PersonalLabel" class="field-error"></span>
            <label asp-for="Add.SavedEhb"></label>
            <input asp-for="Add.SavedEhb" class="form-control" inputmode="decimal" />
            <span asp-validation-for="Add.SavedEhb" class="field-error"></span>
            <button class="btn action-accent-outline">@T["Add character"]</button>
        </form>
    </section>

    @if (Model.PendingUnlinkLinkId is { } pendingId && Model.Links.FirstOrDefault(link => link.Id == pendingId) is { } pending)
    {
        <section class="panel account-warning" aria-labelledby="unlink-warning-heading">
            <h2 id="unlink-warning-heading">@T["Event registration remains"]</h2>
            <p>@T["Unlinking {0} only hides it from future My Accounts selectors. Its upcoming or live event registration remains unchanged.", pending.CharacterName]</p>
            <form method="post" asp-page-handler="Unlink" class="button-row">
                <input asp-for="Unlink.LinkId" type="hidden" value="@pending.Id" />
                <input asp-for="Unlink.ConfirmRegistrationWarning" type="hidden" value="true" />
                <button class="btn btn-outline-danger">@T["Unlink character"]</button>
                <a class="btn neutral-outline-action" asp-page="MyAccounts">@T["Cancel"]</a>
            </form>
        </section>
    }

    <section class="panel my-accounts-list" aria-labelledby="linked-characters-heading">
        <div class="page-heading">
            <div><h2 id="linked-characters-heading">@T["Linked characters"]</h2><p>@T["Your list order is used for future selectors. Saved EHB never changes an existing event registration."]</p></div>
        </div>
        @if (!Model.Links.Any())
        {
            <div class="empty-drop-list"><strong>@T["No OSRS characters yet"]</strong><span>@T["Add an OSRS character to start your list."]</span></div>
        }
        else
        {
            <ol class="my-accounts-list-items">
            @foreach (var link in Model.Links)
            {
                <li class="my-account-card" id="character-@link.Id">
                    <header>
                        <div><span class="my-account-position">@T["#{0}", link.Position + 1]</span><strong>@link.CharacterName</strong>@if (link.Preferred) { <span class="account-state">@T["Preferred"]</span> }</div>
                        <div class="my-account-order" aria-label="@T["Change list order"]">
                            <form method="post" asp-page-handler="MoveUp"><input asp-for="Action.LinkId" type="hidden" value="@link.Id" /><button class="btn neutral-outline-action" aria-label="@T["Move {0} up", link.CharacterName]" disabled="@(link == Model.Links.First())">↑</button></form>
                            <form method="post" asp-page-handler="MoveDown"><input asp-for="Action.LinkId" type="hidden" value="@link.Id" /><button class="btn neutral-outline-action" aria-label="@T["Move {0} down", link.CharacterName]" disabled="@(link == Model.Links.Last())">↓</button></form>
                        </div>
                    </header>
                    <form method="post" asp-page-handler="Update" class="account-entry-form compact">
                        <input asp-for="Edit.LinkId" type="hidden" value="@link.Id" />
                        <label for="label-@link.Id">@T["Personal label"]</label>
                        <input id="label-@link.Id" name="Edit.PersonalLabel" value="@link.PersonalLabel" class="form-control" />
                        <label for="ehb-@link.Id">@T["Saved EHB"]</label>
                        <input id="ehb-@link.Id" name="Edit.SavedEhb" value="@link.SavedEhb" class="form-control" inputmode="decimal" />
                        <button class="btn neutral-outline-action">@T["Save details"]</button>
                    </form>
                    <div class="my-account-actions">
                        @if (!link.Preferred)
                        {
                            <form method="post" asp-page-handler="SetPreferred"><input asp-for="Action.LinkId" type="hidden" value="@link.Id" /><button class="btn action-accent-outline">@T["Make preferred"]</button></form>
                        }
                        <form method="post" asp-page-handler="Unlink"><input asp-for="Unlink.LinkId" type="hidden" value="@link.Id" /><button class="btn btn-outline-danger">@T["Unlink"]</button></form>
                    </div>
                    @if (link.HasUpcomingOrLiveRegistration) { <p class="form-hint">@T["This character is registered for an upcoming or live event. Unlinking will not change that registration."]</p> }
                    <details class="my-account-correction" data-state-key="correct-@link.Id">
                        <summary>@T["Correct spelling"]</summary>
                        <form method="post" asp-page-handler="Correct" class="account-entry-form compact">
                            <input asp-for="Correct.LinkId" type="hidden" value="@link.Id" />
                            <label for="correct-@link.Id">@T["Correct OSRS character spelling"]</label>
                            <input id="correct-@link.Id" name="Correct.CharacterName" value="@link.CharacterName" class="form-control" />
                            <p class="form-hint">@T["This updates your link and any currently editable registrations that use this character. Closed and live history stays unchanged."]</p>
                            <button class="btn btn-outline-danger">@T["Correct character"]</button>
                        </form>
                    </details>
                </li>
            }
            </ol>
        }
    </section>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
