@page
@model ErrorModel
@{
    ViewData["Title"] = T["Error"];
}

<section class="status-editorial status-editorial--500" aria-labelledby="error-heading">
    <div class="status-editorial__code" aria-hidden="true">500</div>
    <div class="status-editorial__copy"><span class="editorial-kicker">@T["Error"]</span><h1 id="error-heading" class="editorial-display">@T["Something went wrong"]</h1><p>@T["Please try again. If the problem continues, contact Chris on Discord."]</p>@if (Model.ShowRequestId) { <p class="status-request"><span>@T["Request ID"]</span> <code>@Model.RequestId</code></p> }<a class="editorial-button editorial-button--coral-outline" asp-page="/Index">@T["Return to public boards"] <span aria-hidden="true">→</span></a></div>
</section>
