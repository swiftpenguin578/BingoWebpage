# Copy to /etc/bingo/production-ops.env on the VPS, chown root:root, chmod 0600.
BINGO_ROOT=/srv/bingo
BINGO_COMPOSE_FILE=/srv/bingo/compose.production.yml
BINGO_CADDY_FILE=/srv/bingo/deploy/Caddyfile
BINGO_ENV_FILE=/etc/bingo/production.env
BINGO_RESTIC_ENV_FILE=/etc/bingo/restic.env
BINGO_RESTIC_PASSWORD_FILE=/etc/bingo/restic-password
BINGO_GHCR_ENV_FILE=/etc/bingo/ghcr-readonly.env
BINGO_BACKUP_ROOT=/var/lib/bingo/backups
BINGO_LOG_DIR=/var/log/bingo
BINGO_DEPLOYMENT_ROOT=/var/lib/bingo/deployments
BINGO_RECEIPT_ROOT=/var/lib/bingo/backup-receipts
BINGO_BOOTSTRAP_STATE_FILE=/var/lib/bingo/bootstrap-state
BINGO_LOCK_FILE=/run/lock/bingo-production.lock
BINGO_IMAGE_NAME=ghcr.io/example/osrs-community-bingo
BINGO_DOMAIN=bingo.example.invalid
BINGO_BOOTSTRAP_OWNER_USERNAME=replace-with-owner-username
BINGO_BOOTSTRAP_OWNER_PASSWORD_FILE=/etc/bingo/bootstrap-owner-password
BINGO_DATA_PROTECTION_DIR=/var/lib/docker/volumes/bingo-production-data-protection/_data
# Set required only for a retained database crossing the legacy boundary.
BINGO_RETAINED_LEGACY_PREFLIGHT=skip
BINGO_RETAINED_OWNER=
BINGO_POSTGRES_IMAGE=postgres:17-alpine
BINGO_KEEP_DAILY=7
BINGO_KEEP_WEEKLY=8
BINGO_KEEP_MONTHLY=12
