# Copy to /etc/bingo/restic.env, chown root:root, chmod 0600.
# Restic encrypts the repository; use an S3-compatible endpoint selected by the operator.
RESTIC_REPOSITORY=s3:https://replace-with-s3-endpoint/bingo-production
AWS_ACCESS_KEY_ID=replace-with-restic-access-key
AWS_SECRET_ACCESS_KEY=replace-with-restic-secret-key
AWS_DEFAULT_REGION=auto
